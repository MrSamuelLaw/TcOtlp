<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_SpanProcessorFailureReason" Id="{210370f5-136e-4ba1-bf98-1a9b67c0080a}">
    <Declaration><![CDATA[(* Why a span processor could not keep or export an ended span. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_SpanProcessorFailureReason :
(
	NA := 0,  // No failure occurred.
	SPAN_CLONE_FAILURE,  // The ended span could not be cloned for retention.
	QUEUE_PUSH_FAILURE,  // The clone could not be pushed onto the queue.
	EXPORT_FAILURE  // The exporter did not accept the prepared batch.
) UDINT;
END_TYPE
]]></Declaration>
