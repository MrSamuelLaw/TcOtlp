<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_TraceStateFailureReason" Id="{35e6b0b3-9989-4b4f-a2f2-90bce258c6da}">
    <Declaration><![CDATA[(* Why TraceStateFactory could not produce a trace state. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_TraceStateFailureReason :
(
	NA := 0,  // No failure.
	DESTINATION_ALREADY_ASSIGNED,  // The destination pointer already holds a trace state.
	SOURCE_POINTER_NULL,  // The source trace state is missing or has been freed.
	HEADER_POINTER_NULL,  // The header pointer is 0.
	HEADER_TOO_LONG,  // The header is longer than TraceStateFactory.MAX_HEADER_LENGTH.
	INVALID_KEY,  // An entry has a key that does not follow the W3C key grammar.
	INVALID_VALUE,  // An entry has no '=' or a value that does not follow the W3C value grammar.
	DUPLICATE_KEY,  // Two entries have the same key.
	TOO_MANY_ENTRIES,  // The header has more than TraceStateFactory.MAX_ENTRIES entries.
	MEMORY_ALLOCATION_FAILURE  // The trace state could not be allocated.
) UDINT;
END_TYPE
]]></Declaration>
