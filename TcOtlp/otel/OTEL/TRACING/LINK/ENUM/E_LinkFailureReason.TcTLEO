<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_LinkFailureReason" Id="{80042483-c6c1-4d55-964c-4d3d4cc6edc9}">
    <Declaration><![CDATA[(* Why a LinkFactory or FB_Links call failed. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_LinkFailureReason :
(
	NA := 0,  // No failure occurred.
	DESTINATION_ALREADY_ASSIGNED,  // The destination pointer was not 0.
	CONTEXT_POINTER_NULL,  // The span context pointer is null.
	CONTEXT_INVALID,  // The span context has an all zero trace id or span id.
	SPAN_POINTER_NULL,  // The span pointer is null.
	LINK_POINTER_NULL,  // The link pointer is null.
	LINK_COUNT_LIMIT_REACHED,  // The collection already holds maxCount links; the link was dropped and counted.
	LINKS_EMPTY,  // The collection holds no links.
	MEMORY_ALLOCATION_FAILURE,  // Dynamic memory allocation failed.
	ATTRIBUTE_COPY_FAILURE  // The link attributes could not be copied.
) UDINT;
END_TYPE
]]></Declaration>
