<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_TracerProviderFailureReason" Id="{da2ffe3e-0d1f-40b2-acfd-cb83f59e027b}">
    <Declaration><![CDATA[(* Why FB_TracerProvider.tick failed. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_TracerProviderFailureReason :
(
	NA := 0,  // No failure occurred.
	QUEUE_POP_FAILURE,  // An ended span could not be popped from the provider queue.
	STAGE_PROCESSOR_FAILURE,  // A processor could not be added to the staged list.
	UNEXPECTED_NULL_PROCESSOR_POINTER,  // A staged processor pointer was null.
	UNEXPECTED_NULL_LINKED_LIST_NODE,  // The staged list was shorter than stagedProcessorCount.
	ID_GENERATOR_TICK_FAILURE  // The id generator could not advance.
) UDINT;
END_TYPE
]]></Declaration>
