<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_SpanExporterFailureReason" Id="{21e06c98-435b-44fd-919a-c9869f59babe}">
    <Declaration><![CDATA[(* Why a span exporter refused a batch or could not deliver it. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_SpanExporterFailureReason :
(
	NA := 0,  // No failure occurred.
	ACTIVE_EXPORT_IN_PROGRESS,  // The exporter cannot accept another batch while an export is active.
	QUEUE_TRANSFER_FAILURE,  // Spans could not be transferred into the exporter queue.
	SERIALIZATION_FAILURE,  // The accepted spans could not be serialized.
	BUFFER_ALLOCATION_FAILURE,  // The serialized payload buffer could not be allocated.
	FILE_OPEN_FAILURE,  // The destination file could not be opened.
	FILE_WRITE_FAILURE,  // The serialized payload could not be written.
	FILE_CLOSE_FAILURE,  // The destination file could not be closed.
	HTTP_URL_PARSE_FAILURE,  // The configured endpoint URL could not be parsed.
	HTTP_REQUEST_FAILURE,  // The HTTP request could not be sent or completed.
	HTTP_STATUS_FAILURE  // The server responded with a non-success HTTP status code.
) UDINT;
END_TYPE
]]></Declaration>
