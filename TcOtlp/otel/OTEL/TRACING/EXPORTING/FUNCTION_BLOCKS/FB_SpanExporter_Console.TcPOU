<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SpanExporter_Console" Id="{bfa6e66b-a17a-4273-aefc-2078300ae23c}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	Writes one line per span to the TwinCAT ADS log at hint level, for development and
	commissioning. For example:
	  span "work" trace=0101...01 span=0202020202020202 parent=none kind=SPAN_KIND_INTERNAL status=STATUS_CODE_UNSET duration=500ns
	export writes the whole batch and releases it before returning, so the exporter is never
	busy and suits FB_SpanProcessor_Simple. Attributes, links, resource and scope are not
	written. Lines longer than 255 characters are truncated.
*)
FUNCTION_BLOCK FB_SpanExporter_Console EXTENDS FB_SpanExporter_Base
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.tick(failureReason=>THIS^._callFailureReason);]]></ST>
    </Implementation>
    <Method Name="_hex" Id="{29d05295-65a5-4fe2-aeda-a1d0a703112a}">
      <Declaration><![CDATA[(* Lower-case hex of count bytes; at most 64 bytes are written. *)
METHOD _hex : T_MaxString
VAR_INPUT
	pBytes: POINTER TO BYTE;
	count: UDINT;
END_VAR
VAR CONSTANT
	MAX_BYTES: UDINT := 64;
END_VAR
VAR
	_i: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_hex := '';
IF pBytes = 0 THEN
	RETURN;
END_IF

FOR _i := 1 TO MIN(count, MAX_BYTES) DO
	_hex := CONCAT(_hex, BYTE_TO_HEXSTR(in:=pBytes[_i - 1], iPrecision:=2, bLoCase:=TRUE));
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="export" Id="{c447d4a5-f2a7-4555-8816-dc3bc4a28608}">
      <Declaration><![CDATA[(* Accepts the batch, writes one line per span and releases the batch. *)
METHOD export : BOOL
VAR_IN_OUT
	spans: FB_SpanQueue;
END_VAR
VAR_INPUT
	count: UDINT;
END_VAR
VAR_OUTPUT
	failureReason: E_SpanExporterFailureReason;
END_VAR
VAR
	_idx: UDINT;
	_pSpan: POINTER TO FB_Span;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[export := SUPER^.export(
	spans:=spans,
	count:=count,
	failureReason=>failureReason
);
IF NOT export THEN
	RETURN;
END_IF

THIS^._spans.reset();
FOR _idx := 1 TO TcOtlp_GVL.MAX_LOOP_COUNT DO
	_pSpan := THIS^._spans.next();
	IF _pSpan = 0 THEN
		EXIT;
	END_IF
	ADSLOGSTR(msgCtrlMask:=ADSLOG_MSGTYPE_HINT, msgFmtStr:='%s', strArg:=THIS^.format(_pSpan^));
END_FOR

THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="format" Id="{ed9cc2c8-6736-4c87-811f-7b4cce07c97e}">
      <Declaration><![CDATA[(* Builds the log line for one span. Missing members are written as empty, none or unset. *)
METHOD format : T_MaxString
VAR_INPUT
	span: REFERENCE TO FB_Span;
END_VAR
VAR
	_name: T_MaxString;
	_traceId: T_MaxString;
	_spanId: T_MaxString;
	_parent: T_MaxString := 'none';
	_status: E_StatusCode := E_StatusCode.STATUS_CODE_UNSET;
	_duration: ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[format := '';
IF NOT __ISVALIDREF(span) THEN
	RETURN;
END_IF

IF span.name <> 0 AND_THEN span.name^.pString <> 0 THEN
	_name := span.name^.pString^;
END_IF
IF span.traceId <> 0 THEN
	_traceId := THIS^._hex(pBytes:=ADR(span.traceId^.bytes), count:=SIZEOF(span.traceId^.bytes));
END_IF
IF span.spanId <> 0 THEN
	_spanId := THIS^._hex(pBytes:=ADR(span.spanId^.bytes), count:=SIZEOF(span.spanId^.bytes));
END_IF
IF span.parentSpanId <> 0 THEN
	_parent := THIS^._hex(pBytes:=ADR(span.parentSpanId^.bytes), count:=SIZEOF(span.parentSpanId^.bytes));
END_IF
IF span.status <> 0 THEN
	_status := span.status^.code;
END_IF
IF span.endTimestamp > span.startTimestamp THEN
	_duration := span.endTimestamp - span.startTimestamp;
END_IF

format := CONCAT('span "', _name);
format := CONCAT(format, '" trace=');
format := CONCAT(format, _traceId);
format := CONCAT(format, ' span=');
format := CONCAT(format, _spanId);
format := CONCAT(format, ' parent=');
format := CONCAT(format, _parent);
format := CONCAT(format, ' kind=');
format := CONCAT(format, TO_STRING(span.kind));
format := CONCAT(format, ' status=');
format := CONCAT(format, TO_STRING(_status));
format := CONCAT(format, ' duration=');
format := CONCAT(format, ULINT_TO_STRING(_duration));
format := CONCAT(format, 'ns');]]></ST>
      </Implementation>
    </Method>
    <Method Name="isBusy" Id="{4772e1a3-f8a6-43c3-b9ed-4b20b994e8b3}">
      <Declaration><![CDATA[METHOD isBusy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isBusy := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="tick" Id="{fec7cc30-b13d-4046-88f6-617ee43e5c60}">
      <Declaration><![CDATA[METHOD tick : BOOL
VAR_OUTPUT
	failureReason: E_SpanExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[failureReason := E_SpanExporterFailureReason.NA;
tick := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>