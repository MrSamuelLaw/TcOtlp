<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TraceId" Id="{957763e9-1dc3-43f7-8bee-d4f8556d5952}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_TraceId IMPLEMENTS I_OtlpValue
VAR_OUTPUT
	bytes: ARRAY [0..15] OF BYTE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="delete" Id="{c97e0256-4d82-467f-8451-1a78cc35cf61}">
      <Declaration><![CDATA[(*
	Releases this value and clears the caller's pointer to it: call it as p^.delete(pSelf:=p).
	pSelf is cleared before the value is freed, so the caller never keeps a dangling pointer.
	A pointer to any other object is refused and left untouched, and nothing is released.
*)
METHOD delete : BOOL
VAR_IN_OUT
	pSelf: POINTER TO FB_TraceId;
END_VAR
VAR
	_pThis: POINTER TO FB_TraceId;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_pThis := THIS;
IF pSelf <> _pThis THEN
	RETURN;
END_IF

pSelf := 0;
__DELETE(_pThis);
delete := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="eType" Id="{a8e38517-e28e-4988-8201-c1e2d19bf319}">
      <Declaration><![CDATA[PROPERTY eType : E_ValueType]]></Declaration>
      <Get Name="Get" Id="{932f2685-55a3-403d-b638-288e54b28a9f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[eType := E_ValueType.E_TraceId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Exit" Id="{c97eaf69-2ccb-4370-a9b2-610f66a40aba}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{f2521e9b-00ca-4214-9c98-a50a3ee6d37e}">
      <Declaration><![CDATA[METHOD free]]></Declaration>
      <Implementation>
        <ST><![CDATA[// just resets values to defaults
MEMSET(ADR(THIS^.bytes), 0, SIZEOF(THIS^.bytes));]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
