  <EnumerationTextList Name="E_AttributesFailureReason" Id="{46c706e7-c1b2-401b-ba9a-eff8813268da}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_AttributesFailureReason :
(
	NA := 0,  // No attribute failure occurred.
	KV_POINTER_NULL,  // The supplied key-value pair pointer is null.
	KV_KEY_POINTER_NULL,  // The key-value pair has no key.
	KV_VALUE_POINTER_NULL,  // The key-value pair has no value.
	KV_VALUE_INVALID,  // The key-value pair contains an invalid value.
	KV_VALUE_TYPE_UNSUPPORTED,  // The key-value pair contains an unsupported value type.
	ATTRIBUTE_COUNT_LIMIT_REACHED,  // Adding a new key would exceed the configured attribute count limit.
	MEMORY_ALLOCATION_FAILURE,  // Dynamic memory allocation failed.
	KEY_NOT_FOUND  // The source collection has no attribute with the requested key.
) UDINT;
END_TYPE
]]></Declaration>
