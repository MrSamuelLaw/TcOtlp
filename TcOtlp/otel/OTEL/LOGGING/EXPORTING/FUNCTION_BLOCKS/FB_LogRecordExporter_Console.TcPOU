<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordExporter_Console" Id="{d538f5ca-8c22-4ab0-a796-ad58fa044956}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordExporter_Console EXTENDS FB_LogRecordExporter_Base
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.tick(failureReason=>THIS^._callFailureReason);]]></ST>
    </Implementation>
    <Method Name="export" Id="{235fc2e0-2811-42e4-bfd0-f35f1b145a8e}">
      <Declaration><![CDATA[METHOD export : BOOL
VAR_IN_OUT
	logRecords: FB_LogRecordQueue;
END_VAR
VAR_INPUT
	count: UDINT;
END_VAR
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[export := SUPER^.export(
	logRecords:=logRecords,
	count:=count,
	failureReason=>failureReason
);
IF NOT export THEN
	RETURN;
END_IF

THIS^.writeToConsole(THIS^._records);
THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="isBusy" Id="{941c51ad-8a54-463a-9aa8-04504fc50b02}">
      <Declaration><![CDATA[METHOD isBusy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isBusy := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="tick" Id="{60b42b8c-0f95-4065-9421-c68853ec8399}">
      <Declaration><![CDATA[METHOD tick : BOOL
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[failureReason := E_LogRecordExporterFailureReason.NA;
tick := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="writeToConsole" Id="{3aea6abb-ab87-43d2-85a8-96216ee4ee7a}">
      <Declaration><![CDATA[METHOD writeToConsole
VAR_IN_OUT
	logRecords: FB_LogRecordQueue;
END_VAR
VAR
	idx: DINT;
	logRecord: POINTER TO FB_LogRecord;
	body: POINTER TO FB_String;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[logRecords.reset();
FOR idx := 0 TO TcOtlp_GVL.MAX_LOOP_COUNT DO
	logRecord := logRecords.next();
	IF logRecord = 0 THEN
		RETURN;
	END_IF
	IF logRecord^.body <> 0 AND_THEN logRecord^.body^.eType = E_ValueType.E_String THEN
		body := logRecord^.body;
		ADSLOGSTR(
			ADSLOG_MSGTYPE_ERROR,
			body^.pString^,
			''
		);
	END_IF
END_FOR

	]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>