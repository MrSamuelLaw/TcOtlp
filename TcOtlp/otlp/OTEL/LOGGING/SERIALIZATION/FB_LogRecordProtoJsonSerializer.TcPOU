<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProtoJsonSerializer" Id="{73891a86-0808-41a7-905d-c2fb3e52068f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordProtoJsonSerializer EXTENDS FB_BaseProtoJsonSerializer
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="serializeLogRecord" Id="{0654a950-e3ed-4905-a094-4f2eaf1f97d9}">
      <Declaration><![CDATA[METHOD serializeLogRecord : BOOL
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pLogRecord: POINTER TO FB_LogRecord;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_buf: T_MaxString;
	_obj: SJsonValue;
	_member: SJsonValue;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[serializeLogRecord := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF
IF pLogRecord = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_POINTER_NULL;
	RETURN;
END_IF

_obj := THIS^.parser.PushbackJsonValue(v, '{}');
IF _obj = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

_buf := pLogRecord^.severityText;
_member := THIS^.parser.AddUintMember(_obj, 'severityNumber', TO_UDINT(pLogRecord^.severityNumber));
IF _member = 0 THEN failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE; RETURN; END_IF
_member := THIS^.parser.AddStringMember(_obj, 'severityText', _buf);
IF _member = 0 THEN failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE; RETURN; END_IF
IF NOT THIS^.serializeUint64Value(_obj, ADR('timeUnixNano'), pLogRecord^.timestamp, failureReason=>failureReason) THEN RETURN; END_IF

IF pLogRecord^.eventName <> 0 AND_THEN NOT THIS^.serializeStringValue(_obj, ADR('eventName'), pLogRecord^.eventName, failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.traceId <> 0 AND_THEN NOT THIS^.serializeTraceIdValue(_obj, pLogRecord^.traceId, failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.flags <> 0 AND_THEN NOT THIS^.serializeUint32Value(_obj, ADR('flags'), TO_UDINT(pLogRecord^.flags^), failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.spanId <> 0 AND_THEN NOT THIS^.serializeSpanIdValue(_obj, pLogRecord^.spanId, failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.body <> 0 AND_THEN NOT THIS^.serializeAnyValue(_obj, ADR('body'), pLogRecord^.body, failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.attributes.count > 0 AND_THEN NOT THIS^.serializeKeyValues(_obj, ADR('attributes'), ADR(pLogRecord^.attributes), failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.droppedAttributesCount > 0 AND_THEN NOT THIS^.serializeUint32Value(
	_obj,
	ADR('droppedAttributesCount'),
	pLogRecord^.droppedAttributesCount,
	failureReason=>failureReason
) THEN
	RETURN;
END_IF
serializeLogRecord := failureReason = E_ProtoJsonSerializerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeLogsData" Id="{30e2ee58-3e38-41f6-ae3d-42f8fb22ab4d}">
      <Declaration><![CDATA[(*
	Takes ownership of all supplied records. Popped records and records remaining in the
	queue are released on both success and failure.
*)
METHOD serializeLogsData : BOOL
VAR_IN_OUT
	logRecords: FB_LogRecordQueue;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_ownedRecordCount: UDINT;
	_pOwnedRecord: POINTER TO FB_LogRecord;
	_resourceLogs: SJsonValue;
	_resourceIdx: UDINT;
	_queueFailureReason: E_LogRecordQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[serializeLogsData := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;

// fail early if loop limit exceeded.
_ownedRecordCount := logRecords.size;
IF _ownedRecordCount > GVL.MAX_LOOP_COUNT THEN
	logRecords.free();
	failureReason := E_ProtoJsonSerializerFailureReason.LOOP_LIMIT_EXCEEDED;
	RETURN;
END_IF

// start a new document in make the first entry an object i.e. "{}"
THIS^.jsonValue := THIS^.parser.NewDocument();
IF THIS^.jsonValue = 0 THEN
	logRecords.free();
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF
THIS^.jsonValue := THIS^.parser.SetObject(THIS^.jsonValue);
IF THIS^.jsonValue = 0 THEN
	logRecords.free();
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

// start the resource logs block
_resourceLogs := THIS^.parser.AddArrayMember(THIS^.jsonValue, 'resourceLogs', 0);
IF _resourceLogs = 0 THEN
	logRecords.free();
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

_pOwnedRecord := 0;
IF _ownedRecordCount > 0 THEN
	FOR _resourceIdx := 1 TO _ownedRecordCount DO
		IF logRecords.size = 0 THEN EXIT; END_IF

		// pop the record to start the group
		IF NOT logRecords.pop(pValue:=_pOwnedRecord, failureReason=>_queueFailureReason) THEN
			failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_POP_FAILURE;
			EXIT;
		END_IF
		IF _pOwnedRecord = 0 THEN
			failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
			EXIT;
		END_IF

		// Recursively descend from LogsData into ResourceLogs and ScopeLogs.
		IF NOT THIS^.serializeResourceLogs(
			v:=_resourceLogs,
			logRecords:=logRecords,
			pLogRecord:=_pOwnedRecord,
			failureReason=>failureReason
		) THEN
			EXIT;
		END_IF
	END_FOR
END_IF

// clean up the last record if it's not cleaned up already
IF _pOwnedRecord <> 0 THEN
	_pOwnedRecord := _pOwnedRecord^.delete();
END_IF

// set flag if log records didn't all get consumed
IF logRecords.size > 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.LOOP_LIMIT_EXCEEDED;
END_IF

// free all the memory and return status
logRecords.free();
serializeLogsData := failureReason = E_ProtoJsonSerializerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeResourceLogs" Id="{4e0ad4b8-d29b-44d7-a231-362cab2e184e}">
      <Declaration><![CDATA[METHOD serializeResourceLogs : BOOL
VAR_IN_OUT
	v: SJsonValue;
	logRecords: FB_LogRecordQueue;
	pLogRecord: POINTER TO FB_LogRecord;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_resourceId: UDINT;
	_scopeLogs: SJsonValue;
	_pHeadRecord: POINTER TO FB_LogRecord;
	_scopeLimit: UDINT;
	_recordsToScan: UDINT;
	_scopeIdx: UDINT;
	_scanIdx: UDINT;
	_queueFailureReason: E_LogRecordQueueFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[serializeResourceLogs := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF
IF pLogRecord = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_POINTER_NULL;
	RETURN;
END_IF

_resourceId := pLogRecord^.resource.id;
IF NOT THIS^.startNewResource(
	v:=v,
	pLogRecord:=pLogRecord,
	scopeLogs=>_scopeLogs,
	failureReason=>failureReason
) THEN
	RETURN;
END_IF

// Descend through each scope belonging to this resource. The queue remains
// the owner of every record until a matching record is popped.
_scopeLimit := logRecords.size + 1;
FOR _scopeIdx := 1 TO _scopeLimit DO
	IF NOT THIS^.serializeScopeLogs(
		v:=_scopeLogs,
		logRecords:=logRecords,
		pLogRecord:=pLogRecord,
		resourceId:=_resourceId,
		failureReason=>failureReason
	) THEN
		RETURN;
	END_IF

	// Find the first record for another scope of this resource. Rotating all
	// other records preserves their arrival order for later resource groups.
	_recordsToScan := logRecords.size;
	FOR _scanIdx := 1 TO _recordsToScan DO
		logRecords.reset();
		_pHeadRecord := logRecords.next();
		IF _pHeadRecord = 0 THEN
			failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
			RETURN;
		END_IF
		IF pLogRecord = 0 AND_THEN _pHeadRecord^.resource.id = _resourceId THEN
			IF NOT logRecords.pop(pValue:=pLogRecord, failureReason=>_queueFailureReason) THEN
				failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_POP_FAILURE;
				RETURN;
			END_IF
			IF pLogRecord = 0 THEN
				failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
				RETURN;
			END_IF
		ELSIF NOT logRecords.rotate(failureReason=>_queueFailureReason) THEN
			failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_ROTATE_FAILURE;
			RETURN;
		END_IF
	END_FOR

	IF pLogRecord = 0 THEN
		serializeResourceLogs := failureReason = E_ProtoJsonSerializerFailureReason.NA;
		RETURN;
	END_IF
END_FOR

failureReason := E_ProtoJsonSerializerFailureReason.LOOP_LIMIT_EXCEEDED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeScopeLogs" Id="{b6c0f248-05c6-4caa-94ee-1fe6d62a922b}">
      <Declaration><![CDATA[METHOD serializeScopeLogs : BOOL
VAR_IN_OUT
	v: SJsonValue;
	logRecords: FB_LogRecordQueue;
	pLogRecord: POINTER TO FB_LogRecord;
END_VAR
VAR_INPUT
	resourceId: UDINT;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_scopeName: T_MaxString;
	_serializedRecords: SJsonValue;
	_pHeadRecord: POINTER TO FB_LogRecord;
	_recordsToScan: UDINT;
	_scanIdx: UDINT;
	_queueFailureReason: E_LogRecordQueueFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[serializeScopeLogs := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF
IF pLogRecord = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_POINTER_NULL;
	RETURN;
END_IF
IF pLogRecord^.resource.id <> resourceId THEN
	failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
	RETURN;
END_IF

_scopeName := pLogRecord^.scope.name;
IF NOT THIS^.startNewScope(
	v:=v,
	pLogRecord:=pLogRecord,
	serializedRecords=>_serializedRecords,
	failureReason=>failureReason
) THEN
	RETURN;
END_IF

IF NOT THIS^.serializeLogRecord(_serializedRecords, pLogRecord, failureReason=>failureReason) THEN
	RETURN;
END_IF
pLogRecord := pLogRecord^.delete();

// Consume and release every remaining record in this resource/scope group.
_recordsToScan := logRecords.size;
FOR _scanIdx := 1 TO _recordsToScan DO
	logRecords.reset();
	_pHeadRecord := logRecords.next();
	IF _pHeadRecord = 0 THEN
		failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
		RETURN;
	END_IF

	IF _pHeadRecord^.resource.id = resourceId AND_THEN _pHeadRecord^.scope.name = _scopeName THEN
		IF NOT logRecords.pop(pValue:=pLogRecord, failureReason=>_queueFailureReason) THEN
			failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_POP_FAILURE;
			RETURN;
		END_IF
		IF pLogRecord = 0 THEN
			failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
			RETURN;
		END_IF
		IF NOT THIS^.serializeLogRecord(_serializedRecords, pLogRecord, failureReason=>failureReason) THEN
			RETURN;
		END_IF
		pLogRecord := pLogRecord^.delete();
	ELSIF NOT logRecords.rotate(failureReason=>_queueFailureReason) THEN
		failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_ROTATE_FAILURE;
		RETURN;
	END_IF
END_FOR

serializeScopeLogs := failureReason = E_ProtoJsonSerializerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="startNewResource" Id="{1425a3b1-ab95-4be2-bc02-659fcd4cfe17}">
      <Declaration><![CDATA[METHOD startNewResource : BOOL
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pLogRecord: POINTER TO FB_LogRecord;
END_VAR
VAR_OUTPUT
	scopeLogs: SJsonValue;
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_resourceObj: SJsonValue;
	_member: SJsonValue;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[startNewResource := FALSE;
scopeLogs := 0;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF
IF pLogRecord = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_POINTER_NULL;
	RETURN;
END_IF

_resourceObj := THIS^.parser.PushbackJsonValue(v, '{}');
IF _resourceObj = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF
IF NOT THIS^._injectResource(_resourceObj, pLogRecord^.resource, failureReason=>failureReason) THEN
	RETURN;
END_IF
IF pLogRecord^.resource.schemaUrl <> '' THEN
	_member := THIS^.parser.AddStringMember(_resourceObj, 'schemaUrl', pLogRecord^.resource.schemaUrl);
	IF _member = 0 THEN
		failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
		RETURN;
	END_IF
END_IF
scopeLogs := THIS^.parser.AddArrayMember(_resourceObj, 'scopeLogs', 0);
IF scopeLogs = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

startNewResource := failureReason = E_ProtoJsonSerializerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="startNewScope" Id="{f4aa450b-a2f6-4710-ba53-3569d7f87482}">
      <Declaration><![CDATA[METHOD startNewScope : BOOL
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pLogRecord: POINTER TO FB_LogRecord;
END_VAR
VAR_OUTPUT
	serializedRecords: SJsonValue;
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_scopeObj: SJsonValue;
	_member: SJsonValue;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[startNewScope := FALSE;
serializedRecords := 0;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF
IF pLogRecord = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_POINTER_NULL;
	RETURN;
END_IF

_scopeObj := THIS^.parser.PushbackJsonValue(v, '{}');
IF _scopeObj = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF
IF NOT THIS^._injectInstrumentationScope(_scopeObj, pLogRecord^.scope, failureReason=>failureReason) THEN
	RETURN;
END_IF
IF pLogRecord^.scope.schemaUrl <> '' THEN
	_member := THIS^.parser.AddStringMember(_scopeObj, 'schemaUrl', pLogRecord^.scope.schemaUrl);
	IF _member = 0 THEN
		failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
		RETURN;
	END_IF
END_IF
serializedRecords := THIS^.parser.AddArrayMember(_scopeObj, 'logRecords', 0);
IF serializedRecords = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

startNewScope := failureReason = E_ProtoJsonSerializerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>