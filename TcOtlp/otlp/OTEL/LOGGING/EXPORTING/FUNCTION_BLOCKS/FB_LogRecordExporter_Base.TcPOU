<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordExporter_Base" Id="{2faa5209-553a-42e9-adaa-2a62a835fb96}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT FB_LogRecordExporter_Base
VAR
	_processor: PVOID;
	_records: FB_LogRecordQueue(maxSize:=0);
	_exportActive: BOOL;
	_callFailureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="call" Id="{cd073f08-383d-42f3-b6af-4bac8b8f45ec}">
      <Declaration><![CDATA[METHOD ABSTRACT call : BOOL
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="export" Id="{50a11cb0-9078-40dd-a22b-8d36a858997d}">
      <Declaration><![CDATA[METHOD export: BOOL
VAR_IN_OUT
	logRecords: FB_LogRecordQueue;  // accepted records are transferred out of this queue
END_VAR
VAR_INPUT
	count: UDINT;
END_VAR
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
VAR
	_queueFailureReason: E_LogRecordQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[export := FALSE;
failureReason := E_LogRecordExporterFailureReason.NA;

IF THIS^.isBusy() THEN
	failureReason := E_LogRecordExporterFailureReason.ACTIVE_EXPORT_IN_PROGRESS;
	RETURN;
END_IF

// Release a completed batch retained by an exporter before accepting the next one.
THIS^.free();
IF NOT logRecords.transferTo(
	destination:=THIS^._records,
	count:=count,
	failureReason=>_queueFailureReason
) THEN
	failureReason := E_LogRecordExporterFailureReason.QUEUE_TRANSFER_FAILURE;
	RETURN;
END_IF

THIS^._exportActive := THIS^._records.size > 0;
export := failureReason = E_LogRecordExporterFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{2d6c8f1f-5edb-4076-9931-3f8dab72d509}">
      <Declaration><![CDATA[METHOD FB_Exit: BOOL
VAR_INPUT
	bInCopyCode: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{0ca757f0-af85-4710-bd06-773643a5b750}">
      <Declaration><![CDATA[METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._records.free();
THIS^._exportActive := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="isBusy" Id="{462b825f-0ddd-4786-aa19-28a6a53ac590}">
      <Declaration><![CDATA[METHOD ABSTRACT isBusy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="register" Id="{96c95875-3b2b-41b4-999e-4bc534240a88}">
      <Declaration><![CDATA[METHOD register: BOOL;
VAR_INPUT
	processor: I_LogRecordProcessor;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._processor = 0 THEN
	THIS^._processor := processor.pSelf;
ELSIF THIS^._processor <> processor.pSelf THEN
	ADSLOGSTR(
		msgCtrlMask:=ADSLOG_MSGTYPE_ERROR,
		'Unable to register multiple processors with a single exporter',
		''
	);
END_IF
register := THIS^._processor = processor.pSelf;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>