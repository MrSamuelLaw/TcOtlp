<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordExporter_Console" Id="{3a1288aa-03f4-4109-a651-f6572a4f5920}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordExporter_Console EXTENDS FB_LogRecordExporter_Base
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.call(failureReason=>THIS^._callFailureReason);]]></ST>
    </Implementation>
    <Method Name="call" Id="{885ef170-5e99-4d99-bb37-c1f43fc430b6}">
      <Declaration><![CDATA[METHOD call : BOOL
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[failureReason := E_LogRecordExporterFailureReason.NA;
call := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="export" Id="{3baff28e-31b9-4999-89e3-058a67dc30f8}">
      <Declaration><![CDATA[METHOD export : BOOL
VAR_IN_OUT
	logRecords: FB_LogRecordQueue;
END_VAR
VAR_INPUT
	count: UDINT;
END_VAR
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[export := SUPER^.export(
	logRecords:=logRecords,
	count:=count,
	failureReason=>failureReason
);
IF NOT export THEN
	RETURN;
END_IF

THIS^.writeToConsole(THIS^._records);
THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="isBusy" Id="{93cc5c4b-a55d-4298-b1d3-daf788b0f0cf}">
      <Declaration><![CDATA[METHOD isBusy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isBusy := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="writeToConsole" Id="{d8717306-f447-4f66-9591-db7269bca370}">
      <Declaration><![CDATA[METHOD writeToConsole
VAR_IN_OUT
	logRecords: FB_LogRecordQueue;
END_VAR
VAR
	idx: DINT;
	logRecord: POINTER TO FB_LogRecord;
	body: POINTER TO FB_String;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[logRecords.reset();
FOR idx := 0 TO GVL.MAX_LOOP_COUNT DO
	logRecord := logRecords.next();
	IF logRecord = 0 THEN
		RETURN;
	END_IF
	IF logRecord^.body <> 0 AND_THEN logRecord^.body^.eType = E_ValueType.E_String THEN
		body := logRecord^.body;
		ADSLOGSTR(
			ADSLOG_MSGTYPE_ERROR,
			body^.pString^,
			''
		);
	END_IF
END_FOR

	]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>