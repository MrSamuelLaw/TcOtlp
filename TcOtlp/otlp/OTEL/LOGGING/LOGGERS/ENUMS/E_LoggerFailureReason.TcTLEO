<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_LoggerFailureReason" Id="{2031a1a1-3f82-47d8-9bca-ad0f05f36de2}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_LoggerFailureReason :
(
	NA := 0,  // No failure occurred.
	LOG_RECORD_ALREADY_STARTED,  // A record is already being built by this logger.
	LOG_RECORD_NOT_STARTED,  // No active record is available to modify or emit.
	EVENT_NAME_INVALID,  // The event name could not be copied into an owned value.
	BODY_VALUE_POINTER_NULL,  // The supplied body value pointer is null.
	BODY_VALUE_INVALID,  // The supplied body value could not be cloned.
	BODY_VALUE_TYPE_UNSUPPORTED,  // The supplied body value type is not supported.
	ATTRIBUTE_VALUE_INVALID,  // An attribute could not be created from the supplied value.
	ATTRIBUTE_VALUE_TYPE_UNSUPPORTED,  // The supplied attribute value type is not supported.
	ATTRIBUTE_COUNT_LIMIT_REACHED,  // The record cannot own another attribute.
	SPAN_ID_BYTES_POINTER_NULL,  // The supplied Span ID byte pointer is null.
	SPAN_ID_BYTE_COUNT_TOO_SMALL,  // The supplied Span ID buffer is shorter than eight bytes.
	SPAN_ID_INVALID,  // The supplied Span ID could not be copied.
	TRACE_ID_BYTES_POINTER_NULL,  // The supplied Trace ID byte pointer is null.
	TRACE_ID_BYTE_COUNT_TOO_SMALL,  // The supplied Trace ID buffer is shorter than sixteen bytes.
	TRACE_ID_INVALID,  // The supplied Trace ID could not be copied.
	SNAPSHOT_COPY_FAILURE,  // The resource or instrumentation-scope snapshot could not be copied.
	MEMORY_ALLOCATION_FAILURE  // Dynamic memory allocation failed.
) UDINT;
END_TYPE
]]></Declaration>
