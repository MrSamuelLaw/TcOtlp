  <GVL Name="GVL" Id="{fafff3c3-4d09-467c-83c6-9e9cf3eee5b7}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	// Program/logic safety limits
	DEFAULT_MAX_ATTRIBUTE_COUNT: UDINT := 20;
	MAX_LOOP_COUNT:		UDINT := 20000;  // Maximum iterations a for/while loop can have
END_VAR
VAR_GLOBAL
	_ID: UDINT := 1;
END_VAR]]></Declaration>
    <Property Name="NEXT_ID" Id="{b0806f51-e306-4618-b098-4a5c2802d5bd}">
      <Declaration><![CDATA[PROPERTY NEXT_ID : UDINT]]></Declaration>
      <Get Name="Get" Id="{3a978cc3-ac9e-41d1-95b3-3c244a975a60}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[NEXT_ID := _ID;
_ID := _ID + 1;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </GVL>
