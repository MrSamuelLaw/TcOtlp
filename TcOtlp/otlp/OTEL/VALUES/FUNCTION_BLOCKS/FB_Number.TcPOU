<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Number" Id="{c2b87342-ce71-495e-9e2f-a1bcc01e53f8}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_Number EXTENDS FB_AnyValue IMPLEMENTS I_OtlpValue
VAR_OUTPUT
	value: AnyType;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="delete" Id="{0f86da8b-18fd-4455-86e3-d5294bea08dd}">
      <Declaration><![CDATA[(* method used to delete all data held by the value and then delete the object itself.*)
METHOD delete : ULINT
VAR
	pSelf: POINTER TO FB_Number;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[pSelf := THIS;
__DELETE(pSelf);
delete := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="eType" Id="{8d0828a8-6190-43e4-9113-60c82d13cd72}">
      <Declaration><![CDATA[PROPERTY eType : E_ValueType]]></Declaration>
      <Get Name="Get" Id="{7efb205d-b4ee-44e5-be79-b6b14edf9928}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[eType := E_ValueType.E_Number;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Exit" Id="{876cfe74-f8a2-4473-a882-d6f6de336c11}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{046fa2f2-939d-46be-8c55-b885fa90aaca}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	value: AnyType;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* ValueFactory owns validation and allocation. FB_Number takes ownership of
the copied value and its type metadata only after every allocation succeeds. *)
THIS^.value := value;]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{3c0b96f9-a763-46f1-9b63-c76452cf496d}">
      <Declaration><![CDATA[(* deallocates all data owned by the value without deleting the object itself.*)
METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.value.pValue <> 0 THEN
	__DELETE(THIS^.value.pValue);
END_IF
MEMSET(ADR(THIS^.value), 0, SIZEOF(THIS^.value));]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>