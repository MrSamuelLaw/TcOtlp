<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SpanId" Id="{f446c055-0ed8-47ee-a04d-05529fcbb3fe}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_SpanId IMPLEMENTS I_OtlpValue
VAR_OUTPUT
	bytes: ARRAY [0..7] OF BYTE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="delete" Id="{6dc6bc4a-08f6-48bc-be15-c1c8622bcaf6}">
      <Declaration><![CDATA[METHOD delete: ULINT
VAR
	pSelf: POINTER TO FB_SpanId;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[pSelf := THIS;
__DELETE(pSelf);
delete := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="eType" Id="{28726191-babe-48c6-a8b5-000c815e69f8}">
      <Declaration><![CDATA[PROPERTY eType : E_ValueType]]></Declaration>
      <Get Name="Get" Id="{3efaabfd-8908-4af9-a563-cfb75051c742}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[eType := E_ValueType.E_SpanId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Exit" Id="{c4786a73-45ac-49b4-a11f-95dbc83ef000}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{80f6e916-d2e5-404c-98e3-fd1b988f1665}">
      <Declaration><![CDATA[(* deallocates all data owned by the value without deleting the object itself.*)
METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MEMSET(ADR(THIS^.bytes), 0, SIZEOF(THIS^.bytes));]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>