<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_String" Id="{764965e6-7279-46be-bae4-95af6375d14f}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_String EXTENDS FB_AnyValue IMPLEMENTS I_OtlpValue
VAR_OUTPUT
	pString: POINTER TO STRING;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="delete" Id="{900990e5-5878-49e1-b13d-450ebe3395be}">
      <Declaration><![CDATA[METHOD delete: ULINT
VAR
	pSelf: POINTER TO FB_String;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[pSelf := THIS;
__DELETE(pSelf);
delete := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="eType" Id="{b26795dd-e9aa-4d5e-ba2b-c958c6e842fe}">
      <Declaration><![CDATA[PROPERTY eType : E_ValueType]]></Declaration>
      <Get Name="Get" Id="{df6843f3-5144-4a25-9b38-529817d43e9a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[eType := E_ValueType.E_String;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Exit" Id="{abf8bc91-3428-4cca-bb35-57b89c1baded}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{8aa9e74b-a751-4e6e-8a3b-2145f765d80c}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	pString: POINTER TO STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* 
Allocation and validation of the bytes is done at the
ValueFactory and not the value iteself, that way a new value 
never gets allocated if the initialization fails.
*)
THIS^.pString := pString;



]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{7f0ff0c6-35be-48e4-a03f-d76d975526b9}">
      <Declaration><![CDATA[METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.pString <> 0 THEN
	__DELETE(THIS^.pString);
	THIS^.pString := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>