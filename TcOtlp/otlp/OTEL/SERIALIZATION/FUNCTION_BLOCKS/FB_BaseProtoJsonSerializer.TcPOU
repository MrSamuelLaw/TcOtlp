      <Implementation>
        <ST><![CDATA[serializeTraceIdValue := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID; RETURN; END_IF
