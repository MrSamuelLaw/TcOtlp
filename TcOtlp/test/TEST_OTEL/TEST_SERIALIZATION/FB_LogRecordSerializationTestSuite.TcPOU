<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordSerializationTestSuite" Id="{ac0b5546-4665-42a2-912c-e215d5228926}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordSerializationTestSuite EXTENDS FB_TestSuite
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.TestCompleteLogRecordSerialization();]]></ST>
    </Implementation>
    <Method Name="TestCompleteLogRecordSerialization" Id="{b8c1d2e3-f4a5-6b7c-8d9e-0f1a2b3c4d5e}">
      <Declaration><![CDATA[METHOD TestCompleteLogRecordSerialization
VAR
	logsData : FB_OtlpLogsData;
	pResourceLogs : POINTER TO FB_OtlpResourceLogs;
	pResource : POINTER TO FB_OtlpResource;
	pScopeLogs : POINTER TO FB_OtlpScopeLogs;
	pScope : POINTER TO FB_OtlpInstrumentationScope;
	pLogRecord : POINTER TO FB_OtlpLogRecord;

	jsonDoc : FB_JsonDynDomParser;
	root : SJsonValue;
	memberValue : SJsonValue;
	resLogsArr : SJsonValue;
	resLogsElem : SJsonValue;
	resourceObj : SJsonValue;
	resAttrArr : SJsonValue;
	resAttrElem : SJsonValue;
	resAttrValObj : SJsonValue;
	scopeLogsArr : SJsonValue;
	scopeLogsElem : SJsonValue;
	scopeObj : SJsonValue;
	logRecordsArr : SJsonValue;
	logRecordElem : SJsonValue;
	bodyObj : SJsonValue;
	attrArr : SJsonValue;
	attrElem : SJsonValue;
	attrValObj : SJsonValue;
	pResAttr : POINTER TO FB_OtlpKeyValue;
	resAttrVal : FB_OtlpStringValue;
	iResAttrVal : I_OtlpAnyValue;
	bodyStr : FB_OtlpStringValue;
	iBody : I_OtlpAnyValue;
	pAttr : POINTER TO FB_OtlpKeyValue;
	attrVal : FB_OtlpStringValue;
	iAttrVal : I_OtlpAnyValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TcUnit.TEST_ORDERED('Test Complete LogRecord Serialization') THEN

// Build hierarchy: LogsData -> ResourceLogs -> ScopeLogs -> LogRecord
pResourceLogs := logsData.AddResourceLogs();

// Set up Resource with an attribute
pResource := __NEW(FB_OtlpResource);
pResAttr := pResource^.AddAttributes();
pResAttr^.sKey := 'service.name';
resAttrVal.sValue := 'test-service';
iResAttrVal := resAttrVal;
pResAttr^.pValue := ADR(iResAttrVal);
pResource^.nDroppedAttributesCount := UDINT#0;
pResourceLogs^.pResource := pResource;
pResourceLogs^.sSchemaUrl := 'https://opentelemetry.io/schemas/1.0.0';

// Set up ScopeLogs with InstrumentationScope
pScopeLogs := pResourceLogs^.AddScopeLogs();
pScope := __NEW(FB_OtlpInstrumentationScope);
pScope^.sName := 'test-scope';
pScope^.sVersion := '1.0.0';
pScopeLogs^.pScope := pScope;
pScopeLogs^.sSchemaUrl := 'https://opentelemetry.io/schemas/1.0.0';

// Set up LogRecord with all scalar fields
pLogRecord := pScopeLogs^.AddLogRecords();
pLogRecord^.nTimeUnixNano := ULINT#1000000000;
pLogRecord^.nObservedTimeUnixNano := ULINT#2000000000;
pLogRecord^.eSeverityNumber := E_OtlpSeverityNumber.SEVERITY_NUMBER_ERROR;
pLogRecord^.sSeverityText := 'ERROR';
pLogRecord^.sEventName := 'test.event';
pLogRecord^.nDroppedAttributesCount := UDINT#2;
pLogRecord^.nFlags := UDINT#256;

// Set body
bodyStr.sValue := 'test log body';
iBody := bodyStr;
pLogRecord^.pBody := ADR(iBody);

// Add an attribute to the log record
pAttr := pLogRecord^.AddAttributes();
pAttr^.sKey := 'log.attr';
attrVal.sValue := 'attr-value';
iAttrVal := attrVal;
pAttr^.pValue := ADR(iAttrVal);

// Serialize the full hierarchy
root := jsonDoc.NewDocument();
jsonDoc.SetObject(root);
logsData.SerializeToProtoJson(jsonDoc, root);

// Verify resourceLogs array exists
resLogsArr := jsonDoc.FindMember(root, 'resourceLogs');
THIS^.AssertTrue(jsonDoc.IsArray(resLogsArr), 'resourceLogs should be an array');

// Navigate into resourceLogs[0]
resLogsElem := jsonDoc.GetArrayValueByIdx(resLogsArr, 0);

// Verify resource object
resourceObj := jsonDoc.FindMember(resLogsElem, 'resource');
THIS^.AssertTrue(jsonDoc.IsObject(resourceObj), 'resource should be an object');

// Verify resource attribute
resAttrArr := jsonDoc.FindMember(resourceObj, 'attributes');
THIS^.AssertTrue(jsonDoc.IsArray(resAttrArr), 'resource attributes should be an array');
resAttrElem := jsonDoc.GetArrayValueByIdx(resAttrArr, 0);
memberValue := jsonDoc.FindMember(resAttrElem, 'key');
THIS^.AssertEquals_STRING('service.name', jsonDoc.GetString(memberValue), 'resource attr key');
resAttrValObj := jsonDoc.FindMember(resAttrElem, 'value');
memberValue := jsonDoc.FindMember(resAttrValObj, 'stringValue');
THIS^.AssertEquals_STRING('test-service', jsonDoc.GetString(memberValue), 'resource attr value');

// Verify schemaUrl on resourceLogs
memberValue := jsonDoc.FindMember(resLogsElem, 'schemaUrl');
THIS^.AssertEquals_STRING('https://opentelemetry.io/schemas/1.0.0', jsonDoc.GetString(memberValue), 'resourceLogs schemaUrl');

// Navigate into scopeLogs[0]
scopeLogsArr := jsonDoc.FindMember(resLogsElem, 'scopeLogs');
THIS^.AssertTrue(jsonDoc.IsArray(scopeLogsArr), 'scopeLogs should be an array');
scopeLogsElem := jsonDoc.GetArrayValueByIdx(scopeLogsArr, 0);

// Verify scope
scopeObj := jsonDoc.FindMember(scopeLogsElem, 'scope');
THIS^.AssertTrue(jsonDoc.IsObject(scopeObj), 'scope should be an object');
memberValue := jsonDoc.FindMember(scopeObj, 'name');
THIS^.AssertEquals_STRING('test-scope', jsonDoc.GetString(memberValue), 'scope name');
memberValue := jsonDoc.FindMember(scopeObj, 'version');
THIS^.AssertEquals_STRING('1.0.0', jsonDoc.GetString(memberValue), 'scope version');

// Navigate into logRecords[0]
logRecordsArr := jsonDoc.FindMember(scopeLogsElem, 'logRecords');
THIS^.AssertTrue(jsonDoc.IsArray(logRecordsArr), 'logRecords should be an array');
logRecordElem := jsonDoc.GetArrayValueByIdx(logRecordsArr, 0);

// Verify LogRecord scalar fields
memberValue := jsonDoc.FindMember(logRecordElem, 'timeUnixNano');
THIS^.AssertTrue(jsonDoc.GetUint64(memberValue) = ULINT#1000000000, 'timeUnixNano');

memberValue := jsonDoc.FindMember(logRecordElem, 'observedTimeUnixNano');
THIS^.AssertTrue(jsonDoc.GetUint64(memberValue) = ULINT#2000000000, 'observedTimeUnixNano');

memberValue := jsonDoc.FindMember(logRecordElem, 'severityNumber');
THIS^.AssertTrue(jsonDoc.GetInt(memberValue) = TO_DINT(E_OtlpSeverityNumber.SEVERITY_NUMBER_ERROR), 'severityNumber');

memberValue := jsonDoc.FindMember(logRecordElem, 'severityText');
THIS^.AssertEquals_STRING('ERROR', jsonDoc.GetString(memberValue), 'severityText');

memberValue := jsonDoc.FindMember(logRecordElem, 'eventName');
THIS^.AssertEquals_STRING('test.event', jsonDoc.GetString(memberValue), 'eventName');

memberValue := jsonDoc.FindMember(logRecordElem, 'droppedAttributesCount');
THIS^.AssertTrue(jsonDoc.GetUint(memberValue) = UDINT#2, 'droppedAttributesCount');

memberValue := jsonDoc.FindMember(logRecordElem, 'flags');
THIS^.AssertTrue(jsonDoc.GetUint(memberValue) = UDINT#256, 'flags');

// Verify body
bodyObj := jsonDoc.FindMember(logRecordElem, 'body');
THIS^.AssertTrue(jsonDoc.IsObject(bodyObj), 'body should be an object');
memberValue := jsonDoc.FindMember(bodyObj, 'stringValue');
THIS^.AssertEquals_STRING('test log body', jsonDoc.GetString(memberValue), 'body stringValue');

// Verify log record attribute
attrArr := jsonDoc.FindMember(logRecordElem, 'attributes');
THIS^.AssertTrue(jsonDoc.IsArray(attrArr), 'attributes should be an array');
attrElem := jsonDoc.GetArrayValueByIdx(attrArr, 0);
memberValue := jsonDoc.FindMember(attrElem, 'key');
THIS^.AssertEquals_STRING('log.attr', jsonDoc.GetString(memberValue), 'attr key');
attrValObj := jsonDoc.FindMember(attrElem, 'value');
memberValue := jsonDoc.FindMember(attrValObj, 'stringValue');
THIS^.AssertEquals_STRING('attr-value', jsonDoc.GetString(memberValue), 'attr stringValue');

// Null out pointer assignments to stack vars before finishing
pLogRecord^.pBody := 0;
pAttr^.pValue := 0;
pResAttr^.pValue := 0;

TcUnit.TEST_FINISHED();
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>