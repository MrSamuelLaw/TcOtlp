<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordSerializationTestSuite" Id="{ac0b5546-4665-42a2-912c-e215d5228926}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordSerializationTestSuite EXTENDS FB_TestSuite
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.TestJsonSerialization();]]></ST>
    </Implementation>
    <Method Name="TestJsonSerialization" Id="{3d144320-2b9d-4286-8011-5747b16f51c5}">
      <Declaration><![CDATA[METHOD TestJsonSerialization : REFERENCE TO FB_Test
VAR
	pJsonDoc: POINTER TO FB_JsonDynDomParser;
	logRecord: ST_OtlpLogRecord;
	root: SJsonValue;
	memberValue: SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('Test Can Build Json Doc');

logRecord.observedTimestamp := ULINT#5000000000;
logRecord.severityNumber := E_OtlpSeverity.WARN;
logRecord.body := 'Test Body';
logRecord.eventName := 'Test Event';

pJsonDoc := F_OtlpLogRecordToJson(logRecord);
THIS^.AssertTrue(pJsonDoc <> 0, 'Can build dynamic json document');

IF pJsonDoc <> 0 THEN
        root := pJsonDoc^.GetDocumentRoot();

        memberValue := pJsonDoc^.FindMember(root, 'observedTimestamp');
        THIS^.AssertTrue(
                pJsonDoc^.GetUint64(memberValue) = logRecord.observedTimestamp,
                'observedTimestamp should round-trip through parser'
        );

        memberValue := pJsonDoc^.FindMember(root, 'severityNumber');
        THIS^.AssertTrue(
                pJsonDoc^.GetInt(memberValue) = TO_DINT(logRecord.severityNumber),
                'severityNumber should round-trip through parser'
        );

        memberValue := pJsonDoc^.FindMember(root, 'body');
        THIS^.AssertTrue(
                pJsonDoc^.GetString(memberValue) = logRecord.body,
                'body should round-trip through parser'
        );

        memberValue := pJsonDoc^.FindMember(root, 'eventName');
        THIS^.AssertTrue(
                pJsonDoc^.GetString(memberValue) = logRecord.eventName,
                'eventName should round-trip through parser'
        );

        __DELETE(pJsonDoc);
END_IF

TcUnit.TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>