<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_HttpSpanExportIntegrationTest" Id="{e3f4a5b6-c7d8-9012-efab-234567890123}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HttpSpanExportIntegrationTest EXTENDS FB_TestSuite
VAR
	_exporter       : FB_HttpBatchSpanExporter;
	_tracesData     : FB_OtlpTracesData;
	_bBuilt         : BOOL;
	_bExportCalled  : BOOL;
	_nTimeout       : TON := (PT := T#10S);

	// Dynamic GUID generation
	_fbCreateGuid   : FB_CreateGUID;
	_arrGuids       : ARRAY[0..6] OF GUID;  // [0]=traceId, [1..6]=spanIds
	_bGuidsReady    : BOOL;
	_bGuidsStarted  : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.TestSendTracesToEndpoint();]]></ST>
    </Implementation>
    <Method Name="TestSendTracesToEndpoint" Id="{f4a5b6c7-d8e9-0123-fabc-345678901234}">
      <Declaration><![CDATA[METHOD TestSendTracesToEndpoint
VAR
	pResourceSpans : POINTER TO FB_OtlpResourceSpans;
	pResource      : POINTER TO FB_OtlpResource;
	pScopeSpans    : POINTER TO FB_OtlpScopeSpans;
	pScope         : POINTER TO FB_OtlpInstrumentationScope;
	pSpan          : POINTER TO FB_OtlpSpan;
	pEvent         : POINTER TO FB_OtlpEvent;
	pStatus        : POINTER TO FB_OtlpStatus;
	bResult        : BOOL;
	nNow           : ULINT;

	// Shared trace ID (all spans in one trace)
	arrTraceId     : ARRAY[0..15] OF BYTE;

	// Individual span IDs (8 bytes each, extracted from generated GUIDs)
	arrRootSpanId  : ARRAY[0..7] OF BYTE;
	arrReadId      : ARRAY[0..7] OF BYTE;
	arrPidId       : ARRAY[0..7] OF BYTE;
	arrWriteId     : ARRAY[0..7] OF BYTE;
	arrAlarmId     : ARRAY[0..7] OF BYTE;
	arrCommId      : ARRAY[0..7] OF BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TcUnit.TEST_ORDERED('Integration: Send multi-span trace to OTLP HTTP endpoint') THEN

// ── Step 1: Generate GUIDs asynchronously ───────────────────────
IF NOT _bGuidsReady THEN
	_fbCreateGuid(
		bExecute        := NOT _bGuidsStarted,
		sNetId          := '',
		tTimeout        := T#2S,
		pGuidBuffer     := ADR(_arrGuids),
		nGuidBufferSize := SIZEOF(_arrGuids)
	);
	_bGuidsStarted := TRUE;

	IF NOT _fbCreateGuid.bBusy AND _bGuidsStarted THEN
		IF _fbCreateGuid.bError THEN
			THIS^.AssertTrue(FALSE, 'FB_CreateGUID failed - cannot generate trace/span IDs');
			TcUnit.TEST_FINISHED();
			RETURN;
		END_IF
		_bGuidsReady := TRUE;
	END_IF
	RETURN;  // wait for GUIDs before building trace
END_IF

// ── Step 2: Build the OTLP trace payload once ──────────────────
IF NOT _bBuilt THEN
	_exporter.sHostName := 'otlp.breakingthelaw.xyz';
	_exporter.nHostPort := 4318;
	_exporter.sUri := '/v1/traces';
	_exporter.bNoServerCertCheck := TRUE;
	_exporter.sCaCertPath := 'C:\Users\samue\Desktop\programming projects\TcOtlp\certs\isrg-root-x1.pem';

	// ── Trace ID from GUID[0] (16 bytes = full GUID) ───────────────
	MEMCPY(ADR(arrTraceId), ADR(_arrGuids[0]), 16);

	// ── Span IDs from GUID[1..6] (first 8 bytes of each) ───────────
	MEMCPY(ADR(arrRootSpanId), ADR(_arrGuids[1]), 8);  // plc.scan-cycle
	MEMCPY(ADR(arrReadId),     ADR(_arrGuids[2]), 8);   // io.read-inputs
	MEMCPY(ADR(arrPidId),      ADR(_arrGuids[3]), 8);   // control.pid-loop
	MEMCPY(ADR(arrWriteId),    ADR(_arrGuids[4]), 8);   // io.write-outputs
	MEMCPY(ADR(arrAlarmId),    ADR(_arrGuids[5]), 8);   // diagnostics.alarm-check
	MEMCPY(ADR(arrCommId),     ADR(_arrGuids[6]), 8);   // comm.modbus-read

	// Current time in nanoseconds since epoch
	nNow := (F_GetSystemTime() - ULINT#116444736000000000) * ULINT#100;

	// ── Resource + Scope ────────────────────────────────────────────
	pResourceSpans := _tracesData.AddResourceSpans();

	pResource := __NEW(FB_OtlpResource);
	pResource^.AddStringAttribute(sKey := 'service.name',    sValue := 'beckhoff-cx5140');
	pResource^.AddStringAttribute(sKey := 'service.version', sValue := '1.2.0');
	pResource^.AddStringAttribute(sKey := 'host.name',       sValue := 'CX-5140-PLC01');
	pResource^.AddStringAttribute(sKey := 'host.arch',       sValue := 'x86');
	pResource^.AddStringAttribute(sKey := 'os.type',         sValue := 'TwinCAT');
	pResource^.AddStringAttribute(sKey := 'os.version',      sValue := '3.1.4026');
	pResourceSpans^.pResource := pResource;

	pScopeSpans := pResourceSpans^.AddScopeSpans();
	pScope := __NEW(FB_OtlpInstrumentationScope);
	pScope^.sName := 'tcotlp.plc';
	pScope^.sVersion := '0.1.0';
	pScopeSpans^.pScope := pScope;

	// ═══════════════════════════════════════════════════════════════
	// SPAN 1 — Root: plc.scan-cycle  (entire PLC cycle, 2ms)
	// ═══════════════════════════════════════════════════════════════
	pSpan := pScopeSpans^.AddSpans();
	pSpan^.arrTraceId := arrTraceId;
	pSpan^.arrSpanId  := arrRootSpanId;
	pSpan^.sName      := 'plc.scan-cycle';
	pSpan^.eKind      := E_OtlpSpanKind.SPAN_KIND_SERVER;
	pSpan^.nStartTimeUnixNano := nNow;
	pSpan^.nEndTimeUnixNano   := nNow + ULINT#2000000;  // 2 ms

	pStatus := __NEW(FB_OtlpStatus);
	pStatus^.eCode := E_OtlpStatusCode.STATUS_CODE_OK;
	pSpan^.pStatus := pStatus;

	pSpan^.AddStringAttribute(sKey := 'plc.task',       sValue := 'PlcTask');
	pSpan^.AddStringAttribute(sKey := 'plc.cycle_count', sValue := '148207');
	pSpan^.AddStringAttribute(sKey := 'plc.priority',    sValue := '20');

	// ═══════════════════════════════════════════════════════════════
	// SPAN 2 — Child: io.read-inputs  (0–200µs into cycle)
	// ═══════════════════════════════════════════════════════════════
	pSpan := pScopeSpans^.AddSpans();
	pSpan^.arrTraceId      := arrTraceId;
	pSpan^.arrSpanId       := arrReadId;
	pSpan^.arrParentSpanId := arrRootSpanId;
	pSpan^.sName           := 'io.read-inputs';
	pSpan^.eKind           := E_OtlpSpanKind.SPAN_KIND_CLIENT;
	pSpan^.nStartTimeUnixNano := nNow;
	pSpan^.nEndTimeUnixNano   := nNow + ULINT#200000;   // 200 µs

	pStatus := __NEW(FB_OtlpStatus);
	pStatus^.eCode := E_OtlpStatusCode.STATUS_CODE_OK;
	pSpan^.pStatus := pStatus;

	pSpan^.AddStringAttribute(sKey := 'io.module',      sValue := 'EL1008');
	pSpan^.AddStringAttribute(sKey := 'io.channel_count', sValue := '8');

	// Event: mapping complete
	pEvent := pSpan^.AddEvents();
	pEvent^.nTimeUnixNano := nNow + ULINT#180000;
	pEvent^.sName := 'process-image-updated';
	pEvent^.AddStringAttribute(sKey := 'io.bytes_read', sValue := '64');

	// ═══════════════════════════════════════════════════════════════
	// SPAN 3 — Child: control.pid-loop  (200µs–1.4ms)
	// ═══════════════════════════════════════════════════════════════
	pSpan := pScopeSpans^.AddSpans();
	pSpan^.arrTraceId      := arrTraceId;
	pSpan^.arrSpanId       := arrPidId;
	pSpan^.arrParentSpanId := arrRootSpanId;
	pSpan^.sName           := 'control.pid-loop';
	pSpan^.eKind           := E_OtlpSpanKind.SPAN_KIND_INTERNAL;
	pSpan^.nStartTimeUnixNano := nNow + ULINT#200000;
	pSpan^.nEndTimeUnixNano   := nNow + ULINT#1400000;  // 1.2 ms

	pStatus := __NEW(FB_OtlpStatus);
	pStatus^.eCode := E_OtlpStatusCode.STATUS_CODE_OK;
	pSpan^.pStatus := pStatus;

	pSpan^.AddStringAttribute(sKey := 'pid.setpoint',     sValue := '72.5');
	pSpan^.AddStringAttribute(sKey := 'pid.process_value', sValue := '71.8');
	pSpan^.AddStringAttribute(sKey := 'pid.output',        sValue := '34.2');
	pSpan^.AddStringAttribute(sKey := 'pid.error',         sValue := '0.7');
	pSpan^.AddStringAttribute(sKey := 'pid.loop_name',     sValue := 'TempControl_Zone1');

	// Event: setpoint reached within tolerance
	pEvent := pSpan^.AddEvents();
	pEvent^.nTimeUnixNano := nNow + ULINT#1300000;
	pEvent^.sName := 'pid.within-tolerance';
	pEvent^.AddStringAttribute(sKey := 'pid.tolerance', sValue := '1.0');

	// ═══════════════════════════════════════════════════════════════
	// SPAN 4 — Grandchild: comm.modbus-read  (child of pid-loop, 400µs–900µs)
	// ═══════════════════════════════════════════════════════════════
	pSpan := pScopeSpans^.AddSpans();
	pSpan^.arrTraceId      := arrTraceId;
	pSpan^.arrSpanId       := arrCommId;
	pSpan^.arrParentSpanId := arrPidId;   // child of pid-loop
	pSpan^.sName           := 'comm.modbus-read';
	pSpan^.eKind           := E_OtlpSpanKind.SPAN_KIND_CLIENT;
	pSpan^.nStartTimeUnixNano := nNow + ULINT#400000;
	pSpan^.nEndTimeUnixNano   := nNow + ULINT#900000;   // 500 µs

	pStatus := __NEW(FB_OtlpStatus);
	pStatus^.eCode := E_OtlpStatusCode.STATUS_CODE_OK;
	pSpan^.pStatus := pStatus;

	pSpan^.AddStringAttribute(sKey := 'modbus.slave_id',     sValue := '1');
	pSpan^.AddStringAttribute(sKey := 'modbus.function_code', sValue := '3');
	pSpan^.AddStringAttribute(sKey := 'modbus.start_register', sValue := '40001');
	pSpan^.AddStringAttribute(sKey := 'modbus.register_count', sValue := '10');
	pSpan^.AddStringAttribute(sKey := 'net.peer.name',         sValue := '192.168.1.50');
	pSpan^.AddStringAttribute(sKey := 'net.peer.port',         sValue := '502');

	// ═══════════════════════════════════════════════════════════════
	// SPAN 5 — Child: io.write-outputs  (1.4ms–1.6ms)
	// ═══════════════════════════════════════════════════════════════
	pSpan := pScopeSpans^.AddSpans();
	pSpan^.arrTraceId      := arrTraceId;
	pSpan^.arrSpanId       := arrWriteId;
	pSpan^.arrParentSpanId := arrRootSpanId;
	pSpan^.sName           := 'io.write-outputs';
	pSpan^.eKind           := E_OtlpSpanKind.SPAN_KIND_CLIENT;
	pSpan^.nStartTimeUnixNano := nNow + ULINT#1400000;
	pSpan^.nEndTimeUnixNano   := nNow + ULINT#1600000;  // 200 µs

	pStatus := __NEW(FB_OtlpStatus);
	pStatus^.eCode := E_OtlpStatusCode.STATUS_CODE_OK;
	pSpan^.pStatus := pStatus;

	pSpan^.AddStringAttribute(sKey := 'io.module',      sValue := 'EL2008');
	pSpan^.AddStringAttribute(sKey := 'io.channel_count', sValue := '8');

	// ═══════════════════════════════════════════════════════════════
	// SPAN 6 — Child: diagnostics.alarm-check  (1.6ms–1.9ms, ERROR)
	// ═══════════════════════════════════════════════════════════════
	pSpan := pScopeSpans^.AddSpans();
	pSpan^.arrTraceId      := arrTraceId;
	pSpan^.arrSpanId       := arrAlarmId;
	pSpan^.arrParentSpanId := arrRootSpanId;
	pSpan^.sName           := 'diagnostics.alarm-check';
	pSpan^.eKind           := E_OtlpSpanKind.SPAN_KIND_INTERNAL;
	pSpan^.nStartTimeUnixNano := nNow + ULINT#1600000;
	pSpan^.nEndTimeUnixNano   := nNow + ULINT#1900000;  // 300 µs

	pStatus := __NEW(FB_OtlpStatus);
	pStatus^.eCode    := E_OtlpStatusCode.STATUS_CODE_ERROR;
	pStatus^.sMessage := 'Temperature sensor Zone3 above high-high limit';
	pSpan^.pStatus := pStatus;

	pSpan^.AddStringAttribute(sKey := 'alarm.severity',  sValue := 'CRITICAL');
	pSpan^.AddStringAttribute(sKey := 'alarm.source',    sValue := 'TC_Zone3_HH');
	pSpan^.AddStringAttribute(sKey := 'alarm.value',     sValue := '98.4');
	pSpan^.AddStringAttribute(sKey := 'alarm.limit',     sValue := '95.0');

	// Event: alarm triggered
	pEvent := pSpan^.AddEvents();
	pEvent^.nTimeUnixNano := nNow + ULINT#1750000;
	pEvent^.sName := 'alarm.triggered';
	pEvent^.AddStringAttribute(sKey := 'alarm.id',       sValue := 'ALM-0042');
	pEvent^.AddStringAttribute(sKey := 'alarm.message',  sValue := 'Zone3 temperature 98.4C exceeds HH limit 95.0C');
	pEvent^.AddStringAttribute(sKey := 'alarm.action',   sValue := 'Emergency shutdown initiated');

	_bBuilt := TRUE;
END_IF

// Trigger the export once
IF _bBuilt AND NOT _bExportCalled THEN
	bResult := _exporter.Export(_tracesData);
	THIS^.AssertTrue(bResult, 'Export should accept the request');
	_bExportCalled := TRUE;
	_nTimeout(IN := TRUE);
END_IF

// Cycle the exporter state machine until done or error
IF _bExportCalled THEN
	_exporter();
	_nTimeout();

	IF _exporter.bDone THEN
		THIS^.AssertTrue(_exporter.nHttpStatus >= 200 AND _exporter.nHttpStatus < 300,
			CONCAT('Expected 2xx, got ', UINT_TO_STRING(_exporter.nHttpStatus)));
		THIS^.AssertEquals_STRING('{"partialSuccess":{}}', _exporter.sResponseBody,
			CONCAT('Response body (len=', CONCAT(UINT_TO_STRING(DINT_TO_UINT(LEN(_exporter.sResponseBody))), ')')));
		TcUnit.TEST_FINISHED();
	ELSIF _exporter.bError THEN
		THIS^.AssertTrue(FALSE,
			CONCAT(CONCAT('Export failed (HTTP ', CONCAT(UINT_TO_STRING(_exporter.nHttpStatus), '): ')), _exporter.sLastError));
		TcUnit.TEST_FINISHED();
	ELSIF _nTimeout.Q THEN
		THIS^.AssertTrue(FALSE, 'Export timed out after 10s');
		TcUnit.TEST_FINISHED();
	END_IF
END_IF

END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
