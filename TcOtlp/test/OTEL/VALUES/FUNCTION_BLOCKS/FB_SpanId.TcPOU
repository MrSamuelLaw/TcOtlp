<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SpanId" Id="{5bf3062c-d603-43ca-8490-cc9822c82385}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_SpanId IMPLEMENTS I_OtlpValue
VAR_OUTPUT
	bytes: ARRAY [0..7] OF BYTE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="delete" Id="{e7cda35d-3a46-47f9-bedc-fb9f4eebf05c}">
      <Declaration><![CDATA[(*
	Releases this value and clears the caller's pointer to it: call it as p^.delete(pSelf:=p).
	pSelf is cleared before the value is freed, so the caller never keeps a dangling pointer.
	A pointer to any other object is refused and left untouched, and nothing is released.
*)
METHOD delete : BOOL
VAR_IN_OUT
	pSelf: POINTER TO FB_SpanId;
END_VAR
VAR
	_pThis: POINTER TO FB_SpanId;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_pThis := THIS;
IF pSelf <> _pThis THEN
	RETURN;
END_IF

pSelf := 0;
__DELETE(_pThis);
delete := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="eType" Id="{386b755d-4227-473a-8d9f-1dcee7cc6d49}">
      <Declaration><![CDATA[PROPERTY eType : E_ValueType]]></Declaration>
      <Get Name="Get" Id="{43f7c6c3-7397-4194-ac11-7e0b8b201aec}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[eType := E_ValueType.E_SpanId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Exit" Id="{b7cf1790-e849-49d8-a0f6-942cd887bf9e}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{9d4a26f9-0175-4cf4-a756-1effe28ccc8b}">
      <Declaration><![CDATA[(* deallocates all data owned by the value without deleting the object itself.*)
METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MEMSET(ADR(THIS^.bytes), 0, SIZEOF(THIS^.bytes));]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
