<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Number" Id="{c5fb9a17-5d56-41cb-88c0-bdfb63683555}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_Number EXTENDS FB_AnyValue IMPLEMENTS I_OtlpValue
VAR_OUTPUT
	value: AnyType;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="delete" Id="{81626baf-73e9-474d-8fdb-3db32f627943}">
      <Declaration><![CDATA[(* method used to delete all data held by the value and then delete the object itself.*)
METHOD delete : ULINT
VAR
	pSelf: POINTER TO FB_Number;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[pSelf := THIS;
__DELETE(pSelf);
delete := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="eType" Id="{5bc99ae1-764d-46dc-ad39-c02b186a1dfd}">
      <Declaration><![CDATA[PROPERTY eType : E_ValueType]]></Declaration>
      <Get Name="Get" Id="{7e33065d-f409-44ce-a7b2-721cf13cf094}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[eType := E_ValueType.E_Number;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Exit" Id="{7b92b00a-edbb-42b3-adc5-8a7e65018ece}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{d6aad393-9bab-4c5d-928a-ab98d173ed73}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	value: AnyType;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* ValueFactory owns validation and allocation. FB_Number takes ownership of
the copied value and its type metadata only after every allocation succeeds. *)
THIS^.value := value;]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{befe6018-20a6-42af-8f70-d8bf62cbbf12}">
      <Declaration><![CDATA[(* deallocates all data owned by the value without deleting the object itself.*)
METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.value.pValue <> 0 THEN
	__DELETE(THIS^.value.pValue);
END_IF
MEMSET(ADR(THIS^.value), 0, SIZEOF(THIS^.value));]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
