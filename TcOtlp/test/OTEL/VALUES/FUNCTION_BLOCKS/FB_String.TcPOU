<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_String" Id="{29fbd388-5d87-497c-bbf9-7bd05aaf4955}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_String EXTENDS FB_AnyValue IMPLEMENTS I_OtlpValue
VAR_OUTPUT
	pString: POINTER TO STRING;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="delete" Id="{7f99e5b0-366a-49b5-ba45-4cdbaf429152}">
      <Declaration><![CDATA[(*
	Releases this value and clears the caller's pointer to it: call it as p^.delete(pSelf:=p).
	pSelf is cleared before the value is freed, so the caller never keeps a dangling pointer.
	A pointer to any other object is refused and left untouched, and nothing is released.
*)
METHOD delete : BOOL
VAR_IN_OUT
	pSelf: POINTER TO FB_AnyValue;
END_VAR
VAR
	_pThis: POINTER TO FB_String;
	_pSelfAsParam: POINTER TO FB_AnyValue;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_pThis := THIS;
_pSelfAsParam := _pThis;
IF pSelf <> _pSelfAsParam THEN
	RETURN;
END_IF

pSelf := 0;
__DELETE(_pThis);
delete := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="eType" Id="{35797e98-a42e-407f-8287-a86a64bbf017}">
      <Declaration><![CDATA[PROPERTY eType : E_ValueType]]></Declaration>
      <Get Name="Get" Id="{771e5d83-1cc2-43e7-8c8a-6a444c95ac77}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[eType := E_ValueType.E_String;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Exit" Id="{435310b9-42ec-4f3e-8242-4e4b7d6f84f4}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{c6da3bd3-1b80-4b65-a1c2-1f8fa4ee9dc6}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	pString: POINTER TO STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* 
Allocation and validation of the bytes is done at the
ValueFactory and not the value iteself, that way a new value 
never gets allocated if the initialization fails.
*)
THIS^.pString := pString;



]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{8b49426d-23c6-4374-be84-d96941a32f61}">
      <Declaration><![CDATA[METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.pString <> 0 THEN
	__DELETE(THIS^.pString);
	THIS^.pString := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
