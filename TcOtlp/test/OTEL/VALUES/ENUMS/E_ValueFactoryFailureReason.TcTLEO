  <EnumerationTextList Name="E_ValueFactoryFailureReason" Id="{deb68734-7fbd-4fc9-8316-6333e87f3d63}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_ValueFactoryFailureReason :
(
	
	DESTINATION_ALREADY_ASSIGNED := 1,  // The destination pointer was already assigned when the operation began.
	SOURCE_POINTER_NULL,  // The source pointer is null.
	NUMBER_VALUE_POINTER_NULL,  // The numeric value pointer is null.
	NUMBER_VALUE_SIZE_INVALID,  // The numeric value size is zero or negative.
	KEY_POINTER_NULL,  // The key pointer is null.
	VALUE_POINTER_NULL,  // The value pointer is null.
	STRING_POINTER_NULL,  // The string pointer is null.
	SPAN_ID_BYTES_POINTER_NULL,  // The Span ID byte-array pointer is null.
	SPAN_ID_BYTE_COUNT_TOO_SMALL,  // The supplied byte count is too small for a Span ID.
	TRACE_ID_BYTES_POINTER_NULL,  // The Trace ID byte-array pointer is null.
	TRACE_ID_BYTE_COUNT_TOO_SMALL,  // The supplied byte count is too small for a Trace ID.
	UNSUPPORTED_VALUE_TYPE,  // The source value type is not supported by the factory operation.
	MEMORY_ALLOCATION_FAILURE  // Dynamic memory allocation failed.
);
END_TYPE
]]></Declaration>
