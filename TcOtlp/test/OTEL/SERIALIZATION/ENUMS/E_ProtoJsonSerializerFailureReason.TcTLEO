<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_ProtoJsonSerializerFailureReason" Id="{57fbe71c-43df-42a6-9831-f7f8ea3226c4}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_ProtoJsonSerializerFailureReason :
(
	NA := 0,  // No failure occurred.
	JSON_VALUE_INVALID,  // The destination JSON value is invalid.
	JSON_OPERATION_FAILURE,  // The JSON DOM parser could not create or append a value.
	KEY_POINTER_NULL,  // The supplied member-key pointer is null.
	VALUE_POINTER_NULL,  // The supplied OTLP value pointer is null.
	LOG_RECORD_POINTER_NULL,  // The supplied log-record pointer is null.
	NUMBER_VALUE_POINTER_NULL,  // The numeric value does not point to its concrete value.
	UNSUPPORTED_VALUE_TYPE,  // The OTLP value type is not supported.
	UNSUPPORTED_NUMBER_TYPE,  // The IEC numeric type is not supported.
	BYTES_POINTER_NULL,  // The byte-array pointer is null.
	BYTE_COUNT_ZERO,  // No bytes were supplied for encoding.
	STRING_POINTER_NULL,  // The destination or source string pointer is null.
	STRING_BUFFER_TOO_SMALL,  // The encoded value does not fit in the destination string.
	UNSUPPORTED_BYTES_ENCODING,  // The requested byte encoding is not supported.
	ATTRIBUTE_COLLECTION_INCONSISTENT,  // The attribute count and linked values disagree.
	LOG_RECORD_COLLECTION_INCONSISTENT,  // The queue count and linked records disagree.
	QUEUE_TRANSFER_FAILURE,  // Ownership could not be transferred to the serializer queue.
	QUEUE_POP_FAILURE,  // An owned record could not be removed from the serializer queue.
	QUEUE_ROTATE_FAILURE,  // The serializer queue could not preserve grouping order.
	LOOP_LIMIT_EXCEEDED  // Serialization could not complete within GVL.MAX_LOOP_COUNT.
) UDINT;
END_TYPE
]]></Declaration>
