<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_BaseProtoJsonSerializer" Id="{932f076d-7af8-433b-a20e-1bed32694275}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BaseProtoJsonSerializer

VAR_OUTPUT
	parser: FB_JsonDynDomParser;
	jsonValue: SJsonValue;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_injectInstrumentationScope" Id="{9c8cb455-2273-4f58-affd-d3fcbf54d800}">
      <Declaration><![CDATA[METHOD _injectInstrumentationScope
VAR_IN_OUT
	v: SJsonValue;
	instrumentationScope: FB_InstrumentationScope;
END_VAR
VAR
	_obj: SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_obj := THIS^.parser.AddObjectMember(v, 'scope');
THIS^.parser.AddStringMember(_obj, 'name', instrumentationScope.name);
THIS^.parser.AddStringMember(_obj, 'version', instrumentationScope.version);
IF instrumentationScope.attributes.count > 0 THEN
	THIS^.serializeKeyValues(_obj, ADR('attributes'), ADR(instrumentationScope.attributes));
END_IF
IF instrumentationScope.attributes.count > 0 OR instrumentationScope.droppedAttributesCount > 0 THEN
	THIS^.serializeUint32Value(_obj, ADR('droppedAttributesCount'), instrumentationScope.droppedAttributesCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_injectResource" Id="{56a836bc-6996-46a9-b0a3-bbca046e4c06}">
      <Declaration><![CDATA[METHOD _injectResource
VAR_IN_OUT
	v: SJsonValue;
	resource: FB_Resource;
END_VAR
VAR
	_obj: SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_obj := THIS^.parser.AddObjectMember(v, 'resource');
IF resource.attributes.count > 0 THEN
	THIS^.serializeKeyValues(_obj, ADR('attributes'), ADR(resource.attributes));
END_IF
IF resource.droppedAttributesCount > 0 THEN
	THIS^.serializeUint32Value(_obj, ADR('droppedAttributesCount'), resource.droppedAttributesCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_serializeBytes" Id="{07016bcd-d229-46fb-8e82-336747340800}">
      <Declaration><![CDATA[METHOD _serializeBytes : BOOL
VAR_INPUT
	pBytes: 	POINTER TO BYTE;	// pointer to bytes to encode
	nBytes: 	UDINT := 0;			// number of bytes to encode
	pStr: 		POINTER TO STRING;  // location to put the encoded bytes
	len:		UDINT;				// len of location to put the encoded bytes
	encoding: 	E_BytesEncoding;	// encoding format
END_VAR

VAR
	_idx: UDINT;
	_nibble: BYTE;
	_requiredLen: UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_serializeBytes := FALSE;

IF pStr <> 0 AND len > 0 AND pBytes <> 0 AND nBytes > 0 THEN
	_requiredLen := nBytes * 2;
	IF len <= _requiredLen THEN
		RETURN;
	END_IF
	
	pStr^ := '';
	// encode bytes to a STRING
	CASE encoding OF
		E_BytesEncoding.hex:
			// Loop from 0 to len - 1 (Standard 0-based array boundary)
            FOR _idx := 0 TO (nBytes - 1) DO 
                // 1. Extract High Nibble (Upper 4 bits)
                _nibble := SHR(pBytes[_idx], 4) AND 16#0F;
                pStr^[(_idx * 2)] := SEL(_nibble < 10, _nibble + 16#37, _nibble + 16#30);  // ASCII '0' to '9' | ASCII 'A' to 'F'
                // 2. Extract Low Nibble (Lower 4 bits)
                _nibble := pBytes[_idx] AND 16#0F;
				pStr^[(_idx * 2) + 1] := SEL(_nibble < 10, _nibble + 16#37, _nibble + 16#30);
            END_FOR
            
            // 3. Force a Null-Terminator at the end of the string
			pStr^[_requiredLen] := 0;
			_serializeBytes := TRUE;
	END_CASE
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeAnyValue" Id="{ce526a8b-754d-4e21-9b26-8200d43a6f87}">
      <Declaration><![CDATA[METHOD serializeAnyValue : BOOL
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pKey: POINTER TO STRING;
	pVal: POINTER TO FB_AnyValue;
END_VAR
VAR
	_v: SJsonValue;
	_type: E_ValueType;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pVal <> 0 THEN
	_type := pVal^.eType;
	CASE _type OF
		E_ValueType.E_String:
		// add a field with key = pKey
		_v := THIS^.parser.AddObjectMember(v, pKey^);
		// but the value needs to be 'dType: val' for example "body": {"stringValue": "my string value"}
		THIS^.serializeStringValue(_v, ADR('stringValue'), pVal);
	ELSE
		//pass
	END_CASE
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeDoubleValue" Id="{8e1716f5-ca18-4545-9ac3-fe0242797154}">
      <Declaration><![CDATA[METHOD serializeDoubleValue
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pKey: POINTER TO STRING;  // allows for any length of key
	val: LREAL;
END_VAR
VAR
	_bits: LWORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pKey <> 0 THEN
	// ProtoJSON represents non-finite floating-point values as strings.
	MEMCPY(ADR(_bits), ADR(val), SIZEOF(_bits));
	IF (_bits AND LWORD#16#7FF0000000000000) = LWORD#16#7FF0000000000000 THEN
		IF (_bits AND LWORD#16#000FFFFFFFFFFFFF) <> 0 THEN
			THIS^.parser.AddStringMember(v, pKey^, 'NaN');
		ELSIF (_bits AND LWORD#16#8000000000000000) <> 0 THEN
			THIS^.parser.AddStringMember(v, pKey^, '-Infinity');
		ELSE
			THIS^.parser.AddStringMember(v, pKey^, 'Infinity');
		END_IF
	ELSE
		THIS^.parser.AddDoubleMember(v, pKey^, val);
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeFloatValue" Id="{61151231-f7cd-44d1-8261-d6a5a8b398f7}">
      <Declaration><![CDATA[METHOD serializeFloatValue
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pKey: POINTER TO STRING;  // allows for any length of key
	val: REAL;
END_VAR
VAR
	_bits: DWORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pKey <> 0 THEN
	// ProtoJSON represents non-finite floating-point values as strings.
	MEMCPY(ADR(_bits), ADR(val), SIZEOF(_bits));
	IF (_bits AND DWORD#16#7F800000) = DWORD#16#7F800000 THEN
		IF (_bits AND DWORD#16#007FFFFF) <> 0 THEN
			THIS^.parser.AddStringMember(v, pKey^, 'NaN');
		ELSIF (_bits AND DWORD#16#80000000) <> 0 THEN
			THIS^.parser.AddStringMember(v, pKey^, '-Infinity');
		ELSE
			THIS^.parser.AddStringMember(v, pKey^, 'Infinity');
		END_IF
	ELSE
		THIS^.parser.AddDoubleMember(v, pKey^, REAL_TO_LREAL(val));
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeInt32Value" Id="{e79efe08-4ca7-4425-9145-6831c737d25f}">
      <Declaration><![CDATA[METHOD serializeInt32Value
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pKey: POINTER TO STRING;  // allows for any length of key
	val: DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pKey <> 0 THEN
	// int32, sint32, and sfixed32 are JSON numbers in ProtoJSON.
	THIS^.parser.AddIntMember(v, pKey^, val);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeInt64Value" Id="{b0f53b48-39e6-4d60-9c1c-71cbf01d4ae4}">
      <Declaration><![CDATA[METHOD serializeInt64Value
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pKey: POINTER TO STRING;  // allows for any length of key
	val: LINT;
END_VAR
VAR
	_buf: STRING(20);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pKey <> 0 THEN
	// int64, sint64, and sfixed64 are decimal strings in ProtoJSON.
	_buf := LINT_TO_STRING(val);
	THIS^.parser.AddStringMember(v, pKey^, _buf);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeKeyValue" Id="{486a70c5-9e67-46b6-89f1-7a33a1497da2}">
      <Declaration><![CDATA[METHOD serializeKeyValue
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pVal: POINTER TO FB_KeyValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pVal <> 0 AND_THEN pVal^.pKey <> 0 THEN
	THIS^.parser.AddStringMember(v, 'key', pVal^.pKey^);
	THIS^.serializeAnyValue(v, ADR('value'), pVal^.pVal);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeKeyValues" Id="{52d74288-6a2d-4c88-827a-3eefad2702d7}">
      <Declaration><![CDATA[METHOD serializeKeyValues
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pKey: POINTER TO STRING;
	pValues: POINTER TO FB_LinkedList_KeyValue;
END_VAR
VAR
	_idx: UDINT;
	_arr: SJsonValue;
	_obj: SJsonValue;
	_pValue: POINTER TO FB_KeyValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pKey <> 0 AND pValues <> 0 THEN
	pValues^.reset();
	_pValue := pValues^.next();
	IF _pValue = 0 THEN RETURN; END_IF

	_arr := THIS^.parser.AddArrayMember(v, pKey^, 0);
	FOR _idx := 1 TO GVL.MAX_ATTRIBUTES DO
		IF _pValue = 0 THEN EXIT; END_IF
		_obj := THIS^.parser.PushbackJsonValue(_arr, '{}');
		THIS^.serializeKeyValue(_obj, _pValue);
		_pValue := pValues^.next();
	END_FOR
	pValues^.reset();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeNumberValue" Id="{aeb900f5-c3ec-444b-ae50-1d2bab03506c}">
      <Declaration><![CDATA[METHOD serializeNumberValue : BOOL
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pKey: POINTER TO STRING;
	val: ANY_NUM;
END_VAR
VAR
	_pSInt: POINTER TO SINT;
	_pInt: POINTER TO INT;
	_pDInt: POINTER TO DINT;
	_pLInt: POINTER TO LINT;
	_pUSInt: POINTER TO USINT;
	_pUInt: POINTER TO UINT;
	_pUDInt: POINTER TO UDINT;
	_pULInt: POINTER TO ULINT;
	_pReal: POINTER TO REAL;
	_pLReal: POINTER TO LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[serializeNumberValue := FALSE;
IF pKey = 0 OR val.pValue = 0 THEN
	RETURN;
END_IF

CASE val.TypeClass OF
	__SYSTEM.TYPE_CLASS.TYPE_SINT:
		_pSInt := val.pValue;
		THIS^.serializeInt32Value(v, pKey, SINT_TO_DINT(_pSInt^));
	__SYSTEM.TYPE_CLASS.TYPE_INT:
		_pInt := val.pValue;
		THIS^.serializeInt32Value(v, pKey, INT_TO_DINT(_pInt^));
	__SYSTEM.TYPE_CLASS.TYPE_DINT:
		_pDInt := val.pValue;
		THIS^.serializeInt32Value(v, pKey, _pDInt^);
	__SYSTEM.TYPE_CLASS.TYPE_LINT:
		_pLInt := val.pValue;
		THIS^.serializeInt64Value(v, pKey, _pLInt^);
	__SYSTEM.TYPE_CLASS.TYPE_USINT:
		_pUSInt := val.pValue;
		THIS^.serializeUint32Value(v, pKey, USINT_TO_UDINT(_pUSInt^));
	__SYSTEM.TYPE_CLASS.TYPE_UINT:
		_pUInt := val.pValue;
		THIS^.serializeUint32Value(v, pKey, UINT_TO_UDINT(_pUInt^));
	__SYSTEM.TYPE_CLASS.TYPE_UDINT:
		_pUDInt := val.pValue;
		THIS^.serializeUint32Value(v, pKey, _pUDInt^);
	__SYSTEM.TYPE_CLASS.TYPE_ULINT:
		_pULInt := val.pValue;
		THIS^.serializeUint64Value(v, pKey, _pULInt^);
	__SYSTEM.TYPE_CLASS.TYPE_REAL:
		_pReal := val.pValue;
		THIS^.serializeFloatValue(v, pKey, _pReal^);
	__SYSTEM.TYPE_CLASS.TYPE_LREAL:
		_pLReal := val.pValue;
		THIS^.serializeDoubleValue(v, pKey, _pLReal^);
	ELSE
		RETURN;
END_CASE

serializeNumberValue := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeSpanIdValue" Id="{9afc261b-39d5-4d44-b105-baf2b6a972f5}">
      <Declaration><![CDATA[METHOD serializeSpanIdValue
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pVal: POINTER TO FB_SpanId;
END_VAR
VAR
	_encodedStr: STRING(16);  // 2 * 8 bytes
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pVal <> 0 THEN
	THIS^._serializeBytes(
		ADR(pVal^.bytes), 
		SIZEOF(pVal^.bytes), 
		ADR(_encodedStr), 
		SIZEOF(_encodedStr), 
		E_BytesEncoding.hex
	);
	THIS^.parser.AddStringMember(v, 'spanId' ,_encodedStr);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeStringValue" Id="{a5d8f280-538f-436e-b57c-fc6ce9363756}">
      <Declaration><![CDATA[METHOD serializeStringValue
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pKey: POINTER TO STRING;  // allows for any length of key
	pVal: POINTER TO FB_String;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pKey <> 0 AND_THEN pVal <> 0 AND_THEN  pVal^.pString <> 0 THEN
	THIS^.parser.AddStringMember(v, pKey^, pVal^.pString^);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeTraceIdValue" Id="{4de4eecb-e305-4f14-9eca-bec6bc920cae}">
      <Declaration><![CDATA[METHOD serializeTraceIdValue
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pVal: POINTER TO FB_TraceId;
END_VAR
VAR
	_encodedStr: STRING(32);  // 2 * 16 bytes
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pVal <> 0 THEN
	THIS^._serializeBytes(
		ADR(pVal^.bytes), 
		SIZEOF(pVal^.bytes), 
		ADR(_encodedStr), 
		SIZEOF(_encodedStr),
		E_BytesEncoding.hex	
	);
	THIS^.parser.AddStringMember(v, 'traceId' ,_encodedStr);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeUint32Value" Id="{1dd3acf5-55a1-4a1e-b2ab-a0a8924ebe6b}">
      <Declaration><![CDATA[METHOD serializeUint32Value
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pKey: POINTER TO STRING;  // allows for any length of key
	val: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pKey <> 0 THEN
	// uint32 and fixed32 are JSON numbers in ProtoJSON.
	THIS^.parser.AddUintMember(v, pKey^, val);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeUint64Value" Id="{03b3c74c-f10f-4570-99ed-23668fd8ddf1}">
      <Declaration><![CDATA[METHOD serializeUint64Value
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pKey: POINTER TO STRING;  // allows for any length of key
	val: ULINT;
END_VAR
VAR
	_buf: STRING(20);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pKey <> 0 THEN
	// uint64 and fixed64 are decimal strings in ProtoJSON.
	_buf := ULINT_TO_STRING(val);
	THIS^.parser.AddStringMember(v, pKey^, _buf);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>