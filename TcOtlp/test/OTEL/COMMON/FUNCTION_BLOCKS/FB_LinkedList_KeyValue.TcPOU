<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LinkedList_KeyValue" Id="{cf073bde-f48d-4029-b947-e958e98bbb16}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_LinkedList_KeyValue
VAR
	_head: POINTER TO ST_LinkedListNode;
	_tail: POINTER TO ST_LinkedListNode;
	_cursor: POINTER TO ST_LinkedListNode;
END_VAR
VAR_OUTPUT
	count: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="addNumberAttribute" Id="{5ce7a6f9-75cf-4bf9-8ec2-655b0a7ea8b4}">
      <Declaration><![CDATA[METHOD addNumberAttribute: E_PointerFactoryStatus;
VAR_INPUT
	key: T_MaxString;
	value: ANY_NUM;
END_VAR
VAR
	_pKv: POINTER TO FB_KeyValue;
	_pNum: POINTER TO FB_Number;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[addNumberAttribute := ValueFactory.createNumber_AnyType(_pNum, value);
IF addNumberAttribute <> E_PointerFactoryStatus.SUCCESS THEN
	RETURN;
END_IF

addNumberAttribute := ValueFactory.createKeyValue(_pKv, ADR(key), _pNum);
IF addNumberAttribute <> E_PointerFactoryStatus.SUCCESS THEN
	_pNum^.delete();
	RETURN;
END_IF
_pNum^.delete();  // clean up the _pNum as its cloned in createKeyValue

addNumberAttribute := THIS^.append(pValue:=_pKv);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="addNumberAttribute_AnyType" Id="{a633e97e-967c-40bb-9f1d-14d8e2ed4da3}">
      <Declaration><![CDATA[METHOD addNumberAttribute_AnyType: E_PointerFactoryStatus;
VAR_INPUT
	key: T_MaxString;
	value: AnyType;
END_VAR
VAR
	_pKv: POINTER TO FB_KeyValue;
	_pNum: POINTER TO FB_Number;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[addNumberAttribute_AnyType := ValueFactory.createNumber_AnyType(_pNum, value);
IF addNumberAttribute_AnyType <> E_PointerFactoryStatus.SUCCESS THEN
	RETURN;
END_IF

addNumberAttribute_AnyType := ValueFactory.createKeyValue(_pKv, ADR(key), _pNum);
IF addNumberAttribute_AnyType <> E_PointerFactoryStatus.SUCCESS THEN
	_pNum^.delete();
	RETURN;
END_IF
_pNum^.delete();  // clean up the _pNum as its cloned in createKeyValue

addNumberAttribute_AnyType := THIS^.append(pValue:=_pKv);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="addStringAttribute" Id="{807c259f-0345-4462-a6a8-1359a14a613b}">
      <Declaration><![CDATA[METHOD addStringAttribute: E_PointerFactoryStatus;
VAR_INPUT
	key: T_MaxString;
	value: T_MaxString;
END_VAR
VAR
	_pKv: POINTER TO FB_KeyValue;
	_pStr: POINTER TO FB_String;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[addStringAttribute := ValueFactory.createString(_pStr, ADR(value));
IF addStringAttribute <> E_PointerFactoryStatus.SUCCESS THEN
	RETURN;
END_IF

addStringAttribute := ValueFactory.createKeyValue(_pKv, ADR(key), _pStr);
IF addStringAttribute <> E_PointerFactoryStatus.SUCCESS THEN
	_pStr^.delete();
	RETURN;
END_IF
_pStr^.delete();  // clean up the _pStr as its cloned in createKeyValue

addStringAttribute := THIS^.append(pValue:=_pKv);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="append" Id="{29d543f3-3e33-4876-b1bf-4a2f0254ef43}">
      <Declaration><![CDATA[METHOD append: E_PointerFactoryStatus
VAR_IN_OUT
	pValue: POINTER TO FB_KeyValue;
END_VAR
VAR
	_node: POINTER TO ST_LinkedListNode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pValue = 0 THEN
	append := E_PointerFactoryStatus.UNEXPECTED_NULL_POINTER;
	RETURN;
END_IF

IF THIS^.count >= GVL.MAX_ATTRIBUTES THEN
	append := E_PointerFactoryStatus.OUT_OF_MEMORY;
	RETURN;
END_IF

_node := __NEW(ST_LinkedListNode);
IF _node = 0 THEN
	append := E_PointerFactoryStatus.OUT_OF_MEMORY;
	RETURN;
END_IF

_node^.val := pValue;
_node^.nxt := 0;

IF THIS^._tail = 0 THEN
	THIS^._head := _node;
	THIS^._cursor := _node;
ELSE
	THIS^._tail^.nxt := _node;
END_IF

THIS^._tail := _node;
THIS^.count := THIS^.count + 1;
// Ownership transfers only after the value has been linked successfully.
pValue := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="copyFrom" Id="{12dc0284-c0fc-445c-a394-015d07f02ff7}">
      <Declaration><![CDATA[METHOD copyFrom : E_PointerFactoryStatus
VAR_IN_OUT
	src: FB_LinkedList_KeyValue;
END_VAR
VAR
	_idx: UDINT;
	_pSrc: POINTER TO FB_KeyValue;
	_pDest: POINTER TO FB_KeyValue;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[copyFrom := E_PointerFactoryStatus.SUCCESS;
src.reset();
FOR _idx := 0 TO GVL.MAX_LOOP_COUNT DO
	_pSrc := src.next();
	IF _pSrc = 0 THEN
		RETURN;
	END_IF
	copyFrom := ValueFactory.cloneKeyValue(_pDest, _pSrc);
	IF copyFrom <> E_PointerFactoryStatus.SUCCESS THEN
		RETURN;
	END_IF
	copyFrom := THIS^.append(_pDest);
	IF copyFrom <> E_PointerFactoryStatus.SUCCESS THEN
		_pDest := _pDest^.delete();
		RETURN;
	END_IF
END_FOR


]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{686344bf-91ee-4a2a-b059-004362cdb29b}">
      <Declaration><![CDATA[METHOD FB_Exit : BOOL
VAR_INPUT
	bInCopyCode: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{cac7191c-0f7c-4339-b12b-895becc570f8}">
      <Declaration><![CDATA[METHOD free
VAR
	_idx: UDINT;
	_node: POINTER TO ST_LinkedListNode;
	_kv: POINTER TO FB_KeyValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR _idx := 0 TO GVL.MAX_ATTRIBUTES DO
	IF THIS^._head = 0 THEN
		EXIT;
	END_IF

	_node := THIS^._head;
	THIS^._head := _node^.nxt;
	IF _node^.val <> 0 THEN
		_kv := _node^.val;
		_node^.val := 0;
		_kv := _kv^.delete();
	END_IF
	__DELETE(_node);
END_FOR

THIS^._head := 0;
THIS^._tail := 0;
THIS^._cursor := 0;
THIS^.count := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="next" Id="{a8ca5105-d23e-40b3-adba-9bbe23230589}">
      <Declaration><![CDATA[METHOD next : POINTER TO FB_KeyValue
]]></Declaration>
      <Implementation>
        <ST><![CDATA[next := 0;

IF THIS^._cursor <> 0 THEN
	next := THIS^._cursor^.val;
	THIS^._cursor := THIS^._cursor^.nxt;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="reset" Id="{8ff040db-0c4f-4ccd-95b1-134233b77487}">
      <Declaration><![CDATA[METHOD reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._cursor := THIS^._head;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
