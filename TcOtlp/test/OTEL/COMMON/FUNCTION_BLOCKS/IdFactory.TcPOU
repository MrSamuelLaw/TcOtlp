<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="IdFactory" Id="{eda40de9-848e-4ddf-9cc4-a46bec817ae0}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	Hands out process-local identities. The counters are private and only
	reachable through the auto incrementing properties, so an id can never
	be observed without also being claimed.
*)
PROGRAM IdFactory
VAR
	_nextResourceId: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="nextResourceId" Id="{579d9f0b-7652-41a8-a11b-63300143100a}">
      <Declaration><![CDATA[// Claims and returns the next resource identity. Every read increments the counter.
PROPERTY nextResourceId : UDINT]]></Declaration>
      <Get Name="Get" Id="{9dd530c2-2a11-4412-b37d-80753d870674}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nextResourceId := _nextResourceId;
_nextResourceId := _nextResourceId + 1;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>