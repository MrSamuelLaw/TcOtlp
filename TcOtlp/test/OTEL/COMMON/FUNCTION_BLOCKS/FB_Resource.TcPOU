<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Resource" Id="{e0c447a6-1944-4b4f-b809-20c0d548eeec}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_Resource
VAR_OUTPUT
	id: UDINT;	// process-local identity, assigned automatically and never exported. Snapshots share the id of their source.
	droppedAttributesCount: UDINT;
	schemaUrl: T_MaxString;
END_VAR
VAR_OUTPUT
	attributes: FB_Attributes(maxCount := TcUnit_GVL.DEFAULT_MAX_ATTRIBUTE_COUNT);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="copyFrom" Id="{f699b31f-6ab6-4d59-8950-0805ae2e4784}">
      <Declaration><![CDATA[METHOD copyFrom : BOOL
VAR_IN_OUT
	src: FB_Resource;
END_VAR
VAR_OUTPUT
	failureResult: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[failureResult := E_AttributesFailureReason.NA;
THIS^.id := src.id;
THIS^.schemaUrl := src.schemaUrl;
THIS^.droppedAttributesCount := src.droppedAttributesCount;
THIS^.attributes.free();
copyFrom := THIS^.attributes.copyFrom(src:=src.attributes, failureReason=>failureResult);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{8de5c17a-7a48-4498-9db6-fe488e5911e1}">
      <Declaration><![CDATA[METHOD FB_Exit : BOOL
VAR_INPUT
	bInCopyCode: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{0abdd27d-4809-4edd-9c8a-ffa2f3a8bbfc}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change) 
	schemaUrl: T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.schemaUrl := schemaUrl;

// claim a process-local identity; keep the existing one during an online change copy
IF NOT bInCopyCode THEN
	THIS^.id := TcUnit_GVL.NEXT_ID;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{0c03ad99-95ec-4068-942a-0ffaa7f065d2}">
      <Declaration><![CDATA[METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.attributes.free();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>