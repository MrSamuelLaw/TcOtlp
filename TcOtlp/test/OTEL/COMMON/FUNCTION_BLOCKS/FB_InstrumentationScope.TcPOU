<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_InstrumentationScope" Id="{b7d10966-7b60-4f22-b7d9-720144dd9472}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_InstrumentationScope
VAR_OUTPUT
	name: T_MaxString;
	version: T_MaxString;
	droppedAttributesCount: UDINT;
	schemaUrl: T_MaxString;
END_VAR
VAR_OUTPUT CONSTANT
	// Owned clone of the list supplied to FB_Init. Do not copy owning lists by value.
	attributes: FB_LinkedList_KeyValue;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{f1944aeb-9f9c-4684-855f-98ad767fb9b0}">
      <Declaration><![CDATA[METHOD FB_Init: BOOL
VAR_INPUT
	bInitRetains: BOOL;
	bInCopyCode: BOOL;
	name: T_MaxString;
	version: T_MaxString;
	schemaUrl: T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.name := name;
THIS^.version := version;
THIS^.schemaUrl := schemaUrl;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>