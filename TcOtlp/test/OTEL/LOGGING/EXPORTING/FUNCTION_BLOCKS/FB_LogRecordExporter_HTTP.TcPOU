<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordExporter_HTTP" Id="{94541c0f-c88a-4178-bb34-d3823fe70965}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordExporter_HTTP EXTENDS FB_LogRecordExporter_Base
VAR_OUTPUT
	currentState: E_HttpExporterState;
	statusCode: UINT;  // the HTTP status code received for the last completed request
END_VAR

VAR
	_execute: BOOL;
	_url: T_MaxString;
	_urlParsed: BOOL;
	_useTls: BOOL;
	_host: T_MaxString;
	_port: UINT;
	_path: T_MaxString;
	_len: UDINT;
	_execRTrig: R_TRIG;
	_pString: POINTER TO STRING;
	_jsonVal: SJsonValue;
	_computedState: E_HttpExporterState;
	_failureReason: E_LogRecordExporterFailureReason;
	_serializationFailureReason: E_ProtoJsonSerializerFailureReason;
	_serializer: FB_LogRecordProtoJsonSerializer;
	_client: FB_IotHttpClient;
	_request: FB_IotHttpRequest;
	_header: FB_IotHttpHeaderFieldMap;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.call(failureReason=>THIS^._callFailureReason);]]></ST>
    </Implementation>
    <Method Name="_parseUrl" Id="{a934a701-5d23-4b65-8267-d06ee977f33c}">
      <Declaration><![CDATA[// Splits a full endpoint URL into scheme (http/https), host, port and path.
// The scheme must be lowercase; IPv6 addresses are not supported.
METHOD _parseUrl : BOOL
VAR
	_rest: T_MaxString;
	_portString: T_MaxString;
	_pathStart: INT;
	_colonIdx: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_parseUrl := FALSE;
THIS^._urlParsed := FALSE;
THIS^._useTls := FALSE;
THIS^._host := '';
THIS^._port := 0;
THIS^._path := '/';

IF FIND(THIS^._url, 'https://') = 1 THEN
	THIS^._useTls := TRUE;
	_rest := RIGHT(THIS^._url, LEN(THIS^._url) - 8);
ELSIF FIND(THIS^._url, 'http://') = 1 THEN
	THIS^._useTls := FALSE;
	_rest := RIGHT(THIS^._url, LEN(THIS^._url) - 7);
ELSE
	RETURN;
END_IF

_pathStart := FIND(_rest, '/');
IF _pathStart > 0 THEN
	THIS^._host := LEFT(_rest, _pathStart - 1);
	THIS^._path := RIGHT(_rest, LEN(_rest) - _pathStart + 1);
ELSE
	THIS^._host := _rest;
	THIS^._path := '/';
END_IF

IF THIS^._useTls THEN
	THIS^._port := 443;
ELSE
	THIS^._port := 80;
END_IF

_colonIdx := FIND(THIS^._host, ':');
IF _colonIdx > 0 THEN
	_portString := RIGHT(THIS^._host, LEN(THIS^._host) - _colonIdx);
	IF _portString = '' THEN RETURN; END_IF
	THIS^._port := STRING_TO_UINT(_portString);
	IF THIS^._port = 0 THEN RETURN; END_IF
	THIS^._host := LEFT(THIS^._host, _colonIdx - 1);
END_IF

IF THIS^._host = '' THEN RETURN; END_IF

THIS^._urlParsed := TRUE;
_parseUrl := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="call" Id="{9b2355dd-f7b1-4921-8536-533aebcd5760}">
      <Declaration><![CDATA[METHOD call : BOOL
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[call := TRUE;
failureReason := E_LogRecordExporterFailureReason.NA;

_execute := THIS^._exportActive;
_execRTrig(CLK := _execute AND_THEN THIS^._records.count > 0);

CASE currentState OF
	E_HttpExporterState.idle:
		IF _execRTrig.Q THEN
			_failureReason := E_LogRecordExporterFailureReason.NA;
			_serializationFailureReason := E_ProtoJsonSerializerFailureReason.NA;
			IF NOT THIS^._urlParsed THEN
				_failureReason := E_LogRecordExporterFailureReason.HTTP_URL_PARSE_FAILURE;
				_computedState := E_HttpExporterState.error;
			ELSE
				_computedState := E_HttpExporterState.serializing;
			END_IF
		END_IF

	E_HttpExporterState.serializing:
		// Serialize the batch and buffer the LogsData document as a byte array payload.
		IF NOT _serializer.serializeLogsData(
			logRecords:=THIS^._records,
			failureReason=>_serializationFailureReason
		) THEN
			_failureReason := E_LogRecordExporterFailureReason.SERIALIZATION_FAILURE;
			_computedState := E_HttpExporterState.error;
		ELSE
			_jsonVal := _serializer.jsonValue;
			IF _jsonVal = 0 OR_ELSE NOT _serializer.parser.IsObject(_jsonVal) THEN
				_failureReason := E_LogRecordExporterFailureReason.SERIALIZATION_FAILURE;
				_computedState := E_HttpExporterState.error;
			ELSE
				_len := _serializer.parser.GetJsonLength(_jsonVal);  // includes the null terminating character
				IF _len = 0 THEN
					_failureReason := E_LogRecordExporterFailureReason.SERIALIZATION_FAILURE;
					_computedState := E_HttpExporterState.error;
				ELSE
					_pString := __NEW(BYTE, _len);
					IF _pString = 0 THEN
						_failureReason := E_LogRecordExporterFailureReason.BUFFER_ALLOCATION_FAILURE;
						_computedState := E_HttpExporterState.error;
					ELSE
						_serializer.parser.CopyJson(_jsonVal, _pString^, _len);
						_computedState := E_HttpExporterState.sending;
					END_IF
				END_IF
			END_IF
		END_IF

	E_HttpExporterState.sending:
		IF NOT _request.bBusy THEN
			IF _request.SendRequest(
				sUri := THIS^._path,
				fbClient := THIS^._client,
				eRequestType := ETcIotHttpRequestType.HTTP_POST,
				pContent := _pString,
				nContentSize := _len - 1,
				fbHeader := THIS^._header
			) THEN
				_computedState := E_HttpExporterState.waiting;
			ELSE
				IF _pString <> 0 THEN __DELETE(_pString); END_IF
				_failureReason := E_LogRecordExporterFailureReason.HTTP_REQUEST_FAILURE;
				_computedState := E_HttpExporterState.error;
			END_IF
		END_IF

	E_HttpExporterState.waiting:
		IF NOT _request.bBusy THEN
			_computedState := E_HttpExporterState.processing;
		END_IF

	E_HttpExporterState.processing:
		IF _request.bError THEN
			IF _pString <> 0 THEN __DELETE(_pString); END_IF
			_failureReason := E_LogRecordExporterFailureReason.HTTP_REQUEST_FAILURE;
			_computedState := E_HttpExporterState.error;
		ELSE
			statusCode := _request.nStatusCode;
			IF statusCode < 200 OR_ELSE statusCode >= 300 THEN
				IF _pString <> 0 THEN __DELETE(_pString); END_IF
				_failureReason := E_LogRecordExporterFailureReason.HTTP_STATUS_FAILURE;
				_computedState := E_HttpExporterState.error;
			ELSE
				IF _pString <> 0 THEN __DELETE(_pString); END_IF
				_computedState := E_HttpExporterState.done;
			END_IF
		END_IF

	E_HttpExporterState.done:
		IF NOT _execute THEN
			_computedState := E_HttpExporterState.idle;
		END_IF
		THIS^.free();

	E_HttpExporterState.error:
		// Retain the failure until export accepts a new batch.
END_CASE

currentState := _computedState;

IF currentState = E_HttpExporterState.done
	OR_ELSE currentState = E_HttpExporterState.error THEN
	THIS^.free();
END_IF

THIS^._client.Execute();

IF currentState = E_HttpExporterState.error THEN
	call := FALSE;
	failureReason := _failureReason;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="export" Id="{c1e9c3db-bbd6-4dba-b7b4-d5219023c6d6}">
      <Declaration><![CDATA[METHOD export: BOOL
VAR_IN_OUT
	logRecords: FB_LogRecordQueue;
END_VAR
VAR_INPUT
	count: UDINT;
END_VAR
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Prepare a completed exporter to accept the next batch immediately.
IF THIS^.currentState = E_HttpExporterState.done OR THIS^.currentState = E_HttpExporterState.error THEN
	THIS^.currentState := E_HttpExporterState.idle;
	THIS^._computedState := E_HttpExporterState.idle;
END_IF
export := SUPER^.export(
	logRecords:=logRecords,
	count:=count,
	failureReason=>failureReason
);
IF export THEN
	THIS^._failureReason := E_LogRecordExporterFailureReason.NA;
	THIS^._serializationFailureReason := E_ProtoJsonSerializerFailureReason.NA;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{62b2e312-9bed-4019-8a5b-4e0d487d8a0a}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
	bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	url: T_MaxString;  // full endpoint URL, e.g. 'http://192.168.1.10:4318/v1/logs'
	bNoServerCertCheck: BOOL := FALSE;  // allow HTTPS connections to servers with self-signed certificates
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.currentState := E_HttpExporterState.idle;
THIS^._computedState := E_HttpExporterState.idle;

THIS^._url := url;
THIS^._urlParsed := THIS^._parseUrl();

THIS^._client.sHostName := THIS^._host;
THIS^._client.nHostPort := THIS^._port;
THIS^._client.bKeepAlive := TRUE;
THIS^._client.tConnectionTimeout := T#10S;
IF THIS^._useTls THEN
	THIS^._client.stTLS.bNoServerCertCheck := bNoServerCertCheck;
END_IF

THIS^._request.sContentType := 'application/json';]]></ST>
      </Implementation>
    </Method>
    <Method Name="isBusy" Id="{40cc32d7-f759-46ec-80dd-15e4415f71f5}">
      <Declaration><![CDATA[METHOD isBusy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isBusy := THIS^._exportActive;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
