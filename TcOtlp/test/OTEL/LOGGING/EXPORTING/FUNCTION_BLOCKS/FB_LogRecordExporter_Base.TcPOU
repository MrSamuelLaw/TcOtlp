<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordExporter_Base" Id="{10005d20-6707-4af6-9c91-e8fb51819d17}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT FB_LogRecordExporter_Base
VAR
	_processor: PVOID;
	_pLogRecords: POINTER TO FB_LogRecordQueue;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="export" Id="{ae492816-f399-4168-9ef3-5fffa135683d}">
      <Declaration><![CDATA[METHOD ABSTRACT export: BOOL
VAR_IN_OUT
	pLogRecords: POINTER TO FB_LogRecordQueue;  // ownership transfers when set to 0
END_VAR
VAR_OUTPUT
	failureResult: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{4cf96576-30d7-4e33-b93a-49a133c9a4da}">
      <Declaration><![CDATA[METHOD FB_Exit: BOOL
VAR_INPUT
	bInCopyCode: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{8a5352f2-a0d5-47c9-aa71-bf818ab953fc}">
      <Declaration><![CDATA[METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._pLogRecords <> 0 THEN
	// FB_LogRecordQueue.FB_Exit deletes every owned record.
	__DELETE(THIS^._pLogRecords);
	THIS^._pLogRecords := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="isBusy" Id="{c736d8fc-db46-4f7d-87a5-2570da83287a}">
      <Declaration><![CDATA[METHOD ABSTRACT isBusy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="register" Id="{849a708c-e03f-4172-8b99-37773ba60614}">
      <Declaration><![CDATA[METHOD register: BOOL;
VAR_INPUT
	processor: I_LogRecordProcessor;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._processor = 0 THEN
	THIS^._processor := processor.pSelf;
ELSIF THIS^._processor <> processor.pSelf THEN
	ADSLOGSTR(
		msgCtrlMask:=ADSLOG_MSGTYPE_ERROR,
		'Unable to register multiple processors with a single exporter',
		''
	);
END_IF
register := THIS^._processor = processor.pSelf;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>