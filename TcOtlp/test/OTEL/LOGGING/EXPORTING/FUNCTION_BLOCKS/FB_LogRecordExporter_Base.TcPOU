<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordExporter_Base" Id="{10005d20-6707-4af6-9c91-e8fb51819d17}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT FB_LogRecordExporter_Base
VAR
	_records: FB_LogRecordQueue(maxCount:=0);
	_exportActive: BOOL;
	_callFailureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="export" Id="{ae492816-f399-4168-9ef3-5fffa135683d}">
      <Declaration><![CDATA[METHOD export: BOOL
VAR_IN_OUT
	logRecords: FB_LogRecordQueue;  // accepted records are transferred out of this queue
END_VAR
VAR_INPUT
	count: UDINT;
END_VAR
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
VAR
	_queueFailureReason: E_LogRecordQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[export := FALSE;
failureReason := E_LogRecordExporterFailureReason.NA;

IF THIS^.isBusy() THEN
	failureReason := E_LogRecordExporterFailureReason.ACTIVE_EXPORT_IN_PROGRESS;
	RETURN;
END_IF

// Release a completed batch retained by an exporter before accepting the next one.
THIS^.free();
IF NOT logRecords.transferTo(
	destination:=THIS^._records,
	count:=count,
	failureReason=>_queueFailureReason
) THEN
	failureReason := E_LogRecordExporterFailureReason.QUEUE_TRANSFER_FAILURE;
	RETURN;
END_IF

THIS^._exportActive := THIS^._records.count > 0;
export := failureReason = E_LogRecordExporterFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{4cf96576-30d7-4e33-b93a-49a133c9a4da}">
      <Declaration><![CDATA[METHOD FB_Exit: BOOL
VAR_INPUT
	bInCopyCode: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{8a5352f2-a0d5-47c9-aa71-bf818ab953fc}">
      <Declaration><![CDATA[METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._records.free();
THIS^._exportActive := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="isBusy" Id="{c736d8fc-db46-4f7d-87a5-2570da83287a}">
      <Declaration><![CDATA[METHOD ABSTRACT isBusy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="tick" Id="{026c006d-bd3c-4d2e-a9f9-a18db63b8c3f}">
      <Declaration><![CDATA[METHOD ABSTRACT tick : BOOL
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>