<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_LogRecordProcessorFailureReason" Id="{d584c2c7-6b3c-46ad-8152-e53006c991ce}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_LogRecordProcessorFailureReason :
(
	NA := 0,  // No failure occurred.
	QUEUE_ALLOCATION_FAILURE := 1,  // A processing queue could not be allocated.
	RECORD_CLONE_FAILURE,  // The emitted record could not be cloned for retention.
	QUEUE_PUSH_FAILURE  // The retained record could not be transferred into the queue.
) UDINT;
END_TYPE
]]></Declaration>
