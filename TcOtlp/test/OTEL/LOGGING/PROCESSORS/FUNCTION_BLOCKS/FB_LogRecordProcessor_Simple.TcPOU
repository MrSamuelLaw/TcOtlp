<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProcessor_Simple" Id="{90ded010-1262-4ab5-9db9-0fd13f25279d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordProcessor_Simple EXTENDS FB_LogRecordProcessor_Base;
VAR
	_records: FB_LogRecordQueue(maxCount:=1);
	_exporter: REFERENCE TO FB_LogRecordExporter_Base;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="enrich" Id="{6f0ee9bd-9f0f-4ae9-bc9c-41fc9bcbd76c}">
      <Declaration><![CDATA[// no-op, overwride to change log mutation/enrichment functionality
METHOD enrich
VAR_IN_OUT
	logRecord	: FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{e0ee58d6-3224-428c-880b-30a0e7bd9f8d}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{589fb0dd-a53b-43f6-9d67-5928802d20cd}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	exporter: REFERENCE TO FB_LogRecordExporter_Base;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(exporter) THEN
	THIS^._exporter REF= exporter;
ELSE
	THIS^._exporter REF= 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{d85fcdb4-384c-4695-8f77-ce517f0d3431}">
      <Declaration><![CDATA[METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._records.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="onEmit" Id="{1a689aff-c482-4d8e-b59e-78bd1c66f367}">
      <Declaration><![CDATA[METHOD onEmit
VAR_INPUT
	logRecord: REFERENCE TO FB_LogRecord;
END_VAR
VAR
	_pLogRecord: POINTER TO FB_LogRecord;
	_cloneFailureResult: E_LogRecordCloneFailureReason;
	_queueFailureReason: E_LogRecordQueueFailureReason;
	_exportFailureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.enrich(logRecord);

IF __ISVALIDREF(THIS^._exporter) THEN
	IF (NOT THIS^._exporter.isBusy()) THEN
		IF logRecord.cloneTo(pDest:=_pLogRecord, failureReason=>_cloneFailureResult) THEN
			IF THIS^._records.push(pValue:=_pLogRecord, failureReason=>_queueFailureReason) THEN
				THIS^._exporter.export(
					logRecords:=THIS^._records,
					count:=1,
					failureReason=>_exportFailureReason
				);
			END_IF
		END_IF
	END_IF
END_IF

// If the exporter did not accept the buffer, the simple processor drops it.
THIS^.free();
IF _pLogRecord <> 0 THEN _pLogRecord^.delete(pSelf:=_pLogRecord); END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="tick" Id="{cbc94a96-e048-4b21-9864-888b5113f033}">
      <Declaration><![CDATA[METHOD tick
VAR
	_exportFailureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(THIS^._exporter) THEN
	THIS^._exporter.tick(failureReason=>_exportFailureReason);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>