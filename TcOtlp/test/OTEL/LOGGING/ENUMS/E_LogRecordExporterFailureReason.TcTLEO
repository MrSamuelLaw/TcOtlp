  <EnumerationTextList Name="E_LogRecordExporterFailureReason" Id="{e1d90d84-b23a-4a95-a760-813f7018766a}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_LogRecordExporterFailureReason :
(
	BATCH_POINTER_NULL := 1,  // The supplied log-record queue pointer is null.
	ACTIVE_EXPORT_IN_PROGRESS,  // The exporter cannot accept another batch while an export is active.
	EXPORTER_REFERENCE_INVALID  // The supplied exporter reference is invalid.
) UDINT;
END_TYPE
]]></Declaration>
