<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_LogRecordQueueFailureReason" Id="{889b75ee-4565-4114-a653-39ae2d0d3f52}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_LogRecordQueueFailureReason :
(
	RECORD_POINTER_NULL := 1,  // The supplied log-record pointer is null.
	DESTINATION_ALREADY_ASSIGNED,  // The pop destination pointer is already assigned.
	QUEUE_EMPTY,  // The queue contains no record to pop.
	MAX_SIZE_ZERO,  // The configured maximum size does not permit any records.
	MAX_SIZE_ENFORCEMENT_FAILURE,  // The bounded eviction loop could not restore the configured maximum size.
	DESTINATION_NOT_EMPTY,  // The transfer destination already owns records.
	DESTINATION_CAPACITY_TOO_SMALL,  // The transfer destination cannot hold every source record.
	SELF_TRANSFER_NOT_ALLOWED,  // A queue cannot transfer ownership to itself.
	MEMORY_ALLOCATION_FAILURE  // Dynamic node allocation failed.
) UDINT;
END_TYPE
]]></Declaration>
