  <EnumerationTextList Name="E_LoggerProviderFailureReason" Id="{7818a20b-97b0-460d-98a1-374dc1cf8ebe}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_LoggerProviderFailureReason :
(
	NA := 0,  // No failure occurred.
	RECORD_POINTER_NULL,  // The supplied log record pointer is null.
	QUEUE_POP_FAILURE  // A record could not be popped from the provider's queue during cyclical processing.
) UDINT;
END_TYPE
]]></Declaration>
