<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LoggerProvider" Id="{16983c20-c68e-4842-a5af-294cf7d1f97c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LoggerProvider
VAR_IN_OUT
	processors: ARRAY [*] OF I_LogRecordProcessor;
END_VAR
VAR
	_resource: REFERENCE TO FB_Resource;
	_idx: DINT;
	_startIdx: DINT;
	_endIdx: DINT;
	_curVal: I_LogRecordProcessor;
	_nextProcessor: I_LogRecordProcessor;
	_prevProcessor: I_LogRecordProcessor;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// check if the last processor is ready
_startIdx := LOWER_BOUND(processors, 1);
_endIdx := UPPER_BOUND(processors, 1);

IF processors[_endIdx].isDone() THEN
	processors[_endIdx].free();
END_IF

FOR _idx := _endIdx TO _startIdx BY -1 DO
	// if there is only a single processor simply call the processor
	IF _endIdx = _startIdx THEN
		processors[_endIdx].call();
	ELSE
		// pass
	END_IF
	// skip
END_FOR]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{4bf253fc-a990-4445-afd2-9dddc5216dd7}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	resource: REFERENCE TO FB_Resource;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._resource REF= resource;]]></ST>
      </Implementation>
    </Method>
    <Method Name="onEmit" Id="{cab51e34-8571-4016-91bd-9f1916518d10}">
      <Declaration><![CDATA[METHOD onEmit: E_PointerFactoryStatus
VAR_IN_OUT
	pSrc: POINTER TO FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// attempt to transfer the record, do nothing if the transfer fails
IF pSrc = 0 THEN
	onEmit := E_PointerFactoryStatus.UNEXPECTED_NULL_POINTER;
	RETURN;
ELSIF THIS^.processors[0].isFull() THEN
	onEmit := E_PointerFactoryStatus.OUT_OF_MEMORY;
	RETURN;
END_IF

onEmit := THIS^.processors[0].push(pSrc);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="resource" Id="{5c5a395f-26fb-4f37-9459-e8fe5661bff3}">
      <Declaration><![CDATA[PROPERTY resource : REFERENCE TO FB_Resource]]></Declaration>
      <Get Name="Get" Id="{e4e2a932-61cb-47f3-8bd9-6fc7f29c0975}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[resource REF= THIS^._resource;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>