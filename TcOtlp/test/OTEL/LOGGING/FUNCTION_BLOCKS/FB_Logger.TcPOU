<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Logger" Id="{730b727f-4674-448e-a99c-ca00a77667b8}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_Logger
VAR_OUTPUT
	pLogRecord: POINTER TO FB_LogRecord;
END_VAR
VAR
	_scope: REFERENCE TO FB_InstrumentationScope;
	_provider: REFERENCE TO FB_LoggerProvider;
	_failed: BOOL;
	_failureResult: E_LoggerFailureReason;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_createLogRecord" Id="{4207d434-2c98-44c0-9f1b-0b70f89803a3}">
      <Declaration><![CDATA[METHOD _createLogRecord : BOOL
VAR_IN_OUT
	pDest: POINTER TO FB_LogRecord;
END_VAR
VAR_INPUT
	severityNumber: E_SeverityNumber;
	timestamp: ULINT;
END_VAR
VAR_OUTPUT
	failureResult: E_LoggerFailureReason;
END_VAR
VAR
	_logRecord: POINTER TO FB_LogRecord;
	_attributesFailureResult: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_createLogRecord := FALSE;
failureResult := E_LoggerFailureReason.NA;

IF pDest <> 0 THEN
	failureResult := E_LoggerFailureReason.LOG_RECORD_ALREADY_STARTED;
	RETURN;
END_IF

_logRecord := __NEW(FB_LogRecord(
	severityNumber:=severityNumber,
	timestamp:=timestamp
));

IF _logRecord = 0 THEN
	failureResult := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

IF NOT _logRecord^.resource.copyFrom(src:=THIS^.resource, failureResult=>_attributesFailureResult) THEN
	IF _attributesFailureResult = E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		failureResult := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		failureResult := E_LoggerFailureReason.SNAPSHOT_COPY_FAILURE;
	END_IF
	_logRecord := _logRecord^.delete();
	RETURN;
END_IF

IF NOT _logRecord^.scope.copyFrom(src:=THIS^.scope, failureResult=>_attributesFailureResult) THEN
	IF _attributesFailureResult = E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		failureResult := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		failureResult := E_LoggerFailureReason.SNAPSHOT_COPY_FAILURE;
	END_IF
	_logRecord := _logRecord^.delete();
	RETURN;
END_IF

pDest := _logRecord;
_logRecord := 0;
_createLogRecord := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_shouldReturnEarly" Id="{dd5ad78b-282f-4ecb-a14b-0db8162267f3}">
      <Declaration><![CDATA[METHOD _shouldReturnEarly : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_shouldReturnEarly := TRUE;

// Preserve the first failure in the active fluent chain.
IF THIS^._failed THEN
	RETURN;
END_IF

// fail early if the log record hasn't been built
IF THIS^.pLogRecord = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureResult := E_LoggerFailureReason.LOG_RECORD_NOT_STARTED;
	RETURN;
END_IF

_shouldReturnEarly := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="addNumberAttribute" Id="{6e8ebb16-a1b8-4ed2-891a-240f2408bf80}">
      <Declaration><![CDATA[METHOD addNumberAttribute: REFERENCE TO FB_Logger
VAR_INPUT
	key: T_MaxString;
	value: ANY_NUM;
END_VAR
VAR
	_attributesSuccess: BOOL;
	_attributesFailureReason: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[addNumberAttribute REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

_attributesSuccess := THIS^.pLogRecord^.attributes.setNumberAttribute_AnyType(
	key:=key,
	value:=value,
	failureReason=>_attributesFailureReason
);
IF NOT _attributesSuccess THEN
	THIS^._failed := TRUE;
	CASE _attributesFailureReason OF
		E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE:
			THIS^._failureResult := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
		E_AttributesFailureReason.ATTRIBUTE_COUNT_LIMIT_REACHED:
			THIS^._failureResult := E_LoggerFailureReason.ATTRIBUTE_COUNT_LIMIT_REACHED;
		E_AttributesFailureReason.KV_VALUE_TYPE_UNSUPPORTED:
			THIS^._failureResult := E_LoggerFailureReason.ATTRIBUTE_VALUE_TYPE_UNSUPPORTED;
	ELSE
		THIS^._failureResult := E_LoggerFailureReason.ATTRIBUTE_VALUE_INVALID;
	END_CASE
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="addStringAttribute" Id="{ca1a9b5c-3e71-4efc-b089-bac82579b23c}">
      <Declaration><![CDATA[METHOD addStringAttribute: REFERENCE TO FB_Logger
VAR_INPUT
	key: T_MaxString;
	value: T_MaxString;
END_VAR
VAR
	_attributesSuccess: BOOL;
	_attributesFailureReason: E_AttributesFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[addStringAttribute REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

_attributesSuccess := THIS^.pLogRecord^.attributes.setStringAttribute(
	key:=key,
	value:=value,
	failureReason=>_attributesFailureReason
);
IF NOT _attributesSuccess THEN
	THIS^._failed := TRUE;
	CASE _attributesFailureReason OF
		E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE:
			THIS^._failureResult := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
		E_AttributesFailureReason.ATTRIBUTE_COUNT_LIMIT_REACHED:
			THIS^._failureResult := E_LoggerFailureReason.ATTRIBUTE_COUNT_LIMIT_REACHED;
		E_AttributesFailureReason.KV_VALUE_TYPE_UNSUPPORTED:
			THIS^._failureResult := E_LoggerFailureReason.ATTRIBUTE_VALUE_TYPE_UNSUPPORTED;
	ELSE
		THIS^._failureResult := E_LoggerFailureReason.ATTRIBUTE_VALUE_INVALID;
	END_CASE
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="emit" Id="{9d921a05-0a1a-4507-b871-f56b935dc996}">
      <Declaration><![CDATA[(*
	Function emits a log record for processing.
	Each log record owns a snapshot of its instrumentation scope and resource, so processors
	may retain the record after its logger or provider has been destroyed.
*)
METHOD emit: BOOL
VAR_IN_OUT
	processors: ARRAY [*] OF I_LogRecordProcessor;
END_VAR
VAR_OUTPUT
	failureResult: E_LoggerFailureReason;
END_VAR
VAR
	_idx: DINT;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[emit := FALSE;
failureResult := E_LoggerFailureReason.NA;

// Preserve the first fluent method failure while releasing the incomplete record.
IF THIS^._failed THEN
	IF THIS^.pLogRecord <> 0 THEN THIS^.pLogRecord := THIS^.pLogRecord^.delete(); END_IF
	failureResult := THIS^._failureResult;
	RETURN;
END_IF

IF THIS^.pLogRecord = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureResult := E_LoggerFailureReason.LOG_RECORD_NOT_STARTED;
	failureResult := THIS^._failureResult;
	RETURN;
END_IF

FOR _idx := LOWER_BOUND(processors, 1) TO UPPER_BOUND(processors, 1) DO
	processors[_idx].onEmit(THIS^.pLogRecord^);
END_FOR
THIS^.pLogRecord := THIS^.pLogRecord^.delete();

THIS^._failed := FALSE;
THIS^._failureResult := E_LoggerFailureReason.NA;
emit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{8c3c5b34-9fb4-4244-bcbe-417c9db34dca}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	scope: REFERENCE TO FB_InstrumentationScope;
	provider: REFERENCE TO FB_LoggerProvider;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._scope REF= scope;
THIS^._provider REF= provider;]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{7a1f6e83-7f40-420d-94fb-81b34da658fd}">
      <Declaration><![CDATA[METHOD free
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.pLogRecord <> 0 THEN
	THIS^.pLogRecord := THIS^.pLogRecord^.delete();
END_IF
THIS^._failed := TRUE;
THIS^._failureResult := E_LoggerFailureReason.LOG_RECORD_NOT_STARTED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="reset" Id="{cfc39e65-b855-4ce2-8008-a09504960012}">
      <Declaration><![CDATA[METHOD reset
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();
THIS^._failed := FALSE;
THIS^._failureResult := E_LoggerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Property Name="resource" Id="{af2fd56b-1f1f-4731-bef9-9ae40f95e566}">
      <Declaration><![CDATA[PROPERTY resource : REFERENCE TO FB_Resource]]></Declaration>
      <Get Name="Get" Id="{bcf317dc-29b7-4ff3-b222-879d72137cad}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[resource REF= THIS^._provider.resource;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="scope" Id="{d2e8b677-bbd2-4f19-8272-9e764fae0428}">
      <Declaration><![CDATA[PROPERTY scope : REFERENCE TO FB_InstrumentationScope]]></Declaration>
      <Get Name="Get" Id="{b10b9cbb-674e-4a26-9f2c-986355dc3d28}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[scope REF= THIS^._scope;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="setBody" Id="{f682be3b-ac6a-4113-bd9d-b20c5c0e539e}">
      <Declaration><![CDATA[METHOD setBody: REFERENCE TO FB_Logger
VAR_INPUT
	str: T_MaxString;  // use setBody_AnyValue if the body isn't a string
END_VAR
VAR
	_pDest: POINTER TO FB_String;
	_factoryFailureReason: E_ValueFactoryFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[setBody REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// Create an owned string body.
IF NOT ValueFactory.createString(
	pDest:=_pDest,
	pString:=ADR(str),
	failureReason=>_factoryFailureReason
	) THEN
	THIS^._failed := TRUE;
	IF _factoryFailureReason = E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		THIS^._failureResult := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		THIS^._failureResult := E_LoggerFailureReason.BODY_VALUE_INVALID;
	END_IF
	RETURN;
END_IF

// Replace the body only after the new value has been created successfully.
IF THIS^.pLogRecord^.body <> 0 THEN
	THIS^.pLogRecord^.body := THIS^.pLogRecord^.body^.delete();
END_IF
THIS^.pLogRecord^.body := _pDest;
_pDest := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setBody_AnyValue" Id="{e851deec-1a83-4031-a7b1-3298d7142b2e}">
      <Declaration><![CDATA[METHOD setBody_AnyValue: REFERENCE TO FB_Logger
VAR_INPUT
	pVal: POINTER TO FB_AnyValue;  // use setBody_AnyValue if the body isn't a string
END_VAR
VAR
	_pDest: POINTER TO FB_AnyValue;
	_factoryFailureReason: E_ValueFactoryFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[setBody_AnyValue REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// check that the value is valid
IF pVal = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureResult := E_LoggerFailureReason.BODY_VALUE_POINTER_NULL;
	RETURN;
END_IF

// try to create a clone
IF NOT ValueFactory.cloneAnyValue(
	pDest:=_pDest,
	pSrc:=pVal,
	failureReason=>_factoryFailureReason
	) THEN
	THIS^._failed := TRUE;
	CASE _factoryFailureReason OF
		E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE:
			THIS^._failureResult := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
		E_ValueFactoryFailureReason.UNSUPPORTED_VALUE_TYPE:
			THIS^._failureResult := E_LoggerFailureReason.BODY_VALUE_TYPE_UNSUPPORTED;
	ELSE
		THIS^._failureResult := E_LoggerFailureReason.BODY_VALUE_INVALID;
	END_CASE
	RETURN;
END_IF

// clean up the prior record if it existed
IF THIS^.pLogRecord^.body <> 0 THEN
	THIS^.pLogRecord^.body := THIS^.pLogRecord^.body^.delete();
END_IF
// transfer ownership
THIS^.pLogRecord^.body := _pDest;
_pDest := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setEventName" Id="{e9a59e4b-8289-499d-8865-35d6e960ff8a}">
      <Declaration><![CDATA[METHOD setEventName: REFERENCE TO FB_Logger
VAR_INPUT
	str: T_MaxString;
END_VAR
VAR
	_pDest: POINTER TO FB_String;
	_factoryFailureReason: E_ValueFactoryFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setEventName REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// create FB_String
IF NOT ValueFactory.createString(
	pDest:=_pDest,
	pString:=ADR(str),
	failureReason=>_factoryFailureReason
	) THEN
	THIS^._failed := TRUE;
	IF _factoryFailureReason = E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		THIS^._failureResult := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		THIS^._failureResult := E_LoggerFailureReason.EVENT_NAME_INVALID;
	END_IF
	RETURN;
END_IF

// assign to record event name
// delete old event name if it exists
IF THIS^.pLogRecord^.eventName <> 0 THEN
	THIS^.pLogRecord^.eventName := THIS^.pLogRecord^.eventName^.delete();
END_IF
// transfer ownership of the pointer
THIS^.pLogRecord^.eventName := _pDest;
_pDest := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setFlags" Id="{5d379f0e-933c-4b0a-a500-5ddf2e9afe34}">
      <Declaration><![CDATA[METHOD setFlags: REFERENCE TO FB_Logger
VAR_INPUT
	flags: E_LogRecordFlag;
END_VAR
VAR
	_pDest: POINTER TO E_LogRecordFlag;
	_pOld: POINTER TO UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[setFlags REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// if the value pointer is null, create a new pointer
IF THIS^.pLogRecord^.flags = 0 THEN
	THIS^.pLogRecord^.flags := __NEW(E_LogRecordFlag);
	// if it failed, than the system is out of memory, abort
	IF THIS^.pLogRecord^.flags = 0 THEN
		THIS^._failed := TRUE;
		THIS^._failureResult := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
		RETURN;
	END_IF
END_IF
// if everything above worked, assign the value
THIS^.pLogRecord^.flags^ := flags;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setSpanId" Id="{14f48eeb-ffc5-4e13-838f-969f880e1995}">
      <Declaration><![CDATA[METHOD setSpanId: REFERENCE TO FB_Logger
VAR_INPUT
	pBytes: POINTER TO BYTE;
	nSize: UDINT;
END_VAR
VAR
	_pDest: POINTER TO FB_SpanId;
	_factoryFailureReason: E_ValueFactoryFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setSpanId REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// create an instance of FB_SpanId
IF NOT ValueFactory.createSpanId(
	pDest:=_pDest,
	pBytes:=pBytes,
	nSize:=nSize,
	failureReason=>_factoryFailureReason
	) THEN
	THIS^._failed := TRUE;
	CASE _factoryFailureReason OF
		E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE:
			THIS^._failureResult := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
		E_ValueFactoryFailureReason.SPAN_ID_BYTES_POINTER_NULL:
			THIS^._failureResult := E_LoggerFailureReason.SPAN_ID_BYTES_POINTER_NULL;
		E_ValueFactoryFailureReason.SPAN_ID_BYTE_COUNT_TOO_SMALL:
			THIS^._failureResult := E_LoggerFailureReason.SPAN_ID_BYTE_COUNT_TOO_SMALL;
	ELSE
		THIS^._failureResult := E_LoggerFailureReason.SPAN_ID_INVALID;
	END_CASE
	RETURN;
END_IF

// assign to the record
// delete the prior record if it exists
IF THIS^.pLogRecord^.spanId <> 0 THEN
	THIS^.pLogRecord^.spanId := THIS^.pLogRecord^.spanId^.delete();
END_IF
// transfer owneship of the data
THIS^.pLogRecord^.spanId := _pDest;
_pDest := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setTraceId" Id="{ca3f3acd-d52b-46f3-b0a6-82a2580b7b9b}">
      <Declaration><![CDATA[METHOD setTraceId: REFERENCE TO FB_Logger
VAR_INPUT
	pBytes: POINTER TO BYTE;
	nSize: UDINT;
END_VAR
VAR
	_pDest: POINTER TO FB_TraceId;
	_factoryFailureReason: E_ValueFactoryFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setTraceId REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// create an instance of FB_TraceId
IF NOT ValueFactory.createTraceId(
	pDest:=_pDest,
	pBytes:=pBytes,
	nSize:=nSize,
	failureReason=>_factoryFailureReason
	) THEN
	THIS^._failed := TRUE;
	CASE _factoryFailureReason OF
		E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE:
			THIS^._failureResult := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
		E_ValueFactoryFailureReason.TRACE_ID_BYTES_POINTER_NULL:
			THIS^._failureResult := E_LoggerFailureReason.TRACE_ID_BYTES_POINTER_NULL;
		E_ValueFactoryFailureReason.TRACE_ID_BYTE_COUNT_TOO_SMALL:
			THIS^._failureResult := E_LoggerFailureReason.TRACE_ID_BYTE_COUNT_TOO_SMALL;
	ELSE
		THIS^._failureResult := E_LoggerFailureReason.TRACE_ID_INVALID;
	END_CASE
	RETURN;
END_IF

// assign to the log record
// delete trace id if it's already set.
IF THIS^.pLogRecord^.traceId <> 0 THEN
	THIS^.pLogRecord^.traceId := THIS^.pLogRecord^.traceId^.delete();
END_IF
// transfer ownership of the data
THIS^.pLogRecord^.traceId := _pDest;
_pDest := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="startLogRecord" Id="{eaefc3eb-aea0-4067-8396-a0c5d23f5ac3}">
      <Declaration><![CDATA[(*
	This method starts the build process with the required log record state.
	Use the fluent setter and adder methods for optional fields.
	
	Example:
	IF NOT logger
		.startLogRecord(severityNumber := E_SeverityNumber.SEVERITY_NUMBER_WARNING)
		.setBody('process cycle amps warning, motor fault imminent')
		.addNumberAttribute('motor.amps.min', minAmps)
		.addNumberAttribute('motor.amps.max', maxAmps)
		.addNumberAttribute('motor.amps.avg', avgAmps)
		.emit(processors:=processors, failureResult=>failureResult) THEN
		// CASE failureResult OF ...
	END_IF
*)
METHOD startLogRecord: REFERENCE TO FB_Logger
VAR_INPUT
	severityNumber: E_SeverityNumber;
	timestamp: POINTER TO ULINT := 0;
END_VAR
VAR
	_timestamp: ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[startLogRecord REF= THIS^;

// do not replace the first failure in an active fluent chain
IF THIS^.pLogRecord <> 0 THEN
	IF NOT THIS^._failed THEN
		THIS^._failed := TRUE;
		THIS^._failureResult := E_LoggerFailureReason.LOG_RECORD_ALREADY_STARTED;
	END_IF
	RETURN;
END_IF

THIS^._failed := FALSE;
THIS^._failureResult := E_LoggerFailureReason.NA;

// set the timetstamp if the pointer is null (which is the prefered method of building a record)
IF timestamp <> 0 THEN
	_timestamp := timestamp^;
ELSE
	_timestamp := F_GetSystemTime() * 100; // convert to nanos
END_IF

// instantiate a log record
IF NOT THIS^._createLogRecord(
	pDest:=THIS^.pLogRecord,
	severityNumber:=severityNumber,
	timestamp:=_timestamp,
	failureResult=>THIS^._failureResult
	) THEN
	THIS^._failed := TRUE;
END_IF

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
