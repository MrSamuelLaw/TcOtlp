<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProcessor_Simple" Id="{90ded010-1262-4ab5-9db9-0fd13f25279d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordProcessor_Simple IMPLEMENTS I_LogRecordProcessor;
VAR
	_records: FB_LinkedList_LogRecord;
	_exporter: REFERENCE TO FB_LogRecordExporter_Base;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{589fb0dd-a53b-43f6-9d67-5928802d20cd}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	exporter: REFERENCE TO FB_LogRecordExporter_Base;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._exporter REF= exporter;]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{d85fcdb4-384c-4695-8f77-ce517f0d3431}">
      <Declaration><![CDATA[METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._records.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="onEmit" Id="{1a689aff-c482-4d8e-b59e-78bd1c66f367}">
      <Declaration><![CDATA[METHOD onEmit
VAR_INPUT
	logRecord: REFERENCE TO FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// TODO: implement the clone and transfer to the exporter if it exists.
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>