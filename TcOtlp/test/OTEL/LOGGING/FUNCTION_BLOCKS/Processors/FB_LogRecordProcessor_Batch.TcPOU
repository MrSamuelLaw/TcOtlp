<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProcessor_Batch" Id="{3c63b4ac-33ba-4480-a899-f0c3be47a7cf}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	Batch processor. Call the FB body cyclically.

	onEmit clones each record into an arrival-order queue (oldest at the head)
	capped at maxQueueSize; when full, the oldest record is dropped to make
	room for the newest. The body flushes every scheduledDelayMillis, or as
	soon as a full batch is queued: the oldest maxExportBatchSize records are
	moved into an arrival-order buffer and ownership of
	the buffer is transferred to the exporter.
*)
FUNCTION_BLOCK FB_LogRecordProcessor_Batch EXTENDS FB_LogRecordProcessor_Mixin IMPLEMENTS I_LogRecordProcessor;
VAR_INPUT
	maxQueueSize: UDINT := 2048;						// the maximum queue size. After the size is reached the oldest logs are dropped. The default value is 2048.
	scheduledDelayMillis: UDINT := 1000;				// the delay interval in milliseconds between two consecutive exports. The default value is 1000.
	exportTimeoutMillis: UDINT := 30000;				// how long the export can run before it is cancelled. The default value is 30000. (not yet implemented)
	maxExportBatchSize: UDINT := 512;					// the maximum batch size of every export. It must be smaller or equal to maxQueueSize. The default value is 512.
END_VAR
VAR_OUTPUT
	sts: E_PointerFactoryStatus;
END_VAR
VAR
	_scheduleDelayTimer: TON;
	_records: POINTER TO FB_LogRecordQueue;		// arrival-order queue (oldest at the head), capped at maxQueueSize
	_buffer: POINTER TO FB_LogRecordQueue;		// arrival-order batch awaiting transfer to the exporter, capped at maxExportBatchSize
	_exporter: REFERENCE TO FB_LogRecordExporter_Base;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.call();]]></ST>
    </Implementation>
    <Method Name="call" Id="{52431084-38a6-4b97-9c40-41396451732f}">
      <Declaration><![CDATA[METHOD call
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.flushIfNeeded();
IF __ISVALIDREF(THIS^._exporter) THEN
	THIS^._exporter();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="enrich" Id="{cd91d31c-cfa3-4b93-ac03-7d361155ee3a}">
      <Declaration><![CDATA[// no-op; override to change log mutation/enrichment functionality
METHOD enrich
VAR_IN_OUT
	logRecord: FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{ee6e60b0-3b81-40b7-905a-5fd33600daae}">
      <Declaration><![CDATA[METHOD FB_Exit : BOOL
VAR_INPUT
	bInCopyCode: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{1b6c3aba-d3d8-44a7-8d93-ac13d7ad0810}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	exporter: REFERENCE TO FB_LogRecordExporter_Base;	// the exporter where the LogRecords are pushed.
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(exporter) AND_THEN exporter.register(THIS^) THEN
	THIS^._exporter REF= exporter;
ELSE
	THIS^._exporter REF= 0;
END_IF

IF NOT bInCopyCode THEN
	THIS^._records := __NEW(FB_LogRecordQueue(maxSize:=THIS^.maxQueueSize));
	IF THIS^._records = 0 THEN
		THIS^.sts := E_PointerFactoryStatus.OUT_OF_MEMORY;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{f13c14df-6aac-4e5f-ae77-f40c30ac792c}">
      <Declaration><![CDATA[METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._records <> 0 THEN
	// FB_LogRecordQueue.free deletes every owned record.
	THIS^._records := THIS^._records^.delete();
END_IF

IF THIS^._buffer <> 0 THEN
	THIS^._buffer := THIS^._buffer^.delete();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="onEmit" Id="{601f420a-eb68-4a65-8062-d11e0d96dc3c}">
      <Declaration><![CDATA[(*
	Clones the log record onto the tail of the arrival-order queue.
	When the queue holds maxQueueSize records, the oldest record is
	dropped from the head to make room for the newest.
*)
METHOD onEmit
VAR_INPUT
	logRecord: REFERENCE TO FB_LogRecord;
END_VAR
VAR
	_pRecord: POINTER TO FB_LogRecord;
	_queueFailureReason: E_LogRecordQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.enrich(logRecord);

IF NOT THIS^.ensureQueue() THEN RETURN; END_IF
_pRecord := 0;
THIS^.sts := logRecord.cloneTo(_pRecord);
IF THIS^.sts <> E_PointerFactoryStatus.SUCCESS THEN
	IF _pRecord <> 0 THEN _pRecord := _pRecord^.delete(); END_IF
	RETURN;
END_IF

IF NOT THIS^._records^.push(pValue:=_pRecord, failureReason=>_queueFailureReason) THEN
	_pRecord := _pRecord^.delete();
	THIS^.sts := E_PointerFactoryStatus.OUT_OF_MEMORY;
	RETURN;
END_IF

THIS^.sts := E_PointerFactoryStatus.SUCCESS;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ensureQueue" Id="{ea1eecb5-ef37-433e-a442-c6100f2bf2c0}">
      <Declaration><![CDATA[METHOD ensureQueue : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._records = 0 THEN
	THIS^._records := __NEW(FB_LogRecordQueue(maxSize:=THIS^.maxQueueSize));
END_IF

ensureQueue := THIS^._records <> 0;
IF ensureQueue THEN
	THIS^._records^.maxSize := THIS^.maxQueueSize;
ELSE
	THIS^.sts := E_PointerFactoryStatus.OUT_OF_MEMORY;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="flushIfNeeded" Id="{ef8261bd-5790-44ed-9787-8d1e3e6279af}">
      <Declaration><![CDATA[METHOD flushIfNeeded
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._scheduleDelayTimer(
	IN := NOT THIS^._scheduleDelayTimer.Q,
	PT := UDINT_TO_TIME(THIS^.scheduledDelayMillis)
);

IF THIS^._scheduleDelayTimer.Q
	OR_ELSE THIS^._buffer <> 0
	OR_ELSE (THIS^.maxExportBatchSize > 0
		AND_THEN THIS^._records <> 0
		AND_THEN THIS^._records^.count >= THIS^.maxExportBatchSize) THEN
	THIS^.pushToExporter();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="buildBuffer" Id="{12d3e85a-6355-4c3e-8fcb-622a0ed4c3c0}">
      <Declaration><![CDATA[METHOD buildBuffer : BOOL
VAR
	_idx: UDINT;
	_pRecord: POINTER TO FB_LogRecord;
	_queueFailureReason: E_LogRecordQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[buildBuffer := FALSE;
IF THIS^.maxExportBatchSize = 0
	OR_ELSE THIS^._records = 0
	OR_ELSE THIS^._records^.count = 0 THEN
	RETURN;
END_IF

THIS^._buffer := __NEW(FB_LogRecordQueue(maxSize:=THIS^.maxExportBatchSize));
IF THIS^._buffer = 0 THEN
	THIS^.sts := E_PointerFactoryStatus.OUT_OF_MEMORY;
	RETURN;
END_IF
THIS^._buffer^.maxSize := THIS^.maxExportBatchSize;

FOR _idx := 1 TO THIS^.maxExportBatchSize DO
	IF NOT THIS^._records^.pop(pValue:=_pRecord, failureReason=>_queueFailureReason) THEN EXIT; END_IF

	IF NOT THIS^._buffer^.push(pValue:=_pRecord, failureReason=>_queueFailureReason) THEN
		_pRecord := _pRecord^.delete();
		THIS^.sts := E_PointerFactoryStatus.OUT_OF_MEMORY;
		RETURN;
	END_IF

	IF THIS^._records^.count = 0 THEN EXIT; END_IF
END_FOR

buildBuffer := THIS^._buffer^.count > 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="pushToExporter" Id="{8f42a6d1-5b7e-4c93-a2d0-6c1e9b57f3a4}">
      <Declaration><![CDATA[(*
	Builds an arrival-order buffer when needed, then offers it to the exporter.
	Returns TRUE only when the exporter accepts ownership of that buffer.
*)
METHOD pushToExporter : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pushToExporter := FALSE;

IF THIS^.maxExportBatchSize = 0
	OR_ELSE NOT __ISVALIDREF(THIS^._exporter)
	OR_ELSE THIS^._exporter.isBusy() THEN
	RETURN;
END_IF

IF THIS^._buffer = 0 AND_THEN NOT THIS^.buildBuffer() THEN RETURN; END_IF
IF THIS^._buffer = 0 THEN RETURN; END_IF

// transfer ownership; a successful exporter accepts the pointer and clears _buffer
IF THIS^._buffer^.count = 0 THEN
	THIS^._buffer := THIS^._buffer^.delete();
	RETURN;
END_IF

THIS^._exporter.export(THIS^._buffer);
pushToExporter := THIS^._buffer = 0;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
