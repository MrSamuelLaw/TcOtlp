<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProcessor_Base" Id="{7f3a9c21-4b8e-4d19-9c47-2e8f5a6b0d31}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	Base class for all log record processors.
	Concrete processors extend this block and override onEmit.
	Processors are registered with an FB_LoggerProvider through its fluent
	registerLogRecordProcessor method, which must be called cyclically so the
	provider can prune registrations whose references have gone stale.
*)
FUNCTION_BLOCK ABSTRACT FB_LogRecordProcessor_Base IMPLEMENTS I_LogRecordProcessor
VAR
	_records: FB_LinkedList_LogRecord;
	_exporter: REFERENCE TO FB_LogRecordExporter_Base;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{8c4b2a10-5d6e-4f2a-8b3c-9d0e1f2a3b4c}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	exporter: REFERENCE TO FB_LogRecordExporter_Base;	// the exporter where the LogRecords are pushed.
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._exporter REF= exporter;]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d}">
      <Declaration><![CDATA[METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._records.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="onEmit" Id="{2b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d6e}">
      <Declaration><![CDATA[METHOD ABSTRACT onEmit
VAR_INPUT
	logRecord: REFERENCE TO FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
