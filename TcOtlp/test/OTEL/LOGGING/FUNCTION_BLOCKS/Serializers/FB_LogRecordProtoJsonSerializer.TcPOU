<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProtoJsonSerializer" Id="{9d5713d1-8fd3-47fe-b5ed-3ec522cca7f6}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordProtoJsonSerializer EXTENDS FB_BaseProtoJsonSerializer
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="serializeLogRecords" Id="{c8755357-2d5c-4040-a054-202bb0d2153c}">
      <Declaration><![CDATA[METHOD serializeLogRecords
VAR_IN_OUT
	v: SJsonValue;
	logRecords: FB_LinkedList_LogRecord;
END_VAR

VAR
	_idx: UDINT := 0;
	_buf: T_MaxString;
	_arr: SJsonValue;
	_obj: SJsonValue;
	_rec: POINTER TO FB_LogRecord;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_arr := THIS^.parser.AddArrayMember(v, 'logRecords', 0);
IF _arr = 0 THEN
	RETURN;
END_IF

// serialize the logs one by one
logRecords.reset();
FOR _idx := 0 TO GVL.MAX_LOOP_COUNT DO
	_rec := logRecords.next();
	IF _rec = 0 THEN
		EXIT;
	END_IF
	// create a json object and appent it to the array
	_obj := THIS^.parser.PushbackJsonValue(_arr, '{}');
	
	// serailize the required fields
	_buf := _rec^.severityText;  // properties require intermediate variables
	THIS^.parser.AddStringMember(_obj, 'severityText', _buf);
	THIS^.serializeFixed64Value(_obj, ADR('timeUnixNano'), _rec^.timestamp);
	
	// serialize the optional fields
	THIS^.serializeStringValue(_obj, ADR('eventName'),_rec^.eventName);
	THIS^.serializeTraceIdValue(_obj, _rec^.traceId);
	IF _rec^.flags <> 0 THEN THIS^.serializeFixed32Value(_obj, ADR('flags'), TO_UDINT(_rec^.flags^)); END_IF
	THIS^.serializeSpanIdValue(_obj, _rec^.spanId);
	THIS^.serializeAnyValue(_obj, ADR('body'), _rec^.body);
	THIS^.serializeKeyValues(_obj, ADR('attributes'), ADR(_rec^.attributes));
END_FOR
logRecords.reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeScopeLogs" Id="{3d36022d-3f4c-4a69-9fa9-1799ece683a0}">
      <Declaration><![CDATA[METHOD serializeScopeLogs
VAR_IN_OUT
	v: SJsonValue;
	instrumentationScope: FB_InstrumentationScope;
	logRecords: FB_LinkedList_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// add the instrumentation scope
THIS^._injectInstrumentationScope(v, instrumentationScope);

// serialize the log records associated with the scope
THIS^.serializeLogRecords(v, logRecords);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>