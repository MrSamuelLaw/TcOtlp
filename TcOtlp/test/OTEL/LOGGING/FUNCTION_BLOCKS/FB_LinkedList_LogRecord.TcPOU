<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LinkedList_LogRecord" Id="{9e1ecc03-058c-4b23-92d3-3bd422ae83cb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LinkedList_LogRecord
VAR
	maxRecordCount: UDINT := 2000;
END_VAR
VAR
	_head: POINTER TO ST_LinkedListNode;
	_tail: POINTER TO ST_LinkedListNode;
	_cursor: POINTER TO ST_LinkedListNode;
END_VAR
VAR_OUTPUT
	count: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="append" Id="{160c78e0-3b3f-49cd-8c42-eefe5336e9d8}">
      <Declaration><![CDATA[METHOD append : BOOL
VAR_IN_OUT
	pValue: POINTER TO FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[append := THIS^.insert(index:=THIS^.count, pValue:=pValue);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{6d9d65b6-2d68-47f0-b7cb-88e631d7acef}">
      <Declaration><![CDATA[METHOD FB_Exit : BOOL
VAR_INPUT
	bInCopyCode: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{fbd1c94b-c09e-4d95-a598-0cd5bb8a61f6}">
      <Declaration><![CDATA[METHOD free
VAR
	_idx: UDINT;
	_node: POINTER TO ST_LinkedListNode;
	_lr: POINTER TO FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR _idx := 0 TO GVL.MAX_LOOP_COUNT DO
	IF THIS^._head = 0 THEN
		EXIT;
	END_IF

	_node := THIS^._head;
	THIS^._head := _node^.nxt;
	IF _node^.val <> 0 THEN
		_lr := _node^.val;
		_node^.val := 0;
		_lr := _lr^.delete();
	END_IF
	__DELETE(_node);
END_FOR

THIS^._head := 0;
THIS^._tail := 0;
THIS^._cursor := 0;
THIS^.count := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="insert" Id="{bdb6bd6f-eaaf-40a8-9acd-12d538eab8de}">
      <Declaration><![CDATA[(*
	Inserts pValue so that it occupies position `index` (zero based).
	index = 0 inserts at the head, index = count appends at the tail.
	Fails when pValue is null, index > count, or the list is full.
*)
METHOD insert : BOOL
VAR_INPUT
	index: UDINT;
END_VAR
VAR_IN_OUT
	pValue: POINTER TO FB_LogRecord;
END_VAR
VAR
	_node: POINTER TO ST_LinkedListNode;
	_prev: POINTER TO ST_LinkedListNode;
	_idx: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[insert := FALSE;

IF pValue = 0 OR_ELSE index > THIS^.count OR_ELSE THIS^.count >= THIS^.maxRecordCount THEN
	RETURN;
END_IF

_node := __NEW(ST_LinkedListNode);
IF _node = 0 THEN
	RETURN;
END_IF

_node^.val := pValue;
_node^.nxt := 0;

IF index = 0 THEN
	// new head (also covers the empty list)
	_node^.nxt := THIS^._head;
	THIS^._head := _node;
	IF THIS^._tail = 0 THEN
		THIS^._tail := _node;
		THIS^._cursor := _node;
	END_IF
ELSIF index = THIS^.count THEN
	// append at the tail in O(1)
	THIS^._tail^.nxt := _node;
	THIS^._tail := _node;
ELSE
	// walk to the node currently before position `index` and splice in
	_prev := THIS^._head;
	FOR _idx := 2 TO index DO
		_prev := _prev^.nxt;
	END_FOR
	_node^.nxt := _prev^.nxt;
	_prev^.nxt := _node;
END_IF

THIS^.count := THIS^.count + 1;
insert := TRUE;
// Ownership transfers only after the value has been linked successfully.
pValue := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="next" Id="{720ec83f-b785-4449-92d1-d6ec1cfa78ab}">
      <Declaration><![CDATA[METHOD next : POINTER TO FB_LogRecord
]]></Declaration>
      <Implementation>
        <ST><![CDATA[next := 0;

IF THIS^._cursor <> 0 THEN
	next := THIS^._cursor^.val;
	THIS^._cursor := THIS^._cursor^.nxt;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="pop" Id="{81f42449-d168-4086-9f3b-beae690752ef}">
      <Declaration><![CDATA[METHOD pop : POINTER TO FB_LogRecord
VAR
	_node: POINTER TO ST_LinkedListNode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pop := 0;

IF THIS^._head = 0 THEN
	RETURN;
END_IF

_node := THIS^._head;
THIS^._head := _node^.nxt;
IF THIS^._cursor = _node THEN
	THIS^._cursor := THIS^._head;
END_IF
IF THIS^._head = 0 THEN
	THIS^._tail := 0;
END_IF

pop := _node^.val;
_node^.val := 0;
_node^.nxt := 0;
__DELETE(_node);
THIS^.count := THIS^.count - 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="reset" Id="{8e5c6da1-a3e7-4711-8032-291e4a16dc6e}">
      <Declaration><![CDATA[METHOD reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._cursor := THIS^._head;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
