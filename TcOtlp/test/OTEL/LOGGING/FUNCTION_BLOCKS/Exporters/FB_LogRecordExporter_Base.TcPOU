<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordExporter_Base" Id="{10005d20-6707-4af6-9c91-e8fb51819d17}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT FB_LogRecordExporter_Base
VAR
	_processor: PVOID;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="export" Id="{ae492816-f399-4168-9ef3-5fffa135683d}">
      <Declaration><![CDATA[METHOD ABSTRACT export: E_LogRecordExporterState
VAR_IN_OUT
	logRecords: FB_LinkedList_LogRecord;  // records to serialize
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="isBusy" Id="{c736d8fc-db46-4f7d-87a5-2570da83287a}">
      <Declaration><![CDATA[METHOD ABSTRACT isBusy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="register" Id="{849a708c-e03f-4172-8b99-37773ba60614}">
      <Declaration><![CDATA[METHOD register: BOOL;
VAR_INPUT
	processor: I_LogRecordProcessor;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._processor = 0 THEN
	THIS^._processor := processor.pSelf;
ELSIF THIS^._processor <> processor.pSelf THEN
	ADSLOGSTR(
		msgCtrlMask:=ADSLOG_MSGTYPE_ERROR,
		'Unable to register multiple processors with a single exporter',
		''
	);
END_IF
register := THIS^._processor = processor.pSelf;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>