<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordExporter_Console" Id="{d538f5ca-8c22-4ab0-a796-ad58fa044956}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordExporter_Console EXTENDS FB_LogRecordExporter_Base
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="export" Id="{235fc2e0-2811-42e4-bfd0-f35f1b145a8e}">
      <Declaration><![CDATA[METHOD export : E_PointerFactoryStatus
VAR_IN_OUT
	(* ownership transfers when set to 0*)
	pLogRecords	: POINTER TO FB_LinkedList_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.writeToConsole(pLogRecords);
// ownership transferred; release the batch after writing
IF pLogRecords <> 0 THEN
	pLogRecords := pLogRecords^.delete();
END_IF
export := E_PointerFactoryStatus.SUCCESS;]]></ST>
      </Implementation>
    </Method>
    <Method Name="isBusy" Id="{941c51ad-8a54-463a-9aa8-04504fc50b02}">
      <Declaration><![CDATA[METHOD isBusy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isBusy := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="writeToConsole" Id="{3aea6abb-ab87-43d2-85a8-96216ee4ee7a}">
      <Declaration><![CDATA[METHOD writeToConsole
VAR_INPUT
	pLogRecords: REFERENCE TO FB_LinkedList_LogRecord;
END_VAR
VAR
	idx: DINT;
	logRecord: POINTER TO FB_LogRecord;
	body: POINTER TO FB_String;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pLogRecords = 0 THEN
	RETURN;
END_IF

pLogRecords.reset();
FOR idx := 0 TO GVL.MAX_LOOP_COUNT DO
	logRecord := pLogRecords.next();
	IF logRecord = 0 THEN
		RETURN;
	END_IF
	IF logRecord^.body <> 0 AND_THEN logRecord^.body^.eType = E_ValueType.E_String THEN
		body := logRecord^.body;
		ADSLOGSTR(
			ADSLOG_MSGTYPE_ERROR,
			body^.pString^,
			''
		);
	END_IF
END_FOR

	]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
