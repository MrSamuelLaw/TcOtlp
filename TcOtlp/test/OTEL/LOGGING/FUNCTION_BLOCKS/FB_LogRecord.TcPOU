<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecord" Id="{cc455288-1c9b-49ff-9835-96f0e748c0de}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_LogRecord
VAR_INPUT
	// required values
	severityNumber: E_SeverityNumber;
	timestamp: 		ULINT;
	
	// optional values
	eventName: 	POINTER TO FB_String; 
	traceId: 	POINTER TO FB_TraceId;
	flags: 		POINTER TO E_LogRecordFlag;
	spanId: 	POINTER TO FB_SpanId;
	body: 		POINTER TO FB_AnyValue;
	droppedAttributesCount: UDINT;
END_VAR
VAR_OUTPUT
	resource: FB_Resource('');
	scope: FB_InstrumentationScope('', '', '');
	attributes: FB_Attributes(maxCount := GVL.DEFAULT_MAX_ATTRIBUTE_COUNT);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="cloneTo" Id="{4a867786-45e0-429a-8696-63d77c0ab19f}">
      <Declaration><![CDATA[METHOD cloneTo : BOOL
VAR_IN_OUT
	pDest: POINTER TO FB_LogRecord;
END_VAR
VAR_OUTPUT
	failureResult: E_LogRecordCloneFailureReason;
END_VAR
VAR
	_pClone: POINTER TO FB_LogRecord;
	_factoryFailureReason: E_ValueFactoryFailureReason;
	_attributesFailureReason: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[cloneTo := FALSE;
MEMSET(ADR(failureResult), 0, SIZEOF(failureResult));

IF pDest <> 0 THEN
	failureResult := E_LogRecordCloneFailureReason.DESTINATION_ALREADY_ASSIGNED;
	RETURN;
END_IF

_pClone := __NEW(FB_LogRecord(
	severityNumber:=THIS^.severityNumber,
	timestamp:=THIS^.timestamp
));
IF _pClone = 0 THEN
	failureResult := E_LogRecordCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

_pClone^.droppedAttributesCount := THIS^.droppedAttributesCount;

IF THIS^.eventName <> 0 THEN
	IF NOT ValueFactory.cloneString(
		pDest:=_pClone^.eventName,
		pSrc:=THIS^.eventName,
		failureReason=>_factoryFailureReason
	) THEN
		IF _factoryFailureReason = E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE THEN
			failureResult := E_LogRecordCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
		ELSE
			failureResult := E_LogRecordCloneFailureReason.EVENT_NAME_INVALID;
		END_IF
		_pClone := _pClone^.delete();
		RETURN;
	END_IF
END_IF

IF THIS^.traceId <> 0 THEN
	IF NOT ValueFactory.createTraceId(
		pDest:=_pClone^.traceId,
		pBytes:=ADR(THIS^.traceId^.bytes),
		nSize:=SIZEOF(THIS^.traceId^.bytes),
		failureReason=>_factoryFailureReason
	) THEN
		IF _factoryFailureReason = E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE THEN
			failureResult := E_LogRecordCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
		ELSE
			failureResult := E_LogRecordCloneFailureReason.TRACE_ID_INVALID;
		END_IF
		_pClone := _pClone^.delete();
		RETURN;
	END_IF
END_IF

IF THIS^.flags <> 0 THEN
	_pClone^.flags := __NEW(E_LogRecordFlag);
	IF _pClone^.flags = 0 THEN
		failureResult := E_LogRecordCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
		_pClone := _pClone^.delete();
		RETURN;
	END_IF
	_pClone^.flags^ := THIS^.flags^;
END_IF

IF THIS^.spanId <> 0 THEN
	IF NOT ValueFactory.createSpanId(
		pDest:=_pClone^.spanId,
		pBytes:=ADR(THIS^.spanId^.bytes),
		nSize:=SIZEOF(THIS^.spanId^.bytes),
		failureReason=>_factoryFailureReason
	) THEN
		IF _factoryFailureReason = E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE THEN
			failureResult := E_LogRecordCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
		ELSE
			failureResult := E_LogRecordCloneFailureReason.SPAN_ID_INVALID;
		END_IF
		_pClone := _pClone^.delete();
		RETURN;
	END_IF
END_IF

IF THIS^.body <> 0 THEN
	IF NOT ValueFactory.cloneAnyValue(
		pDest:=_pClone^.body,
		pSrc:=THIS^.body,
		failureReason=>_factoryFailureReason
	) THEN
		CASE _factoryFailureReason OF
			E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE:
				failureResult := E_LogRecordCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
			E_ValueFactoryFailureReason.UNSUPPORTED_VALUE_TYPE:
				failureResult := E_LogRecordCloneFailureReason.BODY_VALUE_TYPE_UNSUPPORTED;
		ELSE
			failureResult := E_LogRecordCloneFailureReason.BODY_VALUE_INVALID;
		END_CASE
		_pClone := _pClone^.delete();
		RETURN;
	END_IF
END_IF

IF NOT _pClone^.resource.copyFrom(src:=THIS^.resource, failureResult=>_attributesFailureReason) THEN
	IF _attributesFailureReason = E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		failureResult := E_LogRecordCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		failureResult := E_LogRecordCloneFailureReason.RESOURCE_COPY_FAILURE;
	END_IF
	_pClone := _pClone^.delete();
	RETURN;
END_IF

IF NOT _pClone^.scope.copyFrom(src:=THIS^.scope, failureResult=>_attributesFailureReason) THEN
	IF _attributesFailureReason = E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		failureResult := E_LogRecordCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		failureResult := E_LogRecordCloneFailureReason.SCOPE_COPY_FAILURE;
	END_IF
	_pClone := _pClone^.delete();
	RETURN;
END_IF

IF NOT _pClone^.attributes.copyFrom(
	src:=THIS^.attributes,
	failureReason=>_attributesFailureReason
	) THEN
	IF _attributesFailureReason = E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		failureResult := E_LogRecordCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		failureResult := E_LogRecordCloneFailureReason.ATTRIBUTE_COPY_FAILURE;
	END_IF
	_pClone := _pClone^.delete();
	RETURN;
END_IF

pDest := _pClone;
_pClone := 0;
cloneTo := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="delete" Id="{3cb201ad-0be2-4ce4-945f-e69f0fb01637}">
      <Declaration><![CDATA[METHOD delete: ULINT
VAR
	pSelf: POINTER TO FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pSelf := THIS;
__DELETE(pSelf);
delete := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{abe31f98-c1d5-4ef4-91e3-56059cf93707}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{8ccf0625-4a21-4c44-9811-2620e095d968}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	// required values
	severityNumber: E_SeverityNumber;
	timestamp: 		ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// required values
THIS^.severityNumber := severityNumber;
THIS^.timestamp := timestamp;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{541f418c-aa49-48c2-ae9d-c6d4738509a3}">
      <Declaration><![CDATA[METHOD free
VAR
	_pTraceFlags: POINTER TO UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.eventName <> 0 THEN THIS^.eventName := THIS^.eventName^.delete(); END_IF
IF THIS^.traceId <> 0 THEN THIS^.traceId := THIS^.traceId^.delete(); END_IF
IF THIS^.flags <> 0 THEN
	_pTraceFlags := THIS^.flags;
	__DELETE(_pTraceFlags);
	THIS^.flags := 0;
END_IF
IF THIS^.spanId <> 0 THEN THIS^.spanId := THIS^.spanId^.delete(); END_IF
IF THIS^.body <> 0 THEN THIS^.body := THIS^.body^.delete(); END_IF
THIS^.attributes.free();
THIS^.scope.free();
THIS^.resource.free();]]></ST>
      </Implementation>
    </Method>
    <Property Name="severityText" Id="{05c0c7ed-4dd1-46f2-b733-b4a1bc94ddcb}">
      <Declaration><![CDATA[PROPERTY severityText : STRING(30)]]></Declaration>
      <Get Name="Get" Id="{a6ea0245-a5cb-4691-8871-18ac3fb64ff9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[severityText := TO_STRING(THIS^.severityNumber);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
