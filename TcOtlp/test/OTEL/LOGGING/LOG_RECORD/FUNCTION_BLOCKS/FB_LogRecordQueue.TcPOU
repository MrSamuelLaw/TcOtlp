<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordQueue" Id="{9e1ecc03-058c-4b23-92d3-3bd422ae83cb}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	FIFO queue that owns every FB_LogRecord pointer it contains. A maxSize of
	zero is unbounded; otherwise push drops the oldest owned records when the
	bound is reached. pop transfers ownership back to the caller. transferTo
	moves allocated nodes between queue owners without copying records.
*)
FUNCTION_BLOCK FB_LogRecordQueue
VAR
	_head: POINTER TO ST_LinkedListNode;
	_tail: POINTER TO ST_LinkedListNode;
	_cursor: POINTER TO ST_LinkedListNode;
END_VAR
VAR_OUTPUT
	count: UDINT;
	maxCount: UDINT;
	droppedCount: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_Exit" Id="{6d9d65b6-2d68-47f0-b7cb-88e631d7acef}">
      <Declaration><![CDATA[METHOD FB_Exit : BOOL
VAR_INPUT
	bInCopyCode: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{c957bb4c-b6fd-49dc-a4b2-5cb85e435a28}">
      <Declaration><![CDATA[METHOD FB_Init : BOOL
VAR_INPUT
	bInitRetains: BOOL;
	bInCopyCode: BOOL;
	maxCount: UDINT := 0;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.maxCount := maxCount;]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{fbd1c94b-c09e-4d95-a598-0cd5bb8a61f6}">
      <Declaration><![CDATA[METHOD free
VAR
	_idx: UDINT;
	_node: POINTER TO ST_LinkedListNode;
	_record: POINTER TO FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR _idx := 0 TO TcOtlp_GVL.MAX_LOOP_COUNT DO
	IF THIS^._head = 0 THEN
		EXIT;
	END_IF

	_node := THIS^._head;
	THIS^._head := _node^.nxt;
	IF _node^.val <> 0 THEN
		_record := _node^.val;
		_node^.val := 0;
		_record := _record^.delete();
	END_IF
	__DELETE(_node);
END_FOR

THIS^._head := 0;
THIS^._tail := 0;
THIS^._cursor := 0;
THIS^.count := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="next" Id="{720ec83f-b785-4449-92d1-d6ec1cfa78ab}">
      <Declaration><![CDATA[METHOD next : POINTER TO FB_LogRecord
]]></Declaration>
      <Implementation>
        <ST><![CDATA[next := 0;

IF THIS^._cursor <> 0 THEN
	next := THIS^._cursor^.val;
	THIS^._cursor := THIS^._cursor^.nxt;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="pop" Id="{81f42449-d168-4086-9f3b-beae690752ef}">
      <Declaration><![CDATA[METHOD pop : BOOL
VAR_IN_OUT
	pValue: POINTER TO FB_LogRecord;
END_VAR
VAR_OUTPUT
	failureReason: E_LogRecordQueueFailureReason;
END_VAR
VAR
	_node: POINTER TO ST_LinkedListNode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pop := FALSE;
failureReason := E_LogRecordQueueFailureReason.NA;

IF pValue <> 0 THEN
	failureReason := E_LogRecordQueueFailureReason.DESTINATION_ALREADY_ASSIGNED;
	RETURN;
END_IF
IF THIS^._head = 0 THEN
	failureReason := E_LogRecordQueueFailureReason.QUEUE_EMPTY;
	RETURN;
END_IF

_node := THIS^._head;
THIS^._head := _node^.nxt;
IF THIS^._cursor = _node THEN
	THIS^._cursor := THIS^._head;
END_IF
IF THIS^._head = 0 THEN
	THIS^._tail := 0;
END_IF

pValue := _node^.val;
_node^.val := 0;
_node^.nxt := 0;
__DELETE(_node);
THIS^.count := THIS^.count - 1;
pop := failureReason = E_LogRecordQueueFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="push" Id="{160c78e0-3b3f-49cd-8c42-eefe5336e9d8}">
      <Declaration><![CDATA[METHOD push : BOOL
VAR_IN_OUT
	pValue: POINTER TO FB_LogRecord;
END_VAR
VAR_OUTPUT
	failureReason: E_LogRecordQueueFailureReason;
END_VAR
VAR
	_node: POINTER TO ST_LinkedListNode;
	_droppedRecord: POINTER TO FB_LogRecord;
	_popFailureReason: E_LogRecordQueueFailureReason;
	_idx: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[push := FALSE;
failureReason := E_LogRecordQueueFailureReason.NA;

IF pValue = 0 THEN
	failureReason := E_LogRecordQueueFailureReason.RECORD_POINTER_NULL;
	RETURN;
END_IF

// Allocate before evicting so an allocation failure leaves the queue unchanged.
_node := __NEW(ST_LinkedListNode);
IF _node = 0 THEN
	failureReason := E_LogRecordQueueFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

// maxSize is writable, so also restore the bound after a runtime reduction.
IF THIS^.maxCount > 0 THEN
	FOR _idx := 0 TO TcOtlp_GVL.MAX_LOOP_COUNT DO
		IF THIS^.count < THIS^.maxCount THEN
			EXIT;
		END_IF
		IF NOT THIS^.pop(pValue:=_droppedRecord, failureReason=>_popFailureReason) THEN
			__DELETE(_node);
			failureReason := _popFailureReason;
			RETURN;
		END_IF
		_droppedRecord := _droppedRecord^.delete();
		THIS^.droppedCount := THIS^.droppedCount + 1;
	END_FOR
	IF THIS^.count >= THIS^.maxCount THEN
		__DELETE(_node);
		failureReason := E_LogRecordQueueFailureReason.MAX_SIZE_ENFORCEMENT_FAILURE;
		RETURN;
	END_IF
END_IF

_node^.val := pValue;
_node^.nxt := 0;
IF THIS^._tail = 0 THEN
	THIS^._head := _node;
	THIS^._cursor := _node;
ELSE
	THIS^._tail^.nxt := _node;
END_IF
THIS^._tail := _node;
THIS^.count := THIS^.count + 1;
pValue := 0;
push := failureReason = E_LogRecordQueueFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="reset" Id="{8e5c6da1-a3e7-4711-8032-291e4a16dc6e}">
      <Declaration><![CDATA[METHOD reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._cursor := THIS^._head;]]></ST>
      </Implementation>
    </Method>
    <Method Name="rotate" Id="{38f6dc88-7df0-47e8-9ca7-d6d6b143b68e}">
      <Declaration><![CDATA[(* Moves the head node to the tail without changing record ownership. *)
METHOD rotate : BOOL
VAR_OUTPUT
	failureReason: E_LogRecordQueueFailureReason;
END_VAR
VAR
	_node: POINTER TO ST_LinkedListNode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[rotate := FALSE;
failureReason := E_LogRecordQueueFailureReason.NA;

IF THIS^._head = 0 THEN
	failureReason := E_LogRecordQueueFailureReason.QUEUE_EMPTY;
	RETURN;
END_IF

IF THIS^._head <> THIS^._tail THEN
	_node := THIS^._head;
	THIS^._head := _node^.nxt;
	_node^.nxt := 0;
	THIS^._tail^.nxt := _node;
	THIS^._tail := _node;
END_IF

THIS^._cursor := THIS^._head;
rotate := failureReason = E_LogRecordQueueFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="transferTo" Id="{e7eb4308-b34a-4dc8-852c-97a5624b88e2}">
      <Declaration><![CDATA[(*
	Transfers the allocated nodes and owned records without copying them.
	The destination must be a different, empty queue. It receives up to count
	of the oldest records, also respecting a nonzero destination maxSize.
*)
METHOD transferTo : BOOL
VAR_IN_OUT
	destination: FB_LogRecordQueue;
END_VAR
VAR_INPUT
	count: UDINT;
END_VAR
VAR_OUTPUT
	failureReason: E_LogRecordQueueFailureReason;
END_VAR
VAR
	_transferCount: UDINT;
	_idx: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[transferTo := FALSE;
failureReason := E_LogRecordQueueFailureReason.NA;

IF ADR(destination) = THIS THEN
	failureReason := E_LogRecordQueueFailureReason.SELF_TRANSFER_NOT_ALLOWED;
	RETURN;
END_IF
IF destination.count <> 0 OR_ELSE destination._head <> 0 OR_ELSE destination._tail <> 0 THEN
	failureReason := E_LogRecordQueueFailureReason.DESTINATION_NOT_EMPTY;
	RETURN;
END_IF

_transferCount := count;
IF _transferCount > THIS^.count THEN
	_transferCount := THIS^.count;
END_IF
IF destination.maxCount > 0 AND_THEN _transferCount > destination.maxCount THEN
	_transferCount := destination.maxCount;
END_IF
IF _transferCount = 0 THEN
	transferTo := failureReason = E_LogRecordQueueFailureReason.NA;
	RETURN;
END_IF

destination._head := THIS^._head;
destination._tail := destination._head;
FOR _idx := 1 TO _transferCount - 1 DO
	destination._tail := destination._tail^.nxt;
END_FOR

THIS^._head := destination._tail^.nxt;
destination._tail^.nxt := 0;
destination._cursor := destination._head;
destination.count := _transferCount;

THIS^.count := THIS^.count - _transferCount;
THIS^._cursor := THIS^._head;
IF THIS^._head = 0 THEN
	THIS^._tail := 0;
END_IF
transferTo := failureReason = E_LogRecordQueueFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>