<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_LogRecordCloneFailureReason" Id="{0ab31e77-6872-406b-9b51-2384e74d75e5}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_LogRecordCloneFailureReason :
(
	NA := 0,  // No failure occurred.
	DESTINATION_ALREADY_ASSIGNED := 1,  // The clone destination pointer is already assigned.
	EVENT_NAME_INVALID,  // The source event name could not be cloned.
	TRACE_ID_INVALID,  // The source Trace ID could not be cloned.
	SPAN_ID_INVALID,  // The source Span ID could not be cloned.
	BODY_VALUE_INVALID,  // The source body could not be cloned.
	BODY_VALUE_TYPE_UNSUPPORTED,  // The source body contains an unsupported value type.
	RESOURCE_COPY_FAILURE,  // The resource snapshot could not be copied.
	SCOPE_COPY_FAILURE,  // The instrumentation-scope snapshot could not be copied.
	ATTRIBUTE_COPY_FAILURE,  // The record attributes could not be copied.
	MEMORY_ALLOCATION_FAILURE  // Dynamic memory allocation failed.
) UDINT;
END_TYPE
]]></Declaration>
