<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProtoJsonSerializer" Id="{9d5713d1-8fd3-47fe-b5ed-3ec522cca7f6}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordProtoJsonSerializer EXTENDS FB_BaseProtoJsonSerializer
VAR
	_logRecords: FB_LogRecordQueue(maxSize:=0);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="serializeLogRecord" Id="{c41b895d-a15a-49cc-8670-1fbdb0053b6e}">
      <Declaration><![CDATA[METHOD serializeLogRecord : BOOL
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pLogRecord: POINTER TO FB_LogRecord;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_buf: T_MaxString;
	_obj: SJsonValue;
	_member: SJsonValue;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[serializeLogRecord := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF
IF pLogRecord = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_POINTER_NULL;
	RETURN;
END_IF

_obj := THIS^.parser.PushbackJsonValue(v, '{}');
IF _obj = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

_buf := pLogRecord^.severityText;
_member := THIS^.parser.AddUintMember(_obj, 'severityNumber', TO_UDINT(pLogRecord^.severityNumber));
IF _member = 0 THEN failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE; RETURN; END_IF
_member := THIS^.parser.AddStringMember(_obj, 'severityText', _buf);
IF _member = 0 THEN failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE; RETURN; END_IF
IF NOT THIS^.serializeUint64Value(_obj, ADR('timeUnixNano'), pLogRecord^.timestamp, failureReason=>failureReason) THEN RETURN; END_IF

IF pLogRecord^.eventName <> 0 AND_THEN NOT THIS^.serializeStringValue(_obj, ADR('eventName'), pLogRecord^.eventName, failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.traceId <> 0 AND_THEN NOT THIS^.serializeTraceIdValue(_obj, pLogRecord^.traceId, failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.flags <> 0 AND_THEN NOT THIS^.serializeUint32Value(_obj, ADR('flags'), TO_UDINT(pLogRecord^.flags^), failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.spanId <> 0 AND_THEN NOT THIS^.serializeSpanIdValue(_obj, pLogRecord^.spanId, failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.body <> 0 AND_THEN NOT THIS^.serializeAnyValue(_obj, ADR('body'), pLogRecord^.body, failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.attributes.count > 0 AND_THEN NOT THIS^.serializeKeyValues(_obj, ADR('attributes'), ADR(pLogRecord^.attributes), failureReason=>failureReason) THEN RETURN; END_IF
IF pLogRecord^.droppedAttributesCount > 0 AND_THEN NOT THIS^.serializeUint32Value(
	_obj,
	ADR('droppedAttributesCount'),
	pLogRecord^.droppedAttributesCount,
	failureReason=>failureReason
) THEN
	RETURN;
END_IF
serializeLogRecord := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeLogsData" Id="{e949baee-9209-4a36-8a48-4eaffb67bbe1}">
      <Declaration><![CDATA[(*
	Transfers ownership of all supplied records into the serializer. Records moved into
	the serializer are released on both success and failure.
*)
METHOD serializeLogsData : BOOL
VAR_IN_OUT
	logRecords: FB_LogRecordQueue;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_groupIdx: UDINT;
	_scanIdx: UDINT;
	_ownedRecordCount: UDINT;
	_recordsToScan: UDINT;
	_pOwnedRecord: POINTER TO FB_LogRecord;
	_pHeadRecord: POINTER TO FB_LogRecord;
	_resourceId: UDINT;
	_scopeName: T_MaxString;
	_hasResource: BOOL;
	_resourceLogs: SJsonValue;
	_resourceObj: SJsonValue;
	_scopeLogs: SJsonValue;
	_scopeObj: SJsonValue;
	_serializedRecords: SJsonValue;
	_member: SJsonValue;
	_queueFailureReason: E_LogRecordQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[serializeLogsData := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;

THIS^._logRecords.free();
IF NOT logRecords.transferTo(
	destination:=THIS^._logRecords,
	count:=logRecords.size,
	failureReason=>_queueFailureReason
) THEN
	failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_TRANSFER_FAILURE;
	RETURN;
END_IF

_ownedRecordCount := THIS^._logRecords.size;
IF _ownedRecordCount > GVL.MAX_LOOP_COUNT THEN
	THIS^._logRecords.free();
	failureReason := E_ProtoJsonSerializerFailureReason.LOOP_LIMIT_EXCEEDED;
	RETURN;
END_IF

THIS^.jsonValue := THIS^.parser.NewDocument();
IF THIS^.jsonValue = 0 THEN
	THIS^._logRecords.free();
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF
THIS^.jsonValue := THIS^.parser.SetObject(THIS^.jsonValue);
IF THIS^.jsonValue = 0 THEN
	THIS^._logRecords.free();
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF
_resourceLogs := THIS^.parser.AddArrayMember(THIS^.jsonValue, 'resourceLogs', 0);
IF _resourceLogs = 0 THEN
	THIS^._logRecords.free();
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

_hasResource := FALSE;
_pOwnedRecord := 0;
IF THIS^._logRecords.size > 0 AND_THEN NOT THIS^._logRecords.pop(
	pValue:=_pOwnedRecord,
	failureReason=>_queueFailureReason
) THEN
	THIS^._logRecords.free();
	failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_POP_FAILURE;
	RETURN;
END_IF
IF _ownedRecordCount > 0 AND_THEN _pOwnedRecord = 0 THEN
	THIS^._logRecords.free();
	failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
	RETURN;
END_IF
FOR _groupIdx := 1 TO _ownedRecordCount DO
	IF _pOwnedRecord = 0 THEN EXIT; END_IF

	IF NOT _hasResource OR_ELSE _pOwnedRecord^.resource.id <> _resourceId THEN
		_resourceId := _pOwnedRecord^.resource.id;
		_resourceObj := THIS^.parser.PushbackJsonValue(_resourceLogs, '{}');
		IF _resourceObj = 0 THEN
			_pOwnedRecord := _pOwnedRecord^.delete();
			THIS^._logRecords.free();
			failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
			RETURN;
		END_IF
		IF NOT THIS^._injectResource(_resourceObj, _pOwnedRecord^.resource, failureReason=>failureReason) THEN
			_pOwnedRecord := _pOwnedRecord^.delete();
			THIS^._logRecords.free();
			RETURN;
		END_IF
		IF _pOwnedRecord^.resource.schemaUrl <> '' THEN
			_member := THIS^.parser.AddStringMember(_resourceObj, 'schemaUrl', _pOwnedRecord^.resource.schemaUrl);
			IF _member = 0 THEN
				_pOwnedRecord := _pOwnedRecord^.delete();
				THIS^._logRecords.free();
				failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
				RETURN;
			END_IF
		END_IF
		_scopeLogs := THIS^.parser.AddArrayMember(_resourceObj, 'scopeLogs', 0);
		IF _scopeLogs = 0 THEN
			_pOwnedRecord := _pOwnedRecord^.delete();
			THIS^._logRecords.free();
			failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
			RETURN;
		END_IF
		_hasResource := TRUE;
	END_IF

	_scopeName := _pOwnedRecord^.scope.name;
	_scopeObj := THIS^.parser.PushbackJsonValue(_scopeLogs, '{}');
	IF _scopeObj = 0 THEN
		_pOwnedRecord := _pOwnedRecord^.delete();
		THIS^._logRecords.free();
		failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
		RETURN;
	END_IF
	IF NOT THIS^._injectInstrumentationScope(_scopeObj, _pOwnedRecord^.scope, failureReason=>failureReason) THEN
		_pOwnedRecord := _pOwnedRecord^.delete();
		THIS^._logRecords.free();
		RETURN;
	END_IF
	IF _pOwnedRecord^.scope.schemaUrl <> '' THEN
		_member := THIS^.parser.AddStringMember(_scopeObj, 'schemaUrl', _pOwnedRecord^.scope.schemaUrl);
		IF _member = 0 THEN
			_pOwnedRecord := _pOwnedRecord^.delete();
			THIS^._logRecords.free();
			failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
			RETURN;
		END_IF
	END_IF

	_serializedRecords := THIS^.parser.AddArrayMember(_scopeObj, 'logRecords', 0);
	IF _serializedRecords = 0 THEN
		_pOwnedRecord := _pOwnedRecord^.delete();
		THIS^._logRecords.free();
		failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
		RETURN;
	END_IF
	IF NOT THIS^.serializeLogRecord(_serializedRecords, _pOwnedRecord, failureReason=>failureReason) THEN
		_pOwnedRecord := _pOwnedRecord^.delete();
		THIS^._logRecords.free();
		RETURN;
	END_IF
	_pOwnedRecord := _pOwnedRecord^.delete();

	// Consume every remaining record in this resource/scope group. Rotating
	// nonmatches preserves their arrival order for the next group.
	_recordsToScan := THIS^._logRecords.size;
	FOR _scanIdx := 1 TO _recordsToScan DO
		THIS^._logRecords.reset();
		_pHeadRecord := THIS^._logRecords.next();
		IF _pHeadRecord = 0 THEN
			THIS^._logRecords.free();
			failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
			RETURN;
		END_IF

		IF _pHeadRecord^.resource.id = _resourceId AND_THEN _pHeadRecord^.scope.name = _scopeName THEN
			_pOwnedRecord := 0;
			IF NOT THIS^._logRecords.pop(pValue:=_pOwnedRecord, failureReason=>_queueFailureReason) THEN
				THIS^._logRecords.free();
				failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_POP_FAILURE;
				RETURN;
			END_IF
			IF _pOwnedRecord = 0 THEN
				THIS^._logRecords.free();
				failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
				RETURN;
			END_IF
			IF NOT THIS^.serializeLogRecord(_serializedRecords, _pOwnedRecord, failureReason=>failureReason) THEN
				_pOwnedRecord := _pOwnedRecord^.delete();
				THIS^._logRecords.free();
				RETURN;
			END_IF
			_pOwnedRecord := _pOwnedRecord^.delete();
		ELSE
			IF NOT THIS^._logRecords.rotate(failureReason=>_queueFailureReason) THEN
				THIS^._logRecords.free();
				failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_ROTATE_FAILURE;
				RETURN;
			END_IF
		END_IF
	END_FOR

	// Prefer the next scope for this resource while preserving the order of
	// every record left in the queue.
	_pOwnedRecord := 0;
	_recordsToScan := THIS^._logRecords.size;
	FOR _scanIdx := 1 TO _recordsToScan DO
		THIS^._logRecords.reset();
		_pHeadRecord := THIS^._logRecords.next();
		IF _pHeadRecord = 0 THEN
			THIS^._logRecords.free();
			failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
			RETURN;
		END_IF
		IF _pOwnedRecord = 0 AND_THEN _pHeadRecord^.resource.id = _resourceId THEN
			IF NOT THIS^._logRecords.pop(pValue:=_pOwnedRecord, failureReason=>_queueFailureReason) THEN
				THIS^._logRecords.free();
				failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_POP_FAILURE;
				RETURN;
			END_IF
			IF _pOwnedRecord = 0 THEN
				THIS^._logRecords.free();
				failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
				RETURN;
			END_IF
		ELSIF NOT THIS^._logRecords.rotate(failureReason=>_queueFailureReason) THEN
			THIS^._logRecords.free();
			failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_ROTATE_FAILURE;
			RETURN;
		END_IF
	END_FOR

	IF _pOwnedRecord = 0 AND_THEN THIS^._logRecords.size > 0 AND_THEN NOT THIS^._logRecords.pop(
		pValue:=_pOwnedRecord,
		failureReason=>_queueFailureReason
	) THEN
		THIS^._logRecords.free();
		failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_POP_FAILURE;
		RETURN;
	END_IF
	IF _pOwnedRecord = 0 AND_THEN THIS^._logRecords.size < _recordsToScan THEN
		THIS^._logRecords.free();
		failureReason := E_ProtoJsonSerializerFailureReason.LOG_RECORD_COLLECTION_INCONSISTENT;
		RETURN;
	END_IF
END_FOR

IF THIS^._logRecords.size > 0 THEN
	THIS^._logRecords.free();
	failureReason := E_ProtoJsonSerializerFailureReason.LOOP_LIMIT_EXCEEDED;
	RETURN;
END_IF
THIS^._logRecords.free();
serializeLogsData := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
