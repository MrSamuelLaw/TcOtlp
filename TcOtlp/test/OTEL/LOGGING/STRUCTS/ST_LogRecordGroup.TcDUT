<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_LogRecordGroup" Id="{2317d6b0-00b6-4eff-9467-a4cab11cb7a3}">
    <Declaration><![CDATA[(*
	Marker for one (resource, scope) group inside an FB_LogRecordQueue.
	Groups form a singly linked list sorted by (resourceId, scopeName).
	insertIndex is the list position just after the group's last record,
	i.e. where the group's next record gets inserted.
*)
{attribute 'enable_dynamic_creation'}
TYPE ST_LogRecordGroup :
STRUCT
	resourceId: UDINT;
	scopeName: T_MaxString;
	insertIndex: UDINT;
	nxt: POINTER TO ST_LogRecordGroup;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
