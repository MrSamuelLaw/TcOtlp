<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LoggerProvider" Id="{16983c20-c68e-4842-a5af-294cf7d1f97c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LoggerProvider
VAR
	_resource: REFERENCE TO FB_Resource; // borrowed; the declaring scope owns its lifetime
	_records: FB_LogRecordQueue(TcOtlp_GVL.MAX_LOG_RECORDS_PER_SCAN);
	_head: POINTER TO ST_LinkedListNode;
	_failureReason: E_LoggerProviderFailureReason;
END_VAR
VAR_OUTPUT
	stagedProcessorCount: UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_freeProcessors" Id="{a048b19e-db25-489f-881c-c7f13a9d0e5b}">
      <Declaration><![CDATA[METHOD _freeProcessors
VAR
	_idx: UDINT;
	_node: POINTER TO ST_LinkedListNode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR _idx := 0 TO TcOtlp_GVL.MAX_LOOP_COUNT DO
	IF THIS^._head = 0 THEN
		EXIT;
	END_IF
	_node := THIS^._head^.nxt;
	__DELETE(THIS^._head);
	THIS^._head := _node;
END_FOR
THIS^.stagedProcessorCount := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{a3de6da8-4caa-45e5-82ac-23ff1b828ee2}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^._freeProcessors();
	THIS^._records.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{4bf253fc-a990-4445-afd2-9dddc5216dd7}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	resource: REFERENCE TO FB_Resource;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._resource REF= resource;]]></ST>
      </Implementation>
    </Method>
    <Method Name="onEmit" Id="{5fe9168a-4c34-4372-8380-b7c320c1a06c}">
      <Declaration><![CDATA[METHOD onEmit : BOOL
VAR_IN_OUT
	record: POINTER TO FB_LogRecord;
END_VAR
VAR
	_pushFailureReason: E_LogRecordQueueFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[onEmit := FALSE;

IF record = 0 THEN
	RETURN;
END_IF

IF NOT THIS^._records.push(pValue:=record, failureReason=>_pushFailureReason) THEN
	RETURN;
END_IF

onEmit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="resource" Id="{5c5a395f-26fb-4f37-9459-e8fe5661bff3}">
      <Declaration><![CDATA[PROPERTY resource : REFERENCE TO FB_Resource]]></Declaration>
      <Get Name="Get" Id="{e4e2a932-61cb-47f3-8bd9-6fc7f29c0975}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[resource REF= THIS^._resource;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="stageProcessor" Id="{d8725506-cb90-459a-9b97-91a0461551c9}">
      <Declaration><![CDATA[METHOD stageProcessor : REFERENCE TO FB_LoggerProvider
VAR_INPUT
	processor: REFERENCE TO FB_LogRecordProcessor_Base;
END_VAR
VAR
	_idx: UDINT;
	_node: POINTER TO ST_LinkedListNode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stageProcessor REF= THIS^;

// special case if no processors have been registered
IF THIS^._head = 0 THEN
	THIS^._head := __NEW(ST_LinkedListNode);
	IF THIS^._head = 0 THEN
		THIS^._failureReason := E_LoggerProviderFailureReason.STAGE_PROCESSOR_FAILURE;
		RETURN;
	END_IF
	THIS^._head^.val := processor.pSelf;
	THIS^.stagedProcessorCount := THIS^.stagedProcessorCount + 1;
// generic case if at least on processor has been registerd
ELSE
	_node := THIS^._head;
	FOR _idx := 0 TO TcOtlp_GVL.MAX_LOOP_COUNT DO
		IF _node^.val = processor.pSelf THEN
			// silently do nothing if processor already added for this tick
			RETURN;
		ELSIF _node^.nxt = 0 THEN
			_node^.nxt := __NEW(ST_LinkedListNode);
			IF _node^.nxt = 0 THEN
				THIS^._failureReason := E_LoggerProviderFailureReason.STAGE_PROCESSOR_FAILURE;
				RETURN;
			END_IF
			_node^.nxt^.val := processor.pSelf;
			THIS^.stagedProcessorCount := THIS^.stagedProcessorCount + 1;
			RETURN;
		END_IF
		_node := _node^.nxt;
	END_FOR
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="tick" Id="{6ac1f588-839d-47df-a7be-69b648f9145a}">
      <Declaration><![CDATA[METHOD tick : BOOL
VAR_OUTPUT
	failureReason: E_LoggerProviderFailureReason;
END_VAR
VAR
	_i: UDINT;
	_j: UDINT;
	_ownedRecordCount: UDINT;
	_node: POINTER TO ST_LinkedListNode;
	_processor: POINTER TO FB_LogRecordProcessor_Base;
	_record: POINTER TO FB_LogRecord;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[tick := FALSE;
failureReason := THIS^._failureReason;

// short circuit if fluent calls to add processors failed
IF failureReason <> E_LoggerProviderFailureReason.NA THEN
	RETURN;
END_IF

// if no processors added skip loop iteration and just free the queue
IF THIS^._head = 0 THEN
	THIS^._records.free();
	tick := TRUE;
	RETURN;
END_IF

// loop over each item and call each processor for each record
_ownedRecordCount := THIS^._records.count;
FOR _i := 1 TO _ownedRecordCount DO
	IF NOT THIS^._records.pop(_record) THEN
		failureReason := E_LoggerProviderFailureReason.QUEUE_POP_FAILURE;
		JMP _endLabel;
	END_IF
	// call on emit for each record
	_node := THIS^._head;
	FOR _j := 1 TO THIS^.stagedProcessorCount DO
		IF _node = 0 THEN
			failureReason := E_LoggerProviderFailureReason.UNEXPECTED_NULL_LINKED_LIST_NODE;
			JMP _endLabel;
		END_IF
		_processor := _node^.val;
		IF _processor = 0 THEN
			failureReason := E_LoggerProviderFailureReason.UNEXPECTED_NULL_PROCESSOR_POINTER;
			JMP _endLabel;
		END_IF
		_processor^.onEmit(_record^);
		_node := _node^.nxt;
	END_FOR
	_record := _record^.delete();
END_FOR

// tick each processor
_node := THIS^._head;
FOR _j := 1 TO THIS^.stagedProcessorCount DO
	_processor := _node^.val;
	IF _processor = 0 THEN
		failureReason := E_LoggerProviderFailureReason.UNEXPECTED_NULL_PROCESSOR_POINTER;
		JMP _endLabel;
	END_IF
	_processor^.tick();
	_node := _node^.nxt;
	IF _node = 0 THEN
		failureReason := E_LoggerProviderFailureReason.UNEXPECTED_NULL_LINKED_LIST_NODE;
		JMP _endLabel;
	END_IF
END_FOR

// clean up and return
_endLabel:
THIS^._records.free();
THIS^._freeProcessors();
IF _record <> 0 THEN _record := _record^.delete(); END_IF
tick := failureReason = E_LoggerProviderFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>