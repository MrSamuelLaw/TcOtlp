<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Logger" Id="{730b727f-4674-448e-a99c-ca00a77667b8}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_Logger
VAR_OUTPUT
	pLogRecord: POINTER TO FB_LogRecord;
END_VAR
VAR
	_scope: REFERENCE TO FB_InstrumentationScope;
	_provider: REFERENCE TO FB_LoggerProvider;
	_failed: BOOL;
	_failureReason: E_LoggerFailureReason;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_createLogRecord" Id="{4207d434-2c98-44c0-9f1b-0b70f89803a3}">
      <Declaration><![CDATA[METHOD _createLogRecord : BOOL
VAR_IN_OUT
	pDest: POINTER TO FB_LogRecord;
END_VAR
VAR_INPUT
	severityNumber: E_SeverityNumber;
	timestamp: ULINT;
END_VAR
VAR_OUTPUT
	failureReason: E_LoggerFailureReason;
END_VAR
VAR
	_logRecord: POINTER TO FB_LogRecord;
	_attributesFailureResult: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_createLogRecord := FALSE;
failureReason := E_LoggerFailureReason.NA;

IF pDest <> 0 THEN
	failureReason := E_LoggerFailureReason.LOG_RECORD_ALREADY_STARTED;
	RETURN;
END_IF

_logRecord := __NEW(FB_LogRecord(
	severityNumber:=severityNumber,
	timestamp:=timestamp
));

IF _logRecord = 0 THEN
	failureReason := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

IF NOT _logRecord^.resource.copyFrom(src:=THIS^.resource, failureResult=>_attributesFailureResult) THEN
	IF _attributesFailureResult = E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		failureReason := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		failureReason := E_LoggerFailureReason.SNAPSHOT_COPY_FAILURE;
	END_IF
	_logRecord^.delete(pSelf:=_logRecord);
	RETURN;
END_IF

IF NOT _logRecord^.scope.copyFrom(src:=THIS^.scope, failureResult=>_attributesFailureResult) THEN
	IF _attributesFailureResult = E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		failureReason := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		failureReason := E_LoggerFailureReason.SNAPSHOT_COPY_FAILURE;
	END_IF
	_logRecord^.delete(pSelf:=_logRecord);
	RETURN;
END_IF

pDest := _logRecord;
_logRecord := 0;
_createLogRecord := failureReason = E_LoggerFailureReason.NA;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_shouldReturnEarly" Id="{dd5ad78b-282f-4ecb-a14b-0db8162267f3}">
      <Declaration><![CDATA[METHOD _shouldReturnEarly : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_shouldReturnEarly := TRUE;

// Preserve the first failure in the active fluent chain.
IF THIS^._failed THEN
	RETURN;
END_IF

// fail early if the log record hasn't been built
IF THIS^.pLogRecord = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_LoggerFailureReason.LOG_RECORD_NOT_STARTED;
	RETURN;
END_IF

_shouldReturnEarly := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="emit" Id="{9d921a05-0a1a-4507-b871-f56b935dc996}">
      <Declaration><![CDATA[(*
	Function emits a log record by pushing it to the owning provider's queue.
	Each log record owns a snapshot of its instrumentation scope and resource, so processors
	may retain the record after its logger or provider has been destroyed.
*)
METHOD emit: BOOL
VAR_OUTPUT
	failureResult: E_LoggerFailureReason;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[emit := FALSE;
failureResult := E_LoggerFailureReason.NA;

// Preserve the first fluent method failure while releasing the incomplete record.
IF THIS^._failed THEN
	IF THIS^.pLogRecord <> 0 THEN THIS^.pLogRecord^.delete(pSelf:=THIS^.pLogRecord); END_IF
	failureResult := THIS^._failureReason;
	RETURN;
END_IF

IF THIS^.pLogRecord = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_LoggerFailureReason.LOG_RECORD_NOT_STARTED;
	failureResult := THIS^._failureReason;
	RETURN;
END_IF

// Push the record to the provider's queue for cyclical processing.
IF NOT THIS^._provider.onEmit(THIS^.pLogRecord) THEN
	THIS^.pLogRecord^.delete(pSelf:=THIS^.pLogRecord);
	THIS^._failed := TRUE;
	THIS^._failureReason := E_LoggerFailureReason.TRANSFER_TO_PROVIDER_FAILURE;
	failureResult := THIS^._failureReason;
	RETURN;
END_IF

emit := THIS^._failureReason = E_LoggerFailureReason.NA;
THIS^._failed := FALSE;
THIS^._failureReason := E_LoggerFailureReason.NA;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{d1c987c0-02e1-4df2-8722-fb82546f68b2}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// during an online change the copied instance keeps pLogRecord, so the record must survive
IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{8c3c5b34-9fb4-4244-bcbe-417c9db34dca}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	scope: REFERENCE TO FB_InstrumentationScope;
	provider: REFERENCE TO FB_LoggerProvider;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._scope REF= scope;
THIS^._provider REF= provider;]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{7a1f6e83-7f40-420d-94fb-81b34da658fd}">
      <Declaration><![CDATA[METHOD free
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.pLogRecord <> 0 THEN
	THIS^.pLogRecord^.delete(pSelf:=THIS^.pLogRecord);
END_IF
THIS^._failed := TRUE;
THIS^._failureReason := E_LoggerFailureReason.LOG_RECORD_NOT_STARTED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="reset" Id="{cfc39e65-b855-4ce2-8008-a09504960012}">
      <Declaration><![CDATA[METHOD reset
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();
THIS^._failed := FALSE;
THIS^._failureReason := E_LoggerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Property Name="resource" Id="{af2fd56b-1f1f-4731-bef9-9ae40f95e566}">
      <Declaration><![CDATA[PROPERTY resource : REFERENCE TO FB_Resource]]></Declaration>
      <Get Name="Get" Id="{bcf317dc-29b7-4ff3-b222-879d72137cad}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[resource REF= THIS^._provider.resource;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="scope" Id="{d2e8b677-bbd2-4f19-8272-9e764fae0428}">
      <Declaration><![CDATA[PROPERTY scope : REFERENCE TO FB_InstrumentationScope]]></Declaration>
      <Get Name="Get" Id="{b10b9cbb-674e-4a26-9f2c-986355dc3d28}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[scope REF= THIS^._scope;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="setBody" Id="{f682be3b-ac6a-4113-bd9d-b20c5c0e539e}">
      <Declaration><![CDATA[METHOD setBody: REFERENCE TO FB_Logger
VAR_INPUT
	str: T_MaxString;  // use setBody_AnyValue if the body isn't a string
END_VAR
VAR
	_pDest: POINTER TO FB_String;
	_factoryFailureReason: E_ValueFactoryFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[setBody REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// Create an owned string body.
IF NOT ValueFactory.createString(
	pDest:=_pDest,
	pString:=ADR(str),
	failureReason=>_factoryFailureReason
	) THEN
	THIS^._failed := TRUE;
	IF _factoryFailureReason = E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		THIS^._failureReason := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		THIS^._failureReason := E_LoggerFailureReason.BODY_VALUE_INVALID;
	END_IF
	RETURN;
END_IF

// Replace the body only after the new value has been created successfully.
IF THIS^.pLogRecord^.body <> 0 THEN
	THIS^.pLogRecord^.body^.delete(pSelf:=THIS^.pLogRecord^.body);
END_IF
THIS^.pLogRecord^.body := _pDest;
_pDest := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setBody_AnyValue" Id="{e851deec-1a83-4031-a7b1-3298d7142b2e}">
      <Declaration><![CDATA[METHOD setBody_AnyValue: REFERENCE TO FB_Logger
VAR_INPUT
	pVal: POINTER TO FB_AnyValue;  // use setBody_AnyValue if the body isn't a string
END_VAR
VAR
	_pDest: POINTER TO FB_AnyValue;
	_factoryFailureReason: E_ValueFactoryFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[setBody_AnyValue REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// check that the value is valid
IF pVal = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_LoggerFailureReason.BODY_VALUE_POINTER_NULL;
	RETURN;
END_IF

// try to create a clone
IF NOT ValueFactory.cloneAnyValue(
	pDest:=_pDest,
	pSrc:=pVal,
	failureReason=>_factoryFailureReason
	) THEN
	THIS^._failed := TRUE;
	CASE _factoryFailureReason OF
		E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE:
			THIS^._failureReason := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
		E_ValueFactoryFailureReason.UNSUPPORTED_VALUE_TYPE:
			THIS^._failureReason := E_LoggerFailureReason.BODY_VALUE_TYPE_UNSUPPORTED;
	ELSE
		THIS^._failureReason := E_LoggerFailureReason.BODY_VALUE_INVALID;
	END_CASE
	RETURN;
END_IF

// clean up the prior record if it existed
IF THIS^.pLogRecord^.body <> 0 THEN
	THIS^.pLogRecord^.body^.delete(pSelf:=THIS^.pLogRecord^.body);
END_IF
// transfer ownership
THIS^.pLogRecord^.body := _pDest;
_pDest := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setEventName" Id="{e9a59e4b-8289-499d-8865-35d6e960ff8a}">
      <Declaration><![CDATA[METHOD setEventName: REFERENCE TO FB_Logger
VAR_INPUT
	str: T_MaxString;
END_VAR
VAR
	_pDest: POINTER TO FB_String;
	_factoryFailureReason: E_ValueFactoryFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setEventName REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// create FB_String
IF NOT ValueFactory.createString(
	pDest:=_pDest,
	pString:=ADR(str),
	failureReason=>_factoryFailureReason
	) THEN
	THIS^._failed := TRUE;
	IF _factoryFailureReason = E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		THIS^._failureReason := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		THIS^._failureReason := E_LoggerFailureReason.EVENT_NAME_INVALID;
	END_IF
	RETURN;
END_IF

// assign to record event name
// delete old event name if it exists
IF THIS^.pLogRecord^.eventName <> 0 THEN
	THIS^.pLogRecord^.eventName^.delete(pSelf:=THIS^.pLogRecord^.eventName);
END_IF
// transfer ownership of the pointer
THIS^.pLogRecord^.eventName := _pDest;
_pDest := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setTraceContextFromSpan" Id="{36041dd5-74db-47b9-b0fd-9548a818f495}">
      <Declaration><![CDATA[(*
	Fills the record's trace context from the span: the trace id, span id and W3C trace flags, the parts of the
	span context that the log data model carries. Trace state and remoteness are not copied.
	The log then correlates with the span and carries its sampled bit. The span is borrowed for the call only.
	A null span, or a span without ids, is a no-op rather than a failure, so the same chain works inside and outside a span.
*)
METHOD setTraceContextFromSpan: REFERENCE TO FB_Logger
VAR_INPUT
	pSpan: POINTER TO FB_Span;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setTraceContextFromSpan REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// every span has both ids, so a span without them is not worth failing the log over
IF pSpan = 0 OR_ELSE pSpan^.traceId = 0 OR_ELSE pSpan^.spanId = 0 THEN
	RETURN;
END_IF

THIS^._setTraceId(pBytes:=ADR(pSpan^.traceId^.bytes), nSize:=SIZEOF(pSpan^.traceId^.bytes));
THIS^._setSpanId(pBytes:=ADR(pSpan^.spanId^.bytes), nSize:=SIZEOF(pSpan^.spanId^.bytes));
// bits 0-7 of the span flags are the W3C trace flags, the rest describe the parent and stay on the span
THIS^._setFlags(traceFlags:=TO_BYTE(pSpan^.flags AND TO_UDINT(E_SpanFlags.SPAN_FLAGS_TRACE_FLAGS_MASK)));]]></ST>
      </Implementation>
    </Method>
    <Method Name="setNumberAttribute" Id="{6e8ebb16-a1b8-4ed2-891a-240f2408bf80}">
      <Declaration><![CDATA[METHOD setNumberAttribute: REFERENCE TO FB_Logger
VAR_INPUT
	key: T_MaxString;
	value: ANY_NUM;
END_VAR
VAR
	_attributesSuccess: BOOL;
	_attributesFailureReason: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setNumberAttribute REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

_attributesSuccess := THIS^.pLogRecord^.attributes.setNumberAttribute_AnyType(
	key:=key,
	value:=value,
	failureReason=>_attributesFailureReason
);
IF NOT _attributesSuccess THEN
	THIS^._failed := TRUE;
	CASE _attributesFailureReason OF
		E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE:
			THIS^._failureReason := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
		E_AttributesFailureReason.ATTRIBUTE_COUNT_LIMIT_REACHED:
			THIS^._failureReason := E_LoggerFailureReason.ATTRIBUTE_COUNT_LIMIT_REACHED;
		E_AttributesFailureReason.KV_VALUE_TYPE_UNSUPPORTED:
			THIS^._failureReason := E_LoggerFailureReason.ATTRIBUTE_VALUE_TYPE_UNSUPPORTED;
	ELSE
		THIS^._failureReason := E_LoggerFailureReason.ATTRIBUTE_VALUE_INVALID;
	END_CASE
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_setFlags" Id="{0dc1cddd-5b1b-4536-8a5b-948dc8e977e4}">
      <Declaration><![CDATA[(*
	Sets the record's W3C trace flags; bit 0 is sampled. Application code uses setTraceContextFromSpan; this setter is
	for tests and for setTraceContextFromSpan itself. A BYTE keeps the reserved bits 8-31 of the record's flags zero.
*)
METHOD _setFlags: REFERENCE TO FB_Logger
VAR_INPUT
	traceFlags: BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_setFlags REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

THIS^.pLogRecord^.flags := TO_UDINT(traceFlags);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_setSpanId" Id="{14f48eeb-ffc5-4e13-838f-969f880e1995}">
      <Declaration><![CDATA[(* Sets the record's span id from raw bytes. Application code uses setTraceContextFromSpan; this setter is for tests and for setTraceContextFromSpan itself. *)
METHOD _setSpanId: REFERENCE TO FB_Logger
VAR_INPUT
	pBytes: POINTER TO BYTE;
	nSize: UDINT;
END_VAR
VAR
	_pDest: POINTER TO FB_SpanId;
	_factoryFailureReason: E_ValueFactoryFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_setSpanId REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// create an instance of FB_SpanId
IF NOT ValueFactory.createSpanId(
	pDest:=_pDest,
	pBytes:=pBytes,
	nSize:=nSize,
	failureReason=>_factoryFailureReason
	) THEN
	THIS^._failed := TRUE;
	CASE _factoryFailureReason OF
		E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE:
			THIS^._failureReason := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
		E_ValueFactoryFailureReason.SPAN_ID_BYTES_POINTER_NULL:
			THIS^._failureReason := E_LoggerFailureReason.SPAN_ID_BYTES_POINTER_NULL;
		E_ValueFactoryFailureReason.SPAN_ID_BYTE_COUNT_TOO_SMALL:
			THIS^._failureReason := E_LoggerFailureReason.SPAN_ID_BYTE_COUNT_TOO_SMALL;
	ELSE
		THIS^._failureReason := E_LoggerFailureReason.SPAN_ID_INVALID;
	END_CASE
	RETURN;
END_IF

// assign to the record
// delete the prior record if it exists
IF THIS^.pLogRecord^.spanId <> 0 THEN
	THIS^.pLogRecord^.spanId^.delete(pSelf:=THIS^.pLogRecord^.spanId);
END_IF
// transfer owneship of the data
THIS^.pLogRecord^.spanId := _pDest;
_pDest := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setStringAttribute" Id="{ca1a9b5c-3e71-4efc-b089-bac82579b23c}">
      <Declaration><![CDATA[METHOD setStringAttribute: REFERENCE TO FB_Logger
VAR_INPUT
	key: T_MaxString;
	value: T_MaxString;
END_VAR
VAR
	_attributesSuccess: BOOL;
	_attributesFailureReason: E_AttributesFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[setStringAttribute REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

_attributesSuccess := THIS^.pLogRecord^.attributes.setStringAttribute(
	key:=key,
	value:=value,
	failureReason=>_attributesFailureReason
);
IF NOT _attributesSuccess THEN
	THIS^._failed := TRUE;
	CASE _attributesFailureReason OF
		E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE:
			THIS^._failureReason := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
		E_AttributesFailureReason.ATTRIBUTE_COUNT_LIMIT_REACHED:
			THIS^._failureReason := E_LoggerFailureReason.ATTRIBUTE_COUNT_LIMIT_REACHED;
		E_AttributesFailureReason.KV_VALUE_TYPE_UNSUPPORTED:
			THIS^._failureReason := E_LoggerFailureReason.ATTRIBUTE_VALUE_TYPE_UNSUPPORTED;
	ELSE
		THIS^._failureReason := E_LoggerFailureReason.ATTRIBUTE_VALUE_INVALID;
	END_CASE
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="setTimestamp" Id="{7b4d9e15-58e6-4398-9eac-4a27d3cfdaeb}">
      <Declaration><![CDATA[METHOD setTimestamp: REFERENCE TO FB_Logger
VAR_INPUT
	timestamp: ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[setTimestamp REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// if everything above worked, assign the value
THIS^.pLogRecord^.timestamp := timestamp;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_setTraceId" Id="{ca3f3acd-d52b-46f3-b0a6-82a2580b7b9b}">
      <Declaration><![CDATA[(* Sets the record's trace id from raw bytes. Application code uses setTraceContextFromSpan; this setter is for tests and for setTraceContextFromSpan itself. *)
METHOD _setTraceId: REFERENCE TO FB_Logger
VAR_INPUT
	pBytes: POINTER TO BYTE;
	nSize: UDINT;
END_VAR
VAR
	_pDest: POINTER TO FB_TraceId;
	_factoryFailureReason: E_ValueFactoryFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_setTraceId REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

// create an instance of FB_TraceId
IF NOT ValueFactory.createTraceId(
	pDest:=_pDest,
	pBytes:=pBytes,
	nSize:=nSize,
	failureReason=>_factoryFailureReason
	) THEN
	THIS^._failed := TRUE;
	CASE _factoryFailureReason OF
		E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE:
			THIS^._failureReason := E_LoggerFailureReason.MEMORY_ALLOCATION_FAILURE;
		E_ValueFactoryFailureReason.TRACE_ID_BYTES_POINTER_NULL:
			THIS^._failureReason := E_LoggerFailureReason.TRACE_ID_BYTES_POINTER_NULL;
		E_ValueFactoryFailureReason.TRACE_ID_BYTE_COUNT_TOO_SMALL:
			THIS^._failureReason := E_LoggerFailureReason.TRACE_ID_BYTE_COUNT_TOO_SMALL;
	ELSE
		THIS^._failureReason := E_LoggerFailureReason.TRACE_ID_INVALID;
	END_CASE
	RETURN;
END_IF

// assign to the log record
// delete trace id if it's already set.
IF THIS^.pLogRecord^.traceId <> 0 THEN
	THIS^.pLogRecord^.traceId^.delete(pSelf:=THIS^.pLogRecord^.traceId);
END_IF
// transfer ownership of the data
THIS^.pLogRecord^.traceId := _pDest;
_pDest := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="startLogRecord" Id="{eaefc3eb-aea0-4067-8396-a0c5d23f5ac3}">
      <Declaration><![CDATA[(*
	This method starts the build process with the required log record state.
	Use the fluent setter methods for optional fields.
	
	Example:
	IF NOT logger
		.startLogRecord(severityNumber := E_SeverityNumber.SEVERITY_NUMBER_WARNING)
		.setBody('process cycle amps warning, motor fault imminent')
		.setTraceContextFromSpan(pSpan)  // a no-op when pSpan is 0
		.setNumberAttribute('motor.amps.min', minAmps)
		.setNumberAttribute('motor.amps.max', maxAmps)
		.setNumberAttribute('motor.amps.avg', avgAmps)
		.emit(failureResult=>failureResult) THEN
		// CASE failureResult OF ...
	END_IF
*)
METHOD startLogRecord: REFERENCE TO FB_Logger
VAR_INPUT
	severityNumber: E_SeverityNumber;
END_VAR
VAR
	_timestamp: ULINT;
END_VAR
VAR CONSTANT
	UNIX_EPOCH_DIFF: ULINT := 116444736000000000;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[startLogRecord REF= THIS^;

// do not replace the first failure in an active fluent chain
IF THIS^.pLogRecord <> 0 THEN
	IF NOT THIS^._failed THEN
		THIS^._failed := TRUE;
		THIS^._failureReason := E_LoggerFailureReason.LOG_RECORD_ALREADY_STARTED;
	END_IF
	RETURN;
END_IF

THIS^._failed := FALSE;
THIS^._failureReason := E_LoggerFailureReason.NA;


_timestamp := (F_GetSystemTime() - UNIX_EPOCH_DIFF) * 100;  // NT ticks (100ns) -> unix epoch nanos


// instantiate a log record
IF NOT THIS^._createLogRecord(
	pDest:=THIS^.pLogRecord,
	severityNumber:=severityNumber,
	timestamp:=_timestamp,
	failureReason=>THIS^._failureReason
	) THEN
	THIS^._failed := TRUE;
END_IF

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>