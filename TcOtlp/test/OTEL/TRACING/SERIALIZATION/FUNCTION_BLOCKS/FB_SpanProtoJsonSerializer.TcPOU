<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SpanProtoJsonSerializer" Id="{26cc97b2-23b3-421b-9277-0008576ec889}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	Writes ended spans as OTLP ProtoJSON: TracesData > ResourceSpans > ScopeSpans > Span.
	serializeTracesData takes ownership of the queued spans and drains the queue: every span
	is released once written, and whatever is left is released on failure.

	Example:
	IF serializer.serializeTracesData(spans:=queue, failureReason=>reason) THEN
		// serializer.parser and serializer.jsonValue hold the document
	END_IF
*)
FUNCTION_BLOCK FB_SpanProtoJsonSerializer EXTENDS FB_BaseProtoJsonSerializer
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_serializeLinks" Id="{45aabacb-16c0-4a4f-99bf-c2b12725f22d}">
      <Declaration><![CDATA[(*
	Writes the span's links as a 'links' array of Link objects, in the order they were added.
	Walking the links moves their cursor, but the links themselves are only read.
*)
METHOD _serializeLinks : BOOL
VAR_IN_OUT
	v: SJsonValue;
	links: FB_Links;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_array: SJsonValue;
	_obj: SJsonValue;
	_pLink: POINTER TO FB_Link;
	_idx: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_serializeLinks := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF

_array := THIS^.parser.AddArrayMember(v, 'links', 0);
IF _array = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

links.reset();
FOR _idx := 0 TO TcOtlp_GVL.MAX_LOOP_COUNT DO
	_pLink := links.next();
	IF _pLink = 0 THEN
		_serializeLinks := TRUE;
		RETURN;
	END_IF

	_obj := THIS^.parser.PushbackJsonValue(_array, '{}');
	IF _obj = 0 THEN
		failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
		RETURN;
	END_IF
	IF _pLink^.traceId <> 0 AND_THEN NOT THIS^.serializeTraceIdValue(_obj, _pLink^.traceId, failureReason=>failureReason) THEN RETURN; END_IF
	IF _pLink^.spanId <> 0 AND_THEN NOT THIS^.serializeSpanIdValue(_obj, _pLink^.spanId, failureReason=>failureReason) THEN RETURN; END_IF
	IF _pLink^.traceState <> 0 AND_THEN NOT THIS^.serializeStringValue(_obj, ADR('traceState'), _pLink^.traceState, failureReason=>failureReason) THEN RETURN; END_IF
	IF _pLink^.attributes.count > 0 AND_THEN NOT THIS^.serializeKeyValues(_obj, ADR('attributes'), ADR(_pLink^.attributes), failureReason=>failureReason) THEN RETURN; END_IF
	IF _pLink^.attributes.droppedCount > 0 AND_THEN NOT THIS^.serializeUint32Value(
		_obj,
		ADR('droppedAttributesCount'),
		_pLink^.attributes.droppedCount,
		failureReason=>failureReason
	) THEN
		RETURN;
	END_IF
	IF _pLink^.flags <> 0 AND_THEN NOT THIS^.serializeUint32Value(_obj, ADR('flags'), _pLink^.flags, failureReason=>failureReason) THEN RETURN; END_IF
END_FOR

// FB_Links holds at most MAX_LOOP_COUNT links, so the walk always ends above
failureReason := E_ProtoJsonSerializerFailureReason.LOOP_LIMIT_EXCEEDED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_serializeStatus" Id="{8df3e1fb-b498-44c7-a12c-07ce0a43571a}">
      <Declaration><![CDATA[METHOD _serializeStatus : BOOL
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pStatus: POINTER TO FB_Status;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_obj: SJsonValue;
	_member: SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_serializeStatus := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF
IF pStatus = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.VALUE_POINTER_NULL;
	RETURN;
END_IF

_obj := THIS^.parser.AddObjectMember(v, 'status');
IF _obj = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF
IF pStatus^.message <> 0 AND_THEN NOT THIS^.serializeStringValue(_obj, ADR('message'), pStatus^.message, failureReason=>failureReason) THEN
	RETURN;
END_IF
IF pStatus^.code <> E_StatusCode.STATUS_CODE_UNSET THEN
	_member := THIS^.parser.AddUintMember(_obj, 'code', TO_UDINT(pStatus^.code));
	IF _member = 0 THEN
		failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
		RETURN;
	END_IF
END_IF
_serializeStatus := failureReason = E_ProtoJsonSerializerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeSpan" Id="{9db01843-179e-4f59-81af-712c3a873a2f}">
      <Declaration><![CDATA[(* Appends one Span object to the JSON array v. The span is only read. *)
METHOD serializeSpan : BOOL
VAR_IN_OUT
	v: SJsonValue;
END_VAR
VAR_INPUT
	pSpan: POINTER TO FB_Span;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_obj: SJsonValue;
	_member: SJsonValue;
	_parentSpanId: STRING(16);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[serializeSpan := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF
IF pSpan = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF

_obj := THIS^.parser.PushbackJsonValue(v, '{}');
IF _obj = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

// identity; a root span has no parentSpanId
IF pSpan^.traceId <> 0 AND_THEN NOT THIS^.serializeTraceIdValue(_obj, pSpan^.traceId, failureReason=>failureReason) THEN RETURN; END_IF
IF pSpan^.spanId <> 0 AND_THEN NOT THIS^.serializeSpanIdValue(_obj, pSpan^.spanId, failureReason=>failureReason) THEN RETURN; END_IF
IF pSpan^.traceState <> 0 AND_THEN NOT THIS^.serializeStringValue(_obj, ADR('traceState'), pSpan^.traceState, failureReason=>failureReason) THEN RETURN; END_IF
IF pSpan^.parentSpanId <> 0 THEN
	IF NOT THIS^._serializeBytes(
		ADR(pSpan^.parentSpanId^.bytes),
		SIZEOF(pSpan^.parentSpanId^.bytes),
		ADR(_parentSpanId),
		SIZEOF(_parentSpanId),
		E_BytesEncoding.hex,
		failureReason=>failureReason
	) THEN
		RETURN;
	END_IF
	_member := THIS^.parser.AddStringMember(_obj, 'parentSpanId', _parentSpanId);
	IF _member = 0 THEN failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE; RETURN; END_IF
END_IF
IF pSpan^.flags <> 0 AND_THEN NOT THIS^.serializeUint32Value(_obj, ADR('flags'), pSpan^.flags, failureReason=>failureReason) THEN RETURN; END_IF

// description and timing; OTLP/JSON writes enums as numbers and 64-bit integers as strings
IF pSpan^.name <> 0 AND_THEN NOT THIS^.serializeStringValue(_obj, ADR('name'), pSpan^.name, failureReason=>failureReason) THEN RETURN; END_IF
_member := THIS^.parser.AddUintMember(_obj, 'kind', TO_UDINT(pSpan^.kind));
IF _member = 0 THEN failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE; RETURN; END_IF
IF NOT THIS^.serializeUint64Value(_obj, ADR('startTimeUnixNano'), pSpan^.startTimestamp, failureReason=>failureReason) THEN RETURN; END_IF
IF NOT THIS^.serializeUint64Value(_obj, ADR('endTimeUnixNano'), pSpan^.endTimestamp, failureReason=>failureReason) THEN RETURN; END_IF

IF pSpan^.attributes.count > 0 AND_THEN NOT THIS^.serializeKeyValues(_obj, ADR('attributes'), ADR(pSpan^.attributes), failureReason=>failureReason) THEN RETURN; END_IF
IF pSpan^.attributes.droppedCount > 0 AND_THEN NOT THIS^.serializeUint32Value(
	_obj,
	ADR('droppedAttributesCount'),
	pSpan^.attributes.droppedCount,
	failureReason=>failureReason
) THEN
	RETURN;
END_IF
IF pSpan^.links.count > 0 AND_THEN NOT THIS^._serializeLinks(_obj, pSpan^.links, failureReason=>failureReason) THEN RETURN; END_IF
IF pSpan^.links.droppedCount > 0 AND_THEN NOT THIS^.serializeUint32Value(
	_obj,
	ADR('droppedLinksCount'),
	pSpan^.links.droppedCount,
	failureReason=>failureReason
) THEN
	RETURN;
END_IF
IF pSpan^.status <> 0 AND_THEN NOT THIS^._serializeStatus(_obj, pSpan^.status, failureReason=>failureReason) THEN RETURN; END_IF
serializeSpan := failureReason = E_ProtoJsonSerializerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="startNewResource" Id="{6467ee6b-76be-429b-8f02-a6f19ce859e0}">
      <Declaration><![CDATA[METHOD startNewResource : BOOL
VAR_IN_OUT
	v: SJsonValue;
	resource: FB_Resource;
END_VAR
VAR_OUTPUT
	scopeSpans: SJsonValue;
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_resourceObj: SJsonValue;
	_member: SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[startNewResource := FALSE;
scopeSpans := 0;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF

_resourceObj := THIS^.parser.PushbackJsonValue(v, '{}');
IF _resourceObj = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF
IF NOT THIS^._injectResource(_resourceObj, resource, failureReason=>failureReason) THEN
	RETURN;
END_IF
IF resource.schemaUrl <> '' THEN
	_member := THIS^.parser.AddStringMember(_resourceObj, 'schemaUrl', resource.schemaUrl);
	IF _member = 0 THEN
		failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
		RETURN;
	END_IF
END_IF
scopeSpans := THIS^.parser.AddArrayMember(_resourceObj, 'scopeSpans', 0);
IF scopeSpans = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

startNewResource := failureReason = E_ProtoJsonSerializerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="startNewScope" Id="{36122df4-73e4-403e-9cf9-e1f307fb3fe6}">
      <Declaration><![CDATA[METHOD startNewScope : BOOL
VAR_IN_OUT
	v: SJsonValue;
	scope: FB_InstrumentationScope;
END_VAR
VAR_OUTPUT
	serializedSpans: SJsonValue;
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_scopeObj: SJsonValue;
	_member: SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[startNewScope := FALSE;
serializedSpans := 0;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF

_scopeObj := THIS^.parser.PushbackJsonValue(v, '{}');
IF _scopeObj = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF
IF NOT THIS^._injectInstrumentationScope(_scopeObj, scope, failureReason=>failureReason) THEN
	RETURN;
END_IF
IF scope.schemaUrl <> '' THEN
	_member := THIS^.parser.AddStringMember(_scopeObj, 'schemaUrl', scope.schemaUrl);
	IF _member = 0 THEN
		failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
		RETURN;
	END_IF
END_IF
serializedSpans := THIS^.parser.AddArrayMember(_scopeObj, 'spans', 0);
IF serializedSpans = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

startNewScope := failureReason = E_ProtoJsonSerializerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeResourceSpans" Id="{85eb32ea-9c8d-4db6-a04e-02ac413dbe66}">
      <Declaration><![CDATA[(*
	Writes one ResourceSpans group led by pSpan, which the caller has popped and owns. Every
	queued span of the same resource is popped and written, grouped by scope in first-seen
	order. Spans of other resources are rotated, so they keep their arrival order. pSpan is
	0 on success; on failure it holds any span still owned, for the caller to release.
*)
METHOD serializeResourceSpans : BOOL
VAR_IN_OUT
	v: SJsonValue;
	spans: FB_SpanQueue;
	pSpan: POINTER TO FB_Span;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_resourceId: UDINT;
	_scopeSpans: SJsonValue;
	_pHead: POINTER TO FB_Span;
	_scopeLimit: UDINT;
	_spansToScan: UDINT;
	_scopeIdx: UDINT;
	_scanIdx: UDINT;
	_queueFailureReason: E_SpanQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[serializeResourceSpans := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF
IF pSpan = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF

_resourceId := pSpan^.resource.id;
IF NOT THIS^.startNewResource(
	v:=v,
	resource:=pSpan^.resource,
	scopeSpans=>_scopeSpans,
	failureReason=>failureReason
) THEN
	RETURN;
END_IF

// One scope per pass. Each pass writes at least the leading span, so count + 1 passes suffice.
_scopeLimit := spans.count + 1;
FOR _scopeIdx := 1 TO _scopeLimit DO
	IF NOT THIS^.serializeScopeSpans(
		v:=_scopeSpans,
		spans:=spans,
		pSpan:=pSpan,
		resourceId:=_resourceId,
		failureReason=>failureReason
	) THEN
		RETURN;
	END_IF

	// Pop the first span of another scope of this resource. Rotating every other span
	// preserves arrival order for later resource groups.
	_spansToScan := spans.count;
	FOR _scanIdx := 1 TO _spansToScan DO
		spans.reset();
		_pHead := spans.next();
		IF _pHead = 0 THEN
			failureReason := E_ProtoJsonSerializerFailureReason.SPAN_COLLECTION_INCONSISTENT;
			RETURN;
		END_IF
		IF pSpan = 0 AND_THEN _pHead^.resource.id = _resourceId THEN
			IF NOT spans.pop(pValue:=pSpan, failureReason=>_queueFailureReason) THEN
				failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_POP_FAILURE;
				RETURN;
			END_IF
			IF pSpan = 0 THEN
				failureReason := E_ProtoJsonSerializerFailureReason.SPAN_COLLECTION_INCONSISTENT;
				RETURN;
			END_IF
		ELSIF NOT spans.rotate(failureReason=>_queueFailureReason) THEN
			failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_ROTATE_FAILURE;
			RETURN;
		END_IF
	END_FOR

	IF pSpan = 0 THEN
		serializeResourceSpans := failureReason = E_ProtoJsonSerializerFailureReason.NA;
		RETURN;
	END_IF
END_FOR

failureReason := E_ProtoJsonSerializerFailureReason.LOOP_LIMIT_EXCEEDED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeScopeSpans" Id="{7cc34591-f552-4946-b26e-ea4aafe50603}">
      <Declaration><![CDATA[(*
	Writes one ScopeSpans group led by pSpan, which the caller has popped and owns. Every
	queued span with the same resource and scope is popped and written in queue order;
	other spans are rotated. Each span is released once written, so pSpan is 0 on success.
	On failure it holds any span still owned, for the caller to release.
*)
METHOD serializeScopeSpans : BOOL
VAR_IN_OUT
	v: SJsonValue;
	spans: FB_SpanQueue;
	pSpan: POINTER TO FB_Span;
END_VAR
VAR_INPUT
	resourceId: UDINT;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_scopeName: T_MaxString;
	_serializedSpans: SJsonValue;
	_pHead: POINTER TO FB_Span;
	_spansToScan: UDINT;
	_scanIdx: UDINT;
	_queueFailureReason: E_SpanQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[serializeScopeSpans := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;
IF v = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_VALUE_INVALID;
	RETURN;
END_IF
IF pSpan = 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF
IF pSpan^.resource.id <> resourceId THEN
	failureReason := E_ProtoJsonSerializerFailureReason.SPAN_COLLECTION_INCONSISTENT;
	RETURN;
END_IF

_scopeName := pSpan^.scope.name;
IF NOT THIS^.startNewScope(
	v:=v,
	scope:=pSpan^.scope,
	serializedSpans=>_serializedSpans,
	failureReason=>failureReason
) THEN
	RETURN;
END_IF

IF NOT THIS^.serializeSpan(_serializedSpans, pSpan, failureReason=>failureReason) THEN
	RETURN;
END_IF
pSpan^.delete(pSelf:=pSpan);

// Consume and release every remaining span in this resource/scope group.
_spansToScan := spans.count;
FOR _scanIdx := 1 TO _spansToScan DO
	spans.reset();
	_pHead := spans.next();
	IF _pHead = 0 THEN
		failureReason := E_ProtoJsonSerializerFailureReason.SPAN_COLLECTION_INCONSISTENT;
		RETURN;
	END_IF

	IF _pHead^.resource.id = resourceId AND_THEN _pHead^.scope.name = _scopeName THEN
		IF NOT spans.pop(pValue:=pSpan, failureReason=>_queueFailureReason) THEN
			failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_POP_FAILURE;
			RETURN;
		END_IF
		IF pSpan = 0 THEN
			failureReason := E_ProtoJsonSerializerFailureReason.SPAN_COLLECTION_INCONSISTENT;
			RETURN;
		END_IF
		IF NOT THIS^.serializeSpan(_serializedSpans, pSpan, failureReason=>failureReason) THEN
			RETURN;
		END_IF
		pSpan^.delete(pSelf:=pSpan);
	ELSIF NOT spans.rotate(failureReason=>_queueFailureReason) THEN
		failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_ROTATE_FAILURE;
		RETURN;
	END_IF
END_FOR

serializeScopeSpans := failureReason = E_ProtoJsonSerializerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="serializeTracesData" Id="{fb93ca12-8023-45cc-94f5-d5d44fdd762a}">
      <Declaration><![CDATA[(*
	Writes a TracesData document for every span in the queue to jsonValue. Spans are grouped
	by resource and then by instrumentation scope, so each resource and scope is written once.
	Groups keep first-seen order, and spans keep queue order within a group.

	Takes ownership of all queued spans and drains the queue. Written spans are released as
	they are written, and any left over are released on failure, so the queue is empty
	whatever the result. Grouping rotates the queue once per group, so the work is bounded
	by count squared.
*)
METHOD serializeTracesData : BOOL
VAR_IN_OUT
	spans: FB_SpanQueue;
END_VAR
VAR_OUTPUT
	failureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
VAR
	_count: UDINT;
	_pSpan: POINTER TO FB_Span;
	_resourceSpans: SJsonValue;
	_resourceIdx: UDINT;
	_queueFailureReason: E_SpanQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[serializeTracesData := FALSE;
failureReason := E_ProtoJsonSerializerFailureReason.NA;

_count := spans.count;
IF _count > TcOtlp_GVL.MAX_LOOP_COUNT THEN
	spans.free();
	failureReason := E_ProtoJsonSerializerFailureReason.LOOP_LIMIT_EXCEEDED;
	RETURN;
END_IF

// start a new document whose root is an object holding the resourceSpans array
THIS^.jsonValue := THIS^.parser.NewDocument();
IF THIS^.jsonValue = 0 THEN
	spans.free();
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF
THIS^.jsonValue := THIS^.parser.SetObject(THIS^.jsonValue);
IF THIS^.jsonValue = 0 THEN
	spans.free();
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF
_resourceSpans := THIS^.parser.AddArrayMember(THIS^.jsonValue, 'resourceSpans', 0);
IF _resourceSpans = 0 THEN
	spans.free();
	failureReason := E_ProtoJsonSerializerFailureReason.JSON_OPERATION_FAILURE;
	RETURN;
END_IF

// each resource group pops at least its leading span, so _count passes always suffice
_pSpan := 0;
FOR _resourceIdx := 1 TO _count DO
	IF spans.count = 0 THEN
		EXIT;
	END_IF
	IF NOT spans.pop(pValue:=_pSpan, failureReason=>_queueFailureReason) THEN
		failureReason := E_ProtoJsonSerializerFailureReason.QUEUE_POP_FAILURE;
		EXIT;
	END_IF
	IF _pSpan = 0 THEN
		failureReason := E_ProtoJsonSerializerFailureReason.SPAN_COLLECTION_INCONSISTENT;
		EXIT;
	END_IF
	IF NOT THIS^.serializeResourceSpans(
		v:=_resourceSpans,
		spans:=spans,
		pSpan:=_pSpan,
		failureReason=>failureReason
	) THEN
		EXIT;
	END_IF
END_FOR

// release a span a failed group still holds
IF _pSpan <> 0 THEN
	_pSpan^.delete(pSelf:=_pSpan);
END_IF
IF failureReason = E_ProtoJsonSerializerFailureReason.NA AND spans.count > 0 THEN
	failureReason := E_ProtoJsonSerializerFailureReason.SPAN_COLLECTION_INCONSISTENT;
END_IF

spans.free();
serializeTracesData := failureReason = E_ProtoJsonSerializerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>