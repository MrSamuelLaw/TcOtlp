<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Link" Id="{2b4ea221-4624-41d5-872a-acc0a6aeb214}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	A pointer from one span to another span's context, possibly in another trace. Build it
	through LinkFactory, which validates the context and copies its identity.
	The link owns every pointer member and releases them in free.
*)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_Link
VAR_INPUT
	// written by LinkFactory
	traceId: POINTER TO FB_TraceId;
	spanId: POINTER TO FB_SpanId;
	traceState: POINTER TO FB_TraceState;  // optional; 0 means none

	// the linked context's trace flags and remoteness; see E_SpanFlags
	flags: UDINT;
END_VAR
VAR_OUTPUT
	attributes: FB_Attributes(maxCount := TcOtlp_GVL.DEFAULT_MAX_ATTRIBUTE_COUNT);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="delete" Id="{31d78f9e-1537-48a0-a000-9b2a00d6fa65}">
      <Declaration><![CDATA[(*
	Releases this link and clears the caller's pointer to it: call it as p^.delete(pSelf:=p).
	pSelf is cleared before the link is freed, so the caller never keeps a dangling pointer.
	A pointer to any other object is refused and left untouched, and nothing is released.
*)
METHOD delete : BOOL
VAR_IN_OUT
	pSelf: POINTER TO FB_Link;
END_VAR
VAR
	_pThis: POINTER TO FB_Link;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_pThis := THIS;
IF pSelf <> _pThis THEN
	RETURN;
END_IF

pSelf := 0;
__DELETE(_pThis);
delete := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{918fed15-79e0-4368-9d4e-943bcbac7927}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{f5aa2f49-f8d9-4589-8716-ac7d6ea660b4}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{8006ee28-e9aa-4c16-bbd4-cd0d64f09b32}">
      <Declaration><![CDATA[(*
	Releases every value the link owns and clears the pointers. Safe to call more than once.
*)
METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.traceId <> 0 THEN THIS^.traceId^.delete(pSelf:=THIS^.traceId); END_IF
IF THIS^.spanId <> 0 THEN THIS^.spanId^.delete(pSelf:=THIS^.spanId); END_IF
IF THIS^.traceState <> 0 THEN THIS^.traceState^.delete(pSelf:=THIS^.traceState); END_IF
THIS^.attributes.free();
THIS^.flags := 0;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>