<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Link" Id="{2b4ea221-4624-41d5-872a-acc0a6aeb214}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Link
VAR_OUTPUT
	// required values
	traceId: POINTER TO FB_TraceId;
	spanId: POINTER TO FB_SpanId;
	traceState: POINTER TO FB_String;
	attributes: FB_Attributes;
	flags: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="delete" Id="{31d78f9e-1537-48a0-a000-9b2a00d6fa65}">
      <Declaration><![CDATA[METHOD delete : ULINT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{918fed15-79e0-4368-9d4e-943bcbac7927}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{f5aa2f49-f8d9-4589-8716-ac7d6ea660b4}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{8006ee28-e9aa-4c16-bbd4-cd0d64f09b32}">
      <Declaration><![CDATA[METHOD free

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.traceId <> 0 THEN THIS^.traceId^.free(); END_IF
IF THIS^.spanId <> 0 THEN THIS^.spanId^.free(); END_IF
IF THIS^.traceId <> 0 THEN THIS^.traceId^.free(); END_IF
THIS^.attributes.free();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>