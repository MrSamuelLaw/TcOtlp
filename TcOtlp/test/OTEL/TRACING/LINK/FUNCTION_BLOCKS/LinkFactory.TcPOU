<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="LinkFactory" Id="{a9503e6a-dd15-4216-bf41-c07bf9b9a140}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	Creates FB_Link values and keeps their invariants: a link always points at a valid span
	context and owns copies of its identity. Attributes can be added to the link's attributes
	after it is created.
*)
PROGRAM LinkFactory
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="fromContext" Id="{6962bce1-6834-4824-9152-65f271b1dd21}">
      <Declaration><![CDATA[(*
	Allocates a link to the given span context. The context is borrowed: the link holds copies
	of its trace id, span id and trace state, so it stays valid after the context is released.
	The link's flags carry the context's trace flags and remoteness. The caller owns pDest,
	which must be 0; on failure nothing is allocated and pDest is left alone.
*)
METHOD fromContext : BOOL
VAR_IN_OUT
	pDest: POINTER TO FB_Link;
END_VAR
VAR_INPUT
	pContext: POINTER TO FB_SpanContext;
END_VAR
VAR_OUTPUT
	failureReason: E_LinkFailureReason;
END_VAR
VAR
	_ctxTraceId: REFERENCE TO FB_TraceId;
	_ctxSpanId: REFERENCE TO FB_SpanId;
	_pNew: POINTER TO FB_Link;
	_copied: BOOL;
	_flags: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fromContext := FALSE;
failureReason := E_LinkFailureReason.NA;

IF pDest <> 0 THEN
	failureReason := E_LinkFailureReason.DESTINATION_ALREADY_ASSIGNED;
	RETURN;
END_IF
IF pContext = 0 THEN
	failureReason := E_LinkFailureReason.CONTEXT_POINTER_NULL;
	RETURN;
END_IF
IF NOT pContext^.isValid() THEN
	failureReason := E_LinkFailureReason.CONTEXT_INVALID;
	RETURN;
END_IF

_pNew := __NEW(FB_Link);
IF _pNew = 0 THEN
	failureReason := E_LinkFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

// the link owns its members from here, so deleting it releases whatever was copied
_ctxTraceId REF= pContext^.traceId;
_ctxSpanId REF= pContext^.spanId;
_copied := ValueFactory.createTraceId(
		pDest:=_pNew^.traceId,
		pBytes:=ADR(_ctxTraceId.bytes),
		nSize:=SIZEOF(_ctxTraceId.bytes))
	AND_THEN ValueFactory.createSpanId(
		pDest:=_pNew^.spanId,
		pBytes:=ADR(_ctxSpanId.bytes),
		nSize:=SIZEOF(_ctxSpanId.bytes))
	AND_THEN (pContext^.traceState = 0 OR_ELSE ValueFactory.cloneString(
		pDest:=_pNew^.traceState,
		pSrc:=pContext^.traceState));
IF NOT _copied THEN
	_pNew^.delete(pSelf:=_pNew);
	failureReason := E_LinkFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

// the same encoding a span uses for its parent: trace flags plus known remoteness
_flags := (pContext^.traceFlags AND TO_UDINT(E_SpanFlags.SPAN_FLAGS_TRACE_FLAGS_MASK))
	OR TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_HAS_IS_REMOTE_MASK);
IF pContext^.isRemote() THEN
	_flags := _flags OR TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_IS_REMOTE_MASK);
END_IF
_pNew^.flags := _flags;

// transfer ownership to the caller
pDest := _pNew;
_pNew := 0;
fromContext := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="fromSpan" Id="{f83a253a-0649-4c34-adad-b4942b21a606}">
      <Declaration><![CDATA[(*
	Allocates a link to a span the caller holds, such as a running or ended span in this PLC.
	The span is borrowed and unchanged. The link is built from the span's context, so it is
	local: remoteness is known and not remote. The caller owns pDest, which must be 0.
*)
METHOD fromSpan : BOOL
VAR_IN_OUT
	pDest: POINTER TO FB_Link;
END_VAR
VAR_INPUT
	pSpan: POINTER TO FB_Span;
END_VAR
VAR_OUTPUT
	failureReason: E_LinkFailureReason;
END_VAR
VAR
	_pContext: POINTER TO FB_SpanContext;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fromSpan := FALSE;
failureReason := E_LinkFailureReason.NA;

IF pDest <> 0 THEN
	failureReason := E_LinkFailureReason.DESTINATION_ALREADY_ASSIGNED;
	RETURN;
END_IF
IF pSpan = 0 THEN
	failureReason := E_LinkFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF
IF pSpan^.traceId = 0 OR pSpan^.spanId = 0 THEN
	failureReason := E_LinkFailureReason.CONTEXT_INVALID;
	RETURN;
END_IF

IF NOT pSpan^.getContext(pDest:=_pContext) THEN
	IF _pContext <> 0 THEN _pContext^.delete(pSelf:=_pContext); END_IF
	failureReason := E_LinkFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF
fromSpan := LinkFactory.fromContext(pDest:=pDest, pContext:=_pContext, failureReason=>failureReason);
_pContext^.delete(pSelf:=_pContext);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>