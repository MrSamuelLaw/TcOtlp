<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_PropagationFailureReason" Id="{929a8e3b-ca0d-41fc-bce6-d0ae2c7832f7}">
    <Declaration><![CDATA[(* Why TraceContextPropagator could not extract a span context from a carrier, or inject one into it. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_PropagationFailureReason :
(
	NA := 0,  // No failure.
	DESTINATION_ALREADY_ASSIGNED,  // The destination pointer already holds a span context.
	TRACEPARENT_EMPTY,  // No traceparent arrived, so there is no context to extract.
	TRACEPARENT_LENGTH_INVALID,  // The traceparent is shorter than 55 characters, or longer for version 00.
	VERSION_INVALID,  // The version is not two lowercase hex digits, or is the reserved ff.
	DELIMITER_INVALID,  // A field is not followed by '-', or a future version's flags are followed by something else.
	TRACE_ID_INVALID,  // The trace id is not 32 lowercase hex digits, or is all zero.
	SPAN_ID_INVALID,  // The parent span id is not 16 lowercase hex digits, or is all zero.
	TRACE_FLAGS_INVALID,  // The trace flags are not two lowercase hex digits.
	MEMORY_ALLOCATION_FAILURE,  // The span context, or a shortened trace state, could not be allocated.
	CONTEXT_POINTER_NULL,  // inject was given no span context.
	CONTEXT_INVALID  // The span context has an all-zero trace id or span id, so there is nothing to propagate.
) UDINT;
END_TYPE
]]></Declaration>
