<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TraceContextPropagator" Id="{9c5ef736-0160-4416-a3a1-fe86c83d8b9e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	Decodes W3C Trace Context carriers into span contexts, and encodes span contexts into them.
	Propagation is the caller's job: the application owns the carrier, the transport and the span
	it starts, and this program only converts between a context and an ST_TraceContextCarrier.
	It knows nothing about how a carrier travels, so each transport (ADS, OPC UA, HTTP) is a
	separate block that moves the carrier and calls inject or extract. See "Trace Context
	Propagation" in the docs.
*)
PROGRAM TraceContextPropagator
VAR CONSTANT
	TRACEPARENT_LENGTH: UDINT := 55;  // version 00, and the fields every version starts with: 2 + 1 + 32 + 1 + 16 + 1 + 2
	TRACE_ID_OFFSET: UDINT := 3;
	SPAN_ID_OFFSET: UDINT := 36;
	FLAGS_OFFSET: UDINT := 53;
	DELIMITER: BYTE := 16#2D;  // '-'
	MAX_TRACESTATE_LENGTH: UDINT := 512;  // the W3C floor for propagating a tracestate; the size of ST_TraceContextCarrier.tracestate
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="extract" Id="{fbb8a4a6-c3c8-45df-b25c-9fd960f4fb77}">
      <Declaration><![CDATA[(*
	Parses a W3C traceparent and optional tracestate into a new remote span context. The caller
	owns pDest, which must be 0, and releases it once with delete. Nothing is allocated until the
	traceparent is known to be good, and on failure pDest stays 0: the caller should then start
	its span without the context, because a mangled header must not stop a process.
	An all-zero trace id or span id is the encoding of "absent" and is rejected. Version ff is
	invalid. Version 00 is exactly 55 characters; a future version may be longer, and is read as
	its first 55 characters when the flags are followed by '-'. The headers are taken by
	reference at their full length, so an overlong traceparent is seen and rejected, and the
	tracestate is never cut mid-entry. W3C asks for at least 512 tracestate characters to be
	kept and allows only whole entries to be dropped, so every entry is kept here; a carrier of
	limited size uses TraceStateFactory.truncate when the context is sent on. An invalid
	tracestate is dropped without failing the extraction. The context is marked remote. The
	default sampler follows its sampled bit for a span that takes it as a parent, and ignores it
	for a span that only links to it.
*)
METHOD extract : BOOL
VAR_IN_OUT
	pDest: POINTER TO FB_SpanContext;
END_VAR
VAR_IN_OUT CONSTANT
	traceparent: STRING;  // any length: pass carrier.traceparent, or a longer header as received
	tracestate: STRING;  // any length; '' when the header is absent
END_VAR
VAR_OUTPUT
	failureReason: E_PropagationFailureReason;
END_VAR
VAR
	_p: POINTER TO BYTE;
	_length: UDINT;
	_allZero: BOOL;
	_version: BYTE;
	_flags: BYTE;
	_traceId: FB_TraceId;
	_spanId: FB_SpanId;
	_pTraceState: POINTER TO FB_TraceState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[extract := FALSE;
failureReason := E_PropagationFailureReason.NA;

IF pDest <> 0 THEN
	failureReason := E_PropagationFailureReason.DESTINATION_ALREADY_ASSIGNED;
	RETURN;
END_IF

// measured with LEN2, because LEN stops at 255 characters
_p := ADR(traceparent);
_length := TO_UDINT(LEN2(_p));

IF _length = 0 THEN
	failureReason := E_PropagationFailureReason.TRACEPARENT_EMPTY;
	RETURN;
END_IF

IF _length < TRACEPARENT_LENGTH THEN
	failureReason := E_PropagationFailureReason.TRACEPARENT_LENGTH_INVALID;
	RETURN;
END_IF

// every field sits at a fixed offset, so validation is a bounded decode of 27 bytes
IF NOT _decodeHex(pText:=_p, nBytes:=1, pBytes:=ADR(_version)) OR_ELSE _version = 16#FF THEN
	failureReason := E_PropagationFailureReason.VERSION_INVALID;
	RETURN;
END_IF

// version 00 has no room for more fields
IF _version = 0 AND _length > TRACEPARENT_LENGTH THEN
	failureReason := E_PropagationFailureReason.TRACEPARENT_LENGTH_INVALID;
	RETURN;
END_IF

// a future version may add fields after the flags, each introduced by '-'
IF _p[TRACE_ID_OFFSET - 1] <> DELIMITER
	OR _p[SPAN_ID_OFFSET - 1] <> DELIMITER
	OR _p[FLAGS_OFFSET - 1] <> DELIMITER
	OR (_length > TRACEPARENT_LENGTH AND_THEN _p[TRACEPARENT_LENGTH] <> DELIMITER)
THEN
	failureReason := E_PropagationFailureReason.DELIMITER_INVALID;
	RETURN;
END_IF

IF NOT _decodeHex(
		pText:=_p + TRACE_ID_OFFSET,
		nBytes:=SIZEOF(_traceId.bytes),
		pBytes:=ADR(_traceId.bytes),
		allZero=>_allZero)
	OR _allZero
THEN
	failureReason := E_PropagationFailureReason.TRACE_ID_INVALID;
	RETURN;
END_IF

IF NOT _decodeHex(
		pText:=_p + SPAN_ID_OFFSET,
		nBytes:=SIZEOF(_spanId.bytes),
		pBytes:=ADR(_spanId.bytes),
		allZero=>_allZero)
	OR _allZero
THEN
	failureReason := E_PropagationFailureReason.SPAN_ID_INVALID;
	RETURN;
END_IF

IF NOT _decodeHex(pText:=_p + FLAGS_OFFSET, nBytes:=1, pBytes:=ADR(_flags)) THEN
	failureReason := E_PropagationFailureReason.TRACE_FLAGS_INVALID;
	RETURN;
END_IF

// the traceparent is good; an invalid tracestate leaves _pTraceState at 0 and is dropped
TraceStateFactory.parse(pDest:=_pTraceState, pHeader:=ADR(tracestate));

IF NOT ContextFactory.buildContext(
	pDest:=pDest,
	pTraceId:=ADR(_traceId),
	pSpanId:=ADR(_spanId),
	pTraceState:=_pTraceState,
	traceFlags:=TO_UDINT(_flags)
		OR TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_HAS_IS_REMOTE_MASK)
		OR TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_IS_REMOTE_MASK))
THEN
	failureReason := E_PropagationFailureReason.MEMORY_ALLOCATION_FAILURE;
END_IF

// the context holds its own copy of the trace state
IF _pTraceState <> 0 THEN _pTraceState^.delete(pSelf:=_pTraceState); END_IF

extract := failureReason = E_PropagationFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_decodeHex" Id="{6d3983a6-243c-4548-ab4a-7ab9b1a76c4a}">
      <Declaration><![CDATA[(*
	Decodes nBytes bytes from the 2 * nBytes hex characters at pText into pBytes. W3C allows
	only lowercase hex, so any other character fails. allZero reports whether every decoded
	byte is 0. nBytes comes from the fixed traceparent fields, so it is at most 16.
*)
METHOD _decodeHex : BOOL
VAR_INPUT
	pText: POINTER TO BYTE;
	nBytes: UDINT;
	pBytes: POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	allZero: BOOL;
END_VAR
VAR
	_i: UDINT;
	_high: BYTE;
	_low: BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_decodeHex := FALSE;
allZero := TRUE;

IF pText = 0 OR pBytes = 0 OR nBytes = 0 THEN
	RETURN;
END_IF

FOR _i := 0 TO nBytes - 1 DO
	_high := _hexValue(pText[2 * _i]);
	_low := _hexValue(pText[2 * _i + 1]);
	IF _high > 15 OR _low > 15 THEN
		RETURN;
	END_IF
	pBytes[_i] := SHL(_high, 4) OR _low;
	allZero := allZero AND pBytes[_i] = 0;
END_FOR

_decodeHex := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_hexValue" Id="{6de22d62-88b8-4880-b7d3-1e60d3f4dd47}">
      <Declaration><![CDATA[(* Returns the value of one lowercase hex digit, or 16#FF when c is not one. *)
METHOD _hexValue : BYTE
VAR_INPUT
	c: BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF c >= 16#30 AND c <= 16#39 THEN  // '0'..'9'
	_hexValue := c - 16#30;
ELSIF c >= 16#61 AND c <= 16#66 THEN  // 'a'..'f'
	_hexValue := c - 16#61 + 10;
ELSE
	_hexValue := 16#FF;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="inject" Id="{8b2bbc06-6d33-4c8c-8788-77aa1bb5c77a}">
      <Declaration><![CDATA[(*
	Writes a span context into a carrier, for an outbound call. The context is borrowed and not
	changed. The traceparent is version 00 with the low 8 bits of the trace
	flags, which are the W3C trace flags; the OTLP remote bits are not propagated. A trace state
	longer than MAX_TRACESTATE_LENGTH is shortened with TraceStateFactory.truncate, which drops
	whole entries as W3C requires, and a context without one writes ''. On failure both headers
	are left empty, so a caller never sends half a carrier.
*)
METHOD inject : BOOL
VAR_INPUT
	pContext: POINTER TO FB_SpanContext;
END_VAR
VAR_IN_OUT
	carrier: ST_TraceContextCarrier;
END_VAR
VAR_OUTPUT
	failureReason: E_PropagationFailureReason;
END_VAR
VAR
	_p: POINTER TO BYTE;
	_flags: BYTE;
	_pSource: POINTER TO FB_TraceState;
	_pShort: POINTER TO FB_TraceState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[inject := FALSE;
failureReason := E_PropagationFailureReason.NA;
carrier.traceparent := '';
carrier.tracestate := '';

IF pContext = 0 THEN
	failureReason := E_PropagationFailureReason.CONTEXT_POINTER_NULL;
	RETURN;
END_IF

IF NOT pContext^.isValid() THEN
	failureReason := E_PropagationFailureReason.CONTEXT_INVALID;
	RETURN;
END_IF

// the trace state first: it is the only step that can fail after validation
_pSource := pContext^.traceState;
IF _pSource <> 0 AND_THEN _pSource^.length > MAX_TRACESTATE_LENGTH THEN
	// the context's trace state was validated when it was parsed, so only allocation can fail
	IF NOT TraceStateFactory.truncate(pDest:=_pShort, pSrc:=_pSource, maxLength:=MAX_TRACESTATE_LENGTH) THEN
		failureReason := E_PropagationFailureReason.MEMORY_ALLOCATION_FAILURE;
		RETURN;
	END_IF
	_pSource := _pShort;  // 0 when no entry fits, which writes ''
END_IF
IF _pSource <> 0 THEN
	MEMCPY(destAddr:=ADR(carrier.tracestate), srcAddr:=_pSource^.pString, n:=_pSource^.length);
	_p := ADR(carrier.tracestate);
	_p[_pSource^.length] := 0;
END_IF
IF _pShort <> 0 THEN _pShort^.delete(pSelf:=_pShort); END_IF

// every field sits at a fixed offset: 00-<trace id>-<span id>-<flags>
_p := ADR(carrier.traceparent);
_p[0] := 16#30;  // '0'
_p[1] := 16#30;
_p[TRACE_ID_OFFSET - 1] := DELIMITER;
_encodeHex(pBytes:=ADR(pContext^.traceId.bytes), nBytes:=SIZEOF(pContext^.traceId.bytes), pText:=_p + TRACE_ID_OFFSET);
_p[SPAN_ID_OFFSET - 1] := DELIMITER;
_encodeHex(pBytes:=ADR(pContext^.spanId.bytes), nBytes:=SIZEOF(pContext^.spanId.bytes), pText:=_p + SPAN_ID_OFFSET);
_p[FLAGS_OFFSET - 1] := DELIMITER;
_flags := TO_BYTE(pContext^.traceFlags AND 16#FF);
_encodeHex(pBytes:=ADR(_flags), nBytes:=1, pText:=_p + FLAGS_OFFSET);
_p[TRACEPARENT_LENGTH] := 0;

inject := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_encodeHex" Id="{04d38baf-d8f3-43a7-a9b3-ca34ffd73f4a}">
      <Declaration><![CDATA[(*
	Writes nBytes bytes from pBytes as 2 * nBytes lowercase hex characters at pText, the only
	case W3C allows. nBytes comes from the fixed traceparent fields, so it is at most 16.
*)
METHOD _encodeHex
VAR_INPUT
	pBytes: POINTER TO BYTE;
	nBytes: UDINT;
	pText: POINTER TO BYTE;
END_VAR
VAR
	_i: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pBytes = 0 OR pText = 0 OR nBytes = 0 THEN
	RETURN;
END_IF

FOR _i := 0 TO nBytes - 1 DO
	pText[2 * _i] := _hexDigit(SHR(pBytes[_i], 4));
	pText[2 * _i + 1] := _hexDigit(pBytes[_i] AND 16#0F);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="_hexDigit" Id="{b74ca361-04cf-41ac-9add-3846f11c8a04}">
      <Declaration><![CDATA[(* Returns the lowercase hex character for a value from 0 to 15. *)
METHOD _hexDigit : BYTE
VAR_INPUT
	value: BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF value < 10 THEN
	_hexDigit := 16#30 + value;  // '0'..'9'
ELSE
	_hexDigit := 16#57 + value;  // 'a'..'f': 16#61 - 10
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>