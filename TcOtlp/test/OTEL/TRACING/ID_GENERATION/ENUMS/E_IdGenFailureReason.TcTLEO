<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_IdGenFailureReason" Id="{9278004f-779f-4ad2-a921-a0e4dfcd69b1}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_IdGenFailureReason :
(
	NA := 0,  // No failure occurred.
	NO_IDENTIFIERS_AVAILABLE,  // The chunk list held too few chunks; the caller must retry on a later cycle.
	GUID_SERVICE_FAILED,  // The TwinCAT GUID service reported an error while the list was being refilled.
	MEMORY_ALLOCATION_FAILURE  // A chunk node or the staging block could not be allocated.
) UDINT;
END_TYPE
]]></Declaration>
