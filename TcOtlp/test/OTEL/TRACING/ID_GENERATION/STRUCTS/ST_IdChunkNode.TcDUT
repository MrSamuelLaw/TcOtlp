<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_IdChunkNode" Id="{7b3c05e1-9a42-4d18-8f6d-2c41e0b7a933}">
    <Declaration><![CDATA[(*
	One link in an identifier chunk list. Eight bytes is the width of a span id
	and half the width of a trace id, so every identifier the generator hands out
	is a whole number of chunks: one for a span id, two for a trace id.

	The bytes are stored inline rather than behind a PVOID, because a chunk is a
	fixed width value rather than an owned object. That keeps a chunk to a single
	allocation and lets the node itself be recycled once it has been drained.
*)
{attribute 'enable_dynamic_creation'}
TYPE ST_IdChunkNode :
STRUCT
	bytes: ARRAY [0..7] OF BYTE;
	nxt: POINTER TO ST_IdChunkNode;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>