<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_IdGenerator" Id="{247755bf-2c54-4ce4-86df-471d347cd20b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_IdGenerator EXTENDS FB_IdGenerator_Base
VAR CONSTANT
	GUID_BYTES: UDINT := 16;  // one guid, which is also the width of a trace id
END_VAR
VAR
	_creator: Tc2_System.FB_CreateGUID;
	_pBuffer: POINTER TO BYTE;
	_bufferLen: UDINT;
	_head: POINTER TO BYTE;
	_tail: POINTER TO BYTE;
	_count: UDINT;  // unread bytes, starting at _head
	_headRoom: UDINT;  // bytes from _head to the end of the ring, never zero
	_tailRoom: UDINT;  // bytes from _tail to the end of the ring, never zero
	_inFlight: UDINT;  // bytes the refill in flight will write at _tail, 0 when none is out
	_edgeHeld: BOOL;  // bExecute has been high for a cycle, so bBusy describes this request
END_VAR
VAR_OUTPUT
	errorId: UDINT;  // last ADS error reported by the guid service, 0 when healthy
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_take" Id="{b4e523c2-a600-4b42-96b8-2fe42af6e104}">
      <Declaration><![CDATA[(* Cuts nBytes off the head of the ring into pDest, which must have room for them.
   pDest is borrowed for the duration of the call and never taken. *)
METHOD _take : BOOL
VAR_INPUT
	pDest: POINTER TO BYTE;
	nBytes: UDINT;
END_VAR
VAR_OUTPUT
	failureReason: E_IdGenFailureReason;
END_VAR
VAR
	_first: UDINT;  // bytes of the draw that lie ahead of _head, before the ring wraps
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_take := FALSE;
failureReason := E_IdGenFailureReason.NA;

IF NOT THIS^.configValid THEN
	failureReason := E_IdGenFailureReason.INVALID_CONFIGUATION;
	RETURN;
END_IF

// a draw wider than the ring itself can never be served, however long the caller waits,
// so it is reported as the configuration mistake it is rather than as an empty ring
IF (pDest = 0) OR_ELSE (nBytes = 0) OR_ELSE (nBytes > THIS^._bufferLen) THEN
	failureReason := E_IdGenFailureReason.INVALID_CONFIGUATION;
	RETURN;
END_IF

// nothing is written until the draw is known to be servable, which is what leaves the
// caller's identifier untouched on failure
IF THIS^._count < nBytes THEN
	failureReason := E_IdGenFailureReason.NO_IDENTIFIERS_AVAILABLE;
	RETURN;
END_IF

// a draw may straddle the wrap, so it is stitched from the bytes ahead of _head and, once
// those run out, the bytes at the start of the ring. A refill is never stitched this way,
// which is why only this side of the ring has to know about the seam.
_first := THIS^._headRoom;
IF _first > nBytes THEN
	_first := nBytes;
END_IF

MEMCPY(pDest, THIS^._head, _first);
IF _first < nBytes THEN
	MEMCPY(pDest + _first, THIS^._pBuffer, nBytes - _first);
END_IF

// Advance the read point over what was taken. _tail is deliberately left alone: that is
// what keeps the destination of a refill in flight from moving out from under it.
IF _first < THIS^._headRoom THEN
	THIS^._head := THIS^._head + nBytes;
	THIS^._headRoom := THIS^._headRoom - nBytes;
ELSE
	// the draw reached the end of the ring, so reading resumes at its start
	THIS^._head := THIS^._pBuffer + (nBytes - _first);
	THIS^._headRoom := THIS^._bufferLen - (nBytes - _first);
END_IF

THIS^._count := THIS^._count - nBytes;
_take := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="configValid" Id="{57923c4f-63e4-49ec-a270-e59223c02484}">
      <Declaration><![CDATA[PROPERTY configValid : BOOL]]></Declaration>
      <Get Name="Get" Id="{f6e9c601-59e8-44cf-95ac-d13b9ba383c0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[configValid := THIS^._pBuffer <> 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Exit" Id="{3f101495-c416-4f2c-8d67-4492979c7da2}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{3766ca50-80c3-4bab-8f00-1d53888f0851}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	nTraceIds: UDINT;
	nSpanIds: UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (NOT bInCopyCode) AND nTraceIds > 0 AND nSpanIds > 0 THEN
	THIS^._bufferLen := ((nTraceIds*16) + (nSpanIds*8));

	// the ring grows up to a whole number of guids. The guid service writes nothing smaller
	// than one, so a remainder shorter than a guid could never be filled, and because the
	// fill point cannot skip over a hole the ring would strand at the wrap.
	IF (THIS^._bufferLen MOD GUID_BYTES) <> 0 THEN
		THIS^._bufferLen := THIS^._bufferLen + (GUID_BYTES - (THIS^._bufferLen MOD GUID_BYTES));
	END_IF

	THIS^._pBuffer := __NEW(BYTE, THIS^._bufferLen);
	THIS^._head := THIS^._pBuffer;
	THIS^._tail := THIS^._pBuffer;
	THIS^._headRoom := THIS^._bufferLen;
	THIS^._tailRoom := THIS^._bufferLen;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{6a89e62b-508d-4218-a6b2-3062ce1cd402}">
      <Declaration><![CDATA[(*
	Releases the ring and resets every cursor into it. Safe to call more than once.
	A refill still in flight is abandoned: tick stops calling the guid service once
	configValid is FALSE, so the service is never handed the released buffer again.
*)
METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._pBuffer <> 0 THEN
	__DELETE(THIS^._pBuffer);
	THIS^._pBuffer := 0;
END_IF
THIS^._bufferLen := 0;
THIS^._head := 0;
THIS^._tail := 0;
THIS^._count := 0;
THIS^._headRoom := 0;
THIS^._tailRoom := 0;
THIS^._inFlight := 0;
THIS^._edgeHeld := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="generateSpanId" Id="{a1649896-d9b4-41a0-a667-cd16105ad130}">
      <Declaration><![CDATA[METHOD generateSpanId : BOOL
VAR_IN_OUT
	spanId: FB_SpanId;
END_VAR
VAR_OUTPUT
	failureReason: E_IdGenFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// the identifier states its own width, so the draw is eight bytes without anyone here
// having to name the number
generateSpanId := THIS^._take(
	pDest:=ADR(spanId.bytes),
	nBytes:=TO_UDINT(SIZEOF(spanId.bytes)),
	failureReason=>failureReason
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="generateTraceId" Id="{374e4c73-f033-4ea3-98a7-72d6561ec040}">
      <Declaration><![CDATA[METHOD generateTraceId : BOOL
VAR_IN_OUT
	traceId: FB_TraceId;
END_VAR
VAR_OUTPUT
	failureReason: E_IdGenFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// sixteen bytes, taken from the same ring as a span id, because the two identifiers are
// only different widths of the same random bytes
generateTraceId := THIS^._take(
	pDest:=ADR(traceId.bytes),
	nBytes:=TO_UDINT(SIZEOF(traceId.bytes)),
	failureReason=>failureReason
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="tick" Id="{e53be0b2-b8ae-4045-9151-b17dfae83dad}">
      <Declaration><![CDATA[(* Drives the refill request that keeps the ring populated. *)
METHOD tick : BOOL
VAR_OUTPUT
	failureReason: E_IdGenFailureReason;
END_VAR
VAR
	_room: UDINT;  // bytes the next refill may claim, before it is cut to whole guids
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tick := FALSE;
failureReason := E_IdGenFailureReason.NA;

IF NOT THIS^.configValid THEN
	failureReason := E_IdGenFailureReason.INVALID_CONFIGUATION;
	RETURN;
END_IF

// The service writes one contiguous region, so a refill starts at _tail and stops at the
// end of the ring. Free space on the far side of the wrap is left to the refill after this
// one, because filling that side first would leave a hole at _tail and a ring has no way
// to describe a hole.
//
// The service is only ever handed the region _inFlight claims, which is what proves the
// region lies inside the allocation, and its length is remembered rather than recomputed
// because takes move _head while the request is out. A take never moves _tail, so the
// destination cannot shift out from under a request in flight.
THIS^._creator(
	bExecute := (THIS^._inFlight > 0),
	pGuidBuffer := THIS^._tail,
	nGuidBufferSize := THIS^._inFlight
);

IF THIS^._inFlight = 0 THEN
	// Nothing is out, so claim the room from _tail to the end of the ring, bounded by the
	// free space when that runs out first and cut to whole guids. bExecute is only raised by
	// the call above on the next cycle, which leaves the service a low cycle to see the edge.
	_room := THIS^._bufferLen - THIS^._count;
	IF _room > THIS^._tailRoom THEN
		_room := THIS^._tailRoom;
	END_IF
	THIS^._inFlight := (_room / GUID_BYTES) * GUID_BYTES;

ELSIF NOT THIS^._edgeHeld THEN
	// bBusy does not describe this request until the service has seen bExecute high
	THIS^._edgeHeld := TRUE;

ELSIF THIS^._creator.bError THEN
	// a failed request never advances _count, so the bytes it did not write are never
	// handed out as identifiers
	THIS^.errorId := THIS^._creator.nErrorId;
	THIS^._inFlight := 0;
	THIS^._edgeHeld := FALSE;
	failureReason := E_IdGenFailureReason.GUID_SERVICE_FAILED;
	RETURN;

ELSIF NOT THIS^._creator.bBusy THEN
	// the bytes are written, so publish them by advancing the fill point over them
	THIS^.errorId := 0;
	THIS^._count := THIS^._count + THIS^._inFlight;
	THIS^._tail := THIS^._tail + THIS^._inFlight;
	THIS^._tailRoom := THIS^._tailRoom - THIS^._inFlight;
	IF THIS^._tailRoom = 0 THEN
		THIS^._tail := THIS^._pBuffer;
		THIS^._tailRoom := THIS^._bufferLen;
	END_IF
	THIS^._inFlight := 0;
	THIS^._edgeHeld := FALSE;
END_IF

tick := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>