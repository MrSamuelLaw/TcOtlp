<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Span" Id="{17f1f0c3-d0bd-4cc5-82c0-c953a2faa69b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Span
VAR_OUTPUT
	// required
	traceId: POINTER TO FB_TraceId;
	spanId: POINTER TO FB_SpanId;
	traceState: POINTER TO FB_String;
	name: POINTER TO FB_String;
	startTimestamp: ULINT;
	endTimestamp: ULINT;
	attributes: FB_Attributes(maxCount := TcOtlp_GVL.DEFAULT_MAX_ATTRIBUTE_COUNT);

	// required if child span, must be omitted if root span
	parentSpanId: POINTER TO FB_SpanId;
	status: POINTER TO FB_Status;
	links: FB_Links;
	kind: E_SpanKind;

	// span events have been deprecated, instead logs should be emitted with span context for correlation
	// events
	// droppedEventCount
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="getContext" Id="{c5876f4b-23a6-45db-a39c-b8f6e2695806}">
      <Declaration><![CDATA[(*
	Allocates a snapshot of this span's identity through ContextFactory. The caller owns pDest.
	The span is the producer, and its identifiers come from the id generator, which only hands
	out valid ones, so they are not checked again here.
*)
METHOD getContext : BOOL
VAR_IN_OUT
	pDest: POINTER TO FB_SpanContext;
END_VAR
VAR_OUTPUT
	failureReason: E_ContextFactoryFailureReason;
END_VAR
VAR
	_pTraceState: POINTER TO STRING;
	_traceFlags: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.traceState <> 0 THEN
	_pTraceState := THIS^.traceState^.pString;
END_IF

// a span's own flags describe its parent's remoteness; its context is local, so keep only
// the W3C trace flags and mark remoteness as known and not remote
_traceFlags := (THIS^.flags AND TO_UDINT(E_SpanFlags.SPAN_FLAGS_TRACE_FLAGS_MASK))
	OR TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_HAS_IS_REMOTE_MASK);

getContext := ContextFactory.buildContext(
	pDest:=pDest,
	pTraceId:=THIS^.traceId,
	pSpanId:=THIS^.spanId,
	pTraceState:=_pTraceState,
	traceFlags:=_traceFlags,
	failureReason=>failureReason
);]]></ST>
      </Implementation>
    </Method>
    <Property Name="flags" Id="{137dd82b-00cb-4635-988f-dcdef800cd46}">
      <Declaration><![CDATA[PROPERTY flags : UDINT]]></Declaration>
      <Get Name="Get" Id="{3665a6ba-0b31-43b1-9658-363b8500b852}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="setStatusError" Id="{c18bedc1-4f05-4485-a503-1630f73f361d}">
      <Declaration><![CDATA[METHOD setStatusError : REFERENCE TO FB_Span
VAR_INPUT
	message: T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// uses the fluent API to set the status to error with the message for why it failed
setStatusError REF= THIS^;

// try to create the object with using short circuit evaluation]]></ST>
      </Implementation>
    </Method>
    <Method Name="setStatusOk" Id="{51e24243-7fdc-4bd7-ac3c-dc78a2884df3}">
      <Declaration><![CDATA[METHOD setStatusOk : REFERENCE TO FB_Span
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// uses the fluent API to set the status to OK
setStatusOk REF= THIS^;

// try to create the object with using short circuit evaluation
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>