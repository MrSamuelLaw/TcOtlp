<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Span" Id="{17f1f0c3-d0bd-4cc5-82c0-c953a2faa69b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	One timed operation in a trace. Unlike a log record, a span has a lifecycle:
	  building - FB_Tracer owns it while the fluent chain fills it in,
	  running  - build hands it to the caller, who owns it while the work runs,
	  ended    - FB_Tracer.endSpan hands it to the provider for processing.
	The span owns every pointer member and releases them in free.
*)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_Span
VAR_INPUT
	// written by the tracer while the span is built
	name: POINTER TO FB_String;
	kind: E_SpanKind;
	startTimestamp: ULINT;
	endTimestamp: ULINT;
	traceId: POINTER TO FB_TraceId;
	spanId: POINTER TO FB_SpanId;
	traceState: POINTER TO FB_String;

	// required if child span, must be omitted if root span
	parentSpanId: POINTER TO FB_SpanId;

	// describes the parent's remoteness, not this span's; see E_SpanFlags
	flags: UDINT;
	status: POINTER TO FB_Status;
END_VAR
VAR_OUTPUT
	attributes: FB_Attributes(maxCount := TcOtlp_GVL.DEFAULT_MAX_ATTRIBUTE_COUNT);
	links: FB_Links(maxCount := TcOtlp_GVL.DEFAULT_MAX_LINK_COUNT);
	resource: FB_Resource('');
	scope: FB_InstrumentationScope('', '', '');

	// span events have been deprecated, instead logs should be emitted with span context for correlation
	// events
	// droppedEventCount
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="delete" Id="{6a97f055-36d8-4285-ad6e-08b9d3bfdaaf}">
      <Declaration><![CDATA[(*
	Releases this span and clears the caller's pointer to it: call it as p^.delete(pSelf:=p).
	pSelf is cleared before the span is freed, so the caller never keeps a dangling pointer.
	A pointer to any other object is refused and left untouched, and nothing is released.
*)
METHOD delete : BOOL
VAR_IN_OUT
	pSelf: POINTER TO FB_Span;
END_VAR
VAR
	_pThis: POINTER TO FB_Span;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_pThis := THIS;
IF pSelf <> _pThis THEN
	RETURN;
END_IF

pSelf := 0;
__DELETE(_pThis);
delete := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{fa780cfa-04fb-4c49-bd4c-b4e50dffd866}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{8eaa02b8-df25-4adc-9c37-d019075ce71f}">
      <Declaration><![CDATA[(* Releases everything the span owns. Safe to call more than once. *)
METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.name <> 0 THEN THIS^.name^.delete(pSelf:=THIS^.name); END_IF
IF THIS^.traceId <> 0 THEN THIS^.traceId^.delete(pSelf:=THIS^.traceId); END_IF
IF THIS^.spanId <> 0 THEN THIS^.spanId^.delete(pSelf:=THIS^.spanId); END_IF
IF THIS^.traceState <> 0 THEN THIS^.traceState^.delete(pSelf:=THIS^.traceState); END_IF
IF THIS^.parentSpanId <> 0 THEN THIS^.parentSpanId^.delete(pSelf:=THIS^.parentSpanId); END_IF
IF THIS^.status <> 0 THEN THIS^.status^.delete(pSelf:=THIS^.status); END_IF
THIS^.attributes.free();
THIS^.links.free();
THIS^.scope.free();
THIS^.resource.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="getContext" Id="{c5876f4b-23a6-45db-a39c-b8f6e2695806}">
      <Declaration><![CDATA[(*
	Allocates a snapshot of this span's identity through ContextFactory. The caller owns pDest.
	The span is the producer, and its identifiers come from the id generator, which only hands
	out valid ones, so they are not checked again here.
*)
METHOD getContext : BOOL
VAR_IN_OUT
	pDest: POINTER TO FB_SpanContext;
END_VAR
VAR_OUTPUT
	failureReason: E_ContextFactoryFailureReason;
END_VAR
VAR
	_pTraceState: POINTER TO STRING;
	_traceFlags: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.traceState <> 0 THEN
	_pTraceState := THIS^.traceState^.pString;
END_IF

// a span's own flags describe its parent's remoteness; its context is local, so keep only
// the W3C trace flags and mark remoteness as known and not remote
_traceFlags := (THIS^.flags AND TO_UDINT(E_SpanFlags.SPAN_FLAGS_TRACE_FLAGS_MASK))
	OR TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_HAS_IS_REMOTE_MASK);

getContext := ContextFactory.buildContext(
	pDest:=pDest,
	pTraceId:=THIS^.traceId,
	pSpanId:=THIS^.spanId,
	pTraceState:=_pTraceState,
	traceFlags:=_traceFlags,
	failureReason=>failureReason
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="setStatusError" Id="{c18bedc1-4f05-4485-a503-1630f73f361d}">
      <Declaration><![CDATA[METHOD setStatusError : REFERENCE TO FB_Span
VAR_INPUT
	message: T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// uses the fluent API to set the status to error with the message for why it failed
setStatusError REF= THIS^;

// try to create the object with using short circuit evaluation]]></ST>
      </Implementation>
    </Method>
    <Method Name="setStatusOk" Id="{51e24243-7fdc-4bd7-ac3c-dc78a2884df3}">
      <Declaration><![CDATA[METHOD setStatusOk : REFERENCE TO FB_Span
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// uses the fluent API to set the status to OK
setStatusOk REF= THIS^;

// try to create the object with using short circuit evaluation]]></ST>
      </Implementation>
    </Method>
    <Method Name="cloneTo" Id="{8a52cd95-727f-4d26-979c-15f2ccdc0c38}">
      <Declaration><![CDATA[(*
	Allocates a deep copy of this span, for a processor that keeps an ended span past onEnd.
	The copy owns copies of every member, so it stays valid after this span is released. This
	span is only read, apart from its links cursor. The caller owns pDest, which must be 0; on
	failure nothing is allocated and pDest is left alone.
*)
METHOD cloneTo : BOOL
VAR_IN_OUT
	pDest: POINTER TO FB_Span;
END_VAR
VAR_OUTPUT
	failureReason: E_SpanCloneFailureReason;
END_VAR
VAR
	_pClone: POINTER TO FB_Span;
	_pMessage: POINTER TO FB_String;
	_copied: BOOL;
	_attributesFailureReason: E_AttributesFailureReason;
	_linkFailureReason: E_LinkFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[cloneTo := FALSE;
failureReason := E_SpanCloneFailureReason.NA;

IF pDest <> 0 THEN
	failureReason := E_SpanCloneFailureReason.DESTINATION_ALREADY_ASSIGNED;
	RETURN;
END_IF

_pClone := __NEW(FB_Span);
IF _pClone = 0 THEN
	failureReason := E_SpanCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

// the clone owns its members from here, so deleting it releases whatever was copied
_pClone^.kind := THIS^.kind;
_pClone^.startTimestamp := THIS^.startTimestamp;
_pClone^.endTimestamp := THIS^.endTimestamp;
_pClone^.flags := THIS^.flags;

_copied := (THIS^.name = 0 OR_ELSE ValueFactory.cloneString(
		pDest:=_pClone^.name,
		pSrc:=THIS^.name))
	AND_THEN (THIS^.traceId = 0 OR_ELSE ValueFactory.createTraceId(
		pDest:=_pClone^.traceId,
		pBytes:=ADR(THIS^.traceId^.bytes),
		nSize:=SIZEOF(THIS^.traceId^.bytes)))
	AND_THEN (THIS^.spanId = 0 OR_ELSE ValueFactory.createSpanId(
		pDest:=_pClone^.spanId,
		pBytes:=ADR(THIS^.spanId^.bytes),
		nSize:=SIZEOF(THIS^.spanId^.bytes)))
	AND_THEN (THIS^.parentSpanId = 0 OR_ELSE ValueFactory.createSpanId(
		pDest:=_pClone^.parentSpanId,
		pBytes:=ADR(THIS^.parentSpanId^.bytes),
		nSize:=SIZEOF(THIS^.parentSpanId^.bytes)))
	AND_THEN (THIS^.traceState = 0 OR_ELSE ValueFactory.cloneString(
		pDest:=_pClone^.traceState,
		pSrc:=THIS^.traceState))
	AND_THEN (THIS^.status = 0 OR_ELSE THIS^.status^.message = 0 OR_ELSE ValueFactory.cloneString(
		pDest:=_pMessage,
		pSrc:=THIS^.status^.message));
IF NOT _copied THEN
	IF _pMessage <> 0 THEN _pMessage^.delete(pSelf:=_pMessage); END_IF
	_pClone^.delete(pSelf:=_pClone);
	failureReason := E_SpanCloneFailureReason.VALUE_COPY_FAILURE;
	RETURN;
END_IF

IF THIS^.status <> 0 THEN
	_pClone^.status := __NEW(FB_Status(code:=THIS^.status^.code, message:=_pMessage));
	IF _pClone^.status = 0 THEN
		IF _pMessage <> 0 THEN _pMessage^.delete(pSelf:=_pMessage); END_IF
		_pClone^.delete(pSelf:=_pClone);
		failureReason := E_SpanCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
		RETURN;
	END_IF
	_pMessage := 0;  // moved into the status
END_IF

IF NOT _pClone^.attributes.copyFrom(src:=THIS^.attributes, failureReason=>_attributesFailureReason) THEN
	_pClone^.delete(pSelf:=_pClone);
	IF _attributesFailureReason = E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		failureReason := E_SpanCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		failureReason := E_SpanCloneFailureReason.ATTRIBUTE_COPY_FAILURE;
	END_IF
	RETURN;
END_IF

IF NOT _pClone^.links.copyFrom(src:=THIS^.links, failureReason=>_linkFailureReason) THEN
	_pClone^.delete(pSelf:=_pClone);
	IF _linkFailureReason = E_LinkFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		failureReason := E_SpanCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		failureReason := E_SpanCloneFailureReason.LINK_COPY_FAILURE;
	END_IF
	RETURN;
END_IF

IF NOT _pClone^.resource.copyFrom(src:=THIS^.resource, failureResult=>_attributesFailureReason) THEN
	_pClone^.delete(pSelf:=_pClone);
	IF _attributesFailureReason = E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		failureReason := E_SpanCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		failureReason := E_SpanCloneFailureReason.RESOURCE_COPY_FAILURE;
	END_IF
	RETURN;
END_IF

IF NOT _pClone^.scope.copyFrom(src:=THIS^.scope, failureResult=>_attributesFailureReason) THEN
	_pClone^.delete(pSelf:=_pClone);
	IF _attributesFailureReason = E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		failureReason := E_SpanCloneFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		failureReason := E_SpanCloneFailureReason.SCOPE_COPY_FAILURE;
	END_IF
	RETURN;
END_IF

// transfer ownership to the caller
pDest := _pClone;
_pClone := 0;
cloneTo := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>