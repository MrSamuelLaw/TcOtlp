<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_SpanQueueFailureReason" Id="{93cb79ea-577e-41d4-b09a-1fe007836e3a}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_SpanQueueFailureReason :
(
	NA := 0,  // No failure occurred.
	SPAN_POINTER_NULL,  // The supplied span pointer is null.
	DESTINATION_ALREADY_ASSIGNED,  // The pop destination pointer is already assigned.
	QUEUE_EMPTY,  // The queue contains no span to pop.
	MAX_SIZE_ENFORCEMENT_FAILURE,  // The bounded eviction loop could not restore the configured maximum size.
	MEMORY_ALLOCATION_FAILURE,  // Dynamic node allocation failed.
	SELF_TRANSFER_NOT_ALLOWED,  // transferTo was asked to move spans into the same queue.
	DESTINATION_NOT_EMPTY  // transferTo needs an empty destination queue.
) UDINT;
END_TYPE
]]></Declaration>
