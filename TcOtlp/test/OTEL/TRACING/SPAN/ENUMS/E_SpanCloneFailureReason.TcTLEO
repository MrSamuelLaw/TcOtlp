<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_SpanCloneFailureReason" Id="{24d919e3-2dba-49a9-8664-d28c05ccd330}">
    <Declaration><![CDATA[(* Why FB_Span.cloneTo could not copy a span. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_SpanCloneFailureReason :
(
	NA := 0,  // No failure occurred.
	DESTINATION_ALREADY_ASSIGNED,  // The destination pointer was not 0.
	MEMORY_ALLOCATION_FAILURE,  // Dynamic memory allocation failed.
	VALUE_COPY_FAILURE,  // The name, an identifier, the trace state or the status message could not be copied.
	ATTRIBUTE_COPY_FAILURE,  // The span attributes could not be copied.
	LINK_COPY_FAILURE,  // A span link could not be copied.
	RESOURCE_COPY_FAILURE,  // The resource could not be copied.
	SCOPE_COPY_FAILURE  // The instrumentation scope could not be copied.
) UDINT;
END_TYPE
]]></Declaration>
