  <EnumerationTextList Name="E_ContextFactoryFailureReason" Id="{bdc5cc5d-a69e-4dab-82a8-967211c832aa}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_ContextFactoryFailureReason :
(
	NA := 0,  // No failure occurred.
	DESTINATION_ALREADY_ASSIGNED,  // The destination pointer was already assigned when the operation began.
	TRACE_ID_POINTER_NULL,  // The trace ID pointer is null.
	SPAN_ID_POINTER_NULL,  // The span ID pointer is null.
	MEMORY_ALLOCATION_FAILURE,  // Dynamic memory allocation failed.
	SPAN_POINTER_NULL  // fromSpan was given a null span pointer.
);
END_TYPE
]]></Declaration>
