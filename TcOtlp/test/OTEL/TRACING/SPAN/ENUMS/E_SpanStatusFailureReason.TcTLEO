<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_SpanStatusFailureReason" Id="{7a711ea7-060b-45e1-adb2-42f4a0969f94}">
    <Declaration><![CDATA[(* Why FB_Span.setStatusOk or setStatusError left the status unchanged. *)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_SpanStatusFailureReason :
(
	NA := 0,  // No failure occurred.
	STATUS_ALREADY_OK,  // The status is already OK, which is final; the error was ignored.
	MEMORY_ALLOCATION_FAILURE  // Dynamic memory allocation failed; the previous status is kept.
) UDINT;
END_TYPE
]]></Declaration>
