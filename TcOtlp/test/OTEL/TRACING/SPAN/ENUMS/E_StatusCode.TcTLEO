  <EnumerationTextList Name="E_StatusCode" Id="{70f76ffd-034a-4837-8b5d-1d5f06ebc552}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_StatusCode :
(
	// The default status.
    STATUS_CODE_UNSET              := 0,
    // The Span has been validated by an Application developer or Operator to 
    // have completed successfully.
    STATUS_CODE_OK                  := 1,
    // The Span contains an error.
    STATUS_CODE_ERROR               := 2,
);
END_TYPE
]]></Declaration>
