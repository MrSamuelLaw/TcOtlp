<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_SpanFlags" Id="{6480f056-bac2-4a45-ba58-960deaf1b484}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_SpanFlags:
(
	  // The zero value for the enum. Should not be used for comparisons.
	  // Instead use bitwise "and" with the appropriate mask as shown above.
	  SPAN_FLAGS_DO_NOT_USE := 16#0,
	
	  // Bits 0-7 are used for trace flags.
	  SPAN_FLAGS_TRACE_FLAGS_MASK := 16#000000FF,
	
	  // Bits 8 and 9 are used to indicate that the parent span or link span is remote.
	  // Bit 8 (`HAS_IS_REMOTE`) indicates whether the value is known.
	  // Bit 9 (`IS_REMOTE`) indicates whether the span or link is remote.
	  SPAN_FLAGS_CONTEXT_HAS_IS_REMOTE_MASK := 16#00000100,
	  SPAN_FLAGS_CONTEXT_IS_REMOTE_MASK := 16#00000200
	
	  // Bits 10-31 are reserved for future use.
) UDINT;
END_TYPE
]]></Declaration>
