<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <EnumerationTextList Name="E_TracerFailureReason" Id="{ce4006ec-8370-412c-bd90-7e50ec8bff83}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_TracerFailureReason :
(
	NA := 0,  // No failure occurred.
	SPAN_ALREADY_STARTED,  // startSpan was called while a span was still being built.
	SPAN_NOT_STARTED,  // No span is being built to modify or hand over.
	SPAN_NAME_EMPTY,  // The span name is empty.
	SPAN_KIND_UNSPECIFIED,  // SPAN_KIND_UNSPECIFIED was given; OTLP says not to use it.
	PARENT_CONTEXT_POINTER_NULL,  // The parent context pointer is null.
	PARENT_CONTEXT_INVALID,  // The parent context has an all zero trace id or span id.
	ATTRIBUTE_VALUE_INVALID,  // An attribute could not be created from the supplied value.
	ATTRIBUTE_VALUE_TYPE_UNSUPPORTED,  // The supplied attribute value type is not supported.
	ATTRIBUTE_COUNT_LIMIT_REACHED,  // The span cannot own another attribute.
	DESTINATION_ALREADY_ASSIGNED,  // The destination pointer was already assigned when build began.
	IDENTIFIERS_UNAVAILABLE,  // The id generator had no identifiers ready; retry on a later cycle.
	ID_GENERATION_FAILURE,  // The id generator failed for another reason.
	SNAPSHOT_COPY_FAILURE,  // The resource or instrumentation-scope snapshot could not be copied.
	MEMORY_ALLOCATION_FAILURE,  // Dynamic memory allocation failed.
	SPAN_POINTER_NULL,  // A method for a running span, such as endSpan, was given a null span pointer.
	TRANSFER_TO_PROVIDER_FAILURE,  // The provider could not queue the ended span, so it was released.
	LINK_CONTEXT_POINTER_NULL,  // addLink was given a null span context pointer.
	LINK_CONTEXT_INVALID,  // The linked context has an all zero trace id or span id.
	LINK_COUNT_LIMIT_REACHED,  // The span cannot own another link.
	PARENT_SPAN_POINTER_NULL,  // setParentUsingSpan was given a null span pointer.
	PARENT_SPAN_INVALID,  // The parent span has not been built, so it has no trace id or span id.
	SPAN_STATUS_ALREADY_SET,  // The span already has a status, and the first one set wins.
	SPAN_INVALID,  // The span has not been built, so it has no trace id or span id.
	LINK_POINTER_NULL  // pushSpanLink was given a null link pointer.
) UDINT;
END_TYPE
]]></Declaration>
