<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Tracer" Id="{630c4506-e919-4bcb-bc32-932a851a5f73}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	Builds spans with the same fluent chain FB_Logger uses for log records, validating each
	step as it runs. The first failure is kept for the rest of the chain.

	The difference from the logger is the end of the chain: emit pushes a log record to the
	provider, but build hands the span to the caller, because a span starts running when it is
	built and ends later. endSpan then pushes the span to the provider.

	Example:
	IF NOT tracer
		.startSpan(name := 'chiller.startup', kind := E_SpanKind.SPAN_KIND_CONSUMER)
		.setParentUsingContext(pContext := pParentContext)
		.addLink(pContext := pTriggerContext)
		.setStringAttribute('skid', 'A')
		.build(pDest := pSpan, failureReason => reason) THEN
		// CASE reason OF ...
	END_IF
	// ... the work the span measures ...
	tracer.setSpanStatusOk(pSpan := pSpan);
	tracer.endSpan(pSpan := pSpan);

	A running span is read and changed only through the tracer, never through the span pointer:
	getSpanContext, addSpanLink, pushSpanLink, setSpanStringAttribute, setSpanNumberAttribute,
	setSpanStatusOk, setSpanStatusError, endSpan and discardSpan. The caller does not need to
	check the pointer first, because each refuses a null span with SPAN_POINTER_NULL. None of
	them is part of the fluent chain, so they leave a span being built untouched.
*)
FUNCTION_BLOCK FB_Tracer
VAR_OUTPUT
	pSpan: POINTER TO FB_Span;  // the span being built; owned by the tracer until build
END_VAR
VAR
	_scope: REFERENCE TO FB_InstrumentationScope;
	_provider: REFERENCE TO FB_TracerProvider;
	_failed: BOOL;
	_failureReason: E_TracerFailureReason;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_assignIdentity" Id="{5d981575-a270-4c40-aadd-46952ff6e8ac}">
      <Declaration><![CDATA[(* Takes the span's identifiers from the provider's generator. A root span also gets a new
   trace id and root flags; a child already has both from setParentUsingContext or
   setParentUsingSpan. *)
METHOD _assignIdentity : BOOL
VAR_OUTPUT
	failureReason: E_TracerFailureReason;
END_VAR
VAR
	_traceId: FB_TraceId;
	_spanId: FB_SpanId;
	_pTraceId: POINTER TO FB_TraceId;
	_pSpanId: POINTER TO FB_SpanId;
	_idGenFailureReason: E_IdGenFailureReason;
	_factoryFailureReason: E_ValueFactoryFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_assignIdentity := FALSE;
failureReason := E_TracerFailureReason.NA;

// a root span starts a new trace; a child already carries its parent's trace id
IF THIS^.pSpan^.traceId = 0 THEN
	IF NOT THIS^._provider.idGenerator.generateTraceId(traceId:=_traceId, failureReason=>_idGenFailureReason) THEN
		failureReason := THIS^._mapIdGenFailure(_idGenFailureReason);
		RETURN;
	END_IF
	IF NOT ValueFactory.createTraceId(
		pDest:=_pTraceId,
		pBytes:=ADR(_traceId.bytes),
		nSize:=SIZEOF(_traceId.bytes),
		failureReason=>_factoryFailureReason
		) THEN
		failureReason := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
		RETURN;
	END_IF
END_IF

IF NOT THIS^._provider.idGenerator.generateSpanId(spanId:=_spanId, failureReason=>_idGenFailureReason) THEN
	IF _pTraceId <> 0 THEN _pTraceId^.delete(pSelf:=_pTraceId); END_IF
	failureReason := THIS^._mapIdGenFailure(_idGenFailureReason);
	RETURN;
END_IF
IF NOT ValueFactory.createSpanId(
	pDest:=_pSpanId,
	pBytes:=ADR(_spanId.bytes),
	nSize:=SIZEOF(_spanId.bytes),
	failureReason=>_factoryFailureReason
	) THEN
	IF _pTraceId <> 0 THEN _pTraceId^.delete(pSelf:=_pTraceId); END_IF
	failureReason := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

// transfer ownership of the identifiers to the span
IF _pTraceId <> 0 THEN
	THIS^.pSpan^.traceId := _pTraceId;
	_pTraceId := 0;
	// a root span has no parent, so remoteness is known and not remote; the sampler
	// decides the sampled bit in build
	THIS^.pSpan^.flags := TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_HAS_IS_REMOTE_MASK);
END_IF
THIS^.pSpan^.spanId := _pSpanId;
_pSpanId := 0;
_assignIdentity := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_mapAttributesFailure" Id="{ee682f42-b93c-489e-90fa-7ef0b9526bc6}">
      <Declaration><![CDATA[METHOD _mapAttributesFailure : E_TracerFailureReason
VAR_INPUT
	reason: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE reason OF
	E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE:
		_mapAttributesFailure := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
	E_AttributesFailureReason.ATTRIBUTE_COUNT_LIMIT_REACHED:
		_mapAttributesFailure := E_TracerFailureReason.ATTRIBUTE_COUNT_LIMIT_REACHED;
	E_AttributesFailureReason.KV_VALUE_TYPE_UNSUPPORTED:
		_mapAttributesFailure := E_TracerFailureReason.ATTRIBUTE_VALUE_TYPE_UNSUPPORTED;
ELSE
	_mapAttributesFailure := E_TracerFailureReason.ATTRIBUTE_VALUE_INVALID;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_mapIdGenFailure" Id="{3ca36015-f2e6-4b32-a77c-317ea2398a78}">
      <Declaration><![CDATA[METHOD _mapIdGenFailure : E_TracerFailureReason
VAR_INPUT
	reason: E_IdGenFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF reason = E_IdGenFailureReason.NO_IDENTIFIERS_AVAILABLE THEN
	_mapIdGenFailure := E_TracerFailureReason.IDENTIFIERS_UNAVAILABLE;
ELSIF reason = E_IdGenFailureReason.MEMORY_ALLOCATION_FAILURE THEN
	_mapIdGenFailure := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
ELSE
	_mapIdGenFailure := E_TracerFailureReason.ID_GENERATION_FAILURE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_mapLinkFailure" Id="{5dcfaca9-6471-413d-a911-4e1830b22161}">
      <Declaration><![CDATA[METHOD _mapLinkFailure : E_TracerFailureReason
VAR_INPUT
	reason: E_LinkFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE reason OF
	E_LinkFailureReason.CONTEXT_POINTER_NULL:
		_mapLinkFailure := E_TracerFailureReason.LINK_CONTEXT_POINTER_NULL;
	E_LinkFailureReason.CONTEXT_INVALID:
		_mapLinkFailure := E_TracerFailureReason.LINK_CONTEXT_INVALID;
	E_LinkFailureReason.LINK_COUNT_LIMIT_REACHED:
		_mapLinkFailure := E_TracerFailureReason.LINK_COUNT_LIMIT_REACHED;
	E_LinkFailureReason.LINK_POINTER_NULL:
		_mapLinkFailure := E_TracerFailureReason.LINK_POINTER_NULL;
ELSE
	_mapLinkFailure := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_now" Id="{da29f1f9-ee74-40a9-a16d-2bf3b2bd3607}">
      <Declaration><![CDATA[(* The current time in nanoseconds since the Unix epoch, as OTLP timestamps expect. *)
METHOD _now : ULINT
VAR CONSTANT
	UNIX_EPOCH_DIFF: ULINT := 116444736000000000;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_now := (F_GetSystemTime() - UNIX_EPOCH_DIFF) * 100;  // 100ns ticks since 1601 -> ns since 1970]]></ST>
      </Implementation>
    </Method>
    <Method Name="_setParent" Id="{3e8b6f1c-52a4-4d7e-9c1b-7f0d2a6e4b91}">
      <Declaration><![CDATA[(*
	Makes the span being built a child of the given identity. The inputs are borrowed: the span
	keeps its own copies of the trace id, parent span id and trace state. Everything is copied
	before the span is touched, so a failure leaves it unchanged and any earlier parent in place.
	A copy that fails for a reason other than allocation reports invalidReason.
*)
METHOD _setParent
VAR_INPUT
	pTraceId: POINTER TO FB_TraceId;
	pSpanId: POINTER TO FB_SpanId;
	pTraceState: POINTER TO FB_TraceState;  // 0 when the parent carries no trace state
	traceFlags: UDINT;
	isRemote: BOOL;
	invalidReason: E_TracerFailureReason;
END_VAR
VAR
	_pTraceId: POINTER TO FB_TraceId;
	_pParentSpanId: POINTER TO FB_SpanId;
	_pTraceState: POINTER TO FB_TraceState;
	_copied: BOOL;
	_flags: UDINT;
	_factoryFailureReason: E_ValueFactoryFailureReason;
	_traceStateFailureReason: E_TraceStateFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// copy everything before touching the span, so a failure leaves it unchanged
_copied := ValueFactory.createTraceId(
		pDest:=_pTraceId,
		pBytes:=ADR(pTraceId^.bytes),
		nSize:=SIZEOF(pTraceId^.bytes),
		failureReason=>_factoryFailureReason)
	AND_THEN ValueFactory.createSpanId(
		pDest:=_pParentSpanId,
		pBytes:=ADR(pSpanId^.bytes),
		nSize:=SIZEOF(pSpanId^.bytes),
		failureReason=>_factoryFailureReason)
	AND_THEN (pTraceState = 0 OR_ELSE TraceStateFactory.clone(
		pDest:=_pTraceState,
		pSrc:=pTraceState,
		failureReason=>_traceStateFailureReason));

IF NOT _copied THEN
	IF _pTraceId <> 0 THEN _pTraceId^.delete(pSelf:=_pTraceId); END_IF
	IF _pParentSpanId <> 0 THEN _pParentSpanId^.delete(pSelf:=_pParentSpanId); END_IF
	IF _pTraceState <> 0 THEN _pTraceState^.delete(pSelf:=_pTraceState); END_IF
	THIS^._failed := TRUE;
	IF _factoryFailureReason = E_ValueFactoryFailureReason.MEMORY_ALLOCATION_FAILURE
		OR _traceStateFailureReason = E_TraceStateFailureReason.MEMORY_ALLOCATION_FAILURE
	THEN
		THIS^._failureReason := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		THIS^._failureReason := invalidReason;
	END_IF
	RETURN;
END_IF

// replace any earlier parent
IF THIS^.pSpan^.traceId <> 0 THEN THIS^.pSpan^.traceId^.delete(pSelf:=THIS^.pSpan^.traceId); END_IF
IF THIS^.pSpan^.parentSpanId <> 0 THEN THIS^.pSpan^.parentSpanId^.delete(pSelf:=THIS^.pSpan^.parentSpanId); END_IF
IF THIS^.pSpan^.traceState <> 0 THEN THIS^.pSpan^.traceState^.delete(pSelf:=THIS^.pSpan^.traceState); END_IF

// transfer ownership of the copies to the span
THIS^.pSpan^.traceId := _pTraceId;
THIS^.pSpan^.parentSpanId := _pParentSpanId;
THIS^.pSpan^.traceState := _pTraceState;
_pTraceId := 0;
_pParentSpanId := 0;
_pTraceState := 0;

// a span's flags describe its parent: keep the parent's trace flags and record where it came from
_flags := (traceFlags AND TO_UDINT(E_SpanFlags.SPAN_FLAGS_TRACE_FLAGS_MASK))
	OR TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_HAS_IS_REMOTE_MASK);
IF isRemote THEN
	_flags := _flags OR TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_IS_REMOTE_MASK);
END_IF
THIS^.pSpan^.flags := _flags;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_shouldReturnEarly" Id="{88de3424-ad60-4c95-878e-159ca24c8617}">
      <Declaration><![CDATA[METHOD _shouldReturnEarly : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_shouldReturnEarly := TRUE;

// Preserve the first failure in the active fluent chain.
IF THIS^._failed THEN
	RETURN;
END_IF

// fail early if the span hasn't been started
IF THIS^.pSpan = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_TracerFailureReason.SPAN_NOT_STARTED;
	RETURN;
END_IF

_shouldReturnEarly := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="addLink" Id="{32899abc-ae3a-42d5-8087-1375b8ab333d}">
      <Declaration><![CDATA[(*
	Links the span to another span's context, for example the span that triggered this work
	in another trace. The context is borrowed: the link keeps its own copies. Links keep the
	order they are added in. A span holds at most TcOtlp_GVL.DEFAULT_MAX_LINK_COUNT links;
	adding one more fails the chain with LINK_COUNT_LIMIT_REACHED.
	To give a link attributes, build it with LinkFactory and add it to the running span with
	pushSpanLink instead.
*)
METHOD addLink : REFERENCE TO FB_Tracer
VAR_INPUT
	pContext: POINTER TO FB_SpanContext;
END_VAR
VAR
	_pLink: POINTER TO FB_Link;
	_linkFailureReason: E_LinkFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[addLink REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

IF LinkFactory.fromContext(pDest:=_pLink, pContext:=pContext, failureReason=>_linkFailureReason)
	AND_THEN THIS^.pSpan^.links.push(pValue:=_pLink, failureReason=>_linkFailureReason) THEN
	RETURN;
END_IF

// push leaves a refused link with the caller
IF _pLink <> 0 THEN _pLink^.delete(pSelf:=_pLink); END_IF
THIS^._failed := TRUE;
THIS^._failureReason := THIS^._mapLinkFailure(_linkFailureReason);]]></ST>
      </Implementation>
    </Method>
    <Method Name="addSpanLink" Id="{eb4e30c0-8f24-4a8f-8062-f3e33c1914e1}">
      <Declaration><![CDATA[(*
	Links a running span to another span's context. The context is borrowed: the link keeps its
	own copies. A span holds at most TcOtlp_GVL.DEFAULT_MAX_LINK_COUNT links; one more is
	refused with LINK_COUNT_LIMIT_REACHED. A null span is refused with SPAN_POINTER_NULL.
*)
METHOD addSpanLink : BOOL
VAR_INPUT
	pSpan: POINTER TO FB_Span;
	pContext: POINTER TO FB_SpanContext;
END_VAR
VAR_OUTPUT
	failureReason: E_TracerFailureReason;
END_VAR
VAR
	_pLink: POINTER TO FB_Link;
	_linkFailureReason: E_LinkFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[addSpanLink := FALSE;
failureReason := E_TracerFailureReason.NA;

IF pSpan = 0 THEN
	failureReason := E_TracerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF

IF LinkFactory.fromContext(pDest:=_pLink, pContext:=pContext, failureReason=>_linkFailureReason)
	AND_THEN pSpan^.links.push(pValue:=_pLink, failureReason=>_linkFailureReason) THEN
	addSpanLink := TRUE;
	RETURN;
END_IF

// push leaves a refused link with the caller
IF _pLink <> 0 THEN _pLink^.delete(pSelf:=_pLink); END_IF
failureReason := THIS^._mapLinkFailure(_linkFailureReason);]]></ST>
      </Implementation>
    </Method>
    <Method Name="build" Id="{3c8e8a79-eb89-4c0f-8f0e-dcaaee758df5}">
      <Declaration><![CDATA[(*
	Ends the chain. On success the span is running and owned by the caller: it moves to pDest,
	which must be 0, and pSpan is cleared. On failure the incomplete span is released, pDest is
	left alone, and the first failure in the chain is reported. Identifiers are only taken once
	everything before them has succeeded. The provider's sampler then makes the head sampling
	decision through onStart, with the parent, links and attributes already in place.
*)
METHOD build : BOOL
VAR_IN_OUT
	pDest: POINTER TO FB_Span;
END_VAR
VAR_OUTPUT
	failureReason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[build := FALSE;
failureReason := E_TracerFailureReason.NA;

IF NOT THIS^._failed THEN
	IF THIS^.pSpan = 0 THEN
		THIS^._failed := TRUE;
		THIS^._failureReason := E_TracerFailureReason.SPAN_NOT_STARTED;
	ELSIF pDest <> 0 THEN
		THIS^._failed := TRUE;
		THIS^._failureReason := E_TracerFailureReason.DESTINATION_ALREADY_ASSIGNED;
	ELSIF NOT THIS^._assignIdentity(failureReason=>THIS^._failureReason) THEN
		THIS^._failed := TRUE;
	END_IF
END_IF

IF THIS^._failed THEN
	// the chain ends here either way, so the incomplete span is released
	IF THIS^.pSpan <> 0 THEN THIS^.pSpan^.delete(pSelf:=THIS^.pSpan); END_IF
	failureReason := THIS^._failureReason;
ELSE
	THIS^._provider.sampler.onStart(span:=THIS^.pSpan^);
	// transfer ownership to the caller; the span is now running
	pDest := THIS^.pSpan;
	THIS^.pSpan := 0;
	build := TRUE;
END_IF

THIS^._failed := FALSE;
THIS^._failureReason := E_TracerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Method Name="discardSpan" Id="{742b2544-3074-4090-bcc6-0ece59c9e504}">
      <Declaration><![CDATA[(*
	Releases a running span without ending it, so it is never exported, and clears the caller's
	pointer. Use it to abandon work, for example when the PLC program resets. A null span is
	refused with SPAN_POINTER_NULL, so the caller does not need to check it first.
*)
METHOD discardSpan : BOOL
VAR_IN_OUT
	pSpan: POINTER TO FB_Span;
END_VAR
VAR_OUTPUT
	failureReason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[discardSpan := FALSE;
failureReason := E_TracerFailureReason.NA;

IF pSpan = 0 THEN
	failureReason := E_TracerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF

discardSpan := pSpan^.delete(pSelf:=pSpan);]]></ST>
      </Implementation>
    </Method>
    <Method Name="endSpan" Id="{cb0a5ab4-6cec-411b-9a0a-a4cb42e8d8a6}">
      <Declaration><![CDATA[(*
	Ends a running span: stamps its end time and hands it to the provider for processing.
	The caller's pointer is cleared whether or not the hand-off succeeds. If the provider
	cannot queue the span, the span is released, because an ended span has no other owner.
	The span is queued even when no processor is staged yet: the provider keeps it until its
	next tick, which hands it to the processors staged then.
	endSpan is not part of the fluent chain and leaves a span being built untouched.
*)
METHOD endSpan : BOOL
VAR_IN_OUT
	pSpan: POINTER TO FB_Span;
END_VAR
VAR_OUTPUT
	failureReason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[endSpan := FALSE;
failureReason := E_TracerFailureReason.NA;

IF pSpan = 0 THEN
	failureReason := E_TracerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF

pSpan^.endTimestamp := THIS^._now();

// transfer ownership to the provider, which clears pSpan on success
IF NOT THIS^._provider.onEnd(pSpan:=pSpan) THEN
	pSpan^.delete(pSelf:=pSpan);
	failureReason := E_TracerFailureReason.TRANSFER_TO_PROVIDER_FAILURE;
	RETURN;
END_IF

endSpan := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{4beadf6b-53d7-4962-ba17-97fdf954b3a9}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	THIS^.free();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{cf4de8a7-906c-49aa-9013-3b2e55322a5d}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	scope: REFERENCE TO FB_InstrumentationScope;
	provider: REFERENCE TO FB_TracerProvider;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._scope REF= scope;
THIS^._provider REF= provider;]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{71317019-8ed8-47bf-a058-83317e44977d}">
      <Declaration><![CDATA[(* Releases a span that is still being built and clears the chain's failure. *)
METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.pSpan <> 0 THEN
	THIS^.pSpan^.delete(pSelf:=THIS^.pSpan);
END_IF
THIS^._failed := FALSE;
THIS^._failureReason := E_TracerFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Property Name="resource" Id="{d5da383f-f0b1-448b-8274-9168134ffb5e}">
      <Declaration><![CDATA[PROPERTY resource : REFERENCE TO FB_Resource]]></Declaration>
      <Get Name="Get" Id="{a947aff2-a220-44e2-b602-15d5a22a95cd}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[resource REF= THIS^._provider.resource;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="scope" Id="{ed8fea03-8599-4e6d-9b7f-4d4b3103837e}">
      <Declaration><![CDATA[PROPERTY scope : REFERENCE TO FB_InstrumentationScope]]></Declaration>
      <Get Name="Get" Id="{a92a1155-87a4-4158-afa9-2648acd2fcc3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[scope REF= THIS^._scope;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="getSpanContext" Id="{563be6d0-2a22-48ad-877d-9d21a17d943f}">
      <Declaration><![CDATA[(*
	Allocates a snapshot of a running span's identity, for a child span, a link, or a carrier
	to inject. The caller owns pDest, which must be 0, and releases it once. The context is
	always local, and it outlives the span. A null span is refused with SPAN_POINTER_NULL, and
	a span that has not been built with SPAN_INVALID.
*)
METHOD getSpanContext : BOOL
VAR_IN_OUT
	pDest: POINTER TO FB_SpanContext;
END_VAR
VAR_INPUT
	pSpan: POINTER TO FB_Span;
END_VAR
VAR_OUTPUT
	failureReason: E_TracerFailureReason;
END_VAR
VAR
	_contextFailureReason: E_ContextFactoryFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[getSpanContext := FALSE;
failureReason := E_TracerFailureReason.NA;

IF pSpan = 0 THEN
	failureReason := E_TracerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF

IF ContextFactory.fromSpan(pDest:=pDest, pSpan:=pSpan, failureReason=>_contextFailureReason) THEN
	getSpanContext := TRUE;
	RETURN;
END_IF

CASE _contextFailureReason OF
	E_ContextFactoryFailureReason.DESTINATION_ALREADY_ASSIGNED:
		failureReason := E_TracerFailureReason.DESTINATION_ALREADY_ASSIGNED;
	E_ContextFactoryFailureReason.TRACE_ID_POINTER_NULL, E_ContextFactoryFailureReason.SPAN_ID_POINTER_NULL:
		failureReason := E_TracerFailureReason.SPAN_INVALID;
ELSE
	failureReason := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="pushSpanLink" Id="{a5b7c70e-bc63-4d45-bbc9-b514a357d0b0}">
      <Declaration><![CDATA[(*
	Adds a link built with LinkFactory to a running span, for a link that needs attributes.
	The tracer takes the link in every case and clears pLink: the span owns it on success, and
	it is released on failure, so the caller never has a link left to clean up. A null span is
	refused with SPAN_POINTER_NULL, a null link with LINK_POINTER_NULL, and a link past
	TcOtlp_GVL.DEFAULT_MAX_LINK_COUNT with LINK_COUNT_LIMIT_REACHED.
*)
METHOD pushSpanLink : BOOL
VAR_IN_OUT
	pLink: POINTER TO FB_Link;
END_VAR
VAR_INPUT
	pSpan: POINTER TO FB_Span;
END_VAR
VAR_OUTPUT
	failureReason: E_TracerFailureReason;
END_VAR
VAR
	_linkFailureReason: E_LinkFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pushSpanLink := FALSE;
failureReason := E_TracerFailureReason.NA;

IF pSpan = 0 THEN
	IF pLink <> 0 THEN pLink^.delete(pSelf:=pLink); END_IF
	failureReason := E_TracerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF

// push clears pLink on success and leaves a refused link with the caller
IF pSpan^.links.push(pValue:=pLink, failureReason=>_linkFailureReason) THEN
	pushSpanLink := TRUE;
	RETURN;
END_IF

IF pLink <> 0 THEN pLink^.delete(pSelf:=pLink); END_IF
failureReason := THIS^._mapLinkFailure(_linkFailureReason);]]></ST>
      </Implementation>
    </Method>
    <Method Name="setNumberAttribute" Id="{29ef0315-92a8-46d7-aa7d-02fe8142dfe3}">
      <Declaration><![CDATA[METHOD setNumberAttribute: REFERENCE TO FB_Tracer
VAR_INPUT
	key: T_MaxString;
	value: ANY_NUM;
END_VAR
VAR
	_attributesSuccess: BOOL;
	_attributesFailureReason: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setNumberAttribute REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

_attributesSuccess := THIS^.pSpan^.attributes.setNumberAttribute_AnyType(
	key:=key,
	value:=value,
	failureReason=>_attributesFailureReason
);
IF NOT _attributesSuccess THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := THIS^._mapAttributesFailure(_attributesFailureReason);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="setParentUsingContext" Id="{a1b891cf-e895-4bb2-84a9-3cc0d638a94e}">
      <Declaration><![CDATA[(*
	Makes the span a child of the given context, such as one extracted from a remote caller.
	The context is borrowed: the span keeps its own copies of the trace id, parent span id and
	trace state. The tracer is the producer of spans, so this is where the parent is validated.
	Calling it or setParentUsingSpan again replaces the parent.
*)
METHOD setParentUsingContext : REFERENCE TO FB_Tracer
VAR_INPUT
	pContext: POINTER TO FB_SpanContext;
END_VAR
VAR
	_ctxTraceId: REFERENCE TO FB_TraceId;
	_ctxSpanId: REFERENCE TO FB_SpanId;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setParentUsingContext REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

IF pContext = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_TracerFailureReason.PARENT_CONTEXT_POINTER_NULL;
	RETURN;
END_IF

IF NOT pContext^.isValid() THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_TracerFailureReason.PARENT_CONTEXT_INVALID;
	RETURN;
END_IF

_ctxTraceId REF= pContext^.traceId;
_ctxSpanId REF= pContext^.spanId;
THIS^._setParent(
	pTraceId:=ADR(_ctxTraceId),
	pSpanId:=ADR(_ctxSpanId),
	pTraceState:=pContext^.traceState,
	traceFlags:=pContext^.traceFlags,
	isRemote:=pContext^.isRemote(),
	invalidReason:=E_TracerFailureReason.PARENT_CONTEXT_INVALID
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="setParentUsingSpan" Id="{8c2d4a7e-19f3-4b6a-a0e5-5d3c1b9f7e28}">
      <Declaration><![CDATA[(*
	Makes the span a child of a running span in this program, without taking a context from it
	first. The parent is borrowed: the span keeps its own copies of the trace id, parent span id
	and trace state. The parent must have been built, so a span still being built is refused.
	A span in this program is a local parent, so the child's flags mark it as not remote.
	Calling it or setParentUsingContext again replaces the parent.
*)
METHOD setParentUsingSpan : REFERENCE TO FB_Tracer
VAR_INPUT
	pParentSpan: POINTER TO FB_Span;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setParentUsingSpan REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

IF pParentSpan = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_TracerFailureReason.PARENT_SPAN_POINTER_NULL;
	RETURN;
END_IF

// build assigns the identifiers, so a span without them has not been built yet
IF pParentSpan^.traceId = 0 OR pParentSpan^.spanId = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_TracerFailureReason.PARENT_SPAN_INVALID;
	RETURN;
END_IF

THIS^._setParent(
	pTraceId:=pParentSpan^.traceId,
	pSpanId:=pParentSpan^.spanId,
	pTraceState:=pParentSpan^.traceState,
	traceFlags:=pParentSpan^.flags,
	isRemote:=FALSE,
	invalidReason:=E_TracerFailureReason.PARENT_SPAN_INVALID
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="setSpanNumberAttribute" Id="{839302a3-b94e-4d55-ba0c-bda03cb17805}">
      <Declaration><![CDATA[(*
	Sets a number attribute on a running span. Attributes known when the span starts belong in
	the fluent chain instead, where the sampler can see them. A null span is refused with
	SPAN_POINTER_NULL.
*)
METHOD setSpanNumberAttribute : BOOL
VAR_INPUT
	pSpan: POINTER TO FB_Span;
	key: T_MaxString;
	value: ANY_NUM;
END_VAR
VAR_OUTPUT
	failureReason: E_TracerFailureReason;
END_VAR
VAR
	_attributesFailureReason: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setSpanNumberAttribute := FALSE;
failureReason := E_TracerFailureReason.NA;

IF pSpan = 0 THEN
	failureReason := E_TracerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF

IF NOT pSpan^.attributes.setNumberAttribute_AnyType(
	key:=key,
	value:=value,
	failureReason=>_attributesFailureReason
) THEN
	failureReason := THIS^._mapAttributesFailure(_attributesFailureReason);
	RETURN;
END_IF

setSpanNumberAttribute := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setSpanStatusError" Id="{4092588f-85ea-4124-91f3-09000d032a90}">
      <Declaration><![CDATA[(*
	Marks a running span as failed, with a message saying why. An empty message leaves the
	status without one. OK is final, so an error on a span that is already OK is ignored and
	reported as SPAN_STATUS_ALREADY_OK. A later error replaces an earlier one. If memory runs
	out the previous status is kept. The span is borrowed, and a null span is refused.
	Not part of the fluent chain, so it leaves a span being built untouched.
*)
METHOD setSpanStatusError : BOOL
VAR_INPUT
	pSpan: POINTER TO FB_Span;
	message: T_MaxString;
END_VAR
VAR_OUTPUT
	failureReason: E_TracerFailureReason;
END_VAR
VAR
	_pMessage: POINTER TO FB_String;
	_pStatus: POINTER TO FB_Status;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setSpanStatusError := FALSE;
failureReason := E_TracerFailureReason.NA;

IF pSpan = 0 THEN
	failureReason := E_TracerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF

IF pSpan^.status <> 0 AND_THEN pSpan^.status^.code = E_StatusCode.STATUS_CODE_OK THEN
	failureReason := E_TracerFailureReason.SPAN_STATUS_ALREADY_OK;
	RETURN;
END_IF

IF LEN(message) > 0 AND_THEN NOT ValueFactory.createString(pDest:=_pMessage, pString:=ADR(message)) THEN
	failureReason := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

// build the new status before releasing the old one, so a failure keeps the old status
_pStatus := __NEW(FB_Status(code:=E_StatusCode.STATUS_CODE_ERROR, message:=_pMessage));
IF _pStatus = 0 THEN
	IF _pMessage <> 0 THEN _pMessage^.delete(pSelf:=_pMessage); END_IF
	failureReason := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF
_pMessage := 0;  // moved into the status

IF pSpan^.status <> 0 THEN pSpan^.status^.delete(pSelf:=pSpan^.status); END_IF
pSpan^.status := _pStatus;
setSpanStatusError := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setSpanStatusOk" Id="{5571f693-bd3a-46ce-b4eb-e4a3bd1f2529}">
      <Declaration><![CDATA[(*
	Marks a running span as having completed successfully. OK is final: it replaces an earlier
	error and its message, and later calls to setSpanStatusError are ignored. If memory runs out
	the previous status is kept. The span is borrowed, and a null span is refused.
	Not part of the fluent chain, so it leaves a span being built untouched.
*)
METHOD setSpanStatusOk : BOOL
VAR_INPUT
	pSpan: POINTER TO FB_Span;
END_VAR
VAR_OUTPUT
	failureReason: E_TracerFailureReason;
END_VAR
VAR
	_pStatus: POINTER TO FB_Status;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setSpanStatusOk := FALSE;
failureReason := E_TracerFailureReason.NA;

IF pSpan = 0 THEN
	failureReason := E_TracerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF

// OK is final, so a span that is already OK needs nothing more
IF pSpan^.status <> 0 AND_THEN pSpan^.status^.code = E_StatusCode.STATUS_CODE_OK THEN
	setSpanStatusOk := TRUE;
	RETURN;
END_IF

_pStatus := __NEW(FB_Status(code:=E_StatusCode.STATUS_CODE_OK, message:=0));
IF _pStatus = 0 THEN
	failureReason := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

IF pSpan^.status <> 0 THEN pSpan^.status^.delete(pSelf:=pSpan^.status); END_IF
pSpan^.status := _pStatus;
setSpanStatusOk := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setSpanStringAttribute" Id="{8fee46bd-5ae3-43ac-8ec4-484901911049}">
      <Declaration><![CDATA[(*
	Sets a string attribute on a running span. Attributes known when the span starts belong in
	the fluent chain instead, where the sampler can see them. A null span is refused with
	SPAN_POINTER_NULL.
*)
METHOD setSpanStringAttribute : BOOL
VAR_INPUT
	pSpan: POINTER TO FB_Span;
	key: T_MaxString;
	value: T_MaxString;
END_VAR
VAR_OUTPUT
	failureReason: E_TracerFailureReason;
END_VAR
VAR
	_attributesFailureReason: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setSpanStringAttribute := FALSE;
failureReason := E_TracerFailureReason.NA;

IF pSpan = 0 THEN
	failureReason := E_TracerFailureReason.SPAN_POINTER_NULL;
	RETURN;
END_IF

IF NOT pSpan^.attributes.setStringAttribute(
	key:=key,
	value:=value,
	failureReason=>_attributesFailureReason
) THEN
	failureReason := THIS^._mapAttributesFailure(_attributesFailureReason);
	RETURN;
END_IF

setSpanStringAttribute := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setStringAttribute" Id="{99f75826-e10b-4b72-90de-ece62d760792}">
      <Declaration><![CDATA[METHOD setStringAttribute: REFERENCE TO FB_Tracer
VAR_INPUT
	key: T_MaxString;
	value: T_MaxString;
END_VAR
VAR
	_attributesSuccess: BOOL;
	_attributesFailureReason: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[setStringAttribute REF= THIS^;

IF THIS^._shouldReturnEarly() THEN
	RETURN;
END_IF

_attributesSuccess := THIS^.pSpan^.attributes.setStringAttribute(
	key:=key,
	value:=value,
	failureReason=>_attributesFailureReason
);
IF NOT _attributesSuccess THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := THIS^._mapAttributesFailure(_attributesFailureReason);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="startSpan" Id="{49c360a8-a66a-4002-bb96-57eea3b71419}">
      <Declaration><![CDATA[(*
	Starts building a span with its required fields: it allocates the span, stamps its start
	time, copies the name, and snapshots the resource and scope, so processors may keep the
	span after this tracer or its provider is gone. Finish the chain with build.
*)
METHOD startSpan : REFERENCE TO FB_Tracer
VAR_INPUT
	name: T_MaxString;
	kind: E_SpanKind := E_SpanKind.SPAN_KIND_INTERNAL;
END_VAR
VAR
	_factoryFailureReason: E_ValueFactoryFailureReason;
	_attributesFailureReason: E_AttributesFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[startSpan REF= THIS^;

// do not replace the first failure in an active fluent chain
IF THIS^.pSpan <> 0 THEN
	IF NOT THIS^._failed THEN
		THIS^._failed := TRUE;
		THIS^._failureReason := E_TracerFailureReason.SPAN_ALREADY_STARTED;
	END_IF
	RETURN;
END_IF

THIS^._failed := FALSE;
THIS^._failureReason := E_TracerFailureReason.NA;

IF LEN(name) = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_TracerFailureReason.SPAN_NAME_EMPTY;
	RETURN;
END_IF

IF kind = E_SpanKind.SPAN_KIND_UNSPECIFIED THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_TracerFailureReason.SPAN_KIND_UNSPECIFIED;
	RETURN;
END_IF

// the tracer owns the span from here, so every later failure is released by build or free
THIS^.pSpan := __NEW(FB_Span);
IF THIS^.pSpan = 0 THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

THIS^.pSpan^.kind := kind;
THIS^.pSpan^.startTimestamp := THIS^._now();

IF NOT ValueFactory.createString(
	pDest:=THIS^.pSpan^.name,
	pString:=ADR(name),
	failureReason=>_factoryFailureReason
	) THEN
	THIS^._failed := TRUE;
	THIS^._failureReason := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
	RETURN;
END_IF

IF NOT THIS^.pSpan^.resource.copyFrom(src:=THIS^.resource, failureResult=>_attributesFailureReason)
	OR_ELSE NOT THIS^.pSpan^.scope.copyFrom(src:=THIS^.scope, failureResult=>_attributesFailureReason) THEN
	THIS^._failed := TRUE;
	IF _attributesFailureReason = E_AttributesFailureReason.MEMORY_ALLOCATION_FAILURE THEN
		THIS^._failureReason := E_TracerFailureReason.MEMORY_ALLOCATION_FAILURE;
	ELSE
		THIS^._failureReason := E_TracerFailureReason.SNAPSHOT_COPY_FAILURE;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>