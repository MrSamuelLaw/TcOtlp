      <Get Name="Get" Id="{e923fc72-3d48-4df1-a668-704aaf6853b4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nAttributesCount := THIS^._nAttributesCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
