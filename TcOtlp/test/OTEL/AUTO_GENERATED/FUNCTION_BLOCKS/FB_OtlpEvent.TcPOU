      </Get>
      <Set Name="Set" Id="{e184bc52-7abc-4457-ba89-83ba096d6398}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^._nDroppedAttributesCount := nDroppedAttributesCount;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="nTimeUnixNano" Id="{c9fdb09b-d448-4961-9ba4-35ab64b68e7a}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
PROPERTY nTimeUnixNano : ULINT]]></Declaration>
      <Get Name="Get" Id="{16ac5039-b4ac-4aeb-bfd1-19ddf5f68e7c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nTimeUnixNano := THIS^._nTimeUnixNano;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f53a1fbf-0940-4343-b79c-9cadf3fb7a31}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^._nTimeUnixNano := nTimeUnixNano;]]></ST>
