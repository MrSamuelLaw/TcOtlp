<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_OtlpLogsData" Id="{aed951db-d32f-4f6e-80b6-4b5c14e19b5b}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpLogsData IMPLEMENTS I_OtlpSerializable
VAR
	_arrResourceLogs : ARRAY[0..99] OF POINTER TO FB_OtlpResourceLogs;
	_nResourceLogsCount : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SerializeToProtoJson" Id="{4dbffe27-d78f-499f-881d-0bbd155d5660}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	i : UDINT;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nResourceLogsCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'resourceLogs', 0);
	FOR i := 0 TO THIS^._nResourceLogsCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrResourceLogs[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{f2dc52c1-394e-4ca9-85e4-3c40656c3f57}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nResourceLogsCount > 0 THEN
	FOR i := 0 TO THIS^._nResourceLogsCount - 1 DO
		IF THIS^._arrResourceLogs[i] <> 0 THEN
			__DELETE(THIS^._arrResourceLogs[i]);
		END_IF
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddResourceLogs" Id="{2258503c-1c12-4e7f-b575-7df12c9a704b}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddResourceLogs : POINTER TO FB_OtlpResourceLogs
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nResourceLogsCount < 100 THEN
	AddResourceLogs := __NEW(FB_OtlpResourceLogs);
	THIS^._arrResourceLogs[THIS^._nResourceLogsCount] := AddResourceLogs;
	THIS^._nResourceLogsCount := THIS^._nResourceLogsCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="nResourceLogsCount" Id="{d6f1252c-9517-45d5-ad70-58933b954b85}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
PROPERTY nResourceLogsCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{fbc798ca-4e88-4c27-9d86-8bb4394c7eeb}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nResourceLogsCount := THIS^._nResourceLogsCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
