        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nLogRecordsCount := THIS^._nLogRecordsCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="pScope" Id="{47453b87-d38f-43ce-84a9-2db5b6ee897d}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
PROPERTY pScope : POINTER TO FB_OtlpInstrumentationScope]]></Declaration>
      <Get Name="Get" Id="{97e77f19-bbff-4b8d-af04-76aa4684f397}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[pScope := THIS^._pScope;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{4b0308b9-a20b-4eba-a05e-b4716931301d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^._pScope := pScope;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="SerializeToProtoJson" Id="{32a35354-87f3-4bf2-99b1-4415060bcb30}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	i : UDINT;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
	objNode : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._pScope <> 0 THEN
	objNode := parser.AddObjectMember(node, 'scope');
	THIS^._pScope^.SerializeToProtoJson(parser, objNode);
END_IF

IF THIS^._nLogRecordsCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'logRecords', 0);
	FOR i := 0 TO THIS^._nLogRecordsCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrLogRecords[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF

parser.AddStringMember(node, 'schemaUrl', THIS^._sSchemaUrl);]]></ST>
      </Implementation>
    </Method>
    <Property Name="sSchemaUrl" Id="{ac137298-6971-4fd6-86a0-2db7047cbff5}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
PROPERTY sSchemaUrl : STRING(255)]]></Declaration>
      <Get Name="Get" Id="{33c79170-a413-47bd-ac46-9af890489239}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[sSchemaUrl := THIS^._sSchemaUrl;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{2141b3a9-3688-4522-888d-be59bc774c9e}">
        <Declaration><![CDATA[VAR
