<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_OtlpKvlistValue" Id="{6baf3fe7-03ec-4764-8144-bdda34adc95c}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpKvlistValue IMPLEMENTS I_OtlpAnyValue
VAR
	_arrValues : ARRAY[0..99] OF POINTER TO FB_OtlpKeyValue;
	_nValuesCount : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AddValue" Id="{0fa369a7-1268-40a9-be5e-9894451d382e}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddValue : POINTER TO FB_OtlpKeyValue
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nValuesCount < 100 THEN
	AddValue := __NEW(FB_OtlpKeyValue);
	THIS^._arrValues[THIS^._nValuesCount] := AddValue;
	THIS^._nValuesCount := THIS^._nValuesCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="eValueType" Id="{6cec33f8-b45c-4029-978a-c403e08a6bff}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
PROPERTY eValueType : E_OtlpAnyValueType]]></Declaration>
      <Get Name="Get" Id="{326b257e-ac13-4d07-8e6b-c95df4511500}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eValueType := E_OtlpAnyValueType.KVLIST_VALUE;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_exit" Id="{6d06bfad-d7f3-4a0f-a14b-20c7a22c05fd}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nValuesCount > 0 THEN
	FOR i := 0 TO THIS^._nValuesCount - 1 DO
	IF THIS^._arrValues[i] <> 0 THEN
		__DELETE(THIS^._arrValues[i]);
	END_IF
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="nValuesCount" Id="{d91ce7fc-a1b2-4430-a628-bd1be6505742}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
PROPERTY nValuesCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{72ca8fe1-637d-4384-95a2-670c3132d9ef}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nValuesCount := THIS^._nValuesCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SerializeToProtoJson" Id="{68b84ea4-34f5-4614-b655-115d740ca9d4}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	kvlistNode : SJsonValue;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[kvlistNode := parser.AddObjectMember(node, 'kvlistValue');
IF THIS^._nValuesCount > 0 THEN
	arrNode := parser.AddArrayMember(kvlistNode, 'values', 0);
	FOR i := 0 TO THIS^._nValuesCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrValues[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>