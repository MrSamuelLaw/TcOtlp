<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_OtlpInstrumentationScope" Id="{81d3e3e2-b069-4d2e-8d9b-d0b2b134ddbe}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpInstrumentationScope IMPLEMENTS I_OtlpSerializable
VAR
	_sName : STRING(255);
	_sVersion : STRING(255);
	_arrAttributes : ARRAY[0..99] OF POINTER TO FB_OtlpKeyValue;
	_nAttributesCount : UDINT;
	_nDroppedAttributesCount : UDINT;
	_arrStringAttrValues : ARRAY[0..99] OF POINTER TO FB_OtlpStringValue;
	_arrStringAttrInterfaces : ARRAY[0..99] OF I_OtlpAnyValue;
	_nStringAttrValuesCount : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AddAttributes" Id="{f3e089b3-5493-420a-ba5b-c9663027e786}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddAttributes : POINTER TO FB_OtlpKeyValue
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nAttributesCount < 100 THEN
	AddAttributes := __NEW(FB_OtlpKeyValue);
	THIS^._arrAttributes[THIS^._nAttributesCount] := AddAttributes;
	THIS^._nAttributesCount := THIS^._nAttributesCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddStringAttribute" Id="{69ed51f0-c3ca-4600-9717-128833496d96}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddStringAttribute
VAR_INPUT
	sKey : STRING(255);
	sValue : STRING(255);
END_VAR
VAR
	pKv : POINTER TO FB_OtlpKeyValue;
	pStrVal : POINTER TO FB_OtlpStringValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nStringAttrValuesCount >= 100 THEN
	RETURN;
END_IF

pStrVal := __NEW(FB_OtlpStringValue);
IF pStrVal = 0 THEN
	RETURN;
END_IF

pKv := THIS^.AddAttributes();
IF pKv = 0 THEN
	__DELETE(pStrVal);
	RETURN;
END_IF

pKv^.sKey := sKey;

pStrVal^.sValue := sValue;
THIS^._arrStringAttrValues[THIS^._nStringAttrValuesCount] := pStrVal;

THIS^._arrStringAttrInterfaces[THIS^._nStringAttrValuesCount] := pStrVal^;
pKv^.pValue := ADR(THIS^._arrStringAttrInterfaces[THIS^._nStringAttrValuesCount]);

THIS^._nStringAttrValuesCount := THIS^._nStringAttrValuesCount + 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{4d5fb537-91fc-42f0-8285-c4ec38cca519}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nAttributesCount > 0 THEN
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		IF THIS^._arrAttributes[i] <> 0 THEN
			THIS^._arrAttributes[i]^.pValue := 0;
		END_IF
	END_FOR
END_IF

IF THIS^._nStringAttrValuesCount > 0 THEN
	FOR i := 0 TO THIS^._nStringAttrValuesCount - 1 DO
		IF THIS^._arrStringAttrValues[i] <> 0 THEN
			__DELETE(THIS^._arrStringAttrValues[i]);
		END_IF
	END_FOR
END_IF

IF THIS^._nAttributesCount > 0 THEN
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		IF THIS^._arrAttributes[i] <> 0 THEN
			THIS^._arrAttributes[i]^.pValue := 0;
			__DELETE(THIS^._arrAttributes[i]);
		END_IF
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="nAttributesCount" Id="{621ef03e-de29-45a6-84c4-1bc499d5cd81}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
PROPERTY nAttributesCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{ecee9bd9-0979-4ae0-aa69-9ae0dbedf384}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nAttributesCount := THIS^._nAttributesCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="nDroppedAttributesCount" Id="{9cbca568-af28-40e4-950c-ee667097c17e}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
PROPERTY nDroppedAttributesCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{d50639a7-b3de-4ef1-88b6-019c5d9ef6f6}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nDroppedAttributesCount := THIS^._nDroppedAttributesCount;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{27f970d5-e59d-4be7-964c-df39dfc9a5cf}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^._nDroppedAttributesCount := nDroppedAttributesCount;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="SerializeToProtoJson" Id="{d023cf98-7930-41ef-96b7-176d4663ccec}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	i : UDINT;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[parser.AddStringMember(node, 'name', THIS^._sName);

parser.AddStringMember(node, 'version', THIS^._sVersion);

IF THIS^._nAttributesCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'attributes', 0);
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrAttributes[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF

parser.AddUintMember(node, 'droppedAttributesCount', THIS^._nDroppedAttributesCount);]]></ST>
      </Implementation>
    </Method>
