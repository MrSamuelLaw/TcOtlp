<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_OtlpLogRecord" Id="{d187d1a9-e3ad-43e9-a543-90756079ba32}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpLogRecord IMPLEMENTS I_OtlpSerializable
VAR
	_nTimeUnixNano : ULINT;
	_nObservedTimeUnixNano : ULINT;
	_eSeverityNumber : E_OtlpSeverityNumber;
	_sSeverityText : STRING(255);
	_pBody : POINTER TO I_OtlpAnyValue;
	_arrAttributes : ARRAY[0..99] OF POINTER TO FB_OtlpKeyValue;
	_nAttributesCount : UDINT;
	_nDroppedAttributesCount : UDINT;
	_nFlags : UDINT;
	_arrTraceId : ARRAY[0..15] OF BYTE;
	_arrSpanId : ARRAY[0..7] OF BYTE;
	_sEventName : STRING(255);
	_arrStringAttrValues : ARRAY[0..99] OF POINTER TO FB_OtlpStringValue;
	_arrStringAttrInterfaces : ARRAY[0..99] OF I_OtlpAnyValue;
	_nStringAttrValuesCount : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SerializeToProtoJson" Id="{99de75e4-be5a-4d69-9a11-ee24478d494a}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	i : UDINT;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
	objNode : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[parser.AddUint64Member(node, 'timeUnixNano', THIS^._nTimeUnixNano);

parser.AddUint64Member(node, 'observedTimeUnixNano', THIS^._nObservedTimeUnixNano);

parser.AddIntMember(node, 'severityNumber', TO_DINT(THIS^._eSeverityNumber));

parser.AddStringMember(node, 'severityText', THIS^._sSeverityText);

IF THIS^._pBody <> 0 THEN
	objNode := parser.AddObjectMember(node, 'body');
	THIS^._pBody^.SerializeToProtoJson(parser, objNode);
END_IF

IF THIS^._nAttributesCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'attributes', 0);
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrAttributes[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF

parser.AddUintMember(node, 'droppedAttributesCount', THIS^._nDroppedAttributesCount);

parser.AddUintMember(node, 'flags', THIS^._nFlags);

// TODO: serialize bytes field 'traceId' (base64 encoding)

// TODO: serialize bytes field 'spanId' (base64 encoding)

parser.AddStringMember(node, 'eventName', THIS^._sEventName);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{0e29ec09-2337-48e2-b362-fbbcf5d58a1c}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nAttributesCount > 0 THEN
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		IF THIS^._arrAttributes[i] <> 0 THEN
			THIS^._arrAttributes[i]^.pValue := 0;
		END_IF
	END_FOR
END_IF

IF THIS^._nStringAttrValuesCount > 0 THEN
	FOR i := 0 TO THIS^._nStringAttrValuesCount - 1 DO
		IF THIS^._arrStringAttrValues[i] <> 0 THEN
			__DELETE(THIS^._arrStringAttrValues[i]);
		END_IF
	END_FOR
END_IF

IF THIS^._pBody <> 0 THEN
	__DELETE(THIS^._pBody);
END_IF

IF THIS^._nAttributesCount > 0 THEN
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		IF THIS^._arrAttributes[i] <> 0 THEN
			THIS^._arrAttributes[i]^.pValue := 0;
			__DELETE(THIS^._arrAttributes[i]);
		END_IF
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddAttributes" Id="{46e844ae-1e95-4b98-9470-91c3b500eca5}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddAttributes : POINTER TO FB_OtlpKeyValue
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nAttributesCount < 100 THEN
	AddAttributes := __NEW(FB_OtlpKeyValue);
	THIS^._arrAttributes[THIS^._nAttributesCount] := AddAttributes;
	THIS^._nAttributesCount := THIS^._nAttributesCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddStringAttribute" Id="{a8770eeb-a98d-45b0-8cfe-29f2f8dbf517}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddStringAttribute
VAR_INPUT
	sKey : STRING(255);
	sValue : STRING(255);
END_VAR
VAR
	pKv : POINTER TO FB_OtlpKeyValue;
	pStrVal : POINTER TO FB_OtlpStringValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nStringAttrValuesCount >= 100 THEN
	RETURN;
END_IF

pStrVal := __NEW(FB_OtlpStringValue);
IF pStrVal = 0 THEN
	RETURN;
END_IF

pKv := THIS^.AddAttributes();
IF pKv = 0 THEN
	__DELETE(pStrVal);
	RETURN;
END_IF

pKv^.sKey := sKey;

pStrVal^.sValue := sValue;
THIS^._arrStringAttrValues[THIS^._nStringAttrValuesCount] := pStrVal;

THIS^._arrStringAttrInterfaces[THIS^._nStringAttrValuesCount] := pStrVal^;
pKv^.pValue := ADR(THIS^._arrStringAttrInterfaces[THIS^._nStringAttrValuesCount]);

THIS^._nStringAttrValuesCount := THIS^._nStringAttrValuesCount + 1;]]></ST>
      </Implementation>
    </Method>
