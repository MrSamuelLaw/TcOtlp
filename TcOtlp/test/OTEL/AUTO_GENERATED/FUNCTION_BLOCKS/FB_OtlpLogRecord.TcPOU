  <POU Name="FB_OtlpLogRecord" Id="{28a1836b-b20e-4b6d-9646-d33c1262053f}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpLogRecord IMPLEMENTS I_OtlpSerializable
VAR
	_nTimeUnixNano : ULINT;
	_nObservedTimeUnixNano : ULINT;
	_eSeverityNumber : E_OtlpSeverityNumber;
	_sSeverityText : STRING(255);
	_pBody : POINTER TO I_OtlpAnyValue;
	_arrAttributes : ARRAY[0..99] OF POINTER TO FB_OtlpKeyValue;
	_nAttributesCount : UDINT;
	_nDroppedAttributesCount : UDINT;
	_nFlags : UDINT;
	_arrTraceId : ARRAY[0..15] OF BYTE;
	_arrSpanId : ARRAY[0..7] OF BYTE;
	_sEventName : STRING(255);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SerializeToProtoJson" Id="{55cb496b-b65d-4d5d-83f2-2e984e212a09}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	i : UDINT;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
	objNode : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[parser.AddUint64Member(node, 'timeUnixNano', THIS^._nTimeUnixNano);

parser.AddUint64Member(node, 'observedTimeUnixNano', THIS^._nObservedTimeUnixNano);

parser.AddIntMember(node, 'severityNumber', TO_DINT(THIS^._eSeverityNumber));

parser.AddStringMember(node, 'severityText', THIS^._sSeverityText);

IF THIS^._pBody <> 0 THEN
	objNode := parser.AddObjectMember(node, 'body');
	THIS^._pBody^.SerializeToProtoJson(parser, objNode);
END_IF

IF THIS^._nAttributesCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'attributes', 0);
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrAttributes[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF

parser.AddUintMember(node, 'droppedAttributesCount', THIS^._nDroppedAttributesCount);

parser.AddUintMember(node, 'flags', THIS^._nFlags);

// TODO: serialize bytes field 'traceId' (base64 encoding)

// TODO: serialize bytes field 'spanId' (base64 encoding)

parser.AddStringMember(node, 'eventName', THIS^._sEventName);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{f4b25286-292c-4eb5-8113-940fa5ba6543}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._pBody <> 0 THEN
	__DELETE(THIS^._pBody);
END_IF

FOR i := 0 TO THIS^._nAttributesCount - 1 DO
	IF THIS^._arrAttributes[i] <> 0 THEN
		__DELETE(THIS^._arrAttributes[i]);
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddAttributes" Id="{74e7e872-de98-4c94-a968-65277c035bec}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddAttributes : POINTER TO FB_OtlpKeyValue
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nAttributesCount < 100 THEN
	AddAttributes := __NEW(FB_OtlpKeyValue);
	THIS^._arrAttributes[THIS^._nAttributesCount] := AddAttributes;
	THIS^._nAttributesCount := THIS^._nAttributesCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
