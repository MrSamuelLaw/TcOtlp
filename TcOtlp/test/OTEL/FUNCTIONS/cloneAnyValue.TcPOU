<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="cloneAnyValue" Id="{40804519-e153-40c7-ad32-8f98734c6fc1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION cloneAnyValue : POINTER TO FB_AnyValue
VAR_INPUT
	pSrc: POINTER TO FB_AnyValue;
END_VAR
VAR
	_type: E_ValueType;
	_pNumberSrc: POINTER TO FB_Number;
	_pNumberDest: POINTER TO FB_Number;
	_pValue: POINTER TO BYTE;
	_size: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF pSrc <> 0 THEN
	_type := pSrc^.eType;
	CASE _type OF
		E_ValueType.E_String:
			cloneAnyValue := cloneString(pSrc);
		E_ValueType.E_Number:
			_pNumberSrc := pSrc;
			IF _pNumberSrc^.initialized AND
				_pNumberSrc^.value.pValue <> 0 AND
				_pNumberSrc^.value.diSize > 0
			THEN
				_size := TO_UDINT(_pNumberSrc^.value.diSize);
				_pValue := __NEW(BYTE, _size);
				IF _pValue <> 0 THEN
					MEMCPY(_pValue, _pNumberSrc^.value.pValue, _size);
					_pNumberDest := __NEW(FB_Number(
						typeClass:=_pNumberSrc^.value.typeclass,
						pValue:=_pValue,
						diSize:=_pNumberSrc^.value.diSize
					));
					IF _pNumberDest = 0 THEN
						__DELETE(_pValue);
					ELSE
						cloneAnyValue := _pNumberDest;
					END_IF
				END_IF
			END_IF
		ELSE
			cloneAnyValue := 0;
	END_CASE
ELSE
	cloneAnyValue := 0;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
