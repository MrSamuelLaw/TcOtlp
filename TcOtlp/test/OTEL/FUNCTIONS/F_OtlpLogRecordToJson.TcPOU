<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_OtlpLogRecordToJson" Id="{23e21a37-505a-438e-9d4e-849d21068846}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_OtlpLogRecordToJson : POINTER TO FB_JsonDynDomParser
VAR_IN_OUT CONSTANT
	logRecord: ST_OtlpLogRecord;
END_VAR
VAR
      root: SJsonValue;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Allocate parser dynamically so the document outlives this function scope.
F_OtlpLogRecordToJson := __NEW(FB_JsonDynDomParser);
IF F_OtlpLogRecordToJson = 0 THEN
        RETURN;
END_IF

// Initialize JSON document and create root object
root := F_OtlpLogRecordToJson^.NewDocument();
F_OtlpLogRecordToJson^.SetObject(root);

// Add observedTimestamp
F_OtlpLogRecordToJson^.AddUint64Member(root, 'observedTimestamp', logRecord.observedTimestamp);
// Add severityNumber
F_OtlpLogRecordToJson^.AddIntMember(root, 'severityNumber', TO_DINT(logRecord.severityNumber));

// Add body
F_OtlpLogRecordToJson^.AddStringMember(root, 'body', logRecord.body);

// Add eventName
F_OtlpLogRecordToJson^.AddStringMember(root, 'eventName', logRecord.eventName);

// TODO: Add resource object when ST_OtlpResource is populated
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>