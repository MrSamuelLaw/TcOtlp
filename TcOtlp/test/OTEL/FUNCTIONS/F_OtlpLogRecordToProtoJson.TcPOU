<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_OtlpLogRecordToProtoJson" Id="{23e21a37-505a-438e-9d4e-849d21068846}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_OtlpLogRecordToProtoJson : POINTER TO FB_JsonDynDomParser
VAR_INPUT CONSTANT
	logRecord: POINTER TO FB_OtlpLogRecord;
END_VAR
VAR
      root: SJsonValue;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Allocate parser dynamically so the document outlives this function scope.
F_OtlpLogRecordToProtoJson := __NEW(FB_JsonDynDomParser);
IF F_OtlpLogRecordToProtoJson = 0 THEN
        RETURN;
END_IF

// Initialize JSON document and create root object
root := F_OtlpLogRecordToProtoJson^.NewDocument();
F_OtlpLogRecordToProtoJson^.SetObject(root);

// Add observedTimestamp
F_OtlpLogRecordToProtoJson^.AddUint64Member(root, 'observedTimestamp', logRecord^.observedTimestamp);
// Add severityNumber
F_OtlpLogRecordToProtoJson^.AddIntMember(root, 'severityNumber', TO_DINT(logRecord^.severityNumber));

// Add body
F_OtlpLogRecordToProtoJson^.AddStringMember(root, 'body', logRecord^.body);

// Add eventName
F_OtlpLogRecordToProtoJson^.AddStringMember(root, 'eventName', logRecord^.eventName);

// TODO: Add resource object when ST_OtlpResource is populated
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>