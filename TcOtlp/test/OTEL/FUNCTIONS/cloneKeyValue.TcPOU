<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="cloneKeyValue" Id="{83032960-6a65-469d-afc9-0ee68677e7f2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION cloneKeyValue : POINTER TO FB_KeyValue
VAR_INPUT
	pSrc: POINTER TO FB_KeyValue;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF pSrc <> 0 THEN
	cloneKeyValue := ValueFactory.createKeyValue(
		pDest:=0,
		pKey:=pSrc^.pKey,
		pVal:=pSrc^.pVal);
ELSE
	cloneKeyValue := 0;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
