<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_BytesToHex" Id="{a5b6c7d8-e9f0-1234-abcd-567890123456}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_BytesToHex : STRING(255)
VAR_INPUT
	pBytes : POINTER TO BYTE;
	nLen   : UDINT;
END_VAR
VAR
	i       : UDINT;
	nByte   : BYTE;
	nHi     : BYTE;
	nLo     : BYTE;
	sResult : STRING(255);
	nPos    : UDINT;
END_VAR
VAR CONSTANT
	HEX_CHARS : STRING(16) := '0123456789abcdef';
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[sResult := '';

IF pBytes = 0 OR nLen = 0 OR nLen > 127 THEN
	F_BytesToHex := '';
	RETURN;
END_IF

FOR i := 0 TO nLen - 1 DO
	nByte := pBytes[i];
	nHi := SHR(nByte, 4) AND 16#0F;
	nLo := nByte AND 16#0F;
	sResult := CONCAT(sResult, CONCAT(MID(HEX_CHARS, 1, TO_INT(nHi) + 1), MID(HEX_CHARS, 1, TO_INT(nLo) + 1)));
END_FOR

F_BytesToHex := sResult;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
