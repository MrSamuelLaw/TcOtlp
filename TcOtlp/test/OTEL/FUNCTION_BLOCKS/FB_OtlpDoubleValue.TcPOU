<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_OtlpDoubleValue" Id="{2a5cb6d2-1b27-48f4-997a-c1ecaccc102b}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpDoubleValue IMPLEMENTS I_OtlpAnyValue
VAR
	_fValue : LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SerializeToProtoJson" Id="{756a057a-a987-4753-8d44-3cbb3c1143bb}">
      <Declaration><![CDATA[METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[parser.AddLrealMember(node, 'doubleValue', THIS^._fValue);]]></ST>
      </Implementation>
    </Method>
    <Property Name="eValueType" Id="{c61a891b-abee-43ff-8146-863f0beceb65}">
      <Declaration><![CDATA[PROPERTY eValueType : E_OtlpAnyValueType]]></Declaration>
      <Get Name="Get" Id="{dcb79a16-26c7-4d28-99f3-9541386095b9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eValueType := E_OtlpAnyValueType.DOUBLE_VALUE;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="fValue" Id="{331aaa9a-afe6-4002-a939-793eb63a1ade}">
      <Declaration><![CDATA[PROPERTY fValue : LREAL]]></Declaration>
      <Get Name="Get" Id="{cd0febdd-8591-4115-ba1a-be7215a238d8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[fValue := THIS^._fValue;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{5dc9dc84-f967-4259-9d17-1d0c321105a5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^._fValue := fValue;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>