    <Method Name="SerializeToProtoJson" Id="{186d265d-f06f-47ba-b667-6b24e240411b}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	objNode : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[parser.AddStringMember(node, 'key', THIS^._sKey);

IF THIS^._pValue <> 0 THEN
	objNode := parser.AddObjectMember(node, 'value');
	THIS^._pValue^.SerializeToProtoJson(parser, objNode);
END_IF

parser.AddIntMember(node, 'keyStrindex', THIS^._nKeyStrindex);]]></ST>
      </Implementation>
    </Method>
