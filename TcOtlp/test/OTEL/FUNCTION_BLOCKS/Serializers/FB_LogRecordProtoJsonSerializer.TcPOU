<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProtoJsonSerializer" Id="{9d5713d1-8fd3-47fe-b5ed-3ec522cca7f6}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordProtoJsonSerializer EXTENDS FB_BaseProtoJsonSerializer
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="serializeLogRecords" Id="{c8755357-2d5c-4040-a054-202bb0d2153c}">
      <Declaration><![CDATA[METHOD serializeLogRecords

VAR_INPUT
	head: ST_LinkedListNode_LogRecord;
END_VAR

VAR
	_idx: UDINT := 0;
	_buf: T_MaxString;
	_obj: SJsonValue;
	_pNode: POINTER TO ST_LinkedListNode_LogRecord;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.jsonVal := THIS^.parser.NewDocument();
THIS^.parser.SetArray(THIS^.jsonVal, 0);

// serialize the logs one by one
_pNode := ADR(head);
FOR _idx := 0 TO GVL.MAX_INSTANCES DO
	IF _pNode = 0 OR_ELSE _pNode^.ptr = 0 THEN
		// return if pointer is no longer valid
		RETURN;
	ELSE
		// create a json object and appent it to the array
		_obj := THIS^.parser.PushbackJsonValue(THIS^.jsonVal, '{}');
		
		// serailize the required fields
		_buf := _pNode^.ptr^.severityText;  // properties require intermediate variables
		THIS^.parser.AddStringMember(_obj, 'severityText', _buf);
		THIS^.serializeULINTValue(_obj, ADR('timeUnixNano'), _pNode^.ptr^.timestamp);
		
		// serialize the optional fields
		THIS^.serializeStringValue(_obj, ADR('eventName'), _pNode^.ptr^.eventName);
		THIS^.serializeTraceIdValue(_obj, ADR('traceId'), _pNode^.ptr^.traceId);
		THIS^.serializeSpanIdValue(_obj, ADR('spanId'), _pNode^.ptr^.spanId);
		THIS^.serializeAnyValue(_obj, ADR('body'), _pNode^.ptr^.body);
		
		// move on to the next node
		_pNode := _pNode^.nxt;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>