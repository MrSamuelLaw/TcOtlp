<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_OtlpIntValue" Id="{fce2e5fd-c2bd-4544-b3fd-34aee049280e}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpIntValue IMPLEMENTS I_OtlpAnyValue
VAR
	_nValue : LINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="eValueType" Id="{9bb5e6c0-ce12-43b7-94ea-cb2534893390}">
      <Declaration><![CDATA[PROPERTY eValueType : E_OtlpAnyValueType]]></Declaration>
      <Get Name="Get" Id="{325b74a7-d66a-4ed5-aee8-4c9382a0a440}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eValueType := E_OtlpAnyValueType.INT_VALUE;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="nValue" Id="{3d653eb4-436d-44c3-8ab4-dad3dc37b238}">
      <Declaration><![CDATA[PROPERTY nValue : LINT]]></Declaration>
      <Get Name="Get" Id="{a3e4ce72-f37f-48d8-8923-af04d7cfabd6}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nValue := THIS^._nValue;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{4e1c702e-2407-4eae-84a4-32ada15b3f02}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^._nValue := nValue;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="SerializeToProtoJson" Id="{e02e6fb3-4fd3-4bf2-aa17-a7e959a92af1}">
      <Declaration><![CDATA[METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[parser.AddInt64Member(node, 'intValue', THIS^._nValue);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>