<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_HttpBatchSpanExporter" Id="{c1d2e3f4-a5b6-7890-cdef-012345678901}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HttpBatchSpanExporter
VAR_INPUT
	sHostName       : STRING(255);
	nHostPort       : UINT := 4318;
	sUri            : STRING(255) := '/v1/traces';
	bNoServerCertCheck : BOOL;
	sCaCertPath     : STRING(255);
END_VAR
VAR_OUTPUT
	bBusy           : BOOL;
	bDone           : BOOL;
	bError          : BOOL;
	nHttpStatus     : UINT;
	sLastError      : STRING(255);
	sResponseBody   : STRING(1000);
END_VAR
VAR
	_fbClient       : FB_IotHttpClient;
	_fbRequest      : FB_IotHttpRequest;
	_fbSerializer   : FB_JsonDynDomParser;
	_fbSendParser   : FB_JsonDomParser;
	_jsonRoot       : SJsonValue;
	_nState         : INT;
	_sJsonBuffer    : STRING(10000);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT _fbClient.bConfigured THEN
	_fbRequest.sContentType := 'application/json';
	_fbClient.sHostName := sHostName;
	_fbClient.nHostPort := nHostPort;
	IF sCaCertPath <> '' THEN
		_fbClient.stTLS.sCA := sCaCertPath;
		_fbClient.stTLS.bNoServerCertCheck := bNoServerCertCheck;
	END_IF
END_IF

_fbClient.Execute();

CASE _nState OF
	0: // IDLE
		;

	1: // SEND
		IF _fbClient.bConfigured THEN
			IF _fbRequest.SendJsonDomRequest(
				sUri := sUri,
				fbClient := _fbClient,
				eRequestType := ETcIotHttpRequestType.HTTP_POST,
				fbJson := _fbSendParser,
			) THEN
				_nState := 2;
			END_IF
		END_IF

	2: // WAIT_RESPONSE
		IF NOT _fbRequest.bBusy THEN
			nHttpStatus := _fbRequest.nStatusCode;
			_fbRequest.GetContent(pContent := ADR(sResponseBody), nContentSize := SIZEOF(sResponseBody), bSetNullTermination := TRUE);
			IF NOT _fbRequest.bError AND nHttpStatus >= 200 AND nHttpStatus < 300 THEN
				bDone := TRUE;
				_nState := 3;
			ELSE
				sLastError := CONCAT('HTTP ', UINT_TO_STRING(nHttpStatus));
				bError := TRUE;
				_nState := 10;
			END_IF
		END_IF

	3: // DONE
		bBusy := FALSE;
		_nState := 0;

	10: // ERROR
		bBusy := FALSE;
		_nState := 0;
END_CASE]]></ST>
    </Implementation>
    <Method Name="Export" Id="{d2e3f4a5-b6c7-8901-defa-123456789012}">
      <Declaration><![CDATA[METHOD Export : BOOL
VAR_INPUT
	tracesData : REFERENCE TO FB_OtlpTracesData;
END_VAR
VAR
	nJsonLen : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _nState <> 0 THEN
	Export := FALSE;
	RETURN;
END_IF

// Serialize the OTLP tree into JSON using FB_JsonDynDomParser
_jsonRoot := _fbSerializer.NewDocument();
_fbSerializer.SetObject(_jsonRoot);
tracesData.SerializeToProtoJson(_fbSerializer, _jsonRoot);

// Transfer JSON to FB_JsonDomParser for SendJsonDomRequest
nJsonLen := _fbSerializer.GetDocumentLength();
IF nJsonLen > 0 AND nJsonLen < SIZEOF(_sJsonBuffer) THEN
	_fbSerializer.CopyDocument(_sJsonBuffer, SIZEOF(_sJsonBuffer));
	_fbSendParser.ParseDocument(_sJsonBuffer);
END_IF

_nState := 1;
bBusy := TRUE;
bDone := FALSE;
bError := FALSE;
Export := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
