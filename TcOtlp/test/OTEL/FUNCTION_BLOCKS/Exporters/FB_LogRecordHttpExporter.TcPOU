<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordHttpExporter" Id="{a41fa2e9-ec8f-44ea-883a-bf95973149c1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordHttpExporter
VAR_INPUT
	// transport layer params
	bNoServerCertCheck: BOOL;
	nHostPort: 	UINT := 4318;// port on the otlp collector, defaults to 4318
	sHostName: 	STRING(255); // http(s)://this-is-your-host-addr/
	sUri: 	STRING(255) := '/v1/logs'; 		// default logs endpoint
	sCaCertPath:STRING(255); // Set to a valid CA certificate path to enable TLS
	// data
	head: ST_LogRecordLinkedListNode;
END_VAR

VAR_OUTPUT
	currentState: E_HttpExporterState;
END_VAR

VAR
	_val: SJsonValue;
	_client: FB_IotHttpClient;
	_req: FB_IotHttpRequest;
	_ser: FB_LogRecordProtoJsonSerializer;
	_computedState: E_HttpExporterState;
	_pNode: POINTER TO ST_LogRecordLinkedListNode;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[_client.Execute();

CASE currentState OF
	E_HttpExporterState.error:
		// pass
	E_HttpExporterState.idle:
		IF head.ptr <> 0 THEN
			_pNode := ST_LogRecordLinkedListNode;
			_computedState := E_HttpExporterState.serializing;			
		END_IF
	E_HttpExporterState.serializing:
		// pass
		
	E_HttpExporterState.sending:
		// pass
	E_HttpExporterState.waiting:
		// pass
	E_HttpExporterState.processing:
		// pass
	
END_CASE]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>