<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordFileExporter" Id="{5851db96-6302-4f2a-9f8c-695c558b4c7f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordFileExporter EXTENDS FB_LogRecordExporterBase
VAR_INPUT
	filepath: 		T_MaxString;  // path to the root file
	execute: BOOL;
	// maxFileSize: 	UDINT;  // size at which to auto rotate the file
	// maxFiles: 		UDINT;  // max number of files to keep in the rotation
END_VAR

VAR_IN_OUT
	logRecords: 	FB_LinkedList_LogRecord;  // records to serialize
END_VAR

VAR_OUTPUT
	currentState: 	E_FileExporterState;
	errorCode:		E_FileExporterErrorCode;
	fileOpenerErrId: 	UDINT;
	fileWriterErrId: 	UDINT;
	fileCloserErrId: 	UDINT;		
END_VAR

VAR
	_hFile: 		UINT;
	_idx:			UDINT;
	_len:			UDINT;
	_execRTrig:		R_TRIG;
	_pString:		POINTER TO STRING;
	_obj:			SJsonValue;
	_jsonVal:		SJsonValue;
	_logRecordsArray: SJsonValue;
	_arrayPtr:		SJsonAIterator;
	_arrayEnd:		SJsonAIterator;
	_pLogRecord: 	POINTER TO FB_LogRecord;
	_fileOpener: 	FB_FileOpen;
	_fileWriter:	FB_FileWrite;
	_fileCloser:	FB_FileClose;
	_computedState: E_FileExporterState;
	_serializer: 	FB_LogRecordProtoJsonSerializer;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[_execRTrig(CLK := execute);

CASE currentState OF
		
	E_FileExporterState.idle, E_FileExporterState.error:
		IF _execRTrig.Q THEN
			logRecords.reset();
			_pLogRecord := logRecords.next();
			logRecords.reset();
			IF _pLogRecord <> 0 THEN
				errorCode := E_FileExporterErrorCode.UNSET;
				_computedState := E_FileExporterState.serializing;
			END_IF
		END_IF
		
	E_FileExporterState.serializing:
		_jsonVal := _serializer.parser.NewDocument();
		_serializer.parser.SetObject(_jsonVal);
		_serializer.serializeLogRecords(_jsonVal, logRecords);
		_logRecordsArray := _serializer.parser.FindMember(_jsonVal, 'logRecords');
		IF _jsonVal = 0 OR_ELSE _logRecordsArray = 0 OR_ELSE NOT _serializer.parser.IsArray(_logRecordsArray) THEN
			errorCode := E_FileExporterErrorCode.SERIALIZATION_ERROR;
			_computedState := E_FileExporterState.error;
		ELSE
			_computedState := E_FileExporterState.opening;
		END_IF
	
	E_FileExporterState.opening:
		IF _fileOpener.bError THEN
			errorCode := E_FileExporterErrorCode.FILE_OPEN_ERROR;
			_computedState := E_FileExporterState.error;
		ELSIF NOT _fileOpener.bBusy THEN
			_hFile := _fileOpener.hFile;
			_arrayPtr := _serializer.parser.ArrayBegin(_logRecordsArray);
			_arrayEnd := _serializer.parser.ArrayEnd(_logRecordsArray);
			_computedState := E_FileExporterState.buffering;
		END_IF
	
	E_FileExporterState.buffering:
		// cast the object to the string
		_obj := _serializer.parser.GetArrayValue(_arrayPtr);
		_len := _serializer.parser.GetJsonLength(_obj);  // this includes the null terminating character "0"
		_pString := __NEW(BYTE, (_len + 1));  // + 1 for new line
		_serializer.parser.CopyJson(_obj, _pString^, _len);
		CONCAT2(_pString, ADR('$N'), _pString, _len + 1);
		// increment the pointer and the counter
		_arrayPtr := _serializer.parser.NextArray(_arrayPtr);
		_idx := _idx + 1;
		
		_computedState := E_FileExporterState.writing;
		
	E_FileExporterState.writing:
		// TODO: Add error handling
		IF NOT _fileWriter.bBusy THEN
			__DELETE(_pString);
			IF _idx < GVL.MAX_LOG_RECORDS AND _arrayPtr <> _arrayEnd THEN
				_computedState := E_FileExporterState.buffering;
			ELSE
				_computedState := E_FileExporterState.closing;
			END_IF
		END_IF
		
	E_FileExporterState.closing:
		// TODO: Add error handling
		IF NOT _fileCloser.bBusy THEN
			_computedState := E_FileExporterState.idle;
		END_IF
	
END_CASE

currentState := _computedState;


IF currentState <= E_FileExporterState.serializing THEN _hFile := 0; END_IF
IF currentState < E_FileExporterState.buffering THEN _idx := 0; END_IF


_fileOpener(
	sNetId := '',
	sPathName := filepath,
	bExecute := currentState = E_FileExporterState.opening,
	nMode := FOPEN_MODEAPPEND OR FOPEN_MODETEXT,
	ePath := PATH_GENERIC,
	tTimeout := DEFAULT_ADS_TIMEOUT
);
fileOpenerErrId := _fileOpener.nErrId;

_fileWriter(
	hFile := _hFile,
	bExecute := currentState = E_FileExporterState.writing,
	pWriteBuff := _pString,
	cbWriteLen := _len
);
fileWriterErrId := _fileWriter.nErrId;

_fileCloser(
	hFile := _hFile,
	bExecute := currentState = E_FileExporterState.closing
);
fileCloserErrId := _fileCloser.nErrId;
]]></ST>
    </Implementation>
    <Method Name="export" Id="{b40925c8-02a7-4045-bcc3-ff164425210b}">
      <Declaration><![CDATA[METHOD export
VAR_IN_OUT
	logRecords: FB_LinkedList_LogRecord;  // records to serialize
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>