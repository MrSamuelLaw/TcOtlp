<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ValueFactory" Id="{d187342c-6b4d-42f2-9536-f4c1c2d2d7f1}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM ValueFactory
VAR CONSTANT
	nSpanIdBytes: USINT := 8;
	nTraceIdBytes: USINT := 16;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="createKeyValue" Id="{24aad023-b447-4a30-a636-682e068d33e5}">
      <Declaration><![CDATA[METHOD createKeyValue: E_ValueFactoryStatus
VAR_IN_OUT
	pDest: POINTER TO FB_KeyValue;
END_VAR
VAR_INPUT
	pKey: POINTER TO STRING;
	pVal: POINTER TO FB_AnyValue;
END_VAR
VAR
	_pNew: POINTER TO FB_KeyValue;
	_pKey: POINTER TO STRING;
	_pVal: POINTER TO FB_AnyValue;
	_len: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pKey = 0 OR pVal = 0 THEN
	createKeyValue := E_ValueFactoryStatus.INVALID_PARAMETERS;
	RETURN;
END_IF

IF pDest <> 0 THEN
	createKeyValue := E_ValueFactoryStatus.POINTER_ALREADY_ALLOCATED;
	RETURN;
END_IF

IF NOT pVal^.initialized THEN
	createKeyValue := E_ValueFactoryStatus.INVALID_PARAMETERS;
	RETURN;
END_IF

// clone all owned data before allocating the value itself
_len := MIN(LEN2(pKey), GVL.MAX_STRING_LEN) + 1;
_pKey := __NEW(BYTE, _len);
IF _pKey = 0 THEN
	createKeyValue := E_ValueFactoryStatus.OUT_OF_MEMORY;
	RETURN;
END_IF
MEMCPY(_pKey, pKey, _len);

_pVal := cloneAnyValue(pVal);
IF _pVal = 0 THEN
	createKeyValue := E_ValueFactoryStatus.OUT_OF_MEMORY;
	__DELETE(_pKey);
	RETURN;
END_IF

IF NOT _pVal^.initialized THEN
	createKeyValue := E_ValueFactoryStatus.OUT_OF_MEMORY;
	__DELETE(_pKey);
	_pVal := _pVal^.delete();
	RETURN;
END_IF

_pNew := __NEW(FB_KeyValue(pKey:=_pKey, pVal:=_pVal));
IF _pNew = 0 THEN
	createKeyValue := E_ValueFactoryStatus.OUT_OF_MEMORY;
	__DELETE(_pKey);
	_pVal := _pVal^.delete();
END_IF
pDest := _pNew;
createKeyValue := E_ValueFactoryStatus.SUCCESS;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="createNumber" Id="{3bcb96ce-f273-4452-a75d-ea53e63d4d25}">
      <Declaration><![CDATA[METHOD createNumber : POINTER TO FB_Number
VAR_INPUT
	pDest: POINTER TO FB_Number;
	value: ANY_NUM;
END_VAR
VAR_OUTPUT
	sts: E_ValueFactoryStatus;
END_VAR
VAR
	_pValue: POINTER TO BYTE;
	_size: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[createNumber := 0;
IF pDest <> 0 THEN
	createNumber := pDest;
	sts := E_ValueFactoryStatus.POINTER_ALREADY_ALLOCATED;
	RETURN;
END_IF

IF value.pValue = 0 OR value.diSize <= 0 THEN
	sts := E_ValueFactoryStatus.INVALID_PARAMETERS;
	RETURN;
END_IF

// Copy the concrete numeric value so the wrapper never retains caller-owned data.
_size := TO_UDINT(value.diSize);
_pValue := __NEW(BYTE, _size);
IF _pValue = 0 THEN
	sts := E_ValueFactoryStatus.OUT_OF_MEMORY;
	RETURN;
END_IF
MEMCPY(_pValue, value.pValue, _size);

createNumber := __NEW(FB_Number(
	typeClass:=value.typeclass,
	pValue:=_pValue,
	diSize:=value.diSize
));
IF createNumber = 0 THEN
	sts := E_ValueFactoryStatus.OUT_OF_MEMORY;
	__DELETE(_pValue);
ELSE
	sts := E_ValueFactoryStatus.SUCCESS;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="createSpanId" Id="{8c55c398-28af-4759-b54f-4b55d341d11a}">
      <Declaration><![CDATA[METHOD createSpanId: E_ValueFactoryStatus
VAR_IN_OUT
	pDest: POINTER TO FB_SpanId;
END_VAR
VAR_INPUT
	pBytes: POINTER TO BYTE;
	nSize: UDINT;
END_VAR
VAR
	_pNew: POINTER TO FB_SpanId;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pDest <> 0 THEN
	createSpanId := E_ValueFactoryStatus.POINTER_ALREADY_ALLOCATED;
	RETURN;
END_IF

IF pBytes = 0 OR nSize < ValueFactory.nSpanIdBytes THEN
	createSpanId := E_ValueFactoryStatus.INVALID_PARAMETERS;
	RETURN;
END_IF

_pNew := __NEW(FB_SpanId);
IF _pNew = 0 THEN
	createSpanId := E_ValueFactoryStatus.OUT_OF_MEMORY;
	RETURN;
END_IF

MEMCPY(ADR(_pNew^.bytes), pBytes, SIZEOF(_pNew^.bytes));
pDest := _pNew;
createSpanId := E_ValueFactoryStatus.SUCCESS;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="createString" Id="{c9d254c2-678b-419f-ac3c-e884e66c3532}">
      <Declaration><![CDATA[METHOD createString: E_ValueFactoryStatus
VAR_IN_OUT
	pDest: POINTER TO FB_String;
END_VAR
VAR_INPUT
	pString: POINTER TO STRING;
END_VAR
VAR
	_pString: POINTER TO STRING;
	_pNew: POINTER TO FB_String;
	_len: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pDest <> 0  THEN
	createString := E_ValueFactoryStatus.POINTER_ALREADY_ALLOCATED;
	RETURN;
END_IF

IF pString = 0 THEN
	createString := E_ValueFactoryStatus.INVALID_PARAMETERS;
	RETURN;
END_IF

// clone the string into a new pointer so as to not use mutable data
// an extra character is needed for the terminating character, which is a literal 0 just like "cstrings"
_len := MIN(LEN2(pString), GVL.MAX_STRING_LEN) + 1;
_pString := __NEW(BYTE, _len);
IF _pString = 0 THEN
	createString := E_ValueFactoryStatus.OUT_OF_MEMORY;
	RETURN;
END_IF
MEMCPY(_pString, pString, _len);

_pNew := __NEW(FB_String(pString:=_pString));
IF _pNew = 0 THEN
	createString := E_ValueFactoryStatus.OUT_OF_MEMORY;
	__DELETE(_pString);
END_IF
pDest := _pNew;
createString := E_ValueFactoryStatus.SUCCESS;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="createTraceId" Id="{34de56b8-186c-4fd3-a48c-783b8c21d02f}">
      <Declaration><![CDATA[METHOD createTraceId: E_ValueFactoryStatus
VAR_IN_OUT
	pDest: POINTER TO FB_TraceId;
END_VAR
VAR_INPUT
	pBytes: POINTER TO BYTE;
	nSize: UDINT;
END_VAR
VAR
	_pNew: POINTER TO FB_TraceId;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pDest <> 0 THEN
	createTraceId := E_ValueFactoryStatus.POINTER_ALREADY_ALLOCATED;
	RETURN;
END_IF

IF pBytes = 0 OR nSize < ValueFactory.nTraceIdBytes THEN
	createTraceId := E_ValueFactoryStatus.INVALID_PARAMETERS;
	RETURN;
END_IF

_pNew := __NEW(FB_TraceId);
IF _pNew = 0 THEN
	createTraceId := E_ValueFactoryStatus.OUT_OF_MEMORY;
	RETURN;
END_IF
MEMCPY(ADR(_pNew^.bytes), pBytes, SIZEOF(_pNew^.bytes));
pDest := _pNew;
createTraceId := E_ValueFactoryStatus.SUCCESS;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>