<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TraceId" Id="{957763e9-1dc3-43f7-8bee-d4f8556d5952}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_TraceId EXTENDS FB_OtlpValueMixin IMPLEMENTS I_OtlpValue
VAR_OUTPUT
	bytes: ARRAY [0..15] OF BYTE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="delete" Id="{c97e0256-4d82-467f-8451-1a78cc35cf61}">
      <Declaration><![CDATA[METHOD delete

VAR
	pSelf: POINTER TO FB_TraceId;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[pSelf := THIS;
__DELETE(pSelf);]]></ST>
      </Implementation>
    </Method>
    <Property Name="eType" Id="{a8e38517-e28e-4988-8201-c1e2d19bf319}">
      <Declaration><![CDATA[PROPERTY eType : E_ValueType]]></Declaration>
      <Get Name="Get" Id="{932f2685-55a3-403d-b638-288e54b28a9f}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[eType := E_ValueType.E_TraceId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Exit" Id="{c97eaf69-2ccb-4370-a9b2-610f66a40aba}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{92512704-d1be-4109-bc86-ea075a165ecc}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)   
	pBytes: POINTER TO BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF pBytes <> 0 THEN
	MEMCPY(ADR(THIS^.bytes), pBytes, 16);
	THIS^._initialized := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="free" Id="{f2521e9b-00ca-4214-9c98-a50a3ee6d37e}">
      <Declaration><![CDATA[METHOD free]]></Declaration>
      <Implementation>
        <ST><![CDATA[// just resets values to defaults
MEMSET(ADR(THIS^.bytes), 0, SIZEOF(THIS^.bytes));
THIS^._initialized := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>