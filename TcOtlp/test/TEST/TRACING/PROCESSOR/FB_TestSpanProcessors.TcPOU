<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestSpanProcessors" Id="{b3192278-4ca7-4ecc-b77c-8e4f07666086}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests FB_SpanProcessor_Simple and FB_SpanProcessor_Batch and their hand-off to an exporter. *)
FUNCTION_BLOCK FB_TestSpanProcessors EXTENDS FB_TestSuite
VAR
	// kept across scans by testBatchExportsAfterScheduledDelay
	_resource: FB_Resource('');
	_idGenerator: FB_MockIdGenerator;
	_provider: FB_TracerProvider_ForInspection(resource:=_resource, idGenerator:=_idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	_scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	_tracer: FB_Tracer(scope:=_scope, provider:=_provider);
	_exporter: FB_SpanExporter_ForInspection;
	_processor: FB_SpanProcessor_Batch(maxQueueSize:=10, scheduledDelayMillis:=50, maxExportBatchSize:=10, exporter:=_exporter);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testSimpleEnrichesThenExports();
THIS^.testSimpleHandsCloneToExporter();
THIS^.testSimpleDropsSpanWhenExporterBusy();
THIS^.testBatchWaitsForFullBatch();
THIS^.testBatchKeepsSpansWhileExporterBusy();
THIS^.testBatchDropsOldestWhenFull();
THIS^.testBatchIgnoresSpansWithoutExporter();
THIS^.testBatchExportsAfterScheduledDelay();]]></ST>
    </Implementation>
    <Method Name="testSimpleEnrichesThenExports" Id="{b1346e05-6ad0-4ee2-8d51-e80fda8984ed}">
      <Declaration><![CDATA[(* The simple processor enriches each span and then exports it, once per span. *)
METHOD testSimpleEnrichesThenExports : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	processor: FB_SpanProcessor_ForInspection(exporter:=0);
	pSpan: POINTER TO FB_Span;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSimpleEnrichesThenExports');
	tracer.startSpan(name:='work').build(pDest:=pSpan);
	THIS^.AssertTrue(pSpan <> 0, 'Expected the span to build');
	IF pSpan <> 0 THEN
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	THIS^.AssertEquals_UDINT(1, processor.enrichedCount, 'Expected one enrich');
	THIS^.AssertEquals_UDINT(1, processor.exportedCount, 'Expected one export');
	THIS^.AssertTrue(processor.enrichedBeforeExport, 'Expected enrich to run before export');
	THIS^.AssertEquals_STRING('work', processor.lastSpanName, 'Expected the span to be exported');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSimpleHandsCloneToExporter" Id="{beb91446-b849-43c4-8174-85a9c90995e9}">
      <Declaration><![CDATA[(* The simple processor gives the exporter a clone, which outlives the span the provider releases. *)
METHOD testSimpleHandsCloneToExporter : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	exporter: FB_SpanExporter_ForInspection;
	processor: FB_SpanProcessor_Simple(exporter:=exporter);
	pSpan: POINTER TO FB_Span;
	pSource: POINTER TO FB_Span;
	pHeld: POINTER TO FB_Span;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSimpleHandsCloneToExporter');
	tracer.startSpan(name:='work').build(pDest:=pSpan);
	THIS^.AssertTrue(pSpan <> 0, 'Expected the span to build');
	IF pSpan <> 0 THEN
		pSource := pSpan;
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	THIS^.AssertEquals_UDINT(1, exporter.exportCount, 'Expected one export');
	THIS^.AssertEquals_UDINT(1, exporter.lastBatchCount, 'Expected a batch of one');
	pHeld := exporter.heldSpan();
	THIS^.AssertTrue(pHeld <> 0 AND_THEN pHeld <> pSource, 'Expected the exporter to hold a clone');
	IF pHeld <> 0 AND_THEN pHeld^.name <> 0 THEN
		THIS^.AssertEquals_STRING('work', pHeld^.name^.pString^, 'Expected the clone to outlive the source');
	END_IF
	processor.tick();
	THIS^.AssertEquals_UDINT(1, exporter.tickCount, 'Expected tick to reach the exporter');
	exporter.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSimpleDropsSpanWhenExporterBusy" Id="{49a5373a-c431-4bf6-9cea-cc0b09ee197a}">
      <Declaration><![CDATA[(* A busy exporter is not offered the span, and nothing is kept for later. *)
METHOD testSimpleDropsSpanWhenExporterBusy : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	exporter: FB_SpanExporter_ForInspection;
	processor: FB_SpanProcessor_Simple(exporter:=exporter);
	pSpan: POINTER TO FB_Span;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSimpleDropsSpanWhenExporterBusy');
	exporter.busy := TRUE;
	tracer.startSpan(name:='work').build(pDest:=pSpan);
	IF pSpan <> 0 THEN
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	THIS^.AssertEquals_UDINT(0, exporter.exportCount, 'Expected no export while busy');
	THIS^.AssertEquals_UDINT(0, exporter.callsWhileBusy, 'Expected the processor not to call a busy exporter');
	THIS^.AssertTrue(exporter.heldSpan() = 0, 'Expected the exporter to hold nothing');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testBatchWaitsForFullBatch" Id="{15723bbf-5af7-4d94-98ee-bc86b3d23e69}">
      <Declaration><![CDATA[(* Ended spans are only queued; a full batch goes out on the next tick without waiting for the delay. *)
METHOD testBatchWaitsForFullBatch : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	exporter: FB_SpanExporter_ForInspection;
	processor: FB_SpanProcessor_Batch(maxQueueSize:=10, scheduledDelayMillis:=60000, maxExportBatchSize:=3, exporter:=exporter);
	pSpan: POINTER TO FB_Span;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testBatchWaitsForFullBatch');
	tracer.startSpan(name:='a').build(pDest:=pSpan);
	IF pSpan <> 0 THEN
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	tracer.startSpan(name:='b').build(pDest:=pSpan);
	IF pSpan <> 0 THEN
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	THIS^.AssertEquals_UDINT(0, exporter.exportCount, 'Expected onEnd not to export');
	THIS^.AssertEquals_UDINT(2, processor.queuedCount, 'Expected two queued spans');
	processor.tick();
	THIS^.AssertEquals_UDINT(0, exporter.exportCount, 'Expected no export before a full batch or the delay');
	THIS^.AssertEquals_UDINT(1, exporter.tickCount, 'Expected tick to reach the exporter');
	tracer.startSpan(name:='c').build(pDest:=pSpan);
	IF pSpan <> 0 THEN
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	processor.tick();
	THIS^.AssertEquals_UDINT(1, exporter.exportCount, 'Expected one export for the full batch');
	THIS^.AssertEquals_UDINT(3, exporter.lastBatchCount, 'Expected the three spans in one batch');
	THIS^.AssertEquals_UDINT(0, processor.queuedCount, 'Expected the queue to be empty');
	THIS^.AssertEquals_UDINT(0, processor.droppedCount, 'Expected nothing dropped');
	exporter.free();
	processor.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testBatchKeepsSpansWhileExporterBusy" Id="{4f1551b4-6cdc-4f53-9e63-f566802c1f0e}">
      <Declaration><![CDATA[(* Spans that end while the exporter is busy stay queued and are exported once it is idle. *)
METHOD testBatchKeepsSpansWhileExporterBusy : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	exporter: FB_SpanExporter_ForInspection;
	processor: FB_SpanProcessor_Batch(maxQueueSize:=10, scheduledDelayMillis:=60000, maxExportBatchSize:=1, exporter:=exporter);
	pSpan: POINTER TO FB_Span;
	pHeld: POINTER TO FB_Span;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testBatchKeepsSpansWhileExporterBusy');
	exporter.busy := TRUE;
	tracer.startSpan(name:='first').build(pDest:=pSpan);
	IF pSpan <> 0 THEN
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	tracer.startSpan(name:='second').build(pDest:=pSpan);
	IF pSpan <> 0 THEN
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	processor.tick();
	THIS^.AssertEquals_UDINT(0, exporter.exportCount, 'Expected no export while busy');
	THIS^.AssertEquals_UDINT(0, exporter.callsWhileBusy, 'Expected the processor not to call a busy exporter');
	THIS^.AssertEquals_UDINT(2, processor.queuedCount, 'Expected both spans kept');

	exporter.busy := FALSE;
	processor.tick();
	THIS^.AssertEquals_UDINT(1, exporter.exportCount, 'Expected an export once idle');
	THIS^.AssertEquals_UDINT(1, exporter.lastBatchCount, 'Expected a batch of maxExportBatchSize');
	pHeld := exporter.heldSpan();
	IF pHeld <> 0 AND_THEN pHeld^.name <> 0 THEN
		THIS^.AssertEquals_STRING('first', pHeld^.name^.pString^, 'Expected the oldest span first');
	ELSE
		THIS^.AssertTrue(FALSE, 'Expected the exporter to hold a span');
	END_IF
	THIS^.AssertEquals_UDINT(1, processor.queuedCount, 'Expected the newer span to wait');

	processor.tick();
	THIS^.AssertEquals_UDINT(2, exporter.exportCount, 'Expected the second span on the next tick');
	pHeld := exporter.heldSpan();
	IF pHeld <> 0 AND_THEN pHeld^.name <> 0 THEN
		THIS^.AssertEquals_STRING('second', pHeld^.name^.pString^, 'Expected the newer span second');
	END_IF
	THIS^.AssertEquals_UDINT(0, processor.droppedCount, 'Expected nothing dropped');
	exporter.free();
	processor.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testBatchDropsOldestWhenFull" Id="{32c54bb7-a04e-45a8-a28b-62eae9d9e7f2}">
      <Declaration><![CDATA[(* A full queue drops its oldest span for the newest and counts it. *)
METHOD testBatchDropsOldestWhenFull : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	exporter: FB_SpanExporter_ForInspection;
	processor: FB_SpanProcessor_Batch(maxQueueSize:=2, scheduledDelayMillis:=60000, maxExportBatchSize:=2, exporter:=exporter);
	pSpan: POINTER TO FB_Span;
	pHeld: POINTER TO FB_Span;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testBatchDropsOldestWhenFull');
	exporter.busy := TRUE;
	tracer.startSpan(name:='a').build(pDest:=pSpan);
	IF pSpan <> 0 THEN
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	tracer.startSpan(name:='b').build(pDest:=pSpan);
	IF pSpan <> 0 THEN
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	tracer.startSpan(name:='c').build(pDest:=pSpan);
	IF pSpan <> 0 THEN
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	THIS^.AssertEquals_UDINT(2, processor.queuedCount, 'Expected the queue to stay at maxQueueSize');
	THIS^.AssertEquals_UDINT(1, processor.droppedCount, 'Expected one dropped span');
	processor.tick();
	THIS^.AssertEquals_UDINT(0, exporter.callsWhileBusy, 'Expected the processor not to call a busy exporter with a full batch');
	exporter.busy := FALSE;
	processor.tick();
	THIS^.AssertEquals_UDINT(2, exporter.lastBatchCount, 'Expected the two kept spans');
	pHeld := exporter.heldSpan();
	IF pHeld <> 0 AND_THEN pHeld^.name <> 0 THEN
		THIS^.AssertEquals_STRING('b', pHeld^.name^.pString^, 'Expected the oldest span to be the one dropped');
	ELSE
		THIS^.AssertTrue(FALSE, 'Expected the exporter to hold a span');
	END_IF
	exporter.free();
	processor.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testBatchIgnoresSpansWithoutExporter" Id="{d23d10e4-7df6-4166-af85-efaf07b2df2b}">
      <Declaration><![CDATA[(* With no exporter the processor keeps nothing. *)
METHOD testBatchIgnoresSpansWithoutExporter : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	exporter: FB_SpanExporter_ForInspection;
	processor: FB_SpanProcessor_Batch(maxQueueSize:=10, scheduledDelayMillis:=0, maxExportBatchSize:=1, exporter:=0);
	pSpan: POINTER TO FB_Span;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testBatchIgnoresSpansWithoutExporter');
	tracer.startSpan(name:='work').build(pDest:=pSpan);
	IF pSpan <> 0 THEN
		processor.onEnd(pSpan^);
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	processor.tick();
	THIS^.AssertEquals_UDINT(0, processor.queuedCount, 'Expected nothing queued');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testBatchExportsAfterScheduledDelay" Id="{352a6890-8f0a-4b92-94b2-dd5e8777d778}">
      <Declaration><![CDATA[(* A partial batch is exported once scheduledDelayMillis has passed, and not before. *)
METHOD testBatchExportsAfterScheduledDelay : REFERENCE TO FB_Test
VAR CONSTANT
	DELAY_MILLIS: UDINT := 50;  // matches _processor's scheduledDelayMillis
	MAX_CYCLES: UDINT := 1000;
END_VAR
VAR_INST
	_started: BOOL;
	_finished: BOOL;
	_cycles: UDINT;
	_startTime: ULINT;
END_VAR
VAR
	pSpan: POINTER TO FB_Span;
	elapsedMillis: ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testBatchExportsAfterScheduledDelay');
	IF _finished THEN
		RETURN;
	END_IF
	IF NOT _started THEN
		_tracer.startSpan(name:='work').build(pDest:=pSpan);
		IF pSpan <> 0 THEN
			_processor.onEnd(pSpan^);
			pSpan^.delete(pSelf:=pSpan);
		END_IF
		_startTime := F_GetSystemTime();
		_started := TRUE;
	END_IF

	_processor.tick();
	_cycles := _cycles + 1;
	IF _exporter.exportCount > 0 OR _cycles > MAX_CYCLES THEN
		elapsedMillis := (F_GetSystemTime() - _startTime) / 10000;  // 100 ns ticks
		THIS^.AssertEquals_UDINT(1, _exporter.exportCount, 'Expected the partial batch to be exported');
		THIS^.AssertEquals_UDINT(1, _exporter.lastBatchCount, 'Expected a batch of one');
		THIS^.AssertTrue(elapsedMillis >= DELAY_MILLIS - 1, 'Expected the export to wait for the delay');
		_exporter.free();
		_processor.free();
		_finished := TRUE;
		TcUnit.TEST_FINISHED();
	END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>