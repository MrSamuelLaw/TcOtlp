<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestTracer" Id="{35fe2dda-8b84-4218-ae76-39ef68e243e6}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests the FB_Tracer fluent chain: validation at each step, identifier and flag assignment,
   and the hand-over of the built span to the caller. Also tests the methods that read and
   change a running span, which all refuse a null span. Each test builds its own provider and
   tracer around a deterministic id generator. *)
FUNCTION_BLOCK FB_TestTracer EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testBuildsRootSpan();
THIS^.testBuildsChildOfLocalParent();
THIS^.testChildOfRemoteParent();
THIS^.testRejectsInvalidParent();
THIS^.testBuildsChildOfSpan();
THIS^.testRejectsInvalidParentSpan();
THIS^.testKeepsFirstFailure();
THIS^.testRejectsEmptyName();
THIS^.testRejectsUnspecifiedKind();
THIS^.testBuildWithoutStartFails();
THIS^.testStartingSecondSpanFails();
THIS^.testBuildIntoAssignedDestinationFails();
THIS^.testNoIdentifiersAvailable();
THIS^.testSetsAttributes();
THIS^.testEndSpanQueuesSpan();
THIS^.testEndSpanRejectsNull();
THIS^.testEndSpanWithoutProcessorsQueuesSpan();
THIS^.testSetSpanStatusOk();
THIS^.testSetSpanStatusError();
THIS^.testSetSpanStatusFirstWins();
THIS^.testGetSpanContextCopiesIdentity();
THIS^.testGetSpanContextIsLocal();
THIS^.testGetSpanContextRejectsAssignedDestination();
THIS^.testGetSpanContextOnUnbuiltSpan();
THIS^.testAddsLinksToRunningSpan();
THIS^.testSetsRunningSpanAttributes();
THIS^.testDiscardSpanReleasesSpan();
THIS^.testRunningSpanMethodsRejectNullSpan();
THIS^.testAddsLinks();
THIS^.testRejectsInvalidLink();]]></ST>
    </Implementation>
    <Method Name="testBuildsRootSpan" Id="{00bf1eb6-c0c9-43b1-a36c-e82587fffac9}">
      <Declaration><![CDATA[(* A span without a parent starts a new trace: it gets fresh identifiers, no parent, root flags,
   and snapshots of the resource and scope. The tracer gives up ownership. *)
METHOD testBuildsRootSpan : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testBuildsRootSpan');
	success := tracer.startSpan(name:='root').build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected a root span to build');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.NA),
		TO_UDINT(reason),
		'Expected no failure reason on success'
	);
	THIS^.AssertTrue(pSpan <> 0, 'Expected build to assign the destination');
	THIS^.AssertTrue(tracer.pSpan = 0, 'Expected the tracer to hand over the span');

	IF pSpan <> 0 THEN
		THIS^.AssertTrue(pSpan^.traceId <> 0, 'Expected a trace id');
		THIS^.AssertTrue(pSpan^.spanId <> 0, 'Expected a span id');
		THIS^.AssertTrue(pSpan^.parentSpanId = 0, 'Expected a root span to have no parent');
		THIS^.AssertTrue(pSpan^.traceState = 0, 'Expected a root span to have no trace state');
		THIS^.AssertTrue(pSpan^.name <> 0, 'Expected a name');
		IF pSpan^.name <> 0 THEN
			THIS^.AssertEquals_STRING('root', pSpan^.name^.pString^, 'Expected the name to be copied');
		END_IF
		THIS^.AssertEquals_UDINT(
			TO_UDINT(E_SpanKind.SPAN_KIND_INTERNAL),
			TO_UDINT(pSpan^.kind),
			'Expected the default kind to be INTERNAL'
		);
		THIS^.AssertTrue(pSpan^.startTimestamp > 0, 'Expected a start timestamp');
		THIS^.AssertEquals_UDINT(16#101, pSpan^.flags, 'Expected a root span to be sampled with remoteness known');
		THIS^.AssertEquals_STRING('tracer.test', pSpan^.scope.name, 'Expected the scope to be snapshotted');
		pSpan^.delete(pSelf:=pSpan);
	END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testBuildsChildOfLocalParent" Id="{d767c00c-eda9-4be4-85f9-90a9cbc2e617}">
      <Declaration><![CDATA[(* A child of a local span continues its trace, records the parent's span id, and takes its
   own span id. *)
METHOD testBuildsChildOfLocalParent : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pRoot: POINTER TO FB_Span;
	pChild: POINTER TO FB_Span;
	pContext: POINTER TO FB_SpanContext;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testBuildsChildOfLocalParent');
	tracer.startSpan(name:='root').build(pDest:=pRoot);
	IF pRoot <> 0 THEN
		tracer.getSpanContext(pSpan:=pRoot, pDest:=pContext);
	END_IF

	success := tracer
		.startSpan(name:='child', kind:=E_SpanKind.SPAN_KIND_CLIENT)
		.setParentUsingContext(pContext:=pContext)
		.build(pDest:=pChild, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected a child span to build');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.NA),
		TO_UDINT(reason),
		'Expected no failure reason on success'
	);

	IF pRoot <> 0 AND_THEN pChild <> 0 THEN
		THIS^.AssertTrue(
			MEMCMP(ADR(pChild^.traceId^.bytes), ADR(pRoot^.traceId^.bytes), SIZEOF(pRoot^.traceId^.bytes)) = 0,
			'Expected the child to continue the parent$'s trace'
		);
		THIS^.AssertTrue(pChild^.parentSpanId <> 0, 'Expected the child to record its parent');
		IF pChild^.parentSpanId <> 0 THEN
			THIS^.AssertTrue(
				MEMCMP(ADR(pChild^.parentSpanId^.bytes), ADR(pRoot^.spanId^.bytes), SIZEOF(pRoot^.spanId^.bytes)) = 0,
				'Expected the parent span id to be the root$'s span id'
			);
		END_IF
		THIS^.AssertTrue(
			MEMCMP(ADR(pChild^.spanId^.bytes), ADR(pRoot^.spanId^.bytes), SIZEOF(pRoot^.spanId^.bytes)) <> 0,
			'Expected the child to have its own span id'
		);
		THIS^.AssertEquals_UDINT(16#101, pChild^.flags, 'Expected a local parent to set bit 8 but not bit 9');
		THIS^.AssertEquals_UDINT(
			TO_UDINT(E_SpanKind.SPAN_KIND_CLIENT),
			TO_UDINT(pChild^.kind),
			'Expected the kind to be kept'
		);
	END_IF

	IF pContext <> 0 THEN pContext^.delete(pSelf:=pContext); END_IF
	IF pChild <> 0 THEN pChild^.delete(pSelf:=pChild); END_IF
	IF pRoot <> 0 THEN pRoot^.delete(pSelf:=pRoot); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testChildOfRemoteParent" Id="{daaa2fcb-0ec4-4a92-b2ad-c80f47ed2436}">
      <Declaration><![CDATA[(* A remote parent sets bits 8 and 9 on the child and its trace state is copied. The child's
   own context is still local. *)
METHOD testChildOfRemoteParent : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pChild: POINTER TO FB_Span;
	pRemote: POINTER TO FB_SpanContext;
	pChildContext: POINTER TO FB_SpanContext;
	traceId: FB_TraceId;
	spanId: FB_SpanId;
	traceStateText: T_MaxString := 'vendor=abc';
	pTraceState: POINTER TO FB_TraceState;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testChildOfRemoteParent');
	MEMSET(ADR(traceId.bytes), 16#AA, SIZEOF(traceId.bytes));
	MEMSET(ADR(spanId.bytes), 16#BB, SIZEOF(spanId.bytes));
	TraceStateFactory.parse(pDest:=pTraceState, pHeader:=ADR(traceStateText));
	ContextFactory.buildContext(
		pDest:=pRemote,
		pTraceId:=ADR(traceId),
		pSpanId:=ADR(spanId),
		pTraceState:=pTraceState,
		traceFlags:=16#301
	);
	IF pTraceState <> 0 THEN pTraceState^.delete(pSelf:=pTraceState); END_IF

	success := tracer
		.startSpan(name:='remote.child', kind:=E_SpanKind.SPAN_KIND_CONSUMER)
		.setParentUsingContext(pContext:=pRemote)
		.build(pDest:=pChild, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected a child of a remote parent to build');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.NA),
		TO_UDINT(reason),
		'Expected no failure reason on success'
	);

	// the context is borrowed, so it can be released before the span
	IF pRemote <> 0 THEN pRemote^.delete(pSelf:=pRemote); END_IF

	IF pChild <> 0 THEN
		THIS^.AssertEquals_UDINT(16#301, pChild^.flags, 'Expected a remote parent to set bits 8 and 9');
		THIS^.AssertTrue(
			MEMCMP(ADR(pChild^.traceId^.bytes), ADR(traceId.bytes), SIZEOF(traceId.bytes)) = 0,
			'Expected the child to continue the remote trace'
		);
		THIS^.AssertTrue(pChild^.traceState <> 0, 'Expected the trace state to be copied');
		IF pChild^.traceState <> 0 THEN
			THIS^.AssertEquals_STRING('vendor=abc', pChild^.traceState^.pString^, 'Expected the trace state text to be copied');
		END_IF

		tracer.getSpanContext(pSpan:=pChild, pDest:=pChildContext);
		THIS^.AssertTrue(pChildContext <> 0, 'Expected a context from the child');
		IF pChildContext <> 0 THEN
			THIS^.AssertFalse(pChildContext^.isRemote(), 'Expected the child$'s own context to be local');
			THIS^.AssertEquals_UDINT(16#101, pChildContext^.traceFlags, 'Expected the sampled bit and bit 8 only');
			pChildContext^.delete(pSelf:=pChildContext);
		END_IF
		pChild^.delete(pSelf:=pChild);
	END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testRejectsInvalidParent" Id="{f4d6796d-d0a7-4167-a603-97aeb6cb3922}">
      <Declaration><![CDATA[(* A parent context with all zero identifiers is rejected and nothing is handed over. *)
METHOD testRejectsInvalidParent : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	pContext: POINTER TO FB_SpanContext;
	traceId: FB_TraceId;
	spanId: FB_SpanId;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testRejectsInvalidParent');
	ContextFactory.buildContext(pDest:=pContext, pTraceId:=ADR(traceId), pSpanId:=ADR(spanId), pTraceState:=0, traceFlags:=16#101);

	success := tracer.startSpan(name:='child').setParentUsingContext(pContext:=pContext).build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected an invalid parent to fail the chain');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.PARENT_CONTEXT_INVALID),
		TO_UDINT(reason),
		'Expected PARENT_CONTEXT_INVALID'
	);
	THIS^.AssertTrue(pSpan = 0, 'Expected the destination to stay unassigned');
	THIS^.AssertTrue(tracer.pSpan = 0, 'Expected the incomplete span to be released');

	IF pContext <> 0 THEN pContext^.delete(pSelf:=pContext); END_IF
	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testBuildsChildOfSpan" Id="{b4e1c9a2-6d38-4f75-8e0b-2a7c5f1d9e36}">
      <Declaration><![CDATA[(* setParentUsingSpan takes the parent's identity straight from a built span: the child
   continues its trace, records its span id, copies its trace state and marks the parent as
   local, even when the parent itself has a remote parent. *)
METHOD testBuildsChildOfSpan : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pRemote: POINTER TO FB_SpanContext;
	pParent: POINTER TO FB_Span;
	pChild: POINTER TO FB_Span;
	traceId: FB_TraceId;
	spanId: FB_SpanId;
	traceStateText: T_MaxString := 'vendor=abc';
	pTraceState: POINTER TO FB_TraceState;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testBuildsChildOfSpan');
	MEMSET(ADR(traceId.bytes), 16#AA, SIZEOF(traceId.bytes));
	MEMSET(ADR(spanId.bytes), 16#BB, SIZEOF(spanId.bytes));
	TraceStateFactory.parse(pDest:=pTraceState, pHeader:=ADR(traceStateText));
	ContextFactory.buildContext(
		pDest:=pRemote,
		pTraceId:=ADR(traceId),
		pSpanId:=ADR(spanId),
		pTraceState:=pTraceState,
		traceFlags:=16#301
	);
	IF pTraceState <> 0 THEN pTraceState^.delete(pSelf:=pTraceState); END_IF
	tracer.startSpan(name:='parent').setParentUsingContext(pContext:=pRemote).build(pDest:=pParent);
	IF pRemote <> 0 THEN pRemote^.delete(pSelf:=pRemote); END_IF
	THIS^.AssertTrue(pParent <> 0, 'Expected the parent span to build');

	success := tracer
		.startSpan(name:='child')
		.setParentUsingSpan(pParentSpan:=pParent)
		.build(pDest:=pChild, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected a child of a span to build');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.NA),
		TO_UDINT(reason),
		'Expected no failure reason on success'
	);

	IF pParent <> 0 AND_THEN pChild <> 0 THEN
		THIS^.AssertTrue(
			MEMCMP(ADR(pChild^.traceId^.bytes), ADR(pParent^.traceId^.bytes), SIZEOF(pParent^.traceId^.bytes)) = 0,
			'Expected the child to continue the parent$'s trace'
		);
		THIS^.AssertTrue(pChild^.parentSpanId <> 0, 'Expected the child to record its parent');
		IF pChild^.parentSpanId <> 0 THEN
			THIS^.AssertTrue(
				MEMCMP(ADR(pChild^.parentSpanId^.bytes), ADR(pParent^.spanId^.bytes), SIZEOF(pParent^.spanId^.bytes)) = 0,
				'Expected the parent span id to be the parent$'s span id'
			);
		END_IF
		THIS^.AssertEquals_UDINT(16#101, pChild^.flags, 'Expected a span parent to be local: bit 8 set, bit 9 clear');
		THIS^.AssertTrue(pChild^.traceState <> 0, 'Expected the trace state to be copied');
		IF pChild^.traceState <> 0 THEN
			THIS^.AssertTrue(pChild^.traceState <> pParent^.traceState, 'Expected the child to own its own trace state');
			THIS^.AssertEquals_STRING('vendor=abc', pChild^.traceState^.pString^, 'Expected the trace state text to be copied');
		END_IF
	END_IF

	IF pChild <> 0 THEN pChild^.delete(pSelf:=pChild); END_IF
	IF pParent <> 0 THEN pParent^.delete(pSelf:=pParent); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testRejectsInvalidParentSpan" Id="{e7a3d5b1-2c94-4e8f-b6a0-9f1c3d7e5a42}">
      <Declaration><![CDATA[(* setParentUsingSpan refuses a null span and a span that has not been built, and nothing is
   handed over. *)
METHOD testRejectsInvalidParentSpan : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	unbuilt: FB_Span;
	pSpan: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testRejectsInvalidParentSpan');
	success := tracer.startSpan(name:='child').setParentUsingSpan(pParentSpan:=0).build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected a null parent span to fail the chain');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.PARENT_SPAN_POINTER_NULL),
		TO_UDINT(reason),
		'Expected PARENT_SPAN_POINTER_NULL'
	);
	THIS^.AssertTrue(pSpan = 0, 'Expected the destination to stay unassigned');

	success := tracer.startSpan(name:='child').setParentUsingSpan(pParentSpan:=ADR(unbuilt)).build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected a parent span without identifiers to fail the chain');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.PARENT_SPAN_INVALID),
		TO_UDINT(reason),
		'Expected PARENT_SPAN_INVALID'
	);
	THIS^.AssertTrue(pSpan = 0, 'Expected the destination to stay unassigned');
	THIS^.AssertTrue(tracer.pSpan = 0, 'Expected the incomplete span to be released');

	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testKeepsFirstFailure" Id="{b89ccf9f-0932-4580-aefb-9e45bff4b52e}">
      <Declaration><![CDATA[(* Later steps in a failed chain do not replace the first failure. *)
METHOD testKeepsFirstFailure : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testKeepsFirstFailure');
	success := tracer
		.startSpan(name:='child')
		.setParentUsingContext(pContext:=0)
		.setStringAttribute('key', 'value')
		.build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected a null parent to fail the chain');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.PARENT_CONTEXT_POINTER_NULL),
		TO_UDINT(reason),
		'Expected the first failure to be reported'
	);
	THIS^.AssertTrue(pSpan = 0, 'Expected the destination to stay unassigned');

	// the failure does not carry over to the next chain
	success := tracer.startSpan(name:='next').build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected the next chain to start clean');
	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testRejectsEmptyName" Id="{2400d061-57ca-4f8f-9be1-3b95d682e723}">
      <Declaration><![CDATA[(* OTLP requires a span name. *)
METHOD testRejectsEmptyName : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testRejectsEmptyName');
	success := tracer.startSpan(name:='').build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected an empty name to fail');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.SPAN_NAME_EMPTY),
		TO_UDINT(reason),
		'Expected SPAN_NAME_EMPTY'
	);
	THIS^.AssertTrue(pSpan = 0, 'Expected the destination to stay unassigned');
	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testRejectsUnspecifiedKind" Id="{64da90a2-55f6-4549-8d5c-eaf89d9b57aa}">
      <Declaration><![CDATA[(* OTLP says SPAN_KIND_UNSPECIFIED must not be used. *)
METHOD testRejectsUnspecifiedKind : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testRejectsUnspecifiedKind');
	success := tracer.startSpan(name:='span', kind:=E_SpanKind.SPAN_KIND_UNSPECIFIED).build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected an unspecified kind to fail');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.SPAN_KIND_UNSPECIFIED),
		TO_UDINT(reason),
		'Expected SPAN_KIND_UNSPECIFIED'
	);
	THIS^.AssertTrue(pSpan = 0, 'Expected the destination to stay unassigned');
	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testBuildWithoutStartFails" Id="{279511f0-c0c1-45c8-9c40-d00d8d236c88}">
      <Declaration><![CDATA[(* build and the setters need a span that startSpan created. *)
METHOD testBuildWithoutStartFails : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testBuildWithoutStartFails');
	success := tracer.setStringAttribute('key', 'value').build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected build without startSpan to fail');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.SPAN_NOT_STARTED),
		TO_UDINT(reason),
		'Expected SPAN_NOT_STARTED'
	);
	THIS^.AssertTrue(pSpan = 0, 'Expected the destination to stay unassigned');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testStartingSecondSpanFails" Id="{7e64b337-c8c2-491d-8486-f4f3b1298ea6}">
      <Declaration><![CDATA[(* The tracer builds one span at a time. A second startSpan fails the chain, and build
   releases the span that was already building. *)
METHOD testStartingSecondSpanFails : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testStartingSecondSpanFails');
	tracer.startSpan(name:='first');
	success := tracer.startSpan(name:='second').build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected a second startSpan to fail');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.SPAN_ALREADY_STARTED),
		TO_UDINT(reason),
		'Expected SPAN_ALREADY_STARTED'
	);
	THIS^.AssertTrue(pSpan = 0, 'Expected the destination to stay unassigned');
	THIS^.AssertTrue(tracer.pSpan = 0, 'Expected build to release the building span');
	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testBuildIntoAssignedDestinationFails" Id="{d90dd246-7dc1-47bd-8626-63dae40a029f}">
      <Declaration><![CDATA[(* build follows the VAR_IN_OUT pointer pattern: it never overwrites a span the caller owns. *)
METHOD testBuildIntoAssignedDestinationFails : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	pFirst: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testBuildIntoAssignedDestinationFails');
	tracer.startSpan(name:='first').build(pDest:=pSpan);
	pFirst := pSpan;

	success := tracer.startSpan(name:='second').build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected build into an assigned destination to fail');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.DESTINATION_ALREADY_ASSIGNED),
		TO_UDINT(reason),
		'Expected DESTINATION_ALREADY_ASSIGNED'
	);
	THIS^.AssertTrue(pSpan = pFirst, 'Expected the destination pointer to be left alone');
	THIS^.AssertTrue(tracer.pSpan = 0, 'Expected the second span to be released');
	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testNoIdentifiersAvailable" Id="{eba5995f-b038-410d-a7ef-a528e3f7072c}">
      <Declaration><![CDATA[(* A generator with nothing ready fails the build with a retryable reason. *)
METHOD testNoIdentifiersAvailable : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testNoIdentifiersAvailable');
	idGenerator.available := FALSE;
	success := tracer.startSpan(name:='root').build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected build to fail without identifiers');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.IDENTIFIERS_UNAVAILABLE),
		TO_UDINT(reason),
		'Expected IDENTIFIERS_UNAVAILABLE'
	);
	THIS^.AssertTrue(pSpan = 0, 'Expected the destination to stay unassigned');
	THIS^.AssertTrue(tracer.pSpan = 0, 'Expected the incomplete span to be released');
	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetsAttributes" Id="{bba65c61-8c5d-4bd4-8cbd-a52de5244730}">
      <Declaration><![CDATA[(* Attributes set during the chain are owned by the built span. *)
METHOD testSetsAttributes : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	setpoint: DINT := 42;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetsAttributes');
	success := tracer
		.startSpan(name:='span')
		.setStringAttribute('skid', 'A')
		.setNumberAttribute('setpoint', setpoint)
		.build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected a span with attributes to build');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.NA),
		TO_UDINT(reason),
		'Expected no failure reason on success'
	);
	IF pSpan <> 0 THEN
		THIS^.AssertEquals_UDINT(2, pSpan^.attributes.count, 'Expected both attributes on the span');
		pSpan^.delete(pSelf:=pSpan);
	END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testEndSpanQueuesSpan" Id="{46068d5d-1211-4df5-8b11-3c775b2aea59}">
      <Declaration><![CDATA[(* endSpan stamps the end time, moves the span into the provider's queue, and clears the
   caller's pointer. *)
METHOD testEndSpanQueuesSpan : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	processor: FB_SpanProcessor_ForInspection(exporter:=0);
	pSpan: POINTER TO FB_Span;
	pExpected: POINTER TO FB_Span;
	pEnded: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
	queueReason: E_SpanQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testEndSpanQueuesSpan');
	provider.stageProcessor(processor);
	success := tracer.startSpan(name:='work').build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected the span to build');
	pExpected := pSpan;

	success := tracer.endSpan(pSpan:=pSpan, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected endSpan to succeed');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.NA),
		TO_UDINT(reason),
		'Expected no failure reason on success'
	);
	THIS^.AssertTrue(pSpan = 0, 'Expected endSpan to clear the caller$'s pointer');
	THIS^.AssertEquals_UDINT(1, provider.spans.count, 'Expected the provider to queue the span');

	provider.spans.pop(pValue:=pEnded, failureReason=>queueReason);
	THIS^.AssertTrue(pEnded = pExpected, 'Expected the queued span to be the one that was ended');
	IF pEnded <> 0 THEN
		THIS^.AssertTrue(pEnded^.endTimestamp <> 0, 'Expected an end timestamp');
		THIS^.AssertTrue(
			pEnded^.endTimestamp >= pEnded^.startTimestamp,
			'Expected the span to end no earlier than it started'
		);
		pEnded^.delete(pSelf:=pEnded);
	END_IF
	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testEndSpanRejectsNull" Id="{6afea609-d669-4157-ae42-9a7253ffd009}">
      <Declaration><![CDATA[(* A null span pointer is refused and nothing is queued. *)
METHOD testEndSpanRejectsNull : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testEndSpanRejectsNull');
	success := tracer.endSpan(pSpan:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected endSpan to fail without a span');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.SPAN_POINTER_NULL),
		TO_UDINT(reason),
		'Expected SPAN_POINTER_NULL'
	);
	THIS^.AssertEquals_UDINT(0, provider.spans.count, 'Expected nothing to be queued');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testEndSpanWithoutProcessorsQueuesSpan" Id="{32597e59-8288-4682-aa64-c6a3846181b6}">
      <Declaration><![CDATA[(* With no processor staged yet, endSpan still queues the span for the provider's next tick. *)
METHOD testEndSpanWithoutProcessorsQueuesSpan : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testEndSpanWithoutProcessorsQueuesSpan');
	tracer.startSpan(name:='work').build(pDest:=pSpan);
	THIS^.AssertTrue(pSpan <> 0, 'Expected the span to build');

	success := tracer.endSpan(pSpan:=pSpan, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected endSpan to succeed');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_TracerFailureReason.NA),
		TO_UDINT(reason),
		'Expected no failure reason'
	);
	THIS^.AssertTrue(pSpan = 0, 'Expected endSpan to clear the caller$'s pointer');
	THIS^.AssertEquals_UDINT(1, provider.spans.count, 'Expected the span to be queued');
	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetSpanStatusOk" Id="{b85c276f-1cc7-43bd-873a-6daaeaf4196d}">
      <Declaration><![CDATA[(* setSpanStatusOk gives a span with no status an OK status without a message. *)
METHOD testSetSpanStatusOk : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	span: FB_Span;  // a bare span: the status setters need no identity
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetSpanStatusOk');
	success := tracer.setSpanStatusOk(pSpan:=ADR(span), failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected setSpanStatusOk to succeed');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.NA), TO_UDINT(reason), 'Expected no failure');
	THIS^.AssertTrue(span.status <> 0, 'Expected a status');
	IF span.status <> 0 THEN
		THIS^.AssertEquals_UDINT(TO_UDINT(E_StatusCode.STATUS_CODE_OK), TO_UDINT(span.status^.code), 'Expected an OK code');
		THIS^.AssertTrue(span.status^.message = 0, 'Expected no message');
	END_IF
	span.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetSpanStatusError" Id="{0ce5308d-63c9-46d6-b96f-12ee8cd9425b}">
      <Declaration><![CDATA[(* setSpanStatusError keeps its own copy of the message, and an empty message leaves the
   status without one. *)
METHOD testSetSpanStatusError : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	span: FB_Span;  // a bare span: the status setters need no identity
	emptySpan: FB_Span;
	message: T_MaxString := 'motor over temp';
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetSpanStatusError');
	success := tracer.setSpanStatusError(pSpan:=ADR(span), message:=message, failureReason=>reason);
	message := 'changed by the caller';
	THIS^.AssertTrue(success, 'Expected setSpanStatusError to succeed');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.NA), TO_UDINT(reason), 'Expected no failure');
	THIS^.AssertTrue(span.status <> 0, 'Expected a status');
	IF span.status <> 0 THEN
		THIS^.AssertEquals_UDINT(TO_UDINT(E_StatusCode.STATUS_CODE_ERROR), TO_UDINT(span.status^.code), 'Expected an error code');
		THIS^.AssertTrue(span.status^.message <> 0, 'Expected a message');
		IF span.status^.message <> 0 THEN
			THIS^.AssertEquals_STRING('motor over temp', span.status^.message^.pString^, 'Expected the span to keep its own copy of the message');
		END_IF
	END_IF

	success := tracer.setSpanStatusError(pSpan:=ADR(emptySpan), message:='', failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected an empty message to succeed');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.NA), TO_UDINT(reason), 'Expected no failure for an empty message');
	IF emptySpan.status <> 0 THEN
		THIS^.AssertEquals_UDINT(TO_UDINT(E_StatusCode.STATUS_CODE_ERROR), TO_UDINT(emptySpan.status^.code), 'Expected an error code without a message');
		THIS^.AssertTrue(emptySpan.status^.message = 0, 'Expected an empty message to leave no message');
	END_IF
	span.free();
	emptySpan.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetSpanStatusFirstWins" Id="{e7e2ab03-09bb-4e06-b053-a4d4f75dfe75}">
      <Declaration><![CDATA[(* The first status set wins: any later setSpanStatusOk or setSpanStatusError is refused
   with SPAN_STATUS_ALREADY_SET and leaves the status and its message unchanged. *)
METHOD testSetSpanStatusFirstWins : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	errorSpan: FB_Span;  // bare spans: the status setters need no identity
	okSpan: FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetSpanStatusFirstWins');
	tracer.setSpanStatusError(pSpan:=ADR(errorSpan), message:='first fault');

	success := tracer.setSpanStatusOk(pSpan:=ADR(errorSpan), failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected OK after an error to be refused');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_STATUS_ALREADY_SET), TO_UDINT(reason), 'Expected SPAN_STATUS_ALREADY_SET for OK after an error');

	success := tracer.setSpanStatusError(pSpan:=ADR(errorSpan), message:='second fault', failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected a second error to be refused');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_STATUS_ALREADY_SET), TO_UDINT(reason), 'Expected SPAN_STATUS_ALREADY_SET for a second error');

	THIS^.AssertTrue(errorSpan.status <> 0, 'Expected the first status to remain');
	IF errorSpan.status <> 0 THEN
		THIS^.AssertEquals_UDINT(TO_UDINT(E_StatusCode.STATUS_CODE_ERROR), TO_UDINT(errorSpan.status^.code), 'Expected the status to stay ERROR');
		THIS^.AssertTrue(errorSpan.status^.message <> 0, 'Expected the first message to remain');
		IF errorSpan.status^.message <> 0 THEN
			THIS^.AssertEquals_STRING('first fault', errorSpan.status^.message^.pString^, 'Expected the first message to win');
		END_IF
	END_IF

	tracer.setSpanStatusOk(pSpan:=ADR(okSpan));

	success := tracer.setSpanStatusError(pSpan:=ADR(okSpan), message:='late fault', failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected an error after OK to be refused');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_STATUS_ALREADY_SET), TO_UDINT(reason), 'Expected SPAN_STATUS_ALREADY_SET for an error after OK');

	success := tracer.setSpanStatusOk(pSpan:=ADR(okSpan), failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected a second OK to be refused');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_STATUS_ALREADY_SET), TO_UDINT(reason), 'Expected SPAN_STATUS_ALREADY_SET for a second OK');

	IF okSpan.status <> 0 THEN
		THIS^.AssertEquals_UDINT(TO_UDINT(E_StatusCode.STATUS_CODE_OK), TO_UDINT(okSpan.status^.code), 'Expected the status to stay OK');
		THIS^.AssertTrue(okSpan.status^.message = 0, 'Expected no message after the refused error');
	END_IF
	errorSpan.free();
	okSpan.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_fillIds" Id="{c5e71285-5a84-4514-a9d9-5eefa08686b1}">
      <Declaration><![CDATA[(* Writes distinct non-zero bytes into both identifiers. *)
METHOD _fillIds
VAR_IN_OUT
	traceId: FB_TraceId;
	spanId: FB_SpanId;
END_VAR
VAR
	_idx: UDINT;
	_bytes: ARRAY [0..15] OF BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR _idx := 0 TO SIZEOF(_bytes) - 1 DO
	_bytes[_idx] := TO_BYTE(_idx) + 1;
END_FOR
MEMCPY(ADR(traceId.bytes), ADR(_bytes), SIZEOF(traceId.bytes));

FOR _idx := 0 TO SIZEOF(_bytes) - 1 DO
	_bytes[_idx] := TO_BYTE(_idx) + 16#40;
END_FOR
MEMCPY(ADR(spanId.bytes), ADR(_bytes), SIZEOF(spanId.bytes));]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGetSpanContextCopiesIdentity" Id="{b31cbcb3-2674-4f58-b897-4b87aa5852ed}">
      <Declaration><![CDATA[(* The context holds copies of the span's identifiers and trace state, so it stays intact
   after the span ends. *)
METHOD testGetSpanContextCopiesIdentity : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pRemote: POINTER TO FB_SpanContext;
	pSpan: POINTER TO FB_Span;
	pContext: POINTER TO FB_SpanContext;
	traceId: FB_TraceId;
	spanId: FB_SpanId;
	pTraceState: POINTER TO FB_TraceState;
	traceStateText: T_MaxString := 'vendor=abc';
	success: BOOL;
	failureReason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGetSpanContextCopiesIdentity');
	// a remote parent is the only way a span gets trace state; 16#301 is sampled, remoteness known, remote
	THIS^._fillIds(traceId:=traceId, spanId:=spanId);
	TraceStateFactory.parse(pDest:=pTraceState, pHeader:=ADR(traceStateText));
	ContextFactory.buildContext(
		pDest:=pRemote,
		pTraceId:=ADR(traceId),
		pSpanId:=ADR(spanId),
		pTraceState:=pTraceState,
		traceFlags:=16#301
	);
	IF pTraceState <> 0 THEN pTraceState^.delete(pSelf:=pTraceState); END_IF
	tracer.startSpan(name:='work').setParentUsingContext(pContext:=pRemote).build(pDest:=pSpan);
	IF pRemote <> 0 THEN pRemote^.delete(pSelf:=pRemote); END_IF
	THIS^.AssertTrue(pSpan <> 0 AND_THEN pSpan^.traceState <> 0, 'Expected the tracer to build a span with trace state');

	IF pSpan <> 0 AND_THEN pSpan^.traceState <> 0 THEN
		success := tracer.getSpanContext(pSpan:=pSpan, pDest:=pContext, failureReason=>failureReason);
		THIS^.AssertTrue(success, 'Expected getSpanContext to succeed for a span with an identity');
		THIS^.AssertEquals_UDINT(
			TO_UDINT(E_TracerFailureReason.NA),
			TO_UDINT(failureReason),
			'Expected no failure reason on success'
		);
		THIS^.AssertTrue(pContext <> 0, 'Expected getSpanContext to assign the destination');

		IF pContext <> 0 THEN
			THIS^.AssertTrue(pContext^.isValid(), 'Expected the context to be valid');
			THIS^.AssertTrue(
				MEMCMP(ADR(pContext^.traceId.bytes), ADR(pSpan^.traceId^.bytes), SIZEOF(pContext^.traceId.bytes)) = 0,
				'Expected the context to hold the span$'s trace id'
			);
			THIS^.AssertTrue(
				MEMCMP(ADR(pContext^.spanId.bytes), ADR(pSpan^.spanId^.bytes), SIZEOF(pContext^.spanId.bytes)) = 0,
				'Expected the context to hold the span$'s span id'
			);
			THIS^.AssertTrue(pContext^.traceState <> 0 AND_THEN pContext^.traceState <> pSpan^.traceState,
				'Expected the context to hold its own copy of the trace state');
			IF pContext^.traceState <> 0 THEN
				THIS^.AssertEquals_STRING('vendor=abc', pContext^.traceState^.pString^, 'Expected the trace state text to be copied');
			END_IF
		END_IF
	END_IF

	// the span is released first; the context must not depend on it
	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
	IF pContext <> 0 AND_THEN pContext^.traceState <> 0 THEN
		THIS^.AssertEquals_STRING('vendor=abc', pContext^.traceState^.pString^, 'Expected the context$'s trace state to outlive the span');
	END_IF

	IF pContext <> 0 THEN pContext^.delete(pSelf:=pContext); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGetSpanContextIsLocal" Id="{9e01100b-9597-47b0-bfd0-ffc46f2d3d69}">
      <Declaration><![CDATA[(* A context taken from a local span is known to be local: bit 8 is set and bit 9 is clear.
   A span without trace state gives a context without trace state. *)
METHOD testGetSpanContextIsLocal : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	pContext: POINTER TO FB_SpanContext;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGetSpanContextIsLocal');
	// a root span has no trace state
	tracer.startSpan(name:='work').build(pDest:=pSpan);
	THIS^.AssertTrue(pSpan <> 0, 'Expected the tracer to build a root span');

	IF pSpan <> 0 THEN
		tracer.getSpanContext(pSpan:=pSpan, pDest:=pContext);
		THIS^.AssertTrue(pContext <> 0, 'Expected getSpanContext to assign the destination');
		IF pContext <> 0 THEN
			THIS^.AssertFalse(pContext^.isRemote(), 'Expected a local span$'s context not to be remote');
			THIS^.AssertTrue(
				(pContext^.traceFlags AND TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_HAS_IS_REMOTE_MASK)) <> 0,
				'Expected remoteness to be marked as known'
			);
			THIS^.AssertTrue(
				(pContext^.traceFlags AND TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_IS_REMOTE_MASK)) = 0,
				'Expected the remote bit to be clear'
			);
			THIS^.AssertTrue(pContext^.traceState = 0, 'Expected no trace state when the span has none');
			pContext^.delete(pSelf:=pContext);
		END_IF
		pSpan^.delete(pSelf:=pSpan);
	END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGetSpanContextRejectsAssignedDestination" Id="{7381c3ea-efda-49da-9532-c03e32e6183f}">
      <Declaration><![CDATA[(* getSpanContext follows the VAR_IN_OUT pointer pattern: it never overwrites a context the
   caller already owns. *)
METHOD testGetSpanContextRejectsAssignedDestination : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	pContext: POINTER TO FB_SpanContext;
	pFirst: POINTER TO FB_SpanContext;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGetSpanContextRejectsAssignedDestination');
	tracer.startSpan(name:='work').build(pDest:=pSpan);
	THIS^.AssertTrue(pSpan <> 0, 'Expected the tracer to build a root span');

	IF pSpan <> 0 THEN
		success := tracer.getSpanContext(pSpan:=pSpan, pDest:=pContext);
		THIS^.AssertTrue(success, 'Expected the first getSpanContext to succeed');
		pFirst := pContext;

		success := tracer.getSpanContext(pSpan:=pSpan, pDest:=pContext, failureReason=>reason);
		THIS^.AssertFalse(success, 'Expected getSpanContext into an assigned destination to fail');
		THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.DESTINATION_ALREADY_ASSIGNED), TO_UDINT(reason), 'Expected DESTINATION_ALREADY_ASSIGNED');
		THIS^.AssertTrue(pContext = pFirst, 'Expected the destination pointer to be left alone');

		pSpan^.delete(pSelf:=pSpan);
	END_IF
	IF pContext <> 0 THEN pContext^.delete(pSelf:=pContext); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGetSpanContextOnUnbuiltSpan" Id="{4f69085a-cd75-47d8-9f1a-0d16ac285aa8}">
      <Declaration><![CDATA[(* A span with no identity yet has nothing to snapshot, so getSpanContext refuses it with
   SPAN_INVALID and allocates nothing. *)
METHOD testGetSpanContextOnUnbuiltSpan : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	span: FB_Span;
	pContext: POINTER TO FB_SpanContext;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGetSpanContextOnUnbuiltSpan');
	success := tracer.getSpanContext(pSpan:=ADR(span), pDest:=pContext, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected getSpanContext to fail for a span without an identity');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_INVALID), TO_UDINT(reason), 'Expected SPAN_INVALID');
	THIS^.AssertTrue(pContext = 0, 'Expected the destination to stay unassigned');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testAddsLinksToRunningSpan" Id="{00e4f53d-5e83-4223-8541-3fd389ee8b03}">
      <Declaration><![CDATA[(* addSpanLink links a running span to a borrowed context, and pushSpanLink takes a link
   built with LinkFactory, clearing the caller's pointer. *)
METHOD testAddsLinksToRunningSpan : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pTrigger: POINTER TO FB_Span;
	pSpan: POINTER TO FB_Span;
	pTriggerContext: POINTER TO FB_SpanContext;
	pLink: POINTER TO FB_Link;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testAddsLinksToRunningSpan');
	tracer.startSpan(name:='trigger').build(pDest:=pTrigger);
	tracer.getSpanContext(pSpan:=pTrigger, pDest:=pTriggerContext);
	tracer.startSpan(name:='work').build(pDest:=pSpan);
	THIS^.AssertTrue(pSpan <> 0, 'Expected the span to build');

	success := tracer.addSpanLink(pSpan:=pSpan, pContext:=pTriggerContext, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected addSpanLink to succeed');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.NA), TO_UDINT(reason), 'Expected no failure from addSpanLink');
	// the context is borrowed, so the caller still owns it
	THIS^.AssertTrue(pTriggerContext <> 0, 'Expected the context to stay with the caller');

	LinkFactory.fromContext(pDest:=pLink, pContext:=pTriggerContext);
	success := tracer.pushSpanLink(pSpan:=pSpan, pLink:=pLink, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected pushSpanLink to succeed');
	THIS^.AssertTrue(pLink = 0, 'Expected pushSpanLink to take the link');

	success := tracer.addSpanLink(pSpan:=pSpan, pContext:=0, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected addSpanLink to refuse a null context');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.LINK_CONTEXT_POINTER_NULL), TO_UDINT(reason), 'Expected LINK_CONTEXT_POINTER_NULL');

	success := tracer.pushSpanLink(pSpan:=pSpan, pLink:=pLink, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected pushSpanLink to refuse a null link');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.LINK_POINTER_NULL), TO_UDINT(reason), 'Expected LINK_POINTER_NULL');

	IF pSpan <> 0 THEN
		THIS^.AssertEquals_UDINT(2, pSpan^.links.count, 'Expected two links on the running span');
	END_IF
	IF pTriggerContext <> 0 THEN pTriggerContext^.delete(pSelf:=pTriggerContext); END_IF
	tracer.discardSpan(pSpan:=pSpan);
	tracer.discardSpan(pSpan:=pTrigger);
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetsRunningSpanAttributes" Id="{d3cd4057-094d-4533-be0e-98ed35466f31}">
      <Declaration><![CDATA[(* Attributes set on a running span are owned by the span. *)
METHOD testSetsRunningSpanAttributes : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	setpoint: DINT := 42;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetsRunningSpanAttributes');
	tracer.startSpan(name:='span').build(pDest:=pSpan);
	THIS^.AssertTrue(pSpan <> 0, 'Expected the span to build');

	success := tracer.setSpanStringAttribute(pSpan:=pSpan, key:='skid', value:='A', failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected setSpanStringAttribute to succeed');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.NA), TO_UDINT(reason), 'Expected no failure from setSpanStringAttribute');

	success := tracer.setSpanNumberAttribute(pSpan:=pSpan, key:='setpoint', value:=setpoint, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected setSpanNumberAttribute to succeed');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.NA), TO_UDINT(reason), 'Expected no failure from setSpanNumberAttribute');

	IF pSpan <> 0 THEN
		THIS^.AssertEquals_UDINT(2, pSpan^.attributes.count, 'Expected both attributes on the span');
	END_IF
	tracer.discardSpan(pSpan:=pSpan);
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDiscardSpanReleasesSpan" Id="{2f4da80c-7694-4b0d-981e-8c69a370cca8}">
      <Declaration><![CDATA[(* discardSpan releases a running span without handing it to the provider, and clears the
   caller's pointer. *)
METHOD testDiscardSpanReleasesSpan : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testDiscardSpanReleasesSpan');
	tracer.startSpan(name:='abandoned').build(pDest:=pSpan);
	THIS^.AssertTrue(pSpan <> 0, 'Expected the span to build');

	success := tracer.discardSpan(pSpan:=pSpan, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected discardSpan to succeed');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.NA), TO_UDINT(reason), 'Expected no failure');
	THIS^.AssertTrue(pSpan = 0, 'Expected the caller$'s pointer to be cleared');
	THIS^.AssertEquals_UDINT(0, provider.spans.count, 'Expected nothing to be queued');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testRunningSpanMethodsRejectNullSpan" Id="{467048b4-6410-4fde-865d-022617629685}">
      <Declaration><![CDATA[(* Every method for a running span refuses a null span with SPAN_POINTER_NULL, so callers need
   no null check of their own. pushSpanLink still releases the link it was given. *)
METHOD testRunningSpanMethodsRejectNullSpan : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	pRoot: POINTER TO FB_Span;
	pContext: POINTER TO FB_SpanContext;
	pLink: POINTER TO FB_Link;
	setpoint: DINT := 42;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testRunningSpanMethodsRejectNullSpan');
	success := tracer.setSpanStatusOk(pSpan:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected setSpanStatusOk to refuse a null span');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_POINTER_NULL), TO_UDINT(reason), 'Expected SPAN_POINTER_NULL from setSpanStatusOk');

	success := tracer.setSpanStatusError(pSpan:=pSpan, message:='boom', failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected setSpanStatusError to refuse a null span');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_POINTER_NULL), TO_UDINT(reason), 'Expected SPAN_POINTER_NULL from setSpanStatusError');

	success := tracer.getSpanContext(pSpan:=pSpan, pDest:=pContext, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected getSpanContext to refuse a null span');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_POINTER_NULL), TO_UDINT(reason), 'Expected SPAN_POINTER_NULL from getSpanContext');
	THIS^.AssertTrue(pContext = 0, 'Expected getSpanContext to allocate nothing');

	success := tracer.setSpanStringAttribute(pSpan:=pSpan, key:='k', value:='v', failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected setSpanStringAttribute to refuse a null span');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_POINTER_NULL), TO_UDINT(reason), 'Expected SPAN_POINTER_NULL from setSpanStringAttribute');

	success := tracer.setSpanNumberAttribute(pSpan:=pSpan, key:='k', value:=setpoint, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected setSpanNumberAttribute to refuse a null span');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_POINTER_NULL), TO_UDINT(reason), 'Expected SPAN_POINTER_NULL from setSpanNumberAttribute');

	// a real context and link, so the null span is the only thing wrong
	tracer.startSpan(name:='root').build(pDest:=pRoot);
	tracer.getSpanContext(pSpan:=pRoot, pDest:=pContext);

	success := tracer.addSpanLink(pSpan:=pSpan, pContext:=pContext, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected addSpanLink to refuse a null span');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_POINTER_NULL), TO_UDINT(reason), 'Expected SPAN_POINTER_NULL from addSpanLink');

	LinkFactory.fromContext(pDest:=pLink, pContext:=pContext);
	THIS^.AssertTrue(pLink <> 0, 'Expected a link to push');
	success := tracer.pushSpanLink(pSpan:=pSpan, pLink:=pLink, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected pushSpanLink to refuse a null span');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_POINTER_NULL), TO_UDINT(reason), 'Expected SPAN_POINTER_NULL from pushSpanLink');
	THIS^.AssertTrue(pLink = 0, 'Expected pushSpanLink to release the refused link');

	success := tracer.discardSpan(pSpan:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected discardSpan to refuse a null span');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.SPAN_POINTER_NULL), TO_UDINT(reason), 'Expected SPAN_POINTER_NULL from discardSpan');

	IF pContext <> 0 THEN pContext^.delete(pSelf:=pContext); END_IF
	tracer.discardSpan(pSpan:=pRoot);
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testAddsLinks" Id="{791d53e4-31ad-4aba-8e9e-926bde5a2561}">
      <Declaration><![CDATA[(* addLink links the span to other contexts, in the order they are added, without making it
   a child. The contexts are borrowed. *)
METHOD testAddsLinks : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pTrigger: POINTER TO FB_Span;
	pSpan: POINTER TO FB_Span;
	pTriggerContext: POINTER TO FB_SpanContext;
	pRemote: POINTER TO FB_SpanContext;
	pLink: POINTER TO FB_Link;
	traceId: FB_TraceId;
	spanId: FB_SpanId;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testAddsLinks');
	tracer.startSpan(name:='trigger').build(pDest:=pTrigger);
	IF pTrigger <> 0 THEN tracer.getSpanContext(pSpan:=pTrigger, pDest:=pTriggerContext); END_IF
	MEMSET(ADR(traceId.bytes), 16#AA, SIZEOF(traceId.bytes));
	MEMSET(ADR(spanId.bytes), 16#BB, SIZEOF(spanId.bytes));
	ContextFactory.buildContext(pDest:=pRemote, pTraceId:=ADR(traceId), pSpanId:=ADR(spanId), pTraceState:=0, traceFlags:=16#301);

	success := tracer
		.startSpan(name:='work')
		.addLink(pContext:=pTriggerContext)
		.addLink(pContext:=pRemote)
		.build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertTrue(success, 'Expected a span with links to build');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.NA), TO_UDINT(reason), 'Expected no failure reason');

	// the contexts are borrowed, so they can be released before the span
	IF pTriggerContext <> 0 THEN pTriggerContext^.delete(pSelf:=pTriggerContext); END_IF
	IF pRemote <> 0 THEN pRemote^.delete(pSelf:=pRemote); END_IF

	IF pSpan <> 0 THEN
		THIS^.AssertEquals_UDINT(2, pSpan^.links.count, 'Expected two links');
		THIS^.AssertTrue(pSpan^.parentSpanId = 0, 'Expected a link not to make the span a child');
		pSpan^.links.reset();
		pLink := pSpan^.links.next();
		THIS^.AssertTrue(
			pLink <> 0 AND_THEN pTrigger <> 0 AND_THEN MEMCMP(ADR(pLink^.spanId^.bytes), ADR(pTrigger^.spanId^.bytes), SIZEOF(spanId.bytes)) = 0,
			'Expected the first link to point at the trigger span'
		);
		pLink := pSpan^.links.next();
		THIS^.AssertTrue(pLink <> 0 AND_THEN pLink^.traceId^.bytes[0] = 16#AA, 'Expected the second link to point at the remote trace');
		pSpan^.delete(pSelf:=pSpan);
	END_IF
	IF pTrigger <> 0 THEN pTrigger^.delete(pSelf:=pTrigger); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testRejectsInvalidLink" Id="{968ab518-4059-45c8-8fc3-4955c14abc22}">
      <Declaration><![CDATA[(* A null or all zero link context fails the chain, and build then releases the span. *)
METHOD testRejectsInvalidLink : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pSpan: POINTER TO FB_Span;
	pZero: POINTER TO FB_SpanContext;
	traceId: FB_TraceId;
	spanId: FB_SpanId;
	success: BOOL;
	reason: E_TracerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testRejectsInvalidLink');
	success := tracer.startSpan(name:='work').addLink(pContext:=0).build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected a null link context to fail the chain');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.LINK_CONTEXT_POINTER_NULL), TO_UDINT(reason), 'Expected LINK_CONTEXT_POINTER_NULL');
	THIS^.AssertTrue(pSpan = 0, 'Expected no span');

	ContextFactory.buildContext(pDest:=pZero, pTraceId:=ADR(traceId), pSpanId:=ADR(spanId), pTraceState:=0, traceFlags:=0);
	success := tracer.startSpan(name:='work').addLink(pContext:=pZero).build(pDest:=pSpan, failureReason=>reason);
	THIS^.AssertFalse(success, 'Expected an all zero link context to fail the chain');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_TracerFailureReason.LINK_CONTEXT_INVALID), TO_UDINT(reason), 'Expected LINK_CONTEXT_INVALID');
	THIS^.AssertTrue(pSpan = 0, 'Expected no span');

	IF pZero <> 0 THEN pZero^.delete(pSelf:=pZero); END_IF
	IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>