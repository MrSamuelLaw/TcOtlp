<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestSpan" Id="{db2f10cc-3e6d-4621-b34d-b5ee61137998}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests FB_Span.getContext: that it snapshots the span's identity into a caller-owned context,
   marks it local, and follows the factory's pointer contract.

   The tests point the span's identity at local values instead of going through FB_Tracer,
   and clear them again before returning so the span's free does not release them. *)
FUNCTION_BLOCK FB_TestSpan EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testGetContextCopiesIdentity();
THIS^.testGetContextIsLocal();
THIS^.testGetContextRejectsAssignedDestination();
THIS^.testGetContextOnUnstartedSpan();
THIS^.testCloneToCopiesEveryMember();
THIS^.testCloneToRejectsAssignedDestination();
THIS^.testSetStatusOk();
THIS^.testSetStatusError();
THIS^.testSetStatusOkIsFinal();]]></ST>
    </Implementation>
    <Method Name="_setIdentity" Id="{b85f5bb5-bb70-4b48-812a-1abcdb4179c1}">
      <Declaration><![CDATA[(* Points the span's identity outputs at the given values; pass 0 to clear them. *)
METHOD _setIdentity
VAR_IN_OUT
	span: FB_Span;
END_VAR
VAR_INPUT
	pTraceId: POINTER TO FB_TraceId;
	pSpanId: POINTER TO FB_SpanId;
	pTraceState: POINTER TO FB_TraceState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[span.traceId := pTraceId;
span.spanId := pSpanId;
span.traceState := pTraceState;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_fillIds" Id="{c5e71285-5a84-4514-a9d9-5eefa08686b1}">
      <Declaration><![CDATA[(* Writes distinct non-zero bytes into both identifiers. *)
METHOD _fillIds
VAR_IN_OUT
	traceId: FB_TraceId;
	spanId: FB_SpanId;
END_VAR
VAR
	_idx: UDINT;
	_bytes: ARRAY [0..15] OF BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR _idx := 0 TO SIZEOF(_bytes) - 1 DO
	_bytes[_idx] := TO_BYTE(_idx) + 1;
END_FOR
MEMCPY(ADR(traceId.bytes), ADR(_bytes), SIZEOF(traceId.bytes));

FOR _idx := 0 TO SIZEOF(_bytes) - 1 DO
	_bytes[_idx] := TO_BYTE(_idx) + 16#40;
END_FOR
MEMCPY(ADR(spanId.bytes), ADR(_bytes), SIZEOF(spanId.bytes));]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGetContextCopiesIdentity" Id="{69477041-558c-409d-b196-18c985b145b4}">
      <Declaration><![CDATA[(* The context holds copies of the span's identifiers and trace state, so it stays intact
   after the span changes or ends. *)
METHOD testGetContextCopiesIdentity : REFERENCE TO FB_Test
VAR
	span: FB_Span;
	pContext: POINTER TO FB_SpanContext;
	traceId: FB_TraceId;
	spanId: FB_SpanId;
	pTraceState: POINTER TO FB_TraceState;
	traceStateText: T_MaxString := 'vendor=abc';
	success: BOOL;
	failureReason: E_ContextFactoryFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGetContextCopiesIdentity');
	THIS^._fillIds(traceId:=traceId, spanId:=spanId);
	TraceStateFactory.parse(pDest:=pTraceState, pHeader:=ADR(traceStateText));
	THIS^._setIdentity(span:=span, pTraceId:=ADR(traceId), pSpanId:=ADR(spanId), pTraceState:=pTraceState);

	success := span.getContext(pDest:=pContext, failureReason=>failureReason);
	THIS^.AssertTrue(success, 'Expected getContext to succeed for a span with an identity');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_ContextFactoryFailureReason.NA),
		TO_UDINT(failureReason),
		'Expected no failure reason on success'
	);
	THIS^.AssertTrue(pContext <> 0, 'Expected getContext to assign the destination');

	IF pContext <> 0 THEN
		THIS^.AssertTrue(pContext^.isValid(), 'Expected the context to be valid');
		THIS^.AssertTrue(
			MEMCMP(ADR(pContext^.traceId.bytes), ADR(traceId.bytes), SIZEOF(traceId.bytes)) = 0,
			'Expected the context to hold the span$'s trace id'
		);
		THIS^.AssertTrue(
			MEMCMP(ADR(pContext^.spanId.bytes), ADR(spanId.bytes), SIZEOF(spanId.bytes)) = 0,
			'Expected the context to hold the span$'s span id'
		);
		THIS^.AssertTrue(pContext^.traceState <> 0 AND_THEN pContext^.traceState <> pTraceState,
			'Expected the context to hold its own copy of the trace state');
		IF pContext^.traceState <> 0 THEN
			THIS^.AssertEquals_STRING('vendor=abc', pContext^.traceState^.pString^, 'Expected the trace state text to be copied');
		END_IF
	END_IF

	// the span's trace state is released first; the context must not depend on it
	THIS^._setIdentity(span:=span, pTraceId:=0, pSpanId:=0, pTraceState:=0);
	IF pTraceState <> 0 THEN pTraceState^.delete(pSelf:=pTraceState); END_IF
	IF pContext <> 0 AND_THEN pContext^.traceState <> 0 THEN
		THIS^.AssertEquals_STRING('vendor=abc', pContext^.traceState^.pString^, 'Expected the context to outlive the span$'s trace state');
	END_IF

	IF pContext <> 0 THEN pContext^.delete(pSelf:=pContext); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGetContextIsLocal" Id="{d701d3a7-968f-4cca-99fe-54ffb2dc56c6}">
      <Declaration><![CDATA[(* A context taken from a local span is known to be local: bit 8 is set and bit 9 is clear.
   A span without trace state gives a context without trace state. *)
METHOD testGetContextIsLocal : REFERENCE TO FB_Test
VAR
	span: FB_Span;
	pContext: POINTER TO FB_SpanContext;
	traceId: FB_TraceId;
	spanId: FB_SpanId;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGetContextIsLocal');
	THIS^._fillIds(traceId:=traceId, spanId:=spanId);
	THIS^._setIdentity(span:=span, pTraceId:=ADR(traceId), pSpanId:=ADR(spanId), pTraceState:=0);

	span.getContext(pDest:=pContext);
	THIS^.AssertTrue(pContext <> 0, 'Expected getContext to assign the destination');
	IF pContext <> 0 THEN
		THIS^.AssertFalse(pContext^.isRemote(), 'Expected a local span$'s context not to be remote');
		THIS^.AssertTrue(
			(pContext^.traceFlags AND TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_HAS_IS_REMOTE_MASK)) <> 0,
			'Expected remoteness to be marked as known'
		);
		THIS^.AssertTrue(
			(pContext^.traceFlags AND TO_UDINT(E_SpanFlags.SPAN_FLAGS_CONTEXT_IS_REMOTE_MASK)) = 0,
			'Expected the remote bit to be clear'
		);
		THIS^.AssertTrue(pContext^.traceState = 0, 'Expected no trace state when the span has none');
		pContext^.delete(pSelf:=pContext);
	END_IF

	THIS^._setIdentity(span:=span, pTraceId:=0, pSpanId:=0, pTraceState:=0);
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGetContextOnUnstartedSpan" Id="{a22a4ee9-b068-410b-a35c-2d6a30d8634f}">
      <Declaration><![CDATA[(* A span with no identity yet has nothing to snapshot. The factory's argument check reports
   it, and nothing is allocated. *)
METHOD testGetContextOnUnstartedSpan : REFERENCE TO FB_Test
VAR
	span: FB_Span;
	pContext: POINTER TO FB_SpanContext;
	success: BOOL;
	failureReason: E_ContextFactoryFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGetContextOnUnstartedSpan');
	success := span.getContext(pDest:=pContext, failureReason=>failureReason);
	THIS^.AssertFalse(success, 'Expected getContext to fail for a span without an identity');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_ContextFactoryFailureReason.TRACE_ID_POINTER_NULL),
		TO_UDINT(failureReason),
		'Expected a span without a trace id to report TRACE_ID_POINTER_NULL'
	);
	THIS^.AssertTrue(pContext = 0, 'Expected the destination to stay unassigned');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGetContextRejectsAssignedDestination" Id="{d4cb9563-457f-4413-b2db-147f88924d5a}">
      <Declaration><![CDATA[(* getContext follows the VAR_IN_OUT pointer pattern: it never overwrites a context the
   caller already owns. *)
METHOD testGetContextRejectsAssignedDestination : REFERENCE TO FB_Test
VAR
	span: FB_Span;
	pContext: POINTER TO FB_SpanContext;
	pFirst: POINTER TO FB_SpanContext;
	traceId: FB_TraceId;
	spanId: FB_SpanId;
	success: BOOL;
	failureReason: E_ContextFactoryFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGetContextRejectsAssignedDestination');
	THIS^._fillIds(traceId:=traceId, spanId:=spanId);
	THIS^._setIdentity(span:=span, pTraceId:=ADR(traceId), pSpanId:=ADR(spanId), pTraceState:=0);

	success := span.getContext(pDest:=pContext);
	THIS^.AssertTrue(success, 'Expected the first getContext to succeed');
	pFirst := pContext;

	success := span.getContext(pDest:=pContext, failureReason=>failureReason);
	THIS^.AssertFalse(success, 'Expected getContext into an assigned destination to fail');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_ContextFactoryFailureReason.DESTINATION_ALREADY_ASSIGNED),
		TO_UDINT(failureReason),
		'Expected an assigned destination to report DESTINATION_ALREADY_ASSIGNED'
	);
	THIS^.AssertTrue(pContext = pFirst, 'Expected the destination pointer to be left alone');

	IF pContext <> 0 THEN pContext^.delete(pSelf:=pContext); END_IF
	THIS^._setIdentity(span:=span, pTraceId:=0, pSpanId:=0, pTraceState:=0);
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testCloneToCopiesEveryMember" Id="{4490e7af-97e3-416a-8e55-ef9dd747b048}">
      <Declaration><![CDATA[(* cloneTo gives the copy its own copy of every member, so it outlives the source. *)
METHOD testCloneToCopiesEveryMember : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	idGenerator: FB_MockIdGenerator;
	provider: FB_TracerProvider_ForInspection(resource:=resource, idGenerator:=idGenerator);
	scope: FB_InstrumentationScope('tracer.test', '1.0.0', '');
	tracer: FB_Tracer(scope:=scope, provider:=provider);
	pParent: POINTER TO FB_Span;
	pContext: POINTER TO FB_SpanContext;
	pSpan: POINTER TO FB_Span;
	pClone: POINTER TO FB_Span;
	pMessage: POINTER TO FB_String;
	pLink: POINTER TO FB_Link;
	pSourceLink: POINTER TO FB_Link;
	message: STRING := 'boom';
	reason: E_SpanCloneFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testCloneToCopiesEveryMember');
	IF resource.attributes.count = 0 THEN
		resource.attributes.setStringAttribute('host.id', 'PLC1');
	END_IF
	tracer.startSpan(name:='parent').build(pDest:=pParent);
	IF pParent <> 0 THEN pParent^.getContext(pDest:=pContext); END_IF
	tracer.startSpan(name:='work')
		.setParent(pContext:=pContext)
		.addLink(pContext:=pContext)
		.setStringAttribute(key:='k', value:='v')
		.build(pDest:=pSpan);
	THIS^.AssertTrue(pSpan <> 0, 'Expected the span to build');
	IF pSpan <> 0 THEN
		pSpan^.kind := E_SpanKind.SPAN_KIND_SERVER;
		pSpan^.startTimestamp := 1000;
		pSpan^.endTimestamp := 1500;
		ValueFactory.createString(pDest:=pMessage, pString:=ADR(message));
		pSpan^.status := __NEW(FB_Status(code:=E_StatusCode.STATUS_CODE_ERROR, message:=pMessage));
		IF pSpan^.status <> 0 THEN pMessage := 0; END_IF
		pSpan^.links.reset();
		pSourceLink := pSpan^.links.next();

		THIS^.AssertTrue(pSpan^.cloneTo(pDest:=pClone, failureReason=>reason), 'Expected cloneTo to succeed');
		THIS^.AssertEquals_UDINT(TO_UDINT(E_SpanCloneFailureReason.NA), TO_UDINT(reason), 'Expected no failure');
		IF pClone <> 0 THEN
			THIS^.AssertTrue(pClone^.name <> 0 AND_THEN pClone^.name <> pSpan^.name, 'Expected a copied name');
			THIS^.AssertTrue(pClone^.traceId <> 0 AND_THEN pClone^.traceId <> pSpan^.traceId
				AND_THEN MEMCMP(ADR(pClone^.traceId^.bytes), ADR(pSpan^.traceId^.bytes), SIZEOF(pSpan^.traceId^.bytes)) = 0,
				'Expected a copied trace id');
			THIS^.AssertTrue(pClone^.spanId <> 0 AND_THEN pClone^.spanId <> pSpan^.spanId
				AND_THEN MEMCMP(ADR(pClone^.spanId^.bytes), ADR(pSpan^.spanId^.bytes), SIZEOF(pSpan^.spanId^.bytes)) = 0,
				'Expected a copied span id');
			THIS^.AssertTrue(pClone^.parentSpanId <> 0 AND_THEN pClone^.parentSpanId <> pSpan^.parentSpanId
				AND_THEN MEMCMP(ADR(pClone^.parentSpanId^.bytes), ADR(pSpan^.parentSpanId^.bytes), SIZEOF(pSpan^.parentSpanId^.bytes)) = 0,
				'Expected a copied parent span id');
			THIS^.AssertEquals_UDINT(TO_UDINT(E_SpanKind.SPAN_KIND_SERVER), TO_UDINT(pClone^.kind), 'Expected the kind');
			THIS^.AssertTrue(pClone^.startTimestamp = 1000 AND pClone^.endTimestamp = 1500, 'Expected the timestamps');
			THIS^.AssertEquals_UDINT(pSpan^.flags, pClone^.flags, 'Expected the flags');
			THIS^.AssertTrue(pClone^.status <> 0 AND_THEN pClone^.status <> pSpan^.status
				AND_THEN pClone^.status^.code = E_StatusCode.STATUS_CODE_ERROR
				AND_THEN pClone^.status^.message <> 0
				AND_THEN pClone^.status^.message <> pSpan^.status^.message,
				'Expected a copied error status');
			THIS^.AssertEquals_UDINT(pSpan^.attributes.count, pClone^.attributes.count, 'Expected the attributes');
			THIS^.AssertEquals_UDINT(1, pClone^.attributes.count, 'Expected one attribute');
			THIS^.AssertEquals_UDINT(1, pClone^.links.count, 'Expected one link');
			pClone^.links.reset();
			pLink := pClone^.links.next();
			THIS^.AssertTrue(pLink <> 0 AND_THEN pLink <> pSourceLink AND_THEN pLink^.spanId <> 0
				AND_THEN MEMCMP(ADR(pLink^.spanId^.bytes), ADR(pSourceLink^.spanId^.bytes), SIZEOF(pLink^.spanId^.bytes)) = 0,
				'Expected a copied link');
			THIS^.AssertEquals_UDINT(pSpan^.resource.attributes.count, pClone^.resource.attributes.count, 'Expected the resource');
			THIS^.AssertTrue(pClone^.resource.attributes.count > 0, 'Expected resource attributes to be copied');

			// the copy must stay valid once the source is gone
			pSpan^.delete(pSelf:=pSpan);
			THIS^.AssertEquals_STRING('work', pClone^.name^.pString^, 'Expected the name to outlive the source');
			THIS^.AssertEquals_STRING('boom', pClone^.status^.message^.pString^, 'Expected the message to outlive the source');
			pClone^.delete(pSelf:=pClone);
		END_IF
		IF pSpan <> 0 THEN pSpan^.delete(pSelf:=pSpan); END_IF
	END_IF
	IF pMessage <> 0 THEN pMessage^.delete(pSelf:=pMessage); END_IF
	IF pContext <> 0 THEN pContext^.delete(pSelf:=pContext); END_IF
	IF pParent <> 0 THEN pParent^.delete(pSelf:=pParent); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testCloneToRejectsAssignedDestination" Id="{ad9ae434-2120-4175-ad8f-7b344b3e8934}">
      <Declaration><![CDATA[(* cloneTo refuses a destination that already holds a span and leaves it alone. *)
METHOD testCloneToRejectsAssignedDestination : REFERENCE TO FB_Test
VAR
	pSpan: POINTER TO FB_Span;
	pDest: POINTER TO FB_Span;
	reason: E_SpanCloneFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testCloneToRejectsAssignedDestination');
	pSpan := __NEW(FB_Span);
	pDest := pSpan;
	IF pSpan <> 0 THEN
		THIS^.AssertFalse(pSpan^.cloneTo(pDest:=pDest, failureReason=>reason), 'Expected cloneTo to fail');
		THIS^.AssertEquals_UDINT(
			TO_UDINT(E_SpanCloneFailureReason.DESTINATION_ALREADY_ASSIGNED),
			TO_UDINT(reason),
			'Expected DESTINATION_ALREADY_ASSIGNED'
		);
		THIS^.AssertTrue(pDest = pSpan, 'Expected the destination to be left alone');
		pSpan^.delete(pSelf:=pSpan);
	END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetStatusOk" Id="{2de4799a-adb9-48f4-95ac-9c2793c4f7f2}">
      <Declaration><![CDATA[(* setStatusOk gives a span with no status an OK status without a message. *)
METHOD testSetStatusOk : REFERENCE TO FB_Test
VAR
	span: FB_Span;
	failureReason: E_SpanStatusFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetStatusOk');
	span.setStatusOk(failureReason=>failureReason);
	THIS^.AssertEquals_UDINT(TO_UDINT(E_SpanStatusFailureReason.NA), TO_UDINT(failureReason), 'Expected no failure');
	THIS^.AssertTrue(span.status <> 0, 'Expected a status');
	IF span.status <> 0 THEN
		THIS^.AssertEquals_UDINT(TO_UDINT(E_StatusCode.STATUS_CODE_OK), TO_UDINT(span.status^.code), 'Expected an OK code');
		THIS^.AssertTrue(span.status^.message = 0, 'Expected no message');
	END_IF
	span.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetStatusError" Id="{673707f4-e35c-4fbf-9d4e-ef63d10db63c}">
      <Declaration><![CDATA[(* setStatusError keeps its own copy of the message, a later error replaces it, and an empty
   message leaves the status without one. *)
METHOD testSetStatusError : REFERENCE TO FB_Test
VAR
	span: FB_Span;
	message: T_MaxString := 'motor over temp';
	failureReason: E_SpanStatusFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetStatusError');
	span.setStatusError(message:=message, failureReason=>failureReason);
	message := 'changed by the caller';
	THIS^.AssertEquals_UDINT(TO_UDINT(E_SpanStatusFailureReason.NA), TO_UDINT(failureReason), 'Expected no failure');
	THIS^.AssertTrue(span.status <> 0, 'Expected a status');
	IF span.status <> 0 THEN
		THIS^.AssertEquals_UDINT(TO_UDINT(E_StatusCode.STATUS_CODE_ERROR), TO_UDINT(span.status^.code), 'Expected an error code');
		THIS^.AssertTrue(span.status^.message <> 0, 'Expected a message');
		IF span.status^.message <> 0 THEN
			THIS^.AssertEquals_STRING('motor over temp', span.status^.message^.pString^, 'Expected the span to keep its own copy of the message');
		END_IF
	END_IF

	span.setStatusError(message:='second fault');
	IF span.status <> 0 AND_THEN span.status^.message <> 0 THEN
		THIS^.AssertEquals_STRING('second fault', span.status^.message^.pString^, 'Expected a later error to replace the message');
	END_IF

	span.setStatusError(message:='', failureReason=>failureReason);
	THIS^.AssertEquals_UDINT(TO_UDINT(E_SpanStatusFailureReason.NA), TO_UDINT(failureReason), 'Expected no failure for an empty message');
	IF span.status <> 0 THEN
		THIS^.AssertEquals_UDINT(TO_UDINT(E_StatusCode.STATUS_CODE_ERROR), TO_UDINT(span.status^.code), 'Expected an error code without a message');
		THIS^.AssertTrue(span.status^.message = 0, 'Expected an empty message to leave no message');
	END_IF
	span.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetStatusOkIsFinal" Id="{56989a55-e9fd-41d6-bd39-0212e5cbb58f}">
      <Declaration><![CDATA[(* OK replaces an error and its message, and an error after OK is ignored and reported. *)
METHOD testSetStatusOkIsFinal : REFERENCE TO FB_Test
VAR
	span: FB_Span;
	failureReason: E_SpanStatusFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetStatusOkIsFinal');
	span.setStatusError(message:='transient fault').setStatusOk(failureReason=>failureReason);
	THIS^.AssertEquals_UDINT(TO_UDINT(E_SpanStatusFailureReason.NA), TO_UDINT(failureReason), 'Expected OK to replace the error');
	IF span.status <> 0 THEN
		THIS^.AssertEquals_UDINT(TO_UDINT(E_StatusCode.STATUS_CODE_OK), TO_UDINT(span.status^.code), 'Expected an OK code');
		THIS^.AssertTrue(span.status^.message = 0, 'Expected OK to drop the error message');
	END_IF

	span.setStatusError(message:='late fault', failureReason=>failureReason);
	THIS^.AssertEquals_UDINT(TO_UDINT(E_SpanStatusFailureReason.STATUS_ALREADY_OK), TO_UDINT(failureReason), 'Expected the error to be refused');
	IF span.status <> 0 THEN
		THIS^.AssertEquals_UDINT(TO_UDINT(E_StatusCode.STATUS_CODE_OK), TO_UDINT(span.status^.code), 'Expected the status to stay OK');
		THIS^.AssertTrue(span.status^.message = 0, 'Expected no message after the refused error');
	END_IF
	span.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
