<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestSpanQueue" Id="{eb50bf62-c8b0-4579-96a9-3de783520e6f}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests FB_SpanQueue ordering, its bound, and the ownership hand-off on push and pop.

   The spans are opaque queue nodes: the queue only moves and releases pointers, so the tests
   allocate bare spans with __NEW instead of building them through FB_Tracer. *)
FUNCTION_BLOCK FB_TestSpanQueue EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testPushPopIsFifo();
THIS^.testPushDropsOldestWhenFull();
THIS^.testPopIntoAssignedDestinationFails();
THIS^.testCursorWalksWithoutTakingOwnership();
THIS^.testTransferToMovesOldestSpans();
THIS^.testTransferToRejectsInvalidDestination();
THIS^.testRotateMovesOldestToBack();]]></ST>
    </Implementation>
    <Method Name="testPushPopIsFifo" Id="{124b3603-a899-43b7-87f1-fa3878fb6e21}">
      <Declaration><![CDATA[(* push takes ownership and clears the caller's pointer; pop returns spans oldest first. *)
METHOD testPushPopIsFifo : REFERENCE TO FB_Test
VAR
	queue: FB_SpanQueue(maxCount:=4);
	pFirst: POINTER TO FB_Span;
	pSecond: POINTER TO FB_Span;
	pExpectedFirst: POINTER TO FB_Span;
	pExpectedSecond: POINTER TO FB_Span;
	pPopped: POINTER TO FB_Span;
	reason: E_SpanQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testPushPopIsFifo');
	pFirst := __NEW(FB_Span);  // opaque queue node: the queue needs no span identity
	pSecond := __NEW(FB_Span);
	pExpectedFirst := pFirst;
	pExpectedSecond := pSecond;

	THIS^.AssertTrue(queue.push(pValue:=pFirst, failureReason=>reason), 'Expected the first push to succeed');
	THIS^.AssertTrue(queue.push(pValue:=pSecond, failureReason=>reason), 'Expected the second push to succeed');
	THIS^.AssertTrue(pFirst = 0 AND pSecond = 0, 'Expected push to clear the caller$'s pointers');
	THIS^.AssertEquals_UDINT(2, queue.count, 'Expected two queued spans');

	THIS^.AssertTrue(queue.pop(pValue:=pPopped, failureReason=>reason), 'Expected the first pop to succeed');
	THIS^.AssertTrue(pPopped = pExpectedFirst, 'Expected the oldest span first');
	IF pPopped <> 0 THEN pPopped^.delete(pSelf:=pPopped); END_IF

	THIS^.AssertTrue(queue.pop(pValue:=pPopped, failureReason=>reason), 'Expected the second pop to succeed');
	THIS^.AssertTrue(pPopped = pExpectedSecond, 'Expected the newer span second');
	IF pPopped <> 0 THEN pPopped^.delete(pSelf:=pPopped); END_IF

	THIS^.AssertFalse(queue.pop(pValue:=pPopped, failureReason=>reason), 'Expected pop on an empty queue to fail');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_SpanQueueFailureReason.QUEUE_EMPTY),
		TO_UDINT(reason),
		'Expected QUEUE_EMPTY'
	);
	THIS^.AssertEquals_UDINT(0, queue.count, 'Expected the queue to be empty');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testPushDropsOldestWhenFull" Id="{5d91003f-2ffc-4084-ba93-c9f38fdd28e7}">
      <Declaration><![CDATA[(* A full queue releases its oldest span to make room and counts the drop. *)
METHOD testPushDropsOldestWhenFull : REFERENCE TO FB_Test
VAR
	queue: FB_SpanQueue(maxCount:=1);
	pOld: POINTER TO FB_Span;
	pNew: POINTER TO FB_Span;
	pExpected: POINTER TO FB_Span;
	pPopped: POINTER TO FB_Span;
	reason: E_SpanQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testPushDropsOldestWhenFull');
	pOld := __NEW(FB_Span);  // opaque queue node: the queue needs no span identity
	pNew := __NEW(FB_Span);
	pExpected := pNew;

	queue.push(pValue:=pOld, failureReason=>reason);
	THIS^.AssertTrue(queue.push(pValue:=pNew, failureReason=>reason), 'Expected push to a full queue to succeed');
	THIS^.AssertEquals_UDINT(1, queue.count, 'Expected the bound to hold');
	THIS^.AssertEquals_UDINT(1, queue.droppedCount, 'Expected one dropped span');

	queue.pop(pValue:=pPopped, failureReason=>reason);
	THIS^.AssertTrue(pPopped = pExpected, 'Expected the newest span to be kept');
	IF pPopped <> 0 THEN pPopped^.delete(pSelf:=pPopped); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testPopIntoAssignedDestinationFails" Id="{0d4c2db5-724a-4514-8fbf-b7a83ddaab8c}">
      <Declaration><![CDATA[(* pop never overwrites a pointer the caller already owns, and free releases what is left. *)
METHOD testPopIntoAssignedDestinationFails : REFERENCE TO FB_Test
VAR
	queue: FB_SpanQueue(maxCount:=4);
	pQueued: POINTER TO FB_Span;
	pOwned: POINTER TO FB_Span;
	pExpected: POINTER TO FB_Span;
	reason: E_SpanQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testPopIntoAssignedDestinationFails');
	pQueued := __NEW(FB_Span);  // opaque queue node: the queue needs no span identity
	pOwned := __NEW(FB_Span);  // held by the caller, so pop must not overwrite it
	pExpected := pOwned;
	queue.push(pValue:=pQueued, failureReason=>reason);

	THIS^.AssertFalse(queue.pop(pValue:=pOwned, failureReason=>reason), 'Expected pop into an assigned pointer to fail');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_SpanQueueFailureReason.DESTINATION_ALREADY_ASSIGNED),
		TO_UDINT(reason),
		'Expected DESTINATION_ALREADY_ASSIGNED'
	);
	THIS^.AssertTrue(pOwned = pExpected, 'Expected the destination to be left alone');
	THIS^.AssertEquals_UDINT(1, queue.count, 'Expected the span to stay queued');

	THIS^.AssertTrue(queue.free(), 'Expected free to release every span');
	THIS^.AssertEquals_UDINT(0, queue.count, 'Expected an empty queue after free');
	IF pOwned <> 0 THEN pOwned^.delete(pSelf:=pOwned); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testCursorWalksWithoutTakingOwnership" Id="{872d32b9-70ec-476d-9341-337d29cbef0d}">
      <Declaration><![CDATA[(* reset and next walk the spans oldest first and leave them queued; pop keeps the cursor valid. *)
METHOD testCursorWalksWithoutTakingOwnership : REFERENCE TO FB_Test
VAR
	queue: FB_SpanQueue(maxCount:=4);
	pFirst: POINTER TO FB_Span;
	pSecond: POINTER TO FB_Span;
	pExpectedFirst: POINTER TO FB_Span;
	pExpectedSecond: POINTER TO FB_Span;
	pPopped: POINTER TO FB_Span;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testCursorWalksWithoutTakingOwnership');
	pFirst := __NEW(FB_Span);  // opaque queue node: the queue needs no span identity
	pSecond := __NEW(FB_Span);
	pExpectedFirst := pFirst;
	pExpectedSecond := pSecond;
	queue.push(pValue:=pFirst);
	queue.push(pValue:=pSecond);

	queue.reset();
	THIS^.AssertTrue(queue.next() = pExpectedFirst, 'Expected the oldest span first');
	THIS^.AssertTrue(queue.next() = pExpectedSecond, 'Expected the second span next');
	THIS^.AssertTrue(queue.next() = 0, 'Expected 0 after the last span');
	THIS^.AssertEquals_UDINT(2, queue.count, 'Expected the walk to leave both spans queued');

	// popping the node under the cursor moves the cursor to the new head
	queue.reset();
	queue.pop(pValue:=pPopped);
	THIS^.AssertTrue(queue.next() = pExpectedSecond, 'Expected the cursor to move past the popped span');

	IF pPopped <> 0 THEN pPopped^.delete(pSelf:=pPopped); END_IF
	queue.free();
	queue.reset();
	THIS^.AssertTrue(queue.next() = 0, 'Expected an empty walk after free');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testTransferToMovesOldestSpans" Id="{fe6d8c25-cf15-4993-bea2-43011af61f60}">
      <Declaration><![CDATA[(* transferTo moves the oldest spans, up to the destination's bound, without copying them. *)
METHOD testTransferToMovesOldestSpans : REFERENCE TO FB_Test
VAR
	source: FB_SpanQueue(maxCount:=4);
	destination: FB_SpanQueue(maxCount:=2);
	p: POINTER TO FB_Span;
	pFirst: POINTER TO FB_Span;
	pSecond: POINTER TO FB_Span;
	pThird: POINTER TO FB_Span;
	pPopped: POINTER TO FB_Span;
	reason: E_SpanQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testTransferToMovesOldestSpans');
	// opaque queue nodes: the queue needs no span identity
	p := __NEW(FB_Span); pFirst := p; source.push(pValue:=p, failureReason=>reason);
	p := __NEW(FB_Span); pSecond := p; source.push(pValue:=p, failureReason=>reason);
	p := __NEW(FB_Span); pThird := p; source.push(pValue:=p, failureReason=>reason);

	// ask for more than the destination's bound of 2 and more than the source holds
	THIS^.AssertTrue(source.transferTo(destination:=destination, count:=5, failureReason=>reason), 'Expected transferTo to succeed');
	THIS^.AssertEquals_UDINT(2, destination.count, 'Expected the destination bound to hold');
	THIS^.AssertEquals_UDINT(1, source.count, 'Expected one span left behind');

	destination.pop(pValue:=pPopped, failureReason=>reason);
	THIS^.AssertTrue(pPopped = pFirst, 'Expected the oldest span first');
	IF pPopped <> 0 THEN pPopped^.delete(pSelf:=pPopped); END_IF
	destination.pop(pValue:=pPopped, failureReason=>reason);
	THIS^.AssertTrue(pPopped = pSecond, 'Expected the second span next');
	IF pPopped <> 0 THEN pPopped^.delete(pSelf:=pPopped); END_IF
	source.pop(pValue:=pPopped, failureReason=>reason);
	THIS^.AssertTrue(pPopped = pThird, 'Expected the newest span to stay in the source');
	IF pPopped <> 0 THEN pPopped^.delete(pSelf:=pPopped); END_IF

	THIS^.AssertTrue(source.transferTo(destination:=destination, count:=1, failureReason=>reason), 'Expected an empty transfer to succeed');
	THIS^.AssertEquals_UDINT(0, destination.count, 'Expected nothing to move from an empty queue');
	source.free();
	destination.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testTransferToRejectsInvalidDestination" Id="{6135e096-49ef-495b-b5bb-9dc3bd148996}">
      <Declaration><![CDATA[(* transferTo refuses itself and a non-empty destination, and moves nothing. *)
METHOD testTransferToRejectsInvalidDestination : REFERENCE TO FB_Test
VAR
	source: FB_SpanQueue(maxCount:=4);
	destination: FB_SpanQueue(maxCount:=4);
	p: POINTER TO FB_Span;
	reason: E_SpanQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testTransferToRejectsInvalidDestination');
	// opaque queue nodes: the queue needs no span identity
	p := __NEW(FB_Span); source.push(pValue:=p, failureReason=>reason);
	p := __NEW(FB_Span); destination.push(pValue:=p, failureReason=>reason);  // makes the destination non-empty

	THIS^.AssertFalse(source.transferTo(destination:=source, count:=1, failureReason=>reason), 'Expected a self transfer to fail');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_SpanQueueFailureReason.SELF_TRANSFER_NOT_ALLOWED),
		TO_UDINT(reason),
		'Expected SELF_TRANSFER_NOT_ALLOWED'
	);
	THIS^.AssertFalse(source.transferTo(destination:=destination, count:=1, failureReason=>reason), 'Expected a non-empty destination to fail');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_SpanQueueFailureReason.DESTINATION_NOT_EMPTY),
		TO_UDINT(reason),
		'Expected DESTINATION_NOT_EMPTY'
	);
	THIS^.AssertTrue(source.count = 1 AND destination.count = 1, 'Expected both queues to be unchanged');
	source.free();
	destination.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testRotateMovesOldestToBack" Id="{83bb3a4f-7cd2-470b-9244-81c37855d5e1}">
      <Declaration><![CDATA[(* rotate moves the oldest span to the back without releasing it, and fails on an empty queue. *)
METHOD testRotateMovesOldestToBack : REFERENCE TO FB_Test
VAR
	queue: FB_SpanQueue(maxCount:=0);  // 0 means the default bound, MAX_LOOP_COUNT
	pSpan: POINTER TO FB_Span;
	pFirst: POINTER TO FB_Span;
	pSecond: POINTER TO FB_Span;
	pPopped: POINTER TO FB_Span;
	reason: E_SpanQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testRotateMovesOldestToBack');
	THIS^.AssertFalse(queue.rotate(failureReason=>reason), 'Expected rotate on an empty queue to fail');
	THIS^.AssertEquals_UDINT(TO_UDINT(E_SpanQueueFailureReason.QUEUE_EMPTY), TO_UDINT(reason), 'Expected QUEUE_EMPTY');

	pSpan := __NEW(FB_Span);  // opaque queue node: the queue needs no span identity
	pFirst := pSpan;
	queue.push(pValue:=pSpan);
	pSpan := __NEW(FB_Span);
	pSecond := pSpan;
	queue.push(pValue:=pSpan);

	THIS^.AssertTrue(queue.rotate(failureReason=>reason), 'Expected rotate to succeed');
	THIS^.AssertEquals_UDINT(2, queue.count, 'Expected rotate to keep both spans');
	THIS^.AssertTrue(queue.next() = pSecond, 'Expected the cursor at the new head');
	queue.pop(pValue:=pPopped);
	THIS^.AssertTrue(pPopped = pSecond, 'Expected the second span first after a rotate');
	IF pPopped <> 0 THEN pPopped^.delete(pSelf:=pPopped); END_IF
	queue.pop(pValue:=pPopped);
	THIS^.AssertTrue(pPopped = pFirst, 'Expected the rotated span last');
	IF pPopped <> 0 THEN pPopped^.delete(pSelf:=pPopped); END_IF
	queue.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>