<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestSpanSimulation" Id="{176e32a6-c7c8-44d8-b313-652cb89b8d64}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	Runs the manufacturing process from the tracing research notes through the whole pipeline:
	a root span that starts its own trace linked to an upstream caller's span, then step-a and step-b as its children.
	The steps are siblings: the root groups them, and their timestamps show that step-b follows step-a, so no link
	joins them. Each step runs for STEP_CYCLES scans, and step-b and the process end in the same scan. step-a succeeds,
	and step-b fails, which fails the process. Each step also writes logs that carry its span's trace context,
	so the logs and spans tell the same story. Processors are staged and both providers ticked every scan;
	spans go through FB_SpanProcessor_Batch to FB_SpanExporter_File, and logs through FB_LogRecordProcessor_Batch
	to FB_LogRecordExporter_File. The resource names the PLC as a service, and both files are left on disk so the
	exported JSON can be inspected.
*)
FUNCTION_BLOCK FB_TestSpanSimulation EXTENDS FB_TestSuite
VAR
	_resource: FB_Resource('');
	_idGenerator: FB_IdGenerator(nTraceIds:=4, nSpanIds:=16);
	_provider: FB_TracerProvider(resource:=_resource, idGenerator:=_idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	_scope: FB_InstrumentationScope('line1.process', '1.0.0', '');
	_tracer: FB_Tracer(scope:=_scope, provider:=_provider);
	_exporter: FB_SpanExporter_File(filepath:='C:\Users\samue\Desktop\programming projects\TcOtlp\simulation_spans.jsonl');
	_processor: FB_SpanProcessor_Batch(maxQueueSize:=16, scheduledDelayMillis:=200, maxExportBatchSize:=16, exporter:=_exporter);
	_loggerProvider: FB_LoggerProvider(resource:=_resource);
	_logger: FB_Logger(scope:=_scope, provider:=_loggerProvider);
	_logExporter: FB_LogRecordExporter_File(filepath:='C:\Users\samue\Desktop\programming projects\TcOtlp\simulation_logs.jsonl');
	_logProcessor: FB_LogRecordProcessor_Batch(maxQueueSize:=16, scheduledDelayMillis:=200, maxExportBatchSize:=16, exporter:=_logExporter);
	_emittedLogs: UDINT;
	_correlatedLogs: UDINT;  // logs whose trace id and span id match their span
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testManufacturingProcess();]]></ST>
    </Implementation>
    <Method Name="_log" Id="{3844c814-395c-4fe9-b879-bcfed534386c}">
      <Declaration><![CDATA[(*
	Writes one log with the span's trace context, and counts it as emitted and, when its ids match the span's,
	as correlated. The span must still be live, so a step logs before it ends its span.
*)
METHOD _log
VAR_INPUT
	severity: E_SeverityNumber;
	eventName: T_MaxString;
	body: T_MaxString;
	pSpan: POINTER TO FB_Span;
END_VAR
VAR
	failureResult: E_LoggerFailureReason;
	correlated: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._logger
	.startLogRecord(severityNumber:=severity)
	.setEventName(eventName)
	.setBody(body)
	.setTraceContextFromSpan(pSpan);

correlated := THIS^._logger.pLogRecord <> 0 AND_THEN pSpan <> 0
	AND_THEN THIS^._logger.pLogRecord^.traceId <> 0 AND_THEN THIS^._logger.pLogRecord^.spanId <> 0
	AND_THEN MEMCMP(ADR(THIS^._logger.pLogRecord^.traceId^.bytes), ADR(pSpan^.traceId^.bytes), SIZEOF(pSpan^.traceId^.bytes)) = 0
	AND_THEN MEMCMP(ADR(THIS^._logger.pLogRecord^.spanId^.bytes), ADR(pSpan^.spanId^.bytes), SIZEOF(pSpan^.spanId^.bytes)) = 0;

IF THIS^._logger.emit(failureResult=>failureResult) THEN
	THIS^._emittedLogs := THIS^._emittedLogs + 1;
	IF correlated THEN
		THIS^._correlatedLogs := THIS^._correlatedLogs + 1;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="testManufacturingProcess" Id="{32199410-40a9-42ca-999f-041d77c20028}">
      <Declaration><![CDATA[(*
	A multi-scan process with a parent and two sequential children runs end to end through the
	real provider, batch processor and file exporter: every span ends, none is dropped, and the
	file export reports no error. Every log the steps write carries its span's trace id and span id,
	reaches the log file, and none is dropped. An upstream caller's traceparent and tracestate headers are
	extracted, and because the process runs for many scans, the root span starts its own trace as
	a consumer and links to the caller's span instead of becoming its child. The link carries the
	caller's identity, trace state and remoteness.
*)
METHOD testManufacturingProcess : REFERENCE TO FB_Test
VAR CONSTANT
	FILEPATH: STRING := 'C:\Users\samue\Desktop\programming projects\TcOtlp\simulation_spans.jsonl';
	LOG_FILEPATH: STRING := 'C:\Users\samue\Desktop\programming projects\TcOtlp\simulation_logs.jsonl';
	EXPECTED_LOGS: UDINT := 6;  // process started, step-a started and done, step-b started and failed, process failed
	STEP_CYCLES: UDINT := 50;  // scans each process step runs for
	MAX_CYCLES: UDINT := 2000;
END_VAR
VAR_INST
	_step: USINT;
	_cycles: UDINT;
	_stepCycles: UDINT;
	_endedCount: UDINT;
	_exportErrors: UDINT;
	_pRoot: POINTER TO FB_Span;
	_pCurrent: POINTER TO FB_Span;
	_pRemoteContext: POINTER TO FB_SpanContext;
	_extractAttempted: BOOL;  // extract once; if it fails, the process starts without a link
	_rootStartedOwnTrace: BOOL;
	_rootLinksRemoteSpan: BOOL;
	_linkFlags: UDINT;
	_linkTraceState: T_MaxString;
	_fileDeleter: FB_FileDelete;
	_logFileDeleter: FB_FileDelete;
	_logExportErrors: UDINT;
END_VAR
VAR
	tracerReason: E_TracerFailureReason;
	providerReason: E_TracerProviderFailureReason;
	propagationReason: E_PropagationFailureReason;
	setpoint: INT;
	// the upstream caller's headers, from the W3C Trace Context examples
	traceparent: STRING(55) := '00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01';
	tracestate: STRING(512) := 'congo=t61rcWkgMzE,rojo=00f067aa0ba902b7';
	// the identity the traceparent carries, to check the root span links to it
	remoteTraceIdBytes: ARRAY [0..15] OF BYTE := [
		16#4B, 16#F9, 16#2F, 16#35, 16#77, 16#B3, 16#4D, 16#A6,
		16#A3, 16#CE, 16#92, 16#9D, 16#0E, 16#0E, 16#47, 16#36];
	remoteSpanIdBytes: ARRAY [0..7] OF BYTE := [16#00, 16#F0, 16#67, 16#AA, 16#0B, 16#A9, 16#02, 16#B7];
	pLink: POINTER TO FB_Link;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testManufacturingProcess');
	// start of scan: stage the processors before any span ends
	_provider.stageProcessor(_processor);
	_loggerProvider.stageProcessor(_logProcessor);
	_cycles := _cycles + 1;

	CASE _step OF
		0: // describe the PLC once, before any span snapshots the resource; start from an empty file
			IF _resource.attributes.count = 0 THEN
				_resource.attributes.setStringAttribute('service.name', 'line1-plc');
				_resource.attributes.setStringAttribute('service.version', '1.0.0');
				_resource.attributes.setStringAttribute('host.name', 'PLC1');
			END_IF
			_fileDeleter(sPathName:=FILEPATH, bExecute:=TRUE);
			_logFileDeleter(sPathName:=LOG_FILEPATH, bExecute:=TRUE);
			IF NOT _fileDeleter.bBusy AND NOT _logFileDeleter.bBusy THEN
				_fileDeleter(bExecute:=FALSE);
				_logFileDeleter(bExecute:=FALSE);
				_step := 1;
			END_IF

		1: // processInit: start the root span in its own trace, linked to the context extracted from
		   // the caller's headers, and step-a as its child;
		   // retry while ids are not ready
			IF NOT _extractAttempted THEN
				_extractAttempted := TRUE;
				TraceContextPropagator.extract(
					pDest:=_pRemoteContext,
					traceparent:=traceparent,
					tracestate:=tracestate,
					failureReason=>propagationReason
				);
			END_IF
			IF _pRoot = 0 THEN
				_tracer.startSpan(name:='manufacturing-process', kind:=E_SpanKind.SPAN_KIND_CONSUMER)
					.setStringAttribute('line', 'L1')
					.setStringAttribute('recipe', 'widget-7');
				// without a caller's context the process still runs, just unlinked; addLink(0) would fail the build
				IF _pRemoteContext <> 0 THEN
					_tracer.addLink(pContext:=_pRemoteContext);
				END_IF
				_tracer.build(pDest:=_pRoot, failureReason=>tracerReason);
				IF _pRoot <> 0 THEN
					// record the root's identity and link now, because the tracer takes the root when it ends
					_rootStartedOwnTrace := (_pRoot^.parentSpanId = 0 AND _pRoot^.traceId <> 0)
						AND_THEN MEMCMP(ADR(_pRoot^.traceId^.bytes), ADR(remoteTraceIdBytes), SIZEOF(remoteTraceIdBytes)) <> 0;
					_pRoot^.links.reset();
					pLink := _pRoot^.links.next();
					IF _pRoot^.links.count = 1 AND pLink <> 0 THEN
						_rootLinksRemoteSpan := (pLink^.traceId <> 0 AND pLink^.spanId <> 0)
							AND_THEN MEMCMP(ADR(pLink^.traceId^.bytes), ADR(remoteTraceIdBytes), SIZEOF(remoteTraceIdBytes)) = 0
							AND_THEN MEMCMP(ADR(pLink^.spanId^.bytes), ADR(remoteSpanIdBytes), SIZEOF(remoteSpanIdBytes)) = 0;
						_linkFlags := pLink^.flags;
						IF pLink^.traceState <> 0 AND_THEN pLink^.traceState^.pString <> 0 THEN
							_linkTraceState := pLink^.traceState^.pString^;
						END_IF
					END_IF
					// the link copied what it needs from the caller's context
					IF _pRemoteContext <> 0 THEN
						_pRemoteContext^.delete(pSelf:=_pRemoteContext);
					END_IF
					THIS^._log(
						severity:=E_SeverityNumber.INFO,
						eventName:='process.started',
						body:='manufacturing-process started recipe widget-7 on line L1',
						pSpan:=_pRoot
					);
				END_IF
			END_IF
			IF _pRoot <> 0 THEN
				setpoint := 42;
				_tracer.startSpan(name:='step-a')
					.setParentUsingSpan(pParentSpan:=_pRoot)
					.setNumberAttribute('setpoint', setpoint)
					.build(pDest:=_pCurrent, failureReason=>tracerReason);
				IF _pCurrent <> 0 THEN
					THIS^._log(
						severity:=E_SeverityNumber.INFO,
						eventName:='step.started',
						body:='step-a started with setpoint 42',
						pSpan:=_pCurrent
					);
					_stepCycles := 0;
					_step := 2;
				END_IF
			END_IF

		2: // step1Done: end step-a
			_stepCycles := _stepCycles + 1;
			IF _stepCycles >= STEP_CYCLES THEN
				_pCurrent^.setStatusOk();
				THIS^._log(
					severity:=E_SeverityNumber.INFO,
					eventName:='step.completed',
					body:='step-a reached setpoint 42',
					pSpan:=_pCurrent
				);
				IF _tracer.endSpan(pSpan:=_pCurrent, failureReason=>tracerReason) THEN
					_endedCount := _endedCount + 1;
				END_IF
				_step := 3;
			END_IF

		3: // start step-b as the next child of the process
			setpoint := 17;
			_tracer.startSpan(name:='step-b')
				.setParentUsingSpan(pParentSpan:=_pRoot)
				.setNumberAttribute('setpoint', setpoint)
				.build(pDest:=_pCurrent, failureReason=>tracerReason);
			IF _pCurrent <> 0 THEN
				THIS^._log(
					severity:=E_SeverityNumber.INFO,
					eventName:='step.started',
					body:='step-b started with setpoint 17',
					pSpan:=_pCurrent
				);
				_stepCycles := 0;
				_step := 4;
			END_IF

		4: // step2Fault, processDone: step-b fails, and the process ends with it in the same scan
			_stepCycles := _stepCycles + 1;
			IF _stepCycles >= STEP_CYCLES THEN
				_pCurrent^.setStatusError('setpoint not reached');
				_pRoot^.setStatusError('step-b failed');
				THIS^._log(
					severity:=E_SeverityNumber.ERROR,
					eventName:='step.failed',
					body:='step-b did not reach setpoint 17',
					pSpan:=_pCurrent
				);
				THIS^._log(
					severity:=E_SeverityNumber.ERROR,
					eventName:='process.failed',
					body:='manufacturing-process failed because step-b failed',
					pSpan:=_pRoot
				);
				IF _tracer.endSpan(pSpan:=_pCurrent, failureReason=>tracerReason) THEN
					_endedCount := _endedCount + 1;
				END_IF
				IF _tracer.endSpan(pSpan:=_pRoot, failureReason=>tracerReason) THEN
					_endedCount := _endedCount + 1;
				END_IF
				_step := 5;
			END_IF

		5: // let both processors export everything they hold and both exporters finish writing
			IF _processor.queuedCount = 0 AND NOT _exporter.isBusy()
				AND _logProcessor.queuedCount = 0 AND NOT _logExporter.isBusy() THEN
				_step := 6;
			END_IF
	END_CASE

	// end of scan
	_provider.tick(failureReason=>providerReason);
	_loggerProvider.tick();
	IF _exporter.currentState = E_FileExporterState.error THEN
		_exportErrors := _exportErrors + 1;
	END_IF
	IF _logExporter.currentState = E_FileExporterState.error THEN
		_logExportErrors := _logExportErrors + 1;
	END_IF

	IF _step = 6 OR _cycles > MAX_CYCLES THEN
		THIS^.AssertTrue(_cycles <= MAX_CYCLES, CONCAT('Expected the process to finish within MAX_CYCLES; stuck in step ', USINT_TO_STRING(_step)));
		THIS^.AssertEquals_UDINT(3, _endedCount, 'Expected every span to end');
		THIS^.AssertEquals_UDINT(0, _exportErrors, 'Expected no file export errors');
		THIS^.AssertEquals_UDINT(0, _processor.droppedCount, 'Expected the processor to drop no span');
		THIS^.AssertTrue(_rootStartedOwnTrace, 'Expected the root span to start its own trace with no parent');
		THIS^.AssertTrue(_rootLinksRemoteSpan, 'Expected the root span$'s only link to be the propagated span');
		// sampled, with the context's remoteness known and remote
		THIS^.AssertEquals_UDINT(16#301, _linkFlags, 'Expected the link to carry the propagated trace flags and remoteness');
		THIS^.AssertEquals_STRING('congo=t61rcWkgMzE,rojo=00f067aa0ba902b7', _linkTraceState, 'Expected the link to carry the propagated trace state');
		THIS^.AssertEquals_UDINT(EXPECTED_LOGS, _emittedLogs, 'Expected every step log to be emitted');
		THIS^.AssertEquals_UDINT(EXPECTED_LOGS, _correlatedLogs, 'Expected every log to carry its span$'s trace id and span id');
		THIS^.AssertEquals_UDINT(0, _logExportErrors, 'Expected no log file export errors');
		THIS^.AssertEquals_UDINT(0, _logProcessor.droppedCount, 'Expected the log processor to drop no record');
		IF _pCurrent <> 0 THEN _pCurrent^.delete(pSelf:=_pCurrent); END_IF
		IF _pRoot <> 0 THEN _pRoot^.delete(pSelf:=_pRoot); END_IF
		IF _pRemoteContext <> 0 THEN _pRemoteContext^.delete(pSelf:=_pRemoteContext); END_IF
		_extractAttempted := FALSE;
		_rootStartedOwnTrace := FALSE;
		_rootLinksRemoteSpan := FALSE;
		_linkFlags := 0;
		_linkTraceState := '';
		_emittedLogs := 0;
		_correlatedLogs := 0;
		_logExportErrors := 0;
		_step := 0;
		_cycles := 0;
		TcUnit.TEST_FINISHED();
	END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>