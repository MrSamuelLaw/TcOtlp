<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestSpanSimulation" Id="{176e32a6-c7c8-44d8-b313-652cb89b8d64}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	Runs the manufacturing process from the tracing research notes through the whole pipeline:
	a root span that continues a trace propagated by an upstream caller, step-a as its child, then step-b as a child linked to step-a. Each step runs
	for STEP_CYCLES scans, and step-b and the process end in the same scan. step-a succeeds,
	and step-b fails, which fails the process. Processors are
	staged and the provider ticked every scan, and spans go through FB_SpanProcessor_Batch to
	FB_SpanExporter_File. The resource names the PLC as a service, and the file is left on disk so the exported JSON can be inspected.
*)
FUNCTION_BLOCK FB_TestSpanSimulation EXTENDS FB_TestSuite
VAR
	_resource: FB_Resource('');
	_idGenerator: FB_IdGenerator(nTraceIds:=4, nSpanIds:=16);
	_provider: FB_TracerProvider(resource:=_resource, idGenerator:=_idGenerator);
	_scope: FB_InstrumentationScope('line1.process', '1.0.0', '');
	_tracer: FB_Tracer(scope:=_scope, provider:=_provider);
	_exporter: FB_SpanExporter_File(filepath:='C:\Users\samue\Desktop\programming projects\TcOtlp\simulation_spans.jsonl');
	_processor: FB_SpanProcessor_Batch(maxQueueSize:=16, scheduledDelayMillis:=200, maxExportBatchSize:=16, exporter:=_exporter);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testManufacturingProcess();]]></ST>
    </Implementation>
    <Method Name="testManufacturingProcess" Id="{32199410-40a9-42ca-999f-041d77c20028}">
      <Declaration><![CDATA[(*
	A multi-scan process with a parent, a child and a linked child runs end to end through the
	real provider, batch processor and file exporter: every span ends, none is dropped, and the
	file export reports no error. The root span's parent is a remote context faked as if extracted
	from an upstream caller's traceparent and tracestate headers, so the whole process joins that
	trace and carries its trace state.
*)
METHOD testManufacturingProcess : REFERENCE TO FB_Test
VAR CONSTANT
	FILEPATH: STRING := 'C:\Users\samue\Desktop\programming projects\TcOtlp\simulation_spans.jsonl';
	STEP_CYCLES: UDINT := 50;  // scans each process step runs for
	MAX_CYCLES: UDINT := 2000;
END_VAR
VAR_INST
	_step: USINT;
	_cycles: UDINT;
	_stepCycles: UDINT;
	_endedCount: UDINT;
	_exportErrors: UDINT;
	_pRoot: POINTER TO FB_Span;
	_pCurrent: POINTER TO FB_Span;
	_pRootContext: POINTER TO FB_SpanContext;
	_pStepContext: POINTER TO FB_SpanContext;
	_pRemoteContext: POINTER TO FB_SpanContext;
	_rootJoinedRemoteTrace: BOOL;
	_rootParentIsRemoteSpan: BOOL;
	_rootTraceState: T_MaxString;
	_fileDeleter: FB_FileDelete;
END_VAR
VAR
	tracerReason: E_TracerFailureReason;
	providerReason: E_TracerProviderFailureReason;
	propagationReason: E_PropagationFailureReason;
	setpoint: INT;
	// the upstream caller's headers, from the W3C Trace Context examples
	traceparent: STRING(55) := '00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01';
	tracestate: STRING(512) := 'congo=t61rcWkgMzE,rojo=00f067aa0ba902b7';
	// the identity the traceparent carries, to check the root span joined it
	remoteTraceIdBytes: ARRAY [0..15] OF BYTE := [
		16#4B, 16#F9, 16#2F, 16#35, 16#77, 16#B3, 16#4D, 16#A6,
		16#A3, 16#CE, 16#92, 16#9D, 16#0E, 16#0E, 16#47, 16#36];
	remoteSpanIdBytes: ARRAY [0..7] OF BYTE := [16#00, 16#F0, 16#67, 16#AA, 16#0B, 16#A9, 16#02, 16#B7];
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testManufacturingProcess');
	// start of scan: stage the processors before any span ends
	_provider.stageProcessor(_processor);
	_cycles := _cycles + 1;

	CASE _step OF
		0: // describe the PLC once, before any span snapshots the resource; start from an empty file
			IF _resource.attributes.count = 0 THEN
				_resource.attributes.setStringAttribute('service.name', 'line1-plc');
				_resource.attributes.setStringAttribute('service.version', '1.0.0');
				_resource.attributes.setStringAttribute('host.name', 'PLC1');
			END_IF
			_fileDeleter(sPathName:=FILEPATH, bExecute:=TRUE);
			IF NOT _fileDeleter.bBusy THEN
				_fileDeleter(bExecute:=FALSE);
				_step := 1;
			END_IF

		1: // processInit: start the root span under the context extracted from the caller's headers,
		   // and step-a as its child;
		   // retry while ids are not ready
			IF _pRemoteContext = 0 THEN
				TraceContextPropagator.extract(
					pDest:=_pRemoteContext,
					traceparent:=traceparent,
					tracestate:=tracestate,
					failureReason=>propagationReason
				);
			END_IF
			IF _pRoot = 0 AND _pRemoteContext <> 0 THEN
				_tracer.startSpan(name:='manufacturing-process')
					.setParent(pContext:=_pRemoteContext)
					.setStringAttribute('line', 'L1')
					.setStringAttribute('recipe', 'widget-7')
					.build(pDest:=_pRoot, failureReason=>tracerReason);
				IF _pRoot <> 0 THEN
					// record the parentage now, because the tracer takes the root when it ends
					_rootJoinedRemoteTrace := _pRoot^.traceId <> 0
						AND_THEN MEMCMP(ADR(_pRoot^.traceId^.bytes), ADR(remoteTraceIdBytes), SIZEOF(remoteTraceIdBytes)) = 0;
					_rootParentIsRemoteSpan := _pRoot^.parentSpanId <> 0
						AND_THEN MEMCMP(ADR(_pRoot^.parentSpanId^.bytes), ADR(remoteSpanIdBytes), SIZEOF(remoteSpanIdBytes)) = 0;
					IF _pRoot^.traceState <> 0 AND_THEN _pRoot^.traceState^.pString <> 0 THEN
						_rootTraceState := _pRoot^.traceState^.pString^;
					END_IF
					// the root copied what it needs from its parent
					_pRemoteContext^.delete(pSelf:=_pRemoteContext);
				END_IF
			END_IF
			IF _pRoot <> 0 AND _pRootContext = 0 THEN
				_pRoot^.getContext(pDest:=_pRootContext);
			END_IF
			IF _pRootContext <> 0 THEN
				setpoint := 42;
				_tracer.startSpan(name:='step-a')
					.setParent(pContext:=_pRootContext)
					.setNumberAttribute('setpoint', setpoint)
					.build(pDest:=_pCurrent, failureReason=>tracerReason);
				IF _pCurrent <> 0 THEN
					_stepCycles := 0;
					_step := 2;
				END_IF
			END_IF

		2: // step1Done: end step-a, keeping its context to link the next step to it
			_stepCycles := _stepCycles + 1;
			IF _stepCycles >= STEP_CYCLES THEN
				_pCurrent^.setStatusOk();
				_pCurrent^.getContext(pDest:=_pStepContext);
				IF _tracer.endSpan(pSpan:=_pCurrent, failureReason=>tracerReason) THEN
					_endedCount := _endedCount + 1;
				END_IF
				_step := 3;
			END_IF

		3: // start step-b as a child of the process, linked to step-a
			setpoint := 17;
			_tracer.startSpan(name:='step-b')
				.setParent(pContext:=_pRootContext)
				.addLink(pContext:=_pStepContext)
				.setNumberAttribute('setpoint', setpoint)
				.build(pDest:=_pCurrent, failureReason=>tracerReason);
			IF _pCurrent <> 0 THEN
				_pStepContext^.delete(pSelf:=_pStepContext);
				_stepCycles := 0;
				_step := 4;
			END_IF

		4: // step2Fault, processDone: step-b fails, and the process ends with it in the same scan
			_stepCycles := _stepCycles + 1;
			IF _stepCycles >= STEP_CYCLES THEN
				_pCurrent^.setStatusError('setpoint not reached');
				_pRoot^.setStatusError('step-b failed');
				IF _tracer.endSpan(pSpan:=_pCurrent, failureReason=>tracerReason) THEN
					_endedCount := _endedCount + 1;
				END_IF
				IF _tracer.endSpan(pSpan:=_pRoot, failureReason=>tracerReason) THEN
					_endedCount := _endedCount + 1;
				END_IF
				_pRootContext^.delete(pSelf:=_pRootContext);
				_step := 5;
			END_IF

		5: // let the processor export everything it holds and the exporter finish writing
			IF _processor.queuedCount = 0 AND NOT _exporter.isBusy() THEN
				_step := 6;
			END_IF
	END_CASE

	// end of scan
	_provider.tick(failureReason=>providerReason);
	IF _exporter.currentState = E_FileExporterState.error THEN
		_exportErrors := _exportErrors + 1;
	END_IF

	IF _step = 6 OR _cycles > MAX_CYCLES THEN
		THIS^.AssertTrue(_cycles <= MAX_CYCLES, CONCAT('Expected the process to finish within MAX_CYCLES; stuck in step ', USINT_TO_STRING(_step)));
		THIS^.AssertEquals_UDINT(3, _endedCount, 'Expected every span to end');
		THIS^.AssertEquals_UDINT(0, _exportErrors, 'Expected no file export errors');
		THIS^.AssertEquals_UDINT(0, _processor.droppedCount, 'Expected the processor to drop no span');
		THIS^.AssertTrue(_rootJoinedRemoteTrace, 'Expected the root span to join the propagated trace');
		THIS^.AssertTrue(_rootParentIsRemoteSpan, 'Expected the root span$'s parent to be the propagated span');
		THIS^.AssertEquals_STRING('congo=t61rcWkgMzE,rojo=00f067aa0ba902b7', _rootTraceState, 'Expected the root span to carry the propagated trace state');
		IF _pCurrent <> 0 THEN _pCurrent^.delete(pSelf:=_pCurrent); END_IF
		IF _pRoot <> 0 THEN _pRoot^.delete(pSelf:=_pRoot); END_IF
		IF _pRootContext <> 0 THEN _pRootContext^.delete(pSelf:=_pRootContext); END_IF
		IF _pStepContext <> 0 THEN _pStepContext^.delete(pSelf:=_pStepContext); END_IF
		IF _pRemoteContext <> 0 THEN _pRemoteContext^.delete(pSelf:=_pRemoteContext); END_IF
		_rootJoinedRemoteTrace := FALSE;
		_rootParentIsRemoteSpan := FALSE;
		_rootTraceState := '';
		_step := 0;
		_cycles := 0;
		TcUnit.TEST_FINISHED();
	END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>