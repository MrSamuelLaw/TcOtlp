<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestIdGenerator" Id="{8b541683-370a-4944-9efb-d4dbe8f57299}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests trace and span identifier generation.

   The generator refills its chunk list from the operating system GUID service over ADS, so
   a fresh generator has nothing to hand out until `call` has been pumped for a few cycles.
   Every test that needs identifiers therefore owns its generator instance and waits for the
   first refill before asserting. *)
FUNCTION_BLOCK FB_TestIdGenerator EXTENDS FB_TestSuite
VAR
	_pristineGen: FB_IdGenerator(maxCount := 64, guidsPerRefill := 16);  // never pumped, so it stays empty
	_nonZeroTraceGen: FB_IdGenerator(maxCount := 64, guidsPerRefill := 16);
	_nonZeroSpanGen: FB_IdGenerator(maxCount := 64, guidsPerRefill := 16);
	_uniqueTraceGen: FB_IdGenerator(maxCount := 64, guidsPerRefill := 16);
	_uniqueSpanGen: FB_IdGenerator(maxCount := 64, guidsPerRefill := 16);
	_collisionGenA: FB_IdGenerator(maxCount := 64, guidsPerRefill := 16);
	_collisionGenB: FB_IdGenerator(maxCount := 64, guidsPerRefill := 16);
	_baseRefGen: FB_IdGenerator(maxCount := 64, guidsPerRefill := 16);
	_drainGen: FB_IdGenerator(maxCount := 64, guidsPerRefill := 16);
	_capacityGen: FB_IdGenerator(maxCount := 4, guidsPerRefill := 1);  // deliberately short
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testFailsBeforeTheFirstRefill();
THIS^.testGeneratesNonZeroTraceId();
THIS^.testGeneratesNonZeroSpanId();
THIS^.testGeneratesUniqueTraceIds();
THIS^.testGeneratesUniqueSpanIds();
THIS^.testSeparateGeneratorsDoNotCollide();
THIS^.testRefillsAfterTheBufferIsDrained();
THIS^.testGeneratesThroughTheBaseReference();
THIS^.testHonorsConfiguredCapacity();]]></ST>
    </Implementation>
    <Method Name="_isZero" Id="{8eeb504c-43a7-4654-a69b-fcd34676925e}">
      <Declaration><![CDATA[(* TRUE when every byte in the buffer is zero, which is the OTLP invalid identifier. *)
METHOD _isZero : BOOL
VAR_INPUT
	pBytes: POINTER TO BYTE;
	nBytes: UDINT;
END_VAR
VAR
	_idx: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_isZero := TRUE;

IF pBytes = 0 OR_ELSE nBytes = 0 THEN
	RETURN;
END_IF

FOR _idx := 0 TO nBytes - 1 DO
	IF pBytes[_idx] <> 0 THEN
		_isZero := FALSE;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="testFailsBeforeTheFirstRefill" Id="{3f7c21ae-6d90-4b58-9c04-7a1e5d83b6f2}">
      <Declaration><![CDATA[(* A generator that has never been pumped holds no identifiers, and must say so instead of
   handing out an all zero id. *)
METHOD testFailsBeforeTheFirstRefill : REFERENCE TO FB_Test

VAR_INST
	_state: USINT;
END_VAR

VAR
	traceId: FB_TraceId;
	spanId: FB_SpanId;
	failureReason: E_IdGenFailureReason;
	success: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testFailsBeforeTheFirstRefill');
	CASE _state OF
		0:
			success := _pristineGen.generateTraceId(traceId:=traceId, failureReason=>failureReason);
			THIS^.AssertFalse(success, 'Expected trace id generation to fail before the first refill');
			THIS^.AssertEquals_UDINT(
				TO_UDINT(E_IdGenFailureReason.NO_IDENTIFIERS_AVAILABLE),
				TO_UDINT(failureReason),
				'Expected an empty buffer to report NO_IDENTIFIERS_AVAILABLE'
			);
			THIS^.AssertTrue(
				THIS^._isZero(pBytes:=ADR(traceId.bytes), nBytes:=SIZEOF(traceId.bytes)),
				'Expected a failed draw to leave the trace id untouched'
			);

			success := _pristineGen.generateSpanId(spanId:=spanId, failureReason=>failureReason);
			THIS^.AssertFalse(success, 'Expected span id generation to fail before the first refill');
			THIS^.AssertEquals_UDINT(
				TO_UDINT(E_IdGenFailureReason.NO_IDENTIFIERS_AVAILABLE),
				TO_UDINT(failureReason),
				'Expected an empty buffer to report NO_IDENTIFIERS_AVAILABLE'
			);
			THIS^.AssertTrue(
				THIS^._isZero(pBytes:=ADR(spanId.bytes), nBytes:=SIZEOF(spanId.bytes)),
				'Expected a failed draw to leave the span id untouched'
			);

			_state := 255;
			TcUnit.TEST_FINISHED();
	END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGeneratesNonZeroSpanId" Id="{cfdb60ac-5da7-49f9-8b22-ef9d77930d85}">
      <Declaration><![CDATA[METHOD testGeneratesNonZeroSpanId : REFERENCE TO FB_Test

VAR CONSTANT
	MAX_CYCLES: UDINT := 60000;
END_VAR

VAR_INST
	_cycles: UDINT;
	_state: USINT;
END_VAR

VAR
	spanId: FB_SpanId;
	failureReason: E_IdGenFailureReason;
	callSucceeded: BOOL;
	success: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGeneratesNonZeroSpanId');
	CASE _state OF
		0: // the buffer arrives asynchronously, so pump the generator until it can serve
			callSucceeded := _nonZeroSpanGen.call(failureReason=>failureReason);
			_cycles := _cycles + 1;
			IF NOT callSucceeded THEN
				THIS^.AssertTrue(FALSE, 'Expected the GUID service to refill the buffer without error');
				_state := 255;
				TcUnit.TEST_FINISHED();
				RETURN;
			END_IF

			success := _nonZeroSpanGen.generateSpanId(spanId:=spanId, failureReason=>failureReason);
			IF NOT success THEN
				IF _cycles > MAX_CYCLES THEN
					THIS^.AssertTrue(FALSE, 'Timed out waiting for the first span id');
					_state := 255;
					TcUnit.TEST_FINISHED();
				END_IF
				RETURN;
			END_IF

			THIS^.AssertEquals_UDINT(TO_UDINT(E_IdGenFailureReason.NA), TO_UDINT(failureReason), 'Expected no failure reason on success');
			THIS^.AssertEquals_UDINT(8, TO_UDINT(SIZEOF(spanId.bytes)), 'Expected a span id to be 8 bytes');
			THIS^.AssertFalse(
				THIS^._isZero(pBytes:=ADR(spanId.bytes), nBytes:=SIZEOF(spanId.bytes)),
				'Expected the span id not to be all zeroes'
			);
			_state := 255;
			TcUnit.TEST_FINISHED();
	END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGeneratesNonZeroTraceId" Id="{d62f59a8-4a87-4aed-88f9-05f62524bade}">
      <Declaration><![CDATA[METHOD testGeneratesNonZeroTraceId : REFERENCE TO FB_Test

VAR CONSTANT
	MAX_CYCLES: UDINT := 60000;
END_VAR

VAR_INST
	_cycles: UDINT;
	_state: USINT;
END_VAR

VAR
	traceId: FB_TraceId;
	failureReason: E_IdGenFailureReason;
	callSucceeded: BOOL;
	success: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGeneratesNonZeroTraceId');
	CASE _state OF
		0: // the buffer arrives asynchronously, so pump the generator until it can serve
			callSucceeded := _nonZeroTraceGen.call(failureReason=>failureReason);
			_cycles := _cycles + 1;
			IF NOT callSucceeded THEN
				THIS^.AssertTrue(FALSE, 'Expected the GUID service to refill the buffer without error');
				_state := 255;
				TcUnit.TEST_FINISHED();
				RETURN;
			END_IF

			success := _nonZeroTraceGen.generateTraceId(traceId:=traceId, failureReason=>failureReason);
			IF NOT success THEN
				IF _cycles > MAX_CYCLES THEN
					THIS^.AssertTrue(FALSE, 'Timed out waiting for the first trace id');
					_state := 255;
					TcUnit.TEST_FINISHED();
				END_IF
				RETURN;
			END_IF

			THIS^.AssertEquals_UDINT(TO_UDINT(E_IdGenFailureReason.NA), TO_UDINT(failureReason), 'Expected no failure reason on success');
			THIS^.AssertEquals_UDINT(16, TO_UDINT(SIZEOF(traceId.bytes)), 'Expected a trace id to be 16 bytes');
			THIS^.AssertFalse(
				THIS^._isZero(pBytes:=ADR(traceId.bytes), nBytes:=SIZEOF(traceId.bytes)),
				'Expected the trace id not to be all zeroes'
			);
			_state := 255;
			TcUnit.TEST_FINISHED();
	END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGeneratesThroughTheBaseReference" Id="{a7e90cf7-b6c3-4378-8d51-261590d6651d}">
      <Declaration><![CDATA[(* The provider holds the generator as REFERENCE TO FB_IdGenerator_Base, so the abstract
   methods must dispatch to the concrete implementation. *)
METHOD testGeneratesThroughTheBaseReference : REFERENCE TO FB_Test

VAR CONSTANT
	MAX_CYCLES: UDINT := 60000;
END_VAR

VAR_INST
	_cycles: UDINT;
	_state: USINT;
END_VAR

VAR
	base: REFERENCE TO FB_IdGenerator_Base;
	traceId: FB_TraceId;
	spanId: FB_SpanId;
	failureReason: E_IdGenFailureReason;
	callSucceeded: BOOL;
	success: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGeneratesThroughTheBaseReference');
	base REF= _baseRefGen;
	CASE _state OF
		0:
			THIS^.AssertTrue(__ISVALIDREF(base), 'Expected the base reference to be valid');
			_state := 10;
			RETURN;

		10: // pump through the base reference until the first buffer arrives
			callSucceeded := base.call(failureReason=>failureReason);
			_cycles := _cycles + 1;
			IF NOT callSucceeded THEN
				THIS^.AssertTrue(FALSE, 'Expected call to dispatch to the concrete generator without error');
				_state := 255;
				TcUnit.TEST_FINISHED();
				RETURN;
			END_IF

			success := base.generateTraceId(traceId:=traceId, failureReason=>failureReason);
			IF NOT success THEN
				IF _cycles > MAX_CYCLES THEN
					THIS^.AssertTrue(FALSE, 'Timed out waiting for identifiers through the base reference');
					_state := 255;
					TcUnit.TEST_FINISHED();
				END_IF
				RETURN;
			END_IF

			THIS^.AssertFalse(
				THIS^._isZero(pBytes:=ADR(traceId.bytes), nBytes:=SIZEOF(traceId.bytes)),
				'Expected a non zero trace id through the base reference'
			);

			success := base.generateSpanId(spanId:=spanId, failureReason=>failureReason);
			THIS^.AssertTrue(success, 'Expected generateSpanId to dispatch to the concrete generator');
			THIS^.AssertFalse(
				THIS^._isZero(pBytes:=ADR(spanId.bytes), nBytes:=SIZEOF(spanId.bytes)),
				'Expected a non zero span id through the base reference'
			);
			_state := 255;
			TcUnit.TEST_FINISHED();
	END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGeneratesUniqueSpanIds" Id="{34b9c889-2a88-4e38-b6ac-60308864eee6}">
      <Declaration><![CDATA[METHOD testGeneratesUniqueSpanIds : REFERENCE TO FB_Test

VAR CONSTANT
	MAX_CYCLES: UDINT := 60000;
END_VAR

VAR_INST
	_cycles: UDINT;
	_state: USINT;
END_VAR

VAR
	spanId: FB_SpanId;
	samples: ARRAY [0..7, 0..7] OF BYTE;
	failureReason: E_IdGenFailureReason;
	callSucceeded: BOOL;
	success: BOOL;
	_i: UDINT;
	_j: UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGeneratesUniqueSpanIds');
	CASE _state OF
		0: // wait for the first refill
			callSucceeded := _uniqueSpanGen.call(failureReason=>failureReason);
			_cycles := _cycles + 1;
			IF NOT callSucceeded THEN
				THIS^.AssertTrue(FALSE, 'Expected the GUID service to refill the buffer without error');
				_state := 255;
				TcUnit.TEST_FINISHED();
				RETURN;
			END_IF

			IF _uniqueSpanGen.generateSpanId(spanId:=spanId, failureReason=>failureReason) THEN
				_state := 10;
			ELSIF _cycles > MAX_CYCLES THEN
				THIS^.AssertTrue(FALSE, 'Timed out waiting for the first buffer of identifiers');
				_state := 255;
				TcUnit.TEST_FINISHED();
			END_IF
			RETURN;

		10: // one buffer holds far more than eight span ids, so every draw comes out of it
			FOR _i := 0 TO 7 DO
				success := _uniqueSpanGen.generateSpanId(spanId:=spanId, failureReason=>failureReason);
				THIS^.AssertTrue(success, 'Expected every span id draw to succeed');
				THIS^.AssertFalse(
					THIS^._isZero(pBytes:=ADR(spanId.bytes), nBytes:=SIZEOF(spanId.bytes)),
					'Expected no draw to be all zeroes'
				);
				MEMCPY(ADR(samples[_i, 0]), ADR(spanId.bytes), SIZEOF(spanId.bytes));
			END_FOR

			FOR _i := 0 TO 6 DO
				FOR _j := _i + 1 TO 7 DO
					THIS^.AssertTrue(
						MEMCMP(ADR(samples[_i, 0]), ADR(samples[_j, 0]), SIZEOF(spanId.bytes)) <> 0,
						'Expected distinct span id draws'
					);
				END_FOR
			END_FOR

			_state := 255;
			TcUnit.TEST_FINISHED();
	END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="testGeneratesUniqueTraceIds" Id="{d82b59f9-4112-40d2-808d-22ff406da3f1}">
      <Declaration><![CDATA[METHOD testGeneratesUniqueTraceIds : REFERENCE TO FB_Test

VAR CONSTANT
	MAX_CYCLES: UDINT := 60000;
END_VAR

VAR_INST
	_cycles: UDINT;
	_state: USINT;
END_VAR

VAR
	traceId: FB_TraceId;
	samples: ARRAY [0..7, 0..15] OF BYTE;
	failureReason: E_IdGenFailureReason;
	callSucceeded: BOOL;
	success: BOOL;
	_i: UDINT;
	_j: UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testGeneratesUniqueTraceIds');
	CASE _state OF
		0: // wait for the first refill
			callSucceeded := _uniqueTraceGen.call(failureReason=>failureReason);
			_cycles := _cycles + 1;
			IF NOT callSucceeded THEN
				THIS^.AssertTrue(FALSE, 'Expected the GUID service to refill the buffer without error');
				_state := 255;
				TcUnit.TEST_FINISHED();
				RETURN;
			END_IF

			IF _uniqueTraceGen.generateTraceId(traceId:=traceId, failureReason=>failureReason) THEN
				_state := 10;
			ELSIF _cycles > MAX_CYCLES THEN
				THIS^.AssertTrue(FALSE, 'Timed out waiting for the first buffer of identifiers');
				_state := 255;
				TcUnit.TEST_FINISHED();
			END_IF
			RETURN;

		10: // one buffer holds far more than eight trace ids, so every draw comes out of it
			FOR _i := 0 TO 7 DO
				success := _uniqueTraceGen.generateTraceId(traceId:=traceId, failureReason=>failureReason);
				THIS^.AssertTrue(success, 'Expected every trace id draw to succeed');
				THIS^.AssertFalse(
					THIS^._isZero(pBytes:=ADR(traceId.bytes), nBytes:=SIZEOF(traceId.bytes)),
					'Expected no draw to be all zeroes'
				);
				MEMCPY(ADR(samples[_i, 0]), ADR(traceId.bytes), SIZEOF(traceId.bytes));
			END_FOR

			FOR _i := 0 TO 6 DO
				FOR _j := _i + 1 TO 7 DO
					THIS^.AssertTrue(
						MEMCMP(ADR(samples[_i, 0]), ADR(samples[_j, 0]), SIZEOF(traceId.bytes)) <> 0,
						'Expected distinct trace id draws'
					);
				END_FOR
			END_FOR

			_state := 255;
			TcUnit.TEST_FINISHED();
	END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="testHonorsConfiguredCapacity" Id="{f4a17d60-8b25-4c93-a0e6-3d7192bc5e48}">
      <Declaration><![CDATA[(* The list length is chosen where the generator is declared, so a short generator must grow
   to exactly that many chunks and yield exactly that many chunks worth of identifiers. *)
METHOD testHonorsConfiguredCapacity : REFERENCE TO FB_Test

VAR CONSTANT
	MAX_CYCLES: UDINT := 60000;
	EXPECTED_MAX_COUNT: UDINT := 4;  // the length _capacityGen is declared with
	MAX_DRAWS: UDINT := 16;  // comfortably more than a four chunk list holds
END_VAR

VAR_INST
	_cycles: UDINT;
	_state: USINT;
	_overflowed: BOOL;
END_VAR

VAR
	traceId: FB_TraceId;
	failureReason: E_IdGenFailureReason;
	callSucceeded: BOOL;
	drawn: UDINT;
	_i: UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testHonorsConfiguredCapacity');
	CASE _state OF
		0: // pump until the list has grown to the length FB_Init was given
			callSucceeded := _capacityGen.call(failureReason=>failureReason);
			_cycles := _cycles + 1;
			IF NOT callSucceeded THEN
				THIS^.AssertTrue(FALSE, 'Expected the GUID service to fill the chunk list without error');
				_state := 255;
				TcUnit.TEST_FINISHED();
				RETURN;
			END_IF

			IF _capacityGen.count > _capacityGen.maxCount THEN
				_overflowed := TRUE;
			END_IF

			IF _capacityGen.count >= _capacityGen.maxCount THEN
				_state := 10;
			ELSIF _cycles > MAX_CYCLES THEN
				THIS^.AssertTrue(FALSE, 'Timed out waiting for the chunk list to reach its configured length');
				_state := 255;
				TcUnit.TEST_FINISHED();
			END_IF
			RETURN;

		10: // the declared length is the length, and refills stop there
			THIS^.AssertEquals_UDINT(
				EXPECTED_MAX_COUNT,
				_capacityGen.maxCount,
				'Expected FB_Init to set the chunk list length'
			);
			THIS^.AssertEquals_UDINT(
				EXPECTED_MAX_COUNT,
				_capacityGen.count,
				'Expected a full list to hold exactly its configured length'
			);
			THIS^.AssertFalse(_overflowed, 'Expected refills never to grow the list past its configured length');

			// a trace id is two chunks, so a four chunk list yields exactly two of them
			drawn := 0;
			FOR _i := 1 TO MAX_DRAWS DO
				IF NOT _capacityGen.generateTraceId(traceId:=traceId, failureReason=>failureReason) THEN
					EXIT;
				END_IF
				drawn := drawn + 1;
			END_FOR

			THIS^.AssertEquals_UDINT(
				EXPECTED_MAX_COUNT / 2,
				drawn,
				'Expected a four chunk list to yield exactly two trace ids'
			);
			THIS^.AssertEquals_UDINT(
				TO_UDINT(E_IdGenFailureReason.NO_IDENTIFIERS_AVAILABLE),
				TO_UDINT(failureReason),
				'Expected an emptied list to report NO_IDENTIFIERS_AVAILABLE'
			);

			_state := 255;
			TcUnit.TEST_FINISHED();
			RETURN;
	END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="testRefillsAfterTheBufferIsDrained" Id="{b99e9e58-c553-468d-a584-237a9ad5b1cb}">
      <Declaration><![CDATA[(* Draining the served buffer must report an empty buffer rather than emit an invalid id, and
   the generator must recover once call hands the refilled spare over. *)
METHOD testRefillsAfterTheBufferIsDrained : REFERENCE TO FB_Test

VAR CONSTANT
	MAX_CYCLES: UDINT := 60000;
	MAX_DRAWS: UDINT := 512;  // comfortably more than one buffer holds
END_VAR

VAR_INST
	_cycles: UDINT;
	_state: USINT;
END_VAR

VAR
	traceId: FB_TraceId;
	failureReason: E_IdGenFailureReason;
	callSucceeded: BOOL;
	drawn: UDINT;
	_i: UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testRefillsAfterTheBufferIsDrained');
	CASE _state OF
		0: // wait for the first refill
			callSucceeded := _drainGen.call(failureReason=>failureReason);
			_cycles := _cycles + 1;
			IF NOT callSucceeded THEN
				THIS^.AssertTrue(FALSE, 'Expected the GUID service to refill the buffer without error');
				_state := 255;
				TcUnit.TEST_FINISHED();
				RETURN;
			END_IF

			IF _drainGen.generateTraceId(traceId:=traceId, failureReason=>failureReason) THEN
				_state := 10;
			ELSIF _cycles > MAX_CYCLES THEN
				THIS^.AssertTrue(FALSE, 'Timed out waiting for the first buffer of identifiers');
				_state := 255;
				TcUnit.TEST_FINISHED();
			END_IF
			RETURN;

		10: // drain the served buffer without pumping call, so no hand over can happen
			drawn := 0;
			FOR _i := 1 TO MAX_DRAWS DO
				IF NOT _drainGen.generateTraceId(traceId:=traceId, failureReason=>failureReason) THEN
					EXIT;
				END_IF
				drawn := drawn + 1;
			END_FOR

			THIS^.AssertTrue(drawn > 0, 'Expected the served buffer to hand out several trace ids');
			THIS^.AssertTrue(drawn < MAX_DRAWS, 'Expected the served buffer to run out within the draw budget');
			THIS^.AssertEquals_UDINT(
				TO_UDINT(E_IdGenFailureReason.NO_IDENTIFIERS_AVAILABLE),
				TO_UDINT(failureReason),
				'Expected a drained buffer to report NO_IDENTIFIERS_AVAILABLE'
			);

			_cycles := 0;
			_state := 20;
			RETURN;

		20: // call hands the spare over, so generation recovers without any caller change
			callSucceeded := _drainGen.call(failureReason=>failureReason);
			_cycles := _cycles + 1;
			IF NOT callSucceeded THEN
				THIS^.AssertTrue(FALSE, 'Expected the GUID service to refill the spare buffer without error');
				_state := 255;
				TcUnit.TEST_FINISHED();
				RETURN;
			END_IF

			IF _drainGen.generateTraceId(traceId:=traceId, failureReason=>failureReason) THEN
				THIS^.AssertFalse(
					THIS^._isZero(pBytes:=ADR(traceId.bytes), nBytes:=SIZEOF(traceId.bytes)),
					'Expected a non zero trace id once the buffer was refilled'
				);
				_state := 255;
				TcUnit.TEST_FINISHED();
			ELSIF _cycles > MAX_CYCLES THEN
				THIS^.AssertTrue(FALSE, 'Timed out waiting for the drained generator to refill');
				_state := 255;
				TcUnit.TEST_FINISHED();
			END_IF
			RETURN;
	END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSeparateGeneratorsDoNotCollide" Id="{13bc9a35-5583-44ad-8447-e2110526fa25}">
      <Declaration><![CDATA[(* Two generators constructed in the same cycle must not emit the same identifiers,
   otherwise two providers on one PLC would produce colliding traces. *)
METHOD testSeparateGeneratorsDoNotCollide : REFERENCE TO FB_Test

VAR CONSTANT
	MAX_CYCLES: UDINT := 60000;
END_VAR

VAR_INST
	_cycles: UDINT;
	_state: USINT;
END_VAR

VAR
	traceIdA: FB_TraceId;
	traceIdB: FB_TraceId;
	spanIdA: FB_SpanId;
	spanIdB: FB_SpanId;
	failureReason: E_IdGenFailureReason;
	callSucceededA: BOOL;
	callSucceededB: BOOL;
	success: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSeparateGeneratorsDoNotCollide');
	CASE _state OF
		0: // pump both until they can serve in the same cycle
			callSucceededA := _collisionGenA.call(failureReason=>failureReason);
			callSucceededB := _collisionGenB.call(failureReason=>failureReason);
			_cycles := _cycles + 1;
			IF NOT (callSucceededA AND_THEN callSucceededB) THEN
				THIS^.AssertTrue(FALSE, 'Expected both generators to refill without error');
				_state := 255;
				TcUnit.TEST_FINISHED();
				RETURN;
			END_IF

			IF NOT _collisionGenA.generateTraceId(traceId:=traceIdA, failureReason=>failureReason)
				OR_ELSE NOT _collisionGenB.generateTraceId(traceId:=traceIdB, failureReason=>failureReason) THEN
				IF _cycles > MAX_CYCLES THEN
					THIS^.AssertTrue(FALSE, 'Timed out waiting for both generators to fill');
					_state := 255;
					TcUnit.TEST_FINISHED();
				END_IF
				RETURN;
			END_IF

			THIS^.AssertTrue(
				MEMCMP(ADR(traceIdA.bytes), ADR(traceIdB.bytes), SIZEOF(traceIdA.bytes)) <> 0,
				'Expected two generators to produce different trace ids'
			);

			success := _collisionGenA.generateSpanId(spanId:=spanIdA, failureReason=>failureReason);
			THIS^.AssertTrue(success, 'Expected the first generator to produce a span id');
			success := _collisionGenB.generateSpanId(spanId:=spanIdB, failureReason=>failureReason);
			THIS^.AssertTrue(success, 'Expected the second generator to produce a span id');
			THIS^.AssertTrue(
				MEMCMP(ADR(spanIdA.bytes), ADR(spanIdB.bytes), SIZEOF(spanIdA.bytes)) <> 0,
				'Expected two generators to produce different span ids'
			);

			_state := 255;
			TcUnit.TEST_FINISHED();
	END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>