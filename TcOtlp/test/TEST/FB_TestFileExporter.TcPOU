<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestFileExporter" Id="{652c2ccf-e368-4316-b865-a55144794447}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TestFileExporter EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.TestExportLogRecord(cleanup:=FALSE);]]></ST>
    </Implementation>
    <Method Name="TestExportLogRecord" Id="{62c42b19-8451-4cb9-878c-1813787327e9}">
      <Declaration><![CDATA[METHOD TestExportLogRecord : REFERENCE TO FB_Test

VAR_INPUT
	cleanup: BOOL := TRUE;
END_VAR

VAR_INST
	_cycles: 		UDINT;
	_state:			USINT;
	_fileFinder: 	FB_EnumFindFileEntry;
	_fileDeleter:	FB_FileDelete;
	_node:  		ST_LinkedListNode_LogRecord;
	_exporter: 		FB_LogRecordFileExporter;
	_flags: E_LogRecordFlag := E_LogRecordFlag.LOG_RECORD_FLAGS_TRACE_FLAGS_MASK;
END_VAR

VAR CONSTANT
	_filepath: STRING := 'C:\Users\samue\Desktop\programming projects\TcOtlp\logs.jsonl';
END_VAR

VAR
	_fileSize: ULINT;
	_guid: GUID;
	_data1: DWORD := 123;
	_pBody: POINTER TO FB_String;
	_pVal: POINTER TO FB_String;
	_pAttr: POINTER TO FB_KeyValue;
	_head: ST_LinkedListNode_KeyValue;
END_VAR

VAR CONSTANT
	MAX_CYCLES: UDINT := 1000;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('Test FileExportLogRecord');
	CASE _state OF
		0: // initialization
			_exporter(
				filepath:=_filepath,
				head:=_node,
				execute:=FALSE
			);
			_cycles := 0;
			_guid.Data1 := _data1;
			_pBody := __NEW(FB_String(pString:=ADR('This is a test for a string body')));
			_pVal := __NEW(FB_String(pString:=ADR('pVal')));
			_pAttr := __NEW(FB_KeyValue(pKey:=ADR('stats.duration'), pVal:=_pVal));
			_head.ptr:=_pAttr;
			_node.ptr := __NEW(FB_LogRecord(
				severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_DEBUG,
				timestamp:=ULINT#1581452773000000789,
				eventName:=ADR('TestSerializationEvent'),
				traceId:=ADR(_guid),
				traceFlags:=ADR(_flags),
				spanId:=ADR(_guid.Data4),
				body:=_pBody,
				attributes:=ADR(_head)
			));
			IF _pBody <> 0 THEN _pBody^.delete(); END_IF
			IF _pVal <> 0 THEN _pVal^.delete(); END_IF
			IF _pAttr <> 0 THEN _pAttr^.delete(); END_IF
			// verify that the pointer is valid
			IF _node.ptr <> 0 THEN
				THIS^.AssertTrue(_node.ptr^.traceFlags <> 0, 'Expected test log record to have trace flags');
				THIS^.AssertEquals_UDINT(255, TO_UDINT(_node.ptr^.traceFlags^), 'Unexpected test log record trace flags');
				THIS^.AssertTrue(_node.ptr^.attributes <> 0, 'Expected test log record to clone attributes');
				THIS^.AssertTrue(_node.ptr^.attributes^.ptr <> 0, 'Expected cloned attributes to contain a key/value');
				_state := 10;
				RETURN;
			ELSE
				THIS^.AssertTrue(FALSE, 'Failed to allocate test log record');
			END_IF
			
		10: // export
			_exporter(
				filepath:=_filepath,
				head:=_node,
				execute:=TRUE
			);
			_cycles := _cycles + 1;
			IF _exporter.currentState <> E_FileExporterState.error THEN
				IF _exporter.currentState = E_FileExporterState.idle THEN
					// assert no errors occured
					THIS^.AssertEquals_UDINT(0, _exporter.fileOpenerErrId, 'Unexpected file opener error');
					THIS^.AssertEquals_UDINT(0, _exporter.fileWriterErrId, 'Unexpected file writer error');
					THIS^.AssertEquals_UDINT(0, _exporter.fileCloserErrId, 'Unexpected file closer error');
					_state := 20;
				END_IF
				RETURN;
			ELSIF _exporter.currentState = E_FileExporterState.error THEN
				THIS^.AssertTrue(FALSE, 'FB_LogRecordFileExporter failed to export logs to file');
			ELSIF _cycles > MAX_CYCLES THEN
				THIS^.AssertTrue(FALSE, 'Timed out waiting for FB_LogRecordFileExporter to finish');
			END_IF
			
		20: // verify file is non-empty
			_fileFinder(
				sPathName:=_filepath,
				bExecute:=TRUE,
			);
			IF NOT _fileFinder.bBusy THEN
				_fileSize := ULARGE_TO_ULINT(_fileFinder.stFindFile.fileSize);
				THIS^.AssertTrue(_fileSize > 0, 'File size = 0, expected non-empty file');
				_state := 30;
			END_IF
			RETURN;
		
		30: // cleanup the file
			IF cleanup THEN
				_fileDeleter(
					sPathName:=_filepath,
					bExecute:=TRUE,
				);
				IF _fileDeleter.bBusy THEN
					RETURN;
				END_IF
			END_IF
	END_CASE
	
	
	// assert that the test finished
	THIS^.AssertEquals_USINT(30, _state, 'Test did not complete as expeected');
	
	// clean up the node pointer
	IF (_node.ptr <> 0) THEN
		__DELETE(_node.ptr);
		_node.ptr := 0;
	ELSE
		THIS^.AssertTrue(_node.ptr <> 0, 'Unexpected invalid ST_LogRecordNode pointer');
	END_IF
	
	// reset the state
	_state := 0;
	
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
