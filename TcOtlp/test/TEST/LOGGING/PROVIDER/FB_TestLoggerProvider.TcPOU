<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestLoggerProvider" Id="{a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests FB_LoggerProvider processor registration. *)
FUNCTION_BLOCK FB_TestLoggerProvider EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testStageProcessorChaining();
THIS^.testStageProcessorCount();
THIS^.testTickUnstagesProcessors();
THIS^.testDuplicateProcessorReceivesRecordOnce();
THIS^.testDistinctProcessorsEachReceiveRecord();
THIS^.testTickReportsSuccess();]]></ST>
    </Implementation>
    <Method Name="testDistinctProcessorsEachReceiveRecord" Id="{b8c9d0e1-f2a3-4b4c-5d6e-7f8a9b0c1d2e}">
      <Declaration><![CDATA[(*
	Two distinct processors registered with the same provider should each
	receive the emitted record independently.
*)
METHOD testDistinctProcessorsEachReceiveRecord : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('scope', '1.0.0', '');
	logger: FB_Logger(scope, provider);
	exporterA: FB_LogRecordExporter_ForInspection;
	processorA: FB_LogRecordProcessor_Simple(exporterA);
	exporterB: FB_LogRecordExporter_ForInspection;
	processorB: FB_LogRecordProcessor_Simple(exporterB);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testDistinctProcessorsEachReceiveRecord');
	provider.stageProcessor(processorA);
	provider.stageProcessor(processorB);

	logger.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).emit();
	provider.tick();

	THIS^.AssertEquals_UDINT(1, exporterA.records.count, 'Expected one record in exporter A');
	THIS^.AssertEquals_UDINT(1, exporterB.records.count, 'Expected one record in exporter B');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testDuplicateProcessorReceivesRecordOnce" Id="{a7b8c9d0-e1f2-4a3b-4c5d-6e7f8a9b0c1d}">
      <Declaration><![CDATA[(*
	When the same processor is added twice (duplicate rejected), it should
	receive each emitted record exactly once — not twice.
*)
METHOD testDuplicateProcessorReceivesRecordOnce : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('scope', '1.0.0', '');
	logger: FB_Logger(scope, provider);
	exporter: FB_LogRecordExporter_ForInspection;
	processor: FB_LogRecordProcessor_Simple(exporter);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testDuplicateProcessorReceivesRecordOnce');
	provider.stageProcessor(processor);
	// the second stage of the same processor is silently ignored
	provider.stageProcessor(processor);
	THIS^.AssertEquals_UDINT(1, provider.stagedProcessorCount, 'Expected staging the same processor twice to leave one staged processor');

	logger.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).emit();
	provider.tick();

	THIS^.AssertEquals_UDINT(1, exporter.records.count, 'Expected exactly one record in exporter, not two');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testTickUnstagesProcessors" Id="{f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8a9b0c}">
      <Declaration><![CDATA[(*
	Staging lasts one tick: tick releases every staged processor node, so the
	caller must stage processors again each cycle and no list node leaks.
*)
METHOD testTickUnstagesProcessors : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	processorA: FB_LogRecordProcessor_Simple(0);
	processorB: FB_LogRecordProcessor_Simple(0);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testTickUnstagesProcessors');
	provider.stageProcessor(processorA);
	provider.stageProcessor(processorB);
	THIS^.AssertEquals_UDINT(2, provider.stagedProcessorCount, 'Expected two staged processors before tick');
	provider.tick();
	THIS^.AssertEquals_UDINT(0, provider.stagedProcessorCount, 'Expected tick to unstage every processor');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testStageProcessorChaining" Id="{b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e}">
      <Declaration><![CDATA[(*
	stageProcessor returns the provider, so processors can be staged in one
	fluent chain and each chained call still counts.
*)
METHOD testStageProcessorChaining : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	processorA: FB_LogRecordProcessor_Simple(0);
	processorB: FB_LogRecordProcessor_Simple(0);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testStageProcessorChaining');
	provider.stageProcessor(processorA).stageProcessor(processorB);
	THIS^.AssertEquals_UDINT(2, provider.stagedProcessorCount, 'Expected two staged processors after a chained stageProcessor call');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testStageProcessorCount" Id="{c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f}">
      <Declaration><![CDATA[(*
	stagedProcessorCount starts at zero and rises by one per distinct staged
	processor; tick relies on it to bound its walk of the processor list.
*)
METHOD testStageProcessorCount : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	processorA: FB_LogRecordProcessor_Simple(0);
	processorB: FB_LogRecordProcessor_Simple(0);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testStageProcessorCount');
	THIS^.AssertEquals_UDINT(0, provider.stagedProcessorCount, 'Expected zero staged processors after init');
	provider.stageProcessor(processorA);
	THIS^.AssertEquals_UDINT(1, provider.stagedProcessorCount, 'Expected one staged processor after the first stageProcessor call');
	provider.stageProcessor(processorB);
	THIS^.AssertEquals_UDINT(2, provider.stagedProcessorCount, 'Expected two staged processors after the second stageProcessor call');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testTickReportsSuccess" Id="{4f4e1261-083c-45ca-9366-b5a02c20233f}">
      <Declaration><![CDATA[(*
	Exhausting the staged-processor list is normal loop termination, not a
	corrupt list, so tick must report success once every processor has run.
*)
METHOD testTickReportsSuccess : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('scope', '1.0.0', '');
	logger: FB_Logger(scope, provider);
	exporterA: FB_LogRecordExporter_ForInspection;
	processorA: FB_LogRecordProcessor_Simple(exporterA);
	exporterB: FB_LogRecordExporter_ForInspection;
	processorB: FB_LogRecordProcessor_Simple(exporterB);
	tickSucceeded: BOOL;
	tickFailureReason: E_LoggerProviderFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testTickReportsSuccess');
	// a single staged processor walks the list to its tail on the first iteration
	logger.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).emit();
	tickSucceeded := provider
		.stageProcessor(processorA)
		.tick(failureReason=>tickFailureReason);
	THIS^.AssertTrue(tickSucceeded, 'Expected tick to succeed with one staged processor');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_LoggerProviderFailureReason.NA),
		TO_UDINT(tickFailureReason),
		'Expected no failure reason with one staged processor'
	);

	// tick unstages every processor, so both must be staged again
	logger.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).emit();
	tickSucceeded := provider
		.stageProcessor(processorA)
		.stageProcessor(processorB)
		.tick(failureReason=>tickFailureReason);
	THIS^.AssertTrue(tickSucceeded, 'Expected tick to succeed with two staged processors');
	THIS^.AssertEquals_UDINT(
		TO_UDINT(E_LoggerProviderFailureReason.NA),
		TO_UDINT(tickFailureReason),
		'Expected no failure reason with two staged processors'
	);

	// a tick with nothing staged still reports success
	tickSucceeded := provider.tick(failureReason=>tickFailureReason);
	THIS^.AssertTrue(tickSucceeded, 'Expected tick to succeed with no staged processors');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>