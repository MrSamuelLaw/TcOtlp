<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestLogProcessors" Id="{f0aa1fdf-1271-4935-af15-b23605e1dedc}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests simple and batch log processors. *)
FUNCTION_BLOCK FB_TestLogProcessors EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestSimpleProcessors();
TestBatchProcessors();
THIS^.testProcessorsSkipBusyExporter();]]></ST>
    </Implementation>
    <Method Name="testBatchProcessors" Id="{7cba4cd6-baeb-4652-979f-3089242ac7bc}">
      <Declaration><![CDATA[(*
	The batch processor queues emitted records in arrival order (oldest at
	the head), dropping the oldest when the queue is full. Flushing moves
	the oldest maxExportBatchSize records into the exporter's queue.

	FB_LoggerProvider.tick() unstages every processor, so a processor must be
	staged again before each tick. tick() also currently returns FALSE once a
	processor has been staged, so these tests call it as a statement.
*)
METHOD testBatchProcessors : REFERENCE TO FB_Test
VAR
	resourceA: FB_Resource('resource.a');
	resourceB: FB_Resource('resource.b');
	providerA: FB_LoggerProvider(resourceA);
	providerB: FB_LoggerProvider(resourceB);
	scopeA: FB_InstrumentationScope('scope.a', '1.0.0', '');
	scopeB: FB_InstrumentationScope('scope.b', '1.0.0', '');
	loggerAA: FB_Logger(scopeA, providerA);
	loggerAB: FB_Logger(scopeB, providerA);
	loggerBA: FB_Logger(scopeA, providerB);
	exporter: FB_LogRecordExporter_ForInspection;
	processor: FB_LogRecordProcessor_ForBatchInspection(
		maxQueueSize:=10,
		scheduledDelayMillis:=1000,
		maxExportBatchSize:=6,
		exporter:=exporter
	);
	// no exporter, so onEmit only enriches and never queues
	orphanProcessor: FB_LogRecordProcessor_ForBatchInspection(
		maxQueueSize:=10,
		scheduledDelayMillis:=1000,
		maxExportBatchSize:=6,
		exporter:=0
	);
	boundedExporter: FB_LogRecordExporter_ForInspection;
	boundedProcessor: FB_LogRecordProcessor_ForBatchInspection(
		maxQueueSize:=2,
		scheduledDelayMillis:=1000,
		maxExportBatchSize:=3,
		exporter:=boundedExporter
	);
	timerExporter: FB_LogRecordExporter_ForInspection;
	timerProcessor: FB_LogRecordProcessor_ForBatchInspection(
		maxQueueSize:=0,
		scheduledDelayMillis:=0,
		maxExportBatchSize:=3,
		exporter:=timerExporter
	);
	ts1: ULINT := 1;
	ts2: ULINT := 2;
	ts3: ULINT := 3;
	ts4: ULINT := 4;
	ts5: ULINT := 5;
	ts6: ULINT := 6;
	ts7: ULINT := 7;
	ts8: ULINT := 8;
	ts9: ULINT := 9;
	ts10: ULINT := 10;
	ts11: ULINT := 11;
	ts12: ULINT := 12;
	pRec: POINTER TO FB_LogRecord;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('Test BatchLogProcessors');
	// small batches so the count-based flush trigger fires without waiting on the timer

	// emit interleaved across (resource, scope) pairs
	loggerBA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts1).emit();
	loggerAB.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts2).emit();
	loggerAA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts3).emit();
	loggerBA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts4).emit();
	loggerAA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts5).emit();
	// note, it's bad practice to associate processors with multiple providers
	providerA
		.stageProcessor(processor)
		.tick();
	providerB
		.stageProcessor(processor)
		.tick();
	THIS^.AssertTrue(processor.lastOperationSucceeded, 'Expected the last emit to succeed');
	THIS^.AssertEquals_UDINT(5, processor.records.count, 'Expected five queued records');

	// the queue keeps arrival order per provider, oldest at the head
	processor.records.reset();
	pRec := processor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 2, 'Expected queued record 1 to be ts2');
	pRec := processor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 3, 'Expected queued record 2 to be ts3');
	pRec := processor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 5, 'Expected queued record 3 to be ts5');
	pRec := processor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 1, 'Expected queued record 4 to be ts1');
	pRec := processor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 4, 'Expected queued record 5 to be ts4');
	THIS^.AssertTrue(processor.records.next() = 0, 'Expected queue iteration to be exhausted');

	// emit one more to reach maxExportBatchSize, triggering a flush
	loggerAB.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts6).emit();
	providerA
		.stageProcessor(processor)
		.tick();
	THIS^.AssertEquals_UDINT(0, processor.records.count, 'Expected zero records left after a full batch flush');
	THIS^.AssertEquals_UDINT(6, exporter.records.count, 'Expected six records in the exported batch');

	// exported batch preserves arrival order
	exporter.records.reset();
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 2, 'Expected batch record 0 to be ts2');
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 3, 'Expected batch record 1 to be ts3');
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 5, 'Expected batch record 2 to be ts5');
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 1, 'Expected batch record 3 to be ts1');
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 4, 'Expected batch record 4 to be ts4');
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 6, 'Expected batch record 5 to be ts6');
	THIS^.AssertTrue(exporter.records.next() = 0, 'Expected batch iteration to be exhausted');

	// a busy exporter still accepts records into the queue, but no batch leaves
	exporter.busy := TRUE;
	loggerAB.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts7).emit();
	providerA
		.stageProcessor(processor)
		.tick();
	THIS^.AssertEquals_UDINT(1, processor.records.count, 'Expected one queued record while the exporter is busy');
	THIS^.AssertEquals_UDINT(6, exporter.records.count, 'Expected the busy exporter to keep the previous batch');

	// once free again, a partial batch waits for the schedule delay to elapse
	exporter.busy := FALSE;
	providerA
		.stageProcessor(processor)
		.tick();
	THIS^.AssertEquals_UDINT(1, processor.records.count, 'Expected the partial batch to wait for the schedule delay');
	THIS^.AssertEquals_UDINT(6, exporter.records.count, 'Expected no new batch before the schedule delay elapses');

	// without a bound exporter onEmit only enriches, so nothing is cloned or queued
	loggerAA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts8).emit();
	providerA
		.stageProcessor(orphanProcessor)
		.tick();
	THIS^.AssertEquals_UDINT(0, orphanProcessor.records.count, 'Expected no queued records without a bound exporter');
	THIS^.AssertTrue(orphanProcessor.lastOperationSucceeded, 'Expected onEmit to succeed without a bound exporter');

	// a full queue drops the oldest record to make room for the newest
	THIS^.AssertEquals_UDINT(2, boundedProcessor.records.maxCount, 'Expected the internal queue to be bounded to maxQueueSize');
	loggerAA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts9).emit();
	loggerAB.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts10).emit();
	loggerBA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts11).emit();
	providerA
		.stageProcessor(boundedProcessor)
		.tick();
	providerB
		.stageProcessor(boundedProcessor)
		.tick();
	THIS^.AssertEquals_UDINT(2, boundedProcessor.records.count, 'Expected the queue to stay at maxQueueSize');
	THIS^.AssertEquals_UDINT(1, boundedProcessor.records.droppedCount, 'Expected the oldest record to be dropped');
	boundedProcessor.records.reset();
	pRec := boundedProcessor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 10, 'Expected ts9 to be dropped and ts10 at the head');
	pRec := boundedProcessor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 11, 'Expected ts11 at the tail');

	// an unbounded processor queue still flushes a partial batch when its timer expires
	loggerAA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setTimestamp(ts12).emit();
	providerA
		.stageProcessor(timerProcessor)
		.tick();
	THIS^.AssertEquals_UDINT(0, timerProcessor.records.count, 'Expected the elapsed timer to flush a partial batch');
	THIS^.AssertEquals_UDINT(1, timerExporter.records.count, 'Expected one record in the timer-triggered batch');
	timerExporter.records.reset();
	pRec := timerExporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 12, 'Expected the timer-triggered batch record');

	// free releases each processor queue
	processor.free();
	orphanProcessor.free();
	boundedProcessor.free();
	timerProcessor.free();
	THIS^.AssertTrue(processor.records.count = 0, 'Expected zero records after free');
	THIS^.AssertTrue(orphanProcessor.records.count = 0, 'Expected zero orphan records after free');
	THIS^.AssertTrue(boundedProcessor.records.count = 0, 'Expected zero bounded records after free');
	THIS^.AssertTrue(timerProcessor.records.count = 0, 'Expected zero timer records after free');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSimpleProcessors" Id="{4aa68aa9-8a85-4975-8601-420ccbbed827}">
      <Declaration><![CDATA[METHOD testSimpleProcessors : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('name', 'version', 'schemaUrl');
	logger: FB_Logger(scope, provider);
// 	processor: FB_LogRecordProcessor_ConsolePrinter(0);
	processor: FB_LogRecordProcessor_Simple(0);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('Test SimpleLogProcessors');
	resource.attributes.setStringAttribute('plc.name', 'sim.plc');
	logger.startLogRecord(
			severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_ERROR
		)
		.setBody('this is a test')
		.emit();
	provider
		.stageProcessor(processor)
		.tick();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testProcessorsSkipBusyExporter" Id="{08a4b76b-58e1-4e23-b2d2-d15472534b6d}">
      <Declaration><![CDATA[(* Neither processor calls export on a busy exporter, even when the batch processor has a full batch ready. *)
METHOD testProcessorsSkipBusyExporter : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('scope', '1.0.0', '');
	logger: FB_Logger(scope, provider);
	simpleExporter: FB_LogRecordExporter_ForInspection;
	simpleProcessor: FB_LogRecordProcessor_Simple(simpleExporter);
	batchExporter: FB_LogRecordExporter_ForInspection;
	batchProcessor: FB_LogRecordProcessor_ForBatchInspection(
		maxQueueSize:=10,
		scheduledDelayMillis:=60000,
		maxExportBatchSize:=1,
		exporter:=batchExporter
	);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testProcessorsSkipBusyExporter');
	simpleExporter.busy := TRUE;
	batchExporter.busy := TRUE;
	logger.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO).setBody('work').emit();
	provider
		.stageProcessor(simpleProcessor)
		.stageProcessor(batchProcessor)
		.tick();
	THIS^.AssertEquals_UDINT(0, simpleExporter.callsWhileBusy, 'Expected the simple processor not to call a busy exporter');
	THIS^.AssertEquals_UDINT(0, simpleExporter.records.count, 'Expected the busy simple exporter to receive nothing');
	THIS^.AssertEquals_UDINT(0, batchExporter.callsWhileBusy, 'Expected the batch processor not to call a busy exporter');
	THIS^.AssertEquals_UDINT(1, batchProcessor.records.count, 'Expected the full batch to wait in the processor');

	batchExporter.busy := FALSE;
	provider
		.stageProcessor(batchProcessor)
		.tick();
	THIS^.AssertEquals_UDINT(1, batchExporter.records.count, 'Expected the batch once the exporter is idle');
	THIS^.AssertEquals_UDINT(0, batchProcessor.records.count, 'Expected the processor queue to be empty');
	simpleExporter.free();
	batchExporter.free();
	batchProcessor.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>