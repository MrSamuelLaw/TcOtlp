<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProcessor_ForRecordsInspection" Id="{165df84d-fe08-4138-bc80-62512eeb91af}" SpecialFunc="None">
    <Declaration><![CDATA[(* Processor test double that retains emitted records for assertions. *)
// lastOperationSucceeded and failureResult are inherited from FB_LogRecordProcessor_Batch
FUNCTION_BLOCK FB_LogRecordProcessor_ForRecordsInspection EXTENDS FB_LogRecordProcessor_Batch]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="exportRecords" Id="{87208a9f-4de6-4281-8ddd-ed45005649ec}">
      <Declaration><![CDATA[METHOD exportRecords : BOOL
VAR_INPUT
	exporter: REFERENCE TO FB_LogRecordExporter_Base;
END_VAR
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[exportRecords := exporter.export(
	logRecords:=THIS^._records,
	count:=THIS^._records.count,
	failureReason=>failureReason
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="onEmit" Id="{8cff1ee9-6c2d-4cee-b612-4a7db990b38e}">
      <Declaration><![CDATA[(*
	Retains every emitted record for assertions, whether or not an exporter is
	bound. FB_LogRecordProcessor_Batch.onEmit deliberately skips the clone and
	the queue push when it has no exporter; this double overrides that so a test
	can collect records and hand them to an exporter itself via exportRecords.
*)
METHOD onEmit
VAR_INPUT
	logRecord: REFERENCE TO FB_LogRecord;
END_VAR
VAR
	_pRecord: POINTER TO FB_LogRecord;
	_cloneFailureResult: E_LogRecordCloneFailureReason;
	_queueFailureReason: E_LogRecordQueueFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.enrich(logRecord);

_pRecord := 0;
IF NOT logRecord.cloneTo(pDest:=_pRecord, failureReason=>_cloneFailureResult) THEN
	IF _pRecord <> 0 THEN _pRecord^.delete(pSelf:=_pRecord); END_IF
	THIS^.lastOperationSucceeded := FALSE;
	THIS^.failureResult := E_LogRecordProcessorFailureReason.RECORD_CLONE_FAILURE;
	RETURN;
END_IF

IF NOT THIS^._records.push(pValue:=_pRecord, failureReason=>_queueFailureReason) THEN
	_pRecord^.delete(pSelf:=_pRecord);
	THIS^.lastOperationSucceeded := FALSE;
	THIS^.failureResult := E_LogRecordProcessorFailureReason.QUEUE_PUSH_FAILURE;
	RETURN;
END_IF

THIS^.lastOperationSucceeded := TRUE;
THIS^.failureResult := E_LogRecordProcessorFailureReason.NA;]]></ST>
      </Implementation>
    </Method>
    <Property Name="records" Id="{e6573eb1-0ce2-4c29-b81f-faf070bed2e3}">
      <Declaration><![CDATA[PROPERTY records : REFERENCE TO FB_LogRecordQueue]]></Declaration>
      <Get Name="Get" Id="{94707f0e-43af-40f1-b736-6188bca9d8d0}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[records REF= THIS^._records;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>