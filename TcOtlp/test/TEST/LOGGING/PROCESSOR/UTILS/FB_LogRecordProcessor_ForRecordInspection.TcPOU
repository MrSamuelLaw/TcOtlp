<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProcessor_ForRecordInspection" Id="{86e0c01f-365f-4c34-a5f8-f56ecceaf360}" SpecialFunc="None">
    <Declaration><![CDATA[(* Processor test double that retains one emitted record for assertions. *)
FUNCTION_BLOCK FB_LogRecordProcessor_ForRecordInspection EXTENDS FB_LogRecordProcessor_Simple
VAR_OUTPUT
	record: POINTER TO FB_LogRecord;
	lastOperationSucceeded: BOOL := FALSE;
	failureResult: E_LogRecordCloneFailureReason;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="free" Id="{9d6f0dd6-04e2-43c1-b207-46bd50021591}">
      <Declaration><![CDATA[METHOD free
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^.record <> 0 THEN
	THIS^.record^.delete(pSelf:=THIS^.record);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="onEmit" Id="{60b935aa-5fef-4d49-a6b2-6e0283d21352}">
      <Declaration><![CDATA[METHOD onEmit
VAR_INPUT
	logRecord: REFERENCE TO FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.free();
THIS^.lastOperationSucceeded := logRecord.cloneTo(
	pDest:=THIS^.record,
	failureReason=>THIS^.failureResult
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="pop" Id="{3930a8d2-bfba-4caf-bbd7-c6b54b336880}">
      <Declaration><![CDATA[METHOD pop : POINTER TO FB_LogRecord
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pop := THIS^.record;
THIS^.record := 0;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>