<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestLogger" Id="{d436feee-e107-4e32-97d3-4eab460c001a}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests the public logger API. *)
FUNCTION_BLOCK FB_TestLogger EXTENDS FB_TestSuite

]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testEmitWithoutRecordReturnsFailure();
THIS^.testEmitReturnsFirstFluentFailure();
THIS^.testStartingSecondRecordReturnsFailure();
THIS^.testStartLogRecordStampsUnixEpochNanos();
THIS^.testSetTraceContextFromSpanCopiesIdsAndFlags();
THIS^.testSetTraceContextFromSpanWithoutSpanIsNoOp();
THIS^.testSetFlagsStoresTraceFlags();
THIS^.testExitReleasesRecordUnlessCopied();
]]></ST>
    </Implementation>
    <Method Name="testEmitReturnsFirstFluentFailure" Id="{22b29b23-959e-4f62-a5d9-51b7a540587f}">
      <Declaration><![CDATA[(*
	When several fluent setters fail, emit reports the first failure and frees the
	incomplete record, so the caller sees the root cause and nothing leaks.
*)
METHOD testEmitReturnsFirstFluentFailure : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('name', 'version', '');
	logger: FB_Logger(scope, provider);
	success: BOOL;
	failureResult: E_LoggerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testEmitReturnsFirstFluentFailure');
	// both setters get a deliberately null pointer; the span ID failure comes first
	logger
		.startLogRecord(E_SeverityNumber.ERROR)
		._setSpanId(pBytes:=0, nSize:=0)
		._setTraceId(pBytes:=0, nSize:=0);

	success := logger.emit(failureResult=>failureResult);
	THIS^.AssertFalse(success, 'Expected the invalid Span ID to fail emission');
	THIS^.AssertTrue(
		failureResult = E_LoggerFailureReason.SPAN_ID_BYTES_POINTER_NULL,
		'Expected emit to report the first fluent failure, SPAN_ID_BYTES_POINTER_NULL'
	);
	THIS^.AssertTrue(logger.pLogRecord = 0, 'Expected failed emit to release the incomplete record');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testEmitWithoutRecordReturnsFailure" Id="{266078e4-fb0f-4c33-8b21-a844ac7e4540}">
      <Declaration><![CDATA[(*
	Calling emit with no record started fails with LOG_RECORD_NOT_STARTED, so a
	misordered call is reported instead of emitting an empty record.
*)
METHOD testEmitWithoutRecordReturnsFailure : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('name', 'version', '');
	logger: FB_Logger(scope, provider);
	success: BOOL;
	failureResult: E_LoggerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testEmitWithoutRecordReturnsFailure');
	logger.reset();
	success := logger.emit(failureResult=>failureResult);
	THIS^.AssertFalse(success, 'Expected emit without a started record to fail');
	THIS^.AssertTrue(
		failureResult = E_LoggerFailureReason.LOG_RECORD_NOT_STARTED,
		'Expected emit without a started record to report LOG_RECORD_NOT_STARTED'
	);
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testExitReleasesRecordUnlessCopied" Id="{c1976cd6-4423-4012-885c-d93d45891d38}">
      <Declaration><![CDATA[(*
	FB_Exit releases a record still being built, so a logger removed mid-chain does not leak it.
	During an online change the copied instance keeps the record, so FB_Exit leaves it alone.
*)
METHOD testExitReleasesRecordUnlessCopied : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('name', 'version', '');
	logger: FB_Logger(scope, provider);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testExitReleasesRecordUnlessCopied');
	logger.startLogRecord(E_SeverityNumber.INFO);
	THIS^.AssertTrue(logger.pLogRecord <> 0, 'Expected the logger to hold the record');

	logger.FB_Exit(bInCopyCode:=TRUE);
	THIS^.AssertTrue(logger.pLogRecord <> 0, 'Expected an online change to keep the record');

	logger.FB_Exit(bInCopyCode:=FALSE);
	THIS^.AssertTrue(logger.pLogRecord = 0, 'Expected FB_Exit to release the record');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetFlagsStoresTraceFlags" Id="{6c04f632-3f5b-40e3-bc5a-8ab02628c5f1}">
      <Declaration><![CDATA[(*
	_setFlags stores the W3C trace flags in the record's flags, and a later call replaces them.
	The serializer, not the record, leaves flags out for a record without a trace id.
*)
METHOD testSetFlagsStoresTraceFlags : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('name', 'version', '');
	logger: FB_Logger(scope, provider);
	success: BOOL;
	failureResult: E_LoggerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetFlagsStoresTraceFlags');
	logger
		.startLogRecord(E_SeverityNumber.INFO)
		._setFlags(16#FF);
	THIS^.AssertTrue(logger.pLogRecord <> 0, 'Expected the logger to hold the record');
	IF logger.pLogRecord <> 0 THEN
		THIS^.AssertEquals_UDINT(16#FF, logger.pLogRecord^.flags, 'Expected _setFlags to store all eight trace flag bits');
	END_IF

	logger._setFlags(16#01);  // sampled
	IF logger.pLogRecord <> 0 THEN
		THIS^.AssertEquals_UDINT(1, logger.pLogRecord^.flags, 'Expected a later _setFlags to replace the trace flags');
	END_IF

	success := logger.emit(failureResult=>failureResult);
	THIS^.AssertTrue(success, 'Expected the record to be emitted');
	provider.tick();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetTraceContextFromSpanCopiesIdsAndFlags" Id="{9738cce3-695a-4961-8670-de7c92125c74}">
      <Declaration><![CDATA[(*
	setTraceContextFromSpan copies the span's trace id, span id and W3C trace flags onto the record, so a log
	correlates with its span and is marked sampled only when the span is.
*)
METHOD testSetTraceContextFromSpanCopiesIdsAndFlags : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	loggerProvider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('name', 'version', '');
	logger: FB_Logger(scope, loggerProvider);
	idGenerator: FB_MockIdGenerator;
	tracerProvider: FB_TracerProvider(resource:=resource, idGenerator:=idGenerator, sampler:=TcOtlp_GVL.defaultSampler);
	tracer: FB_Tracer(scope:=scope, provider:=tracerProvider);
	unsampled: STRING(55) := '00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00';
	pUnsampledParent: POINTER TO FB_SpanContext;
	pSampledSpan: POINTER TO FB_Span;
	pUnsampledSpan: POINTER TO FB_Span;
	success: BOOL;
	failureResult: E_LoggerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetTraceContextFromSpanCopiesIdsAndFlags');
	// the default sampler samples a root span and keeps the child of an unsampled parent unsampled
	TraceContextPropagator.extract(pDest:=pUnsampledParent, traceparent:=unsampled, tracestate:='');
	tracer.startSpan(name:='sampled').build(pDest:=pSampledSpan);
	tracer.startSpan(name:='unsampled').setParent(pContext:=pUnsampledParent).build(pDest:=pUnsampledSpan);
	THIS^.AssertTrue(pSampledSpan <> 0 AND pUnsampledSpan <> 0, 'Expected both spans to be built');

	IF pSampledSpan <> 0 THEN
		logger
			.startLogRecord(E_SeverityNumber.INFO)
			.setTraceContextFromSpan(pSampledSpan);
		THIS^.AssertTrue(logger.pLogRecord <> 0, 'Expected the logger to hold the record from the sampled span');
		IF logger.pLogRecord <> 0 THEN
			THIS^.AssertTrue(
				logger.pLogRecord^.traceId <> 0 AND_THEN logger.pLogRecord^.traceId <> pSampledSpan^.traceId
				AND_THEN MEMCMP(ADR(logger.pLogRecord^.traceId^.bytes), ADR(pSampledSpan^.traceId^.bytes), SIZEOF(pSampledSpan^.traceId^.bytes)) = 0,
				'Expected the record to own a copy of the span trace id'
			);
			THIS^.AssertTrue(
				logger.pLogRecord^.spanId <> 0 AND_THEN logger.pLogRecord^.spanId <> pSampledSpan^.spanId
				AND_THEN MEMCMP(ADR(logger.pLogRecord^.spanId^.bytes), ADR(pSampledSpan^.spanId^.bytes), SIZEOF(pSampledSpan^.spanId^.bytes)) = 0,
				'Expected the record to own a copy of the span id'
			);
			THIS^.AssertEquals_UDINT(1, logger.pLogRecord^.flags, 'Expected a record from a sampled span to carry the sampled flag');
		END_IF
		success := logger.emit(failureResult=>failureResult);
		THIS^.AssertTrue(success, 'Expected the record from the sampled span to be emitted');
	END_IF

	IF pUnsampledSpan <> 0 THEN
		logger
			.startLogRecord(E_SeverityNumber.INFO)
			.setTraceContextFromSpan(pUnsampledSpan);
		THIS^.AssertTrue(logger.pLogRecord <> 0, 'Expected the logger to hold the record from the unsampled span');
		IF logger.pLogRecord <> 0 THEN
			THIS^.AssertTrue(logger.pLogRecord^.traceId <> 0, 'Expected a record from an unsampled span to keep its trace id');
			THIS^.AssertEquals_UDINT(0, logger.pLogRecord^.flags, 'Expected a record from an unsampled span not to carry the sampled flag');
		END_IF
		success := logger.emit(failureResult=>failureResult);
		THIS^.AssertTrue(success, 'Expected the record from the unsampled span to be emitted');
	END_IF

	loggerProvider.tick();
	IF pSampledSpan <> 0 THEN pSampledSpan^.delete(pSelf:=pSampledSpan); END_IF
	IF pUnsampledSpan <> 0 THEN pUnsampledSpan^.delete(pSelf:=pUnsampledSpan); END_IF
	IF pUnsampledParent <> 0 THEN pUnsampledParent^.delete(pSelf:=pUnsampledParent); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetTraceContextFromSpanWithoutSpanIsNoOp" Id="{a6aa1651-f73f-4d89-8244-a3908cba084c}">
      <Declaration><![CDATA[(*
	setTraceContextFromSpan with a null span, or a span that has no ids, leaves the record without ids and does
	not fail the chain, so the same logging code works inside and outside a span.
*)
METHOD testSetTraceContextFromSpanWithoutSpanIsNoOp : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('name', 'version', '');
	logger: FB_Logger(scope, provider);
	spanWithoutIds: FB_Span;  // declared directly because the tracer never builds a span without ids
	success: BOOL;
	failureResult: E_LoggerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetTraceContextFromSpanWithoutSpanIsNoOp');
	logger
		.startLogRecord(E_SeverityNumber.INFO)
		.setTraceContextFromSpan(0);
	THIS^.AssertTrue(logger.pLogRecord <> 0, 'Expected the logger to hold the record after a null span');
	IF logger.pLogRecord <> 0 THEN
		THIS^.AssertTrue(logger.pLogRecord^.traceId = 0 AND logger.pLogRecord^.spanId = 0, 'Expected a null span to leave the record without ids');
	END_IF
	success := logger.emit(failureResult=>failureResult);
	THIS^.AssertTrue(success, 'Expected a null span not to fail emission');

	logger
		.startLogRecord(E_SeverityNumber.INFO)
		.setTraceContextFromSpan(ADR(spanWithoutIds));
	THIS^.AssertTrue(logger.pLogRecord <> 0, 'Expected the logger to hold the record after a span without ids');
	IF logger.pLogRecord <> 0 THEN
		THIS^.AssertTrue(logger.pLogRecord^.traceId = 0 AND logger.pLogRecord^.spanId = 0, 'Expected a span without ids to leave the record without ids');
	END_IF
	success := logger.emit(failureResult=>failureResult);
	THIS^.AssertTrue(success, 'Expected a span without ids not to fail emission');

	provider.tick();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testStartingSecondRecordReturnsFailure" Id="{12abcb47-297d-44c0-b695-aa665d9ece2d}">
      <Declaration><![CDATA[(*
	Starting a second record before the first is emitted fails the pending emit and
	frees the record, so one logger never holds or leaks two records at once.
*)
METHOD testStartingSecondRecordReturnsFailure : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('name', 'version', '');
	logger: FB_Logger(scope, provider);
	success: BOOL;
	failureResult: E_LoggerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testStartingSecondRecordReturnsFailure');
	logger.startLogRecord(E_SeverityNumber.INFO);
	// deliberately start a second record before the first is emitted
	logger.startLogRecord(E_SeverityNumber.WARN);

	success := logger.emit(failureResult=>failureResult);
	THIS^.AssertFalse(success, 'Expected starting a second record to fail emission');
	THIS^.AssertTrue(
		failureResult = E_LoggerFailureReason.LOG_RECORD_ALREADY_STARTED,
		'Expected starting a second record to report LOG_RECORD_ALREADY_STARTED'
	);
	THIS^.AssertTrue(logger.pLogRecord = 0, 'Expected failed emit to release the incomplete record');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testStartLogRecordStampsUnixEpochNanos" Id="{3e082376-53e9-4a25-8cd4-9824a3e8e093}">
      <Declaration><![CDATA[(*
	The auto-stamped timestamp is nanoseconds since the unix epoch. A precedence
	error in (F_GetSystemTime() - DIFF * 100) once underflowed ULINT and produced
	timestamps billions of years in the future.
*)
METHOD testStartLogRecordStampsUnixEpochNanos : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('name', 'version', '');
	logger: FB_Logger(scope, provider);
	success: BOOL;
	failureResult: E_LoggerFailureReason;
	beforeNs: ULINT;
	afterNs: ULINT;
END_VAR
VAR CONSTANT
	UNIX_EPOCH_DIFF: ULINT := 116444736000000000;  // 1601 -> 1970 offset in 100ns intervals
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testStartLogRecordStampsUnixEpochNanos');
	beforeNs := (F_GetSystemTime() - UNIX_EPOCH_DIFF) * 100;
	logger.startLogRecord(E_SeverityNumber.INFO);
	afterNs := (F_GetSystemTime() - UNIX_EPOCH_DIFF) * 100;

	THIS^.AssertTrue(logger.pLogRecord <> 0, 'Expected startLogRecord to allocate a record');
	IF logger.pLogRecord <> 0 THEN
		THIS^.AssertTrue(
			logger.pLogRecord^.timestamp >= beforeNs AND_THEN logger.pLogRecord^.timestamp <= afterNs,
			'Expected the auto-stamped timestamp to fall within the sampled wall clock window'
		);
	END_IF

	success := logger.emit(failureResult=>failureResult);
	THIS^.AssertTrue(success AND_THEN logger.pLogRecord = 0, 'Expected emit to succeed and release the record');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>