<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestLoggerProvider" Id="{cda24098-20fd-4ad5-bc1f-836d215b288b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TestLoggerProvider EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testLoggerLifecycle();]]></ST>
    </Implementation>
    <Method Name="testLoggerLifecycle" Id="{bdefdcda-22cb-4124-9e61-9ff51ef801e6}">
      <Declaration><![CDATA[METHOD testLoggerLifecycle : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	destroyStatus: E_LoggerProviderMethodStatus;
	logger: I_Logger;
	noOpStatus: E_PointerFactoryStatus;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testLoggerLifecycle');
	// assert that it can create and store loggers
	provider.createLogger('logger1', '0.0.0.a');
	provider.createLogger('logger2', '0.0.0.b');
	provider.createLogger('logger3', '0.0.0.c');
	THIS^.AssertTrue(provider.hasLogger('logger1'), 'Expected logger1 to exist');
	THIS^.AssertTrue(provider.hasLogger('logger2'), 'Expected logger2 to exist');
	THIS^.AssertTrue(provider.hasLogger('logger3'), 'Expected logger3 to exist');
	THIS^.AssertFalse(provider.hasLogger('loggerX'), 'Expected loggerX to not exist');
	
	// assert that it can retrieve loggers
	logger := provider.getLogger('logger1');
	THIS^.AssertTrue(logger <> 0, 'Expected getLogger to return logger1');
	logger := provider.getLogger('loggerX');
	THIS^.AssertTrue(logger <> 0, 'Expected getLogger to return a no-op logger for loggerX');
	noOpStatus := logger
		.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO)
		.setBody(ADR('ignored'))
		.emit();
	THIS^.AssertEquals_UDINT(E_PointerFactoryStatus.SUCCESS, noOpStatus, 'Expected no-op logger calls to succeed');
	THIS^.AssertFalse(provider.hasLogger('loggerX'), 'Expected the no-op logger to remain outside the lookup');

	// assert that it can destroy the middle, tail, and only remaining logger
	destroyStatus := provider.destroyLogger('logger2');
	THIS^.AssertEquals_UDINT(E_LoggerProviderMethodStatus.SUCCESS, destroyStatus, 'Expected middle logger destruction to succeed');
	THIS^.AssertTrue(provider.hasLogger('logger1'), 'Expected logger1 to remain after destroying logger2');
	THIS^.AssertFalse(provider.hasLogger('logger2'), 'Expected logger2 to be destroyed');
	THIS^.AssertTrue(provider.hasLogger('logger3'), 'Expected logger3 to remain after destroying logger2');

	destroyStatus := provider.destroyLogger('logger3');
	THIS^.AssertEquals_UDINT(E_LoggerProviderMethodStatus.SUCCESS, destroyStatus, 'Expected tail logger destruction to succeed');
	THIS^.AssertTrue(provider.hasLogger('logger1'), 'Expected logger1 to remain after destroying logger3');
	THIS^.AssertFalse(provider.hasLogger('logger3'), 'Expected logger3 to be destroyed');

	destroyStatus := provider.destroyLogger('loggerX');
	THIS^.AssertEquals_UDINT(E_LoggerProviderMethodStatus.SUCCESS, destroyStatus, 'Expected missing logger destruction to succeed');
	THIS^.AssertTrue(provider.hasLogger('logger1'), 'Expected missing logger destruction to leave logger1 intact');

	destroyStatus := provider.destroyLogger('logger1');
	THIS^.AssertEquals_UDINT(E_LoggerProviderMethodStatus.SUCCESS, destroyStatus, 'Expected final logger destruction to succeed');
	THIS^.AssertFalse(provider.hasLogger('logger1'), 'Expected logger1 to be destroyed');

	provider.createLogger('logger4', '0.0.0.d');
	THIS^.AssertTrue(provider.hasLogger('logger4'), 'Expected logger creation after destroying all loggers to succeed');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>