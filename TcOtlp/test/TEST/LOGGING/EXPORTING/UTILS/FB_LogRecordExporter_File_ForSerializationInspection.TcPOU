<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordExporter_File_ForSerializationInspection" Id="{7733a436-9c26-44c4-9f9a-b58f765ed25f}" SpecialFunc="None">
    <Declaration><![CDATA[(* Exporter test double that serializes accepted records without destination I/O. *)
FUNCTION_BLOCK FB_LogRecordExporter_File_ForSerializationInspection EXTENDS FB_LogRecordExporter_Base
VAR_OUTPUT
	serializer: FB_LogRecordProtoJsonSerializer;
END_VAR
VAR
	_serializationFailureReason: E_ProtoJsonSerializerFailureReason;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="call" Id="{02f14eb3-c0a1-44a8-a5e1-327221e56a6d}">
      <Declaration><![CDATA[METHOD call : BOOL
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[failureReason := E_LogRecordExporterFailureReason.NA;
call := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="export" Id="{a8814952-f93e-467d-a452-a3c44ef19158}">
      <Declaration><![CDATA[METHOD export : BOOL
VAR_IN_OUT
	logRecords: FB_LogRecordQueue;
END_VAR
VAR_INPUT
	count: UDINT;
END_VAR
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_serializationFailureReason := E_ProtoJsonSerializerFailureReason.NA;
export := SUPER^.export(
	logRecords:=logRecords,
	count:=count,
	failureReason=>failureReason
);
IF NOT export THEN
	RETURN;
END_IF

IF NOT THIS^.serializer.serializeLogsData(
	logRecords:=THIS^._records,
	failureReason=>_serializationFailureReason
) THEN
	failureReason := E_LogRecordExporterFailureReason.SERIALIZATION_FAILURE;
	export := FALSE;
END_IF
THIS^.free();]]></ST>
      </Implementation>
    </Method>
    <Method Name="isBusy" Id="{3fcad1b8-f625-4274-83b7-cc42030874ba}">
      <Declaration><![CDATA[METHOD isBusy : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[isBusy := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
