<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestLogExporters" Id="{6be9410b-9d69-4d16-a5fe-b31cbe727e6c}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests the contract between a caller's batch and a log exporter. *)
FUNCTION_BLOCK FB_TestLogExporters EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testExportSerializesWholeBatch();]]></ST>
    </Implementation>
    <Method Name="testExportSerializesWholeBatch" Id="{5d5f1575-5e45-48b1-b9ad-2eec80177025}">
      <Declaration><![CDATA[(*
	export takes ownership of every record in the caller's batch and passes them to the serializer, so the
	caller holds nothing the exporter will release. Grouping by resource and scope is tested in FB_TestProtoJsonSerializer.
*)
METHOD testExportSerializesWholeBatch : REFERENCE TO FB_Test
VAR CONSTANT
	RECORD_COUNT: UDINT := 2;  // more than one, so the whole batch has to move, not just its head
END_VAR
VAR
	exporter: FB_LogRecordExporter_File_ForSerializationInspection;
	serialized: REFERENCE TO FB_LogRecordProtoJsonSerializer;
	batch: FB_LogRecordQueue(maxCount:=0);
	pRecord: POINTER TO FB_LogRecord;
	queueFailureReason: E_LogRecordQueueFailureReason;
	exporterFailureReason: E_LogRecordExporterFailureReason;
	pushSucceeded: BOOL;
	exportSucceeded: BOOL;
	resourceLogs: SJsonValue;
	_idx: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testExportSerializesWholeBatch');
	// arrange: a batch of bare records; their resource and scope do not matter here
	FOR _idx := 1 TO RECORD_COUNT DO
		// no factory hands a test an owned FB_LogRecord
		pRecord := __NEW(FB_LogRecord(
			severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO,
			timestamp:=_idx
		));
		THIS^.AssertTrue(pRecord <> 0, 'Expected the record allocation to succeed');
		IF pRecord = 0 THEN EXIT; END_IF

		pushSucceeded := batch.push(
			pValue:=pRecord,
			failureReason=>queueFailureReason
		);
		THIS^.AssertTrue(pushSucceeded, 'Expected the batch to accept the record');
		IF NOT pushSucceeded AND_THEN pRecord <> 0 THEN pRecord^.delete(pSelf:=pRecord); END_IF
	END_FOR

	// act
	exportSucceeded := exporter.export(
		logRecords:=batch,
		count:=batch.count,
		failureReason=>exporterFailureReason
	);

	// assert: the exporter owns the whole batch and serialized it
	THIS^.AssertTrue(
		exportSucceeded
		AND_THEN batch.count = 0
		AND_THEN exporterFailureReason = E_LogRecordExporterFailureReason.NA,
		'Expected export to succeed with no failure reason and take every record out of the batch'
	);
	serialized REF= exporter.serializer;
	resourceLogs := serialized.parser.FindMember(serialized.jsonValue, 'resourceLogs');
	THIS^.AssertTrue(resourceLogs <> 0 AND_THEN serialized.parser.IsArray(resourceLogs), 'Expected the exporter to serialize the batch into a resourceLogs array');

	exporter.free();
	batch.free();
	IF pRecord <> 0 THEN pRecord^.delete(pSelf:=pRecord); END_IF
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>