<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestLogExporters" Id="{6be9410b-9d69-4d16-a5fe-b31cbe727e6c}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests log exporter contracts. *)
FUNCTION_BLOCK FB_TestLogExporters EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[testOneToOneProcessorRelationship();]]></ST>
    </Implementation>
    <Method Name="testOneToOneProcessorRelationship" Id="{89abff76-f9b8-4aba-b0cd-1d50ad7339ac}">
      <Declaration><![CDATA[METHOD testOneToOneProcessorRelationship : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('name', 'version', 'schemaUrl');
	logger: FB_Logger(scope, provider);
	exporter: FB_LogRecordExporter_File('C:\Users\samue\Desktop\programming projects\TcOtlp\logs.jsonl');
	processor1: FB_LogRecordProcessor_Simple(0);
	processor2: FB_LogRecordProcessor_Simple(0);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('Test SimpleLogProcessors');
	THIS^.AssertTrue(exporter.register(processor1), 'Expected processor 1 to be registered with the exporter');
	THIS^.AssertFalse(exporter.register(processor2),'Expected processor 2 to NOT be registerd with the exporter');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
