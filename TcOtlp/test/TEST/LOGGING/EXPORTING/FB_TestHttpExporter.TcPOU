<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestHttpExporter" Id="{bfb7e007-9273-4824-8978-2683d2dd42fa}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests how the HTTP log exporter reports and recovers from destination failures. *)
FUNCTION_BLOCK FB_TestHttpExporter EXTENDS FB_TestSuite
VAR
	_exporterBadUrl: 	FB_LogRecordExporter_HTTP(url:='not-a-valid-url', bNoServerCertCheck:=TRUE);
	_exporterRefused: 	FB_LogRecordExporter_HTTP(url:='http://127.0.0.1:1/v1/logs', bNoServerCertCheck:=TRUE);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testInvalidUrlFailsFast();
THIS^.testConnectionRefusedReportsFailure();]]></ST>
    </Implementation>
    <Method Name="testConnectionRefusedReportsFailure" Id="{065feb3c-02c9-46b0-ad35-d7d0685f8118}">
      <Declaration><![CDATA[(*
	A refused connection surfaces as HTTP_REQUEST_FAILURE and leaves the exporter in the error state,
	and the next export still recovers it, so one unreachable collector cannot wedge logging for good.
*)
METHOD testConnectionRefusedReportsFailure : REFERENCE TO FB_Test

VAR CONSTANT
	MAX_CYCLES: UDINT := 60000;  // generous bound on scan cycles per request; a loopback refusal normally fails in a few
END_VAR

VAR_INST
	_cycles: 		UDINT;
	_state:			USINT;
END_VAR

VAR
	exportSucceeded: BOOL;
	callSucceeded: BOOL;
	failureReason: E_LogRecordExporterFailureReason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testConnectionRefusedReportsFailure');
	CASE _state OF
		0: // export one batch to the unreachable endpoint
			_cycles := 0;
			exportSucceeded := THIS^._exportOneRecord(exporter:=_exporterRefused, timestamp:=1, failureReason=>failureReason);
			THIS^.AssertTrue(
				exportSucceeded
				AND_THEN failureReason = E_LogRecordExporterFailureReason.NA,
				'Expected the HTTP exporter to accept the batch for an unreachable endpoint'
			);
			_state := 10;
			RETURN;

		10: // wait for the request to fail; loopback refusal should be quick
			callSucceeded := _exporterRefused.tick(failureReason=>failureReason);
			_cycles := _cycles + 1;
			IF NOT callSucceeded THEN
				THIS^.AssertTrue(
					failureReason = E_LogRecordExporterFailureReason.HTTP_REQUEST_FAILURE,
					'Expected HTTP_REQUEST_FAILURE when the server refuses the connection'
				);
				THIS^.AssertTrue(
					_exporterRefused.currentState = E_HttpExporterState.error,
					'Expected the exporter to enter the error state after a refused connection'
				);
				_state := 15;
				RETURN;
			ELSIF _cycles > MAX_CYCLES THEN
				THIS^.AssertTrue(FALSE, 'Expected the refused connection to fail within MAX_CYCLES');
				_state := 20;
				RETURN;
			ELSE
				RETURN;
			END_IF

		15: // a failed export must not wedge the exporter; it accepts the next batch
			exportSucceeded := THIS^._exportOneRecord(exporter:=_exporterRefused, timestamp:=2, failureReason=>failureReason);
			THIS^.AssertTrue(
				exportSucceeded
				AND_THEN failureReason = E_LogRecordExporterFailureReason.NA
				AND_THEN _exporterRefused.currentState = E_HttpExporterState.idle,
				'Expected export to reset an errored exporter back to idle'
			);
			_cycles := 0;
			_state := 16;
			RETURN;

		16: // the accepted batch must start and fail again rather than wait in idle for good
			callSucceeded := _exporterRefused.tick(failureReason=>failureReason);
			_cycles := _cycles + 1;
			IF NOT callSucceeded THEN
				THIS^.AssertTrue(
					_exporterRefused.currentState = E_HttpExporterState.error,
					'Expected the second batch to reach the error state'
				);
				_state := 20;
			ELSIF _cycles > MAX_CYCLES THEN
				THIS^.AssertTrue(FALSE, CONCAT('Expected the second batch to fail within MAX_CYCLES; state ', TO_STRING(_exporterRefused.currentState)));
				_state := 20;
			END_IF
			RETURN;

		20: // cleanup
			_exporterRefused.free();
			THIS^.AssertFalse(_exporterRefused.isBusy(), 'Expected the HTTP exporter to release its records on cleanup');
			_state := 0;
			TcUnit.TEST_FINISHED();
	END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="testInvalidUrlFailsFast" Id="{77bbc1ef-8cf0-40de-91d7-0bb12b15c980}">
      <Declaration><![CDATA[(*
	An endpoint URL without an http(s) scheme fails on the first tick with HTTP_URL_PARSE_FAILURE and
	releases the batch without sending, so a misconfigured exporter never holds records or blocks a request slot.
*)
METHOD testInvalidUrlFailsFast : REFERENCE TO FB_Test
VAR
	exportSucceeded: BOOL;
	callSucceeded: BOOL;
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testInvalidUrlFailsFast');
	exportSucceeded := THIS^._exportOneRecord(exporter:=_exporterBadUrl, timestamp:=1, failureReason=>failureReason);
	THIS^.AssertTrue(
		exportSucceeded
		AND_THEN failureReason = E_LogRecordExporterFailureReason.NA,
		'Expected the exporter to accept the batch before validating the URL'
	);

	callSucceeded := _exporterBadUrl.tick(failureReason=>failureReason);
	THIS^.AssertFalse(callSucceeded, 'Expected tick to report failure for an unparseable endpoint URL');
	THIS^.AssertTrue(
		failureReason = E_LogRecordExporterFailureReason.HTTP_URL_PARSE_FAILURE,
		'Expected HTTP_URL_PARSE_FAILURE for an endpoint URL without an http(s) scheme'
	);
	THIS^.AssertTrue(
		_exporterBadUrl.currentState = E_HttpExporterState.error,
		'Expected the exporter to enter the error state without sending anything'
	);
	THIS^.AssertFalse(_exporterBadUrl.isBusy(), 'Expected the failed batch to be released');

	// A failed exporter recovers when the next export is accepted.
	exportSucceeded := THIS^._exportOneRecord(exporter:=_exporterBadUrl, timestamp:=2, failureReason=>failureReason);
	THIS^.AssertTrue(
		exportSucceeded
		AND_THEN _exporterBadUrl.currentState = E_HttpExporterState.idle,
		'Expected export to reset an errored exporter back to idle'
	);

	_exporterBadUrl.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_exportOneRecord" Id="{3d41bbbb-badb-426e-ba77-fac83fecd583}">
      <Declaration><![CDATA[(*
	Emits one record through a logger and hands it to the exporter as a one-record batch,
	asserting that the record reached the batch and that the exporter took it out.
	Returns what export returned.
*)
METHOD _exportOneRecord : BOOL
VAR_INPUT
	exporter: REFERENCE TO FB_LogRecordExporter_Base;
	timestamp: ULINT;
END_VAR
VAR_OUTPUT
	failureReason: E_LogRecordExporterFailureReason;
END_VAR
VAR
	resource: FB_Resource(schemaUrl:='');
	provider: FB_LoggerProvider(resource:=resource);
	scope: FB_InstrumentationScope(name:='http.exporter.test', version:='1.0.0', schemaUrl:='');
	logger: FB_Logger(scope:=scope, provider:=provider);
	processor: FB_LogRecordProcessor_ForRecordsInspection(
		maxQueueSize:=0,
		scheduledDelayMillis:=1000,
		maxExportBatchSize:=512,
		exporter:=0
	);
	emitSucceeded: BOOL;
	emitFailureReason: E_LoggerFailureReason;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_exportOneRecord := FALSE;
emitSucceeded := logger
	.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO)
	.setTimestamp(timestamp)
	.emit(failureResult=>emitFailureReason);
provider
	.stageProcessor(processor)
	.tick();
THIS^.AssertTrue(emitSucceeded AND_THEN processor.records.count = 1, 'Expected the logger to hand one record to the batch');

_exportOneRecord := processor.exportRecords(exporter:=exporter, failureReason=>failureReason);
THIS^.AssertEquals_UDINT(0, processor.records.count, 'Expected the exporter to take the record out of the batch');
processor.free();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>