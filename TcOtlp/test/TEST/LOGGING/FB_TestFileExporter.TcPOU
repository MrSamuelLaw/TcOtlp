<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestFileExporter" Id="{652c2ccf-e368-4316-b865-a55144794447}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TestFileExporter EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.TestExportLogRecord(cleanup:=FALSE);]]></ST>
    </Implementation>
    <Method Name="TestExportLogRecord" Id="{62c42b19-8451-4cb9-878c-1813787327e9}">
      <Declaration><![CDATA[METHOD TestExportLogRecord : REFERENCE TO FB_Test

VAR_INPUT
	cleanup: BOOL := TRUE;
END_VAR

VAR_INST
	_cycles: 		UDINT;
	_state:			USINT;
	_fileFinder: 	FB_EnumFindFileEntry;
	_fileDeleter:	FB_FileDelete;
	_logRecords:	FB_LinkedList_LogRecord;
	_exporter: 		FB_LogRecordFileExporter;
	_flags: E_LogRecordFlag := E_LogRecordFlag.LOG_RECORD_FLAGS_TRACE_FLAGS_MASK;
END_VAR

VAR CONSTANT
	_filepath: STRING := 'C:\Users\samue\Desktop\programming projects\TcOtlp\logs.jsonl';
END_VAR

VAR
	_fileSize: ULINT;
	_guid: GUID;
	_data1: DWORD := 123;
	_pBody: POINTER TO FB_String;
	_pVal: POINTER TO FB_String;
	_pAttr: POINTER TO FB_KeyValue;
	_pLogRecord: POINTER TO FB_LogRecord;
	_attributes: FB_LinkedList_KeyValue;
END_VAR

VAR CONSTANT
	MAX_CYCLES: UDINT := 1000;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('Test FileExportLogRecord');
	CASE _state OF
		0: // initialization
			_exporter(
				filepath:=_filepath,
				logRecords:=_logRecords,
				execute:=FALSE
			);
			_cycles := 0;
			_logRecords.free();
			_attributes.free();
			_guid.Data1 := _data1;
			ValueFactory.createString(_pBody, ADR('This is a test for a string body'));
			ValueFactory.createString(_pVal, ADR('pVal'));
			ValueFactory.createKeyValue(_pAttr, ADR('stats.duration'), _pVal);
			_attributes.append(_pAttr);
			// Once FB_Logger has been implemented this should migrate away from using __NEW
			_pLogRecord := __NEW(FB_LogRecord(
				severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_DEBUG,
				timestamp:=ULINT#1581452773000000789,
				eventName:=ADR('TestSerializationEvent'),
				traceId:=ADR(_guid),
				flags:=ADR(_flags),
				spanId:=ADR(_guid.Data4),
				body:=_pBody,
				attributes:=ADR(_attributes),
				droppedAttributesCount:=0
			));
			IF _pBody <> 0 THEN _pBody^.delete(); END_IF
			IF _pVal <> 0 THEN _pVal^.delete(); END_IF
			IF _pAttr <> 0 THEN _pAttr^.delete(); END_IF
			_attributes.free();
			// verify that the pointer is valid
			IF _pLogRecord <> 0 AND_THEN _logRecords.append(_pLogRecord) THEN
				THIS^.AssertTrue(_pLogRecord^.flags <> 0, 'Expected test log record to have trace flags');
				THIS^.AssertEquals_UDINT(255, TO_UDINT(_pLogRecord^.flags^), 'Unexpected test log record trace flags');
				_pLogRecord^.attributes.reset();
				THIS^.AssertTrue(_pLogRecord^.attributes.next() <> 0, 'Expected cloned attributes to contain a key/value');
				_state := 10;
				RETURN;
			ELSE
				THIS^.AssertTrue(FALSE, 'Failed to create test log record list');
			END_IF
			
		10: // export
			_exporter(
				filepath:=_filepath,
				logRecords:=_logRecords,
				execute:=TRUE
			);
			_cycles := _cycles + 1;
			IF _exporter.currentState = E_FileExporterState.error THEN
				THIS^.AssertTrue(FALSE, 'FB_LogRecordFileExporter failed to export logs to file');
				_state := 30;
				RETURN;
			ELSIF _cycles > MAX_CYCLES THEN
				THIS^.AssertTrue(FALSE, 'Timed out waiting for FB_LogRecordFileExporter to finish');
				_state := 30;
				RETURN;
			ELSIF _exporter.currentState = E_FileExporterState.idle THEN
				// assert no errors occurred
				THIS^.AssertEquals_UDINT(0, _exporter.fileOpenerErrId, 'Unexpected file opener error');
				THIS^.AssertEquals_UDINT(0, _exporter.fileWriterErrId, 'Unexpected file writer error');
				THIS^.AssertEquals_UDINT(0, _exporter.fileCloserErrId, 'Unexpected file closer error');
				_state := 20;
				RETURN;
			ELSE
				RETURN;
			END_IF
			
		20: // verify file is non-empty
			_fileFinder(
				sPathName:=_filepath,
				bExecute:=TRUE,
			);
			IF NOT _fileFinder.bBusy THEN
				_fileSize := ULARGE_TO_ULINT(_fileFinder.stFindFile.fileSize);
				THIS^.AssertTrue(_fileSize > 0, 'File size = 0, expected non-empty file');
				_state := 30;
			END_IF
			RETURN;
		
		30: // cleanup the file
			IF cleanup THEN
				_fileDeleter(
					sPathName:=_filepath,
					bExecute:=TRUE,
				);
				IF _fileDeleter.bBusy THEN
					RETURN;
				END_IF
			END_IF

			// clean up the owned log record list
			_logRecords.free();
			_pLogRecord := 0;
			THIS^.AssertTrue(_logRecords.next() = 0, 'Expected logRecords to be empty after cleanup');

			_state := 0;
			TcUnit.TEST_FINISHED();
	END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>