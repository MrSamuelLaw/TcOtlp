<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestLogProcessors" Id="{f0aa1fdf-1271-4935-af15-b23605e1dedc}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests simple and batch log processors. *)
FUNCTION_BLOCK FB_TestLogProcessors EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestSimpleProcessors();
TestBatchProcessors();]]></ST>
    </Implementation>
    <Method Name="testBatchProcessors" Id="{7cba4cd6-baeb-4652-979f-3089242ac7bc}">
      <Declaration><![CDATA[(*
	The batch processor queues emitted records in arrival order (oldest at
	the head), dropping the oldest when the queue is full. Flushing moves
	the oldest maxExportBatchSize records into the exporter's queue.
*)
METHOD testBatchProcessors : REFERENCE TO FB_Test
VAR
	resourceA: FB_Resource('resource.a');
	resourceB: FB_Resource('resource.b');
	providerA: FB_LoggerProvider(resourceA);
	providerB: FB_LoggerProvider(resourceB);
	scopeA: FB_InstrumentationScope('scope.a', '1.0.0', '');
	scopeB: FB_InstrumentationScope('scope.b', '1.0.0', '');
	loggerAA: FB_Logger(scopeA, providerA);
	loggerAB: FB_Logger(scopeB, providerA);
	loggerBA: FB_Logger(scopeA, providerB);
	exporter: FB_LogRecordExporter_ForInspection;
	processor: FB_LogRecordProcessor_ForBatchInspection(
		maxQueueSize:=10,
		scheduledDelayMillis:=1000,
		maxExportBatchSize:=3,
		exporter:=exporter
	);
	processors: ARRAY [0..0] OF I_LogRecordProcessor := [
		processor
	];
	boundedExporter: FB_LogRecordExporter_ForInspection;
	boundedProcessor: FB_LogRecordProcessor_ForBatchInspection(
		maxQueueSize:=2,
		scheduledDelayMillis:=1000,
		maxExportBatchSize:=3,
		exporter:=boundedExporter
	);
	boundedProcessors: ARRAY [0..0] OF I_LogRecordProcessor := [
		boundedProcessor
	];
	timerExporter: FB_LogRecordExporter_ForInspection;
	timerProcessor: FB_LogRecordProcessor_ForBatchInspection(
		maxQueueSize:=0,
		scheduledDelayMillis:=0,
		maxExportBatchSize:=3,
		exporter:=timerExporter
	);
	timerProcessors: ARRAY [0..0] OF I_LogRecordProcessor := [
		timerProcessor
	];
	ts1: ULINT := 1;
	ts2: ULINT := 2;
	ts3: ULINT := 3;
	ts4: ULINT := 4;
	ts5: ULINT := 5;
	ts6: ULINT := 6;
	ts7: ULINT := 7;
	ts8: ULINT := 8;
	ts9: ULINT := 9;
	ts10: ULINT := 10;
	pRec: POINTER TO FB_LogRecord;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('Test BatchLogProcessors');
	// small batches so the count-based flush trigger fires without waiting on the timer

	// emit interleaved across (resource, scope) pairs
	loggerBA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO, timestamp:=ADR(ts1)).emit(processors);
	loggerAB.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO, timestamp:=ADR(ts2)).emit(processors);
	loggerAA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO, timestamp:=ADR(ts3)).emit(processors);
	loggerBA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO, timestamp:=ADR(ts4)).emit(processors);
	loggerAA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO, timestamp:=ADR(ts5)).emit(processors);
	THIS^.AssertTrue(processor.lastOperationSucceeded, 'Expected the last emit to succeed');
	THIS^.AssertTrue(processor.records.size = 5, 'Expected five queued records');

	// the queue keeps arrival order, oldest at the head
	processor.records.reset();
	pRec := processor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 1, 'Expected queued record 0 to be ts1');
	pRec := processor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 2, 'Expected queued record 1 to be ts2');
	pRec := processor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 3, 'Expected queued record 2 to be ts3');
	pRec := processor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 4, 'Expected queued record 3 to be ts4');
	pRec := processor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 5, 'Expected queued record 4 to be ts5');
	THIS^.AssertTrue(processor.records.next() = 0, 'Expected queue iteration to be exhausted');

	// the body flushes the three OLDEST records (ts1..ts3) since count >= maxExportBatchSize
	processor();
	THIS^.AssertTrue(processor.records.size = 2, 'Expected two records left in the queue after the flush');
	THIS^.AssertTrue(exporter.records.size = 3, 'Expected three records in the exported batch');

	// exported batch preserves arrival order: ts1, ts2, ts3
	exporter.records.reset();
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 1, 'Expected batch record 0 to be ts1');
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 2, 'Expected batch record 1 to be ts2');
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 3, 'Expected batch record 2 to be ts3');
	THIS^.AssertTrue(exporter.records.next() = 0, 'Expected batch iteration to be exhausted');

	// a busy exporter leaves the queue untouched
	exporter.busy := TRUE;
	loggerAB.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO, timestamp:=ADR(ts6)).emit(processors);
	processor();
	THIS^.AssertTrue(processor.records.size = 3, 'Expected three queued records while the exporter is busy');

	// once free again, the next flush exports the remaining records in arrival order
	exporter.busy := FALSE;
	processor();
	THIS^.AssertTrue(processor.records.size = 0, 'Expected an empty queue after the second flush');
	THIS^.AssertTrue(exporter.records.size = 3, 'Expected three records in the second exported batch');
	exporter.records.reset();
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 4, 'Expected batch record 0 to be ts4');
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 5, 'Expected batch record 1 to be ts5');
	pRec := exporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 6, 'Expected batch record 2 to be ts6');

	// a full queue drops the oldest record to make room for the newest
	THIS^.AssertEquals_UDINT(0, boundedProcessor.records.maxSize, 'Expected the internal queue to remain unbounded');
	loggerAA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO, timestamp:=ADR(ts7)).emit(boundedProcessors);
	loggerAB.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO, timestamp:=ADR(ts8)).emit(boundedProcessors);
	loggerBA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO, timestamp:=ADR(ts9)).emit(boundedProcessors);
	THIS^.AssertTrue(boundedProcessor.records.size = 2, 'Expected the queue to stay at maxQueueSize');
	boundedProcessor.records.reset();
	pRec := boundedProcessor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 8, 'Expected ts7 to be dropped and ts8 at the head');
	pRec := boundedProcessor.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 9, 'Expected ts9 at the tail');

	// an unbounded processor queue still flushes a partial batch when its timer expires
	loggerAA.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO, timestamp:=ADR(ts10)).emit(timerProcessors);
	THIS^.AssertTrue(
		timerProcessor.lastOperationSucceeded AND_THEN timerProcessor.records.size = 1,
		'Expected maxQueueSize zero to retain the record until call'
	);
	timerProcessor();
	THIS^.AssertTrue(timerProcessor.records.size = 0, 'Expected the elapsed timer to flush a partial batch');
	THIS^.AssertTrue(timerExporter.records.size = 1, 'Expected one record in the timer-triggered batch');
	timerExporter.records.reset();
	pRec := timerExporter.records.next();
	THIS^.AssertTrue(pRec <> 0 AND_THEN pRec^.timestamp = 10, 'Expected the timer-triggered batch record');

	// free releases each processor queue
	processor.free();
	boundedProcessor.free();
	timerProcessor.free();
	THIS^.AssertTrue(processor.records.size = 0, 'Expected zero records after free');
	THIS^.AssertTrue(boundedProcessor.records.size = 0, 'Expected zero bounded records after free');
	THIS^.AssertTrue(timerProcessor.records.size = 0, 'Expected zero timer records after free');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSimpleProcessors" Id="{4aa68aa9-8a85-4975-8601-420ccbbed827}">
      <Declaration><![CDATA[METHOD testSimpleProcessors : REFERENCE TO FB_Test
VAR
	resource: FB_Resource('');
	provider: FB_LoggerProvider(resource);
	scope: FB_InstrumentationScope('name', 'version', 'schemaUrl');
	logger: FB_Logger(scope, provider);
// 	processor: FB_LogRecordProcessor_ConsolePrinter(0);
	processor: FB_LogRecordProcessor_Simple(0);
	processors: ARRAY [0..0] OF I_LogRecordProcessor := [
		processor
	];
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('Test SimpleLogProcessors');
	resource.attributes.setStringAttribute('plc.name', 'sim.plc');
	logger.startLogRecord(
			severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_ERROR
		)
		.setBody('this is a test')
		.emit(processors);
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
