<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProcessor_ForBatchInspection" Id="{77cf6308-3d1f-410d-950d-b1dca7c648b7}" SpecialFunc="None">
    <Declaration><![CDATA[(*
	Processor test double that exposes the batch processor's record queue for assertions.
	Unlike FB_LogRecordProcessor_ForRecordsInspection it does NOT override
	onEmit, so tests exercise the real batch grouping behavior.
*)
FUNCTION_BLOCK FB_LogRecordProcessor_ForBatchInspection EXTENDS FB_LogRecordProcessor_Batch]]></Declaration>
    <Implementation>
      <ST><![CDATA[// explicitly run the batch processor body so tests exercise the flush logic
SUPER^();]]></ST>
    </Implementation>
    <Property Name="records" Id="{f123a485-0b0c-4d1a-a6b7-26aed6beabce}">
      <Declaration><![CDATA[PROPERTY records : REFERENCE TO FB_LogRecordQueue]]></Declaration>
      <Get Name="Get" Id="{f907df37-cc42-4b7f-92c6-7c91c79a1e96}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF THIS^._records = 0 THEN
	THIS^._records := __NEW(FB_LogRecordQueue(maxSize:=THIS^.maxQueueSize));
END_IF
records REF= THIS^._records^;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
