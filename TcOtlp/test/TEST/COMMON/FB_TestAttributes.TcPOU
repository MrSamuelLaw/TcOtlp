<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestAttributes" Id="{280ace23-1240-4f33-8a73-c7de699285bb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TestAttributes EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.testSetBehavior();
THIS^.testCopyValues();
THIS^.testResultCodes();]]></ST>
    </Implementation>
    <Method Name="testCopyValues" Id="{23900586-864d-4e56-8db4-89d06b3a65a9}">
      <Declaration><![CDATA[METHOD testCopyValues : REFERENCE TO FB_Test
VAR
	attributes: FB_Attributes(maxCount:=GVL.DEFAULT_MAX_ATTRIBUTE_COUNT);
	copyTarget: FB_Attributes(maxCount:=GVL.DEFAULT_MAX_ATTRIBUTE_COUNT);
	strVal: T_MaxString := 'String';
	numVal: REAL := 42;
	result: E_AttributesResultCode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testCopyValues');
	// test adding attributes
	result := attributes.setStringAttribute('strKey', strVal);
	THIS^.AssertTrue(result = E_AttributesResultCode.SUCCESS, 'Expected string attribute creation to succeed');
	THIS^.AssertTrue(attributes.count = 1, 'Expected only a single attribute');
	THIS^.AssertTrue(copyTarget.count = 0, 'Expected zero attributes');
	
	result := attributes.setNumberAttribute('numKey', numVal);
	THIS^.AssertTrue(result = E_AttributesResultCode.SUCCESS, 'Expected number attribute creation to succeed');
	THIS^.AssertTrue(attributes.count = 2, 'Expected two attributes');
	THIS^.AssertTrue(copyTarget.count = 0, 'Expected zero attributes');
	
	// values should get copied
	result := copyTarget.copyFrom(attributes);
	THIS^.AssertTrue(result = E_AttributesResultCode.SUCCESS, 'Expected attribute copy to succeed');
	THIS^.AssertTrue(attributes.count = 2, 'Expected two attributes');
	THIS^.AssertTrue(copyTarget.count = 2, 'Expected two attributes');
	
	// test freeing memory
	attributes.free();
	THIS^.AssertTrue(attributes.count = 0, 'Expected zero attributes');
	THIS^.AssertTrue(copyTarget.count = 2, 'Expected two attributes');
	
	copyTarget.free();
	THIS^.AssertTrue(copyTarget.count = 0, 'Expected zero attributes');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testSetBehavior" Id="{ba5afccb-3e5f-42c4-96a6-ce199c7009d2}">
      <Declaration><![CDATA[METHOD testSetBehavior : REFERENCE TO FB_Test
VAR
	attributes: FB_Attributes(maxCount:=GVL.DEFAULT_MAX_ATTRIBUTE_COUNT);
	strVal: T_MaxString;
	numVal: REAL;
	result: E_AttributesResultCode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testSetBehavior');
	// test that a string and number can be inserted
	strVal := 'strValue';
	result := attributes.setStringAttribute('strKey', strVal);
	THIS^.AssertTrue(result = E_AttributesResultCode.SUCCESS, 'Expected string attribute creation to succeed');
	THIS^.AssertTrue(attributes.count = 1, 'Expected attribute count to be 1');
	
	numVal := 10.0;
	result := attributes.setNumberAttribute('numKey', numVal);
	THIS^.AssertTrue(result = E_AttributesResultCode.SUCCESS, 'Expected number attribute creation to succeed');
	THIS^.AssertTrue(attributes.count = 2, 'Expected attribute count to be 2');
	
	attributes.free();
	THIS^.AssertTrue(attributes.count = 0, 'Expected attribute count to be 0');
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="testResultCodes" Id="{1ee828af-5982-44fc-8e06-e5dc9eba142d}">
      <Declaration><![CDATA[METHOD testResultCodes : REFERENCE TO FB_Test
VAR
	attributes: FB_Attributes(maxCount:=1);
	invalidKv: FB_KeyValue(pKey:=0, pVal:=0);
	pKv: POINTER TO FB_KeyValue;
	pKey: POINTER TO STRING;
	key: T_MaxString := 'key';
	keySize: UDINT;
	invalidValue: AnyType;
	result: E_AttributesResultCode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('testResultCodes');
	result := attributes.setAttribute(pKv);
	THIS^.AssertTrue(result = E_AttributesResultCode.KV_POINTER_NULL, 'Expected a null key-value pointer to be rejected');

	pKv := ADR(invalidKv);
	result := attributes.setAttribute(pKv);
	THIS^.AssertTrue(result = E_AttributesResultCode.KV_KEY_POINTER_NULL, 'Expected a key-value pair without a key to be rejected');

	pKv := 0;
	keySize := LEN2(ADR(key)) + 1;
	pKey := __NEW(BYTE, keySize);
	IF pKey <> 0 THEN
		MEMCPY(pKey, ADR(key), keySize);
		pKv := __NEW(FB_KeyValue(pKey:=pKey, pVal:=0));
		IF pKv <> 0 THEN
			pKey := 0;
			result := attributes.setAttribute(pKv);
			THIS^.AssertTrue(result = E_AttributesResultCode.KV_VALUE_POINTER_NULL, 'Expected a key-value pair without a value to be rejected');
			pKv := pKv^.delete();
		ELSE
			THIS^.AssertTrue(FALSE, 'Expected allocation of the invalid key-value test fixture to succeed');
			__DELETE(pKey);
		END_IF
	ELSE
		THIS^.AssertTrue(FALSE, 'Expected allocation of the invalid key test fixture to succeed');
	END_IF

	result := attributes.setNumberAttribute_AnyType('invalid', invalidValue);
	THIS^.AssertTrue(result = E_AttributesResultCode.KV_VALUE_INVALID, 'Expected invalid number data to be rejected');

	result := attributes.setStringAttribute('first', 'one');
	THIS^.AssertTrue(result = E_AttributesResultCode.SUCCESS, 'Expected the first attribute to be added');
	result := attributes.setStringAttribute('second', 'two');
	THIS^.AssertTrue(result = E_AttributesResultCode.ATTRIBUTE_COUNT_LIMIT_REACHED, 'Expected the attribute count limit to reject a new key');
	THIS^.AssertEquals_UDINT(1, attributes.count, 'Expected the rejected attribute not to change the count');
	THIS^.AssertEquals_UDINT(1, attributes.droppedCount, 'Expected the rejected attribute to increment the dropped count');

	result := attributes.setStringAttribute('first', 'replacement');
	THIS^.AssertTrue(result = E_AttributesResultCode.SUCCESS, 'Expected an existing key to be replaceable at the count limit');
	THIS^.AssertEquals_UDINT(1, attributes.count, 'Expected replacement not to change the attribute count');
	THIS^.AssertEquals_UDINT(1, attributes.droppedCount, 'Expected replacement not to increment the dropped count');

	attributes.free();
TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
