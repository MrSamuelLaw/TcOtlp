<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestAnyValue" Id="{af6fe3bb-585a-451a-bfdf-1f4164768687}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TestAnyValue EXTENDS FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[THIS^.TestStringValue();]]></ST>
    </Implementation>
    <Method Name="TestStringValue" Id="{2baeab92-0710-4fb0-9984-fda6a680188d}">
      <Declaration><![CDATA[METHOD TestStringValue : REFERENCE TO FB_Test
VAR
	actual: STRING;
	expected: STRING;
	pValue: POINTER TO FB_StringValue;
	anyValue: I_AnyValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TcUnit.TEST('Test StringValue');

 pValue := __NEW(FB_StringValue(pString:=ADR('string literal')));
 THIS^.AssertTrue(pValue <> 0, 'Unexpected null pointer when attempting to create a string');
 IF pValue <> 0 THEN
 	anyValue := pValue^;
 	// test that the data is correct
	actual := pValue^.pString^;
	expected := 'string literal';
	THIS^.AssertEquals(
		expected,
		actual,
		'strings do not match'
	);
 	__DELETE(pValue);
 END_IF

TcUnit.TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>