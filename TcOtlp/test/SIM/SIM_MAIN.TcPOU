<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SIM_MAIN" Id="{e7bb73c9-25de-42b1-a4f9-ce2c149f30b5}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM SIM_MAIN

VAR
	// logging config
	resource: FB_Resource(schemaUrl:='');
	provider: FB_LoggerProvider(resource:=resource);
	motorScope: FB_InstrumentationScope(name:='motor', version:='0.0.0a', schemaUrl:='');
	motorLogger: FB_Logger(provider:=provider, scope:=motorScope);
	valveScope: FB_InstrumentationScope(name:='valve', version:='0.0.0a', schemaUrl:='');
	valveLogger: FB_Logger(provider:=provider, scope:=valveScope);
	// 	exporter: FB_LogRecordExporter_File(filepath:='/tmp/logs.jsonl');
	exporter: FB_LogRecordExporter_HTTP('http://127.0.0.1:4318/v1/logs', TRUE);
	signozProcessor: FB_LogRecordProcessor_Signoz(0);
	consoleProcessor: FB_LogRecordProcessor_ConsolePrinter(0);
	batchProcessor: FB_LogRecordProcessor_Batch(500, 1500, 100, exporter);
	processors: ARRAY [0..2] OF I_LogRecordProcessor;
	
	// initialization setup
	firstScan: BOOL := TRUE;
	
	// program variables
	_idx: DINT;
	motorFaultFlag: BOOL;
	motorWarningFlag: BOOL;
	valveAlarmFlag: BOOL;
	valveClosedFlag: BOOL;
	valvePosFeedback: 	REAL := 70.0;
 	valvePosCommand: 	REAL := 0.0;
	{attribute 'OPC.UA.DA' := '1'}
	motorSpeedSetpoint: REAL := 50.0;
	motorSpeedSetpointLast: REAL := 50.0;
	{attribute 'OPC.UA.DA' := '1'}
	motorTemp: REAL;
	motorTempWarningLimit: REAL := 100.00; // °F 
	motorTempFaultLimit: REAL := 135.00;  // °F
	
	formatter: FB_FormatString();
	body: T_MaxString;
	
	// simulate a delayed rising temp once speed gets too hot
	motorTempTimer: TON := (PT:=T#1M);
	valveClosingTimer: TON := (PT:=T#30S);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF firstScan THEN
	resource.attributes.setStringAttribute('name', 'PLC1');
END_IF

processors[0] := signozProcessor;
processors[1] := consoleProcessor;
processors[2] := batchProcessor;
provider.call(processors);

IF motorSpeedSetpoint <> motorSpeedSetpointLast  THEN
	motorSpeedSetpointLast := motorSpeedSetpoint;
	formatter(sFormat:='motor speed setpoint changed to %0.2f', arg1:=F_REAL(motorSpeedSetpoint), sOut=>body);
	motorLogger
		.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO)
		.setEventName('motor.speedSetpointChanged')
		.setBody(body)
		.setStringAttribute('speed.units', 'Hz')
		.setNumberAttribute('speed.setpoint', motorSpeedSetpoint)
		.emit();
END_IF

// simulate a cascading failure due to a high setpoint
motorTempTimer(IN:=motorSpeedSetpoint > 75.0);
motorTemp := motorTempFaultLimit * TO_REAL(motorTempTimer.ET) / TO_REAL(motorTempTimer.PT);

IF motorTemp > motorTempWarningLimit AND NOT motorWarningFlag THEN
	motorLogger
		.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_WARN)
		.setEventName('motor.overTempWarning')
		.setBody('Motor experienced an over temp alarm, continued temperature rise will result in automatic shutdown!')
		.setStringAttribute('temperature.units', '°F')
		.setNumberAttribute('temperature.alarmLimit', motorTempWarningLimit)
		.setNumberAttribute('temperature.processValue', motorTemp)
		.emit();
END_IF
motorWarningFlag := motorTemp >= motorTempWarningLimit;

IF motorTemp > motorTempFaultLimit AND NOT motorFaultFlag THEN
	motorLogger
		.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_FATAL)
		.setEventName('motor.overTempFault')
		.setBody('Motor experienced an over temp fault... initiating auto shutdown sequence!')
		.setStringAttribute('temperature.units', '°F')
		.setNumberAttribute('temperature.alarmLimit', motorTempFaultLimit)
		.setNumberAttribute('temperature.processValue', motorTemp)
		.emit();
END_IF
motorFaultFlag := motorTemp >= motorTempFaultLimit;
firstScan := FALSE;

IF motorFaultFlag AND NOT valveAlarmFlag THEN
	valveLogger
		.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_FATAL)
		.setEventName('valve.emergencyClose')
		.setBody('Motor has stopped running, closing valve to prevent flooding!')
		.setStringAttribute('position.units', '%')
		.setNumberAttribute('position.currentValue', valvePosFeedback)
		.setNumberAttribute('position.commandedValue', valvePosCommand)
		.emit();
END_IF
valveAlarmFlag := motorFaultFlag;
valvePosFeedback := SEL(valveClosedFlag, 70.0, 0.0);

valveClosingTimer(IN:=valveAlarmFlag);
IF valveClosingTimer.Q AND NOT valveClosedFlag THEN
	valveLogger
		.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_INFO)
		.setEventName('valve.emergencyCloseComplete')
		.setBody('Motor has stopped running, valve is interlocked closed prevent flooding!')
		.setStringAttribute('position.units', '%')
		.setNumberAttribute('position.currentValue', valvePosFeedback)
		.setNumberAttribute('position.commandedValue', valvePosCommand)
		.emit();
END_IF
valveClosedFlag := valveClosingTimer.Q;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>