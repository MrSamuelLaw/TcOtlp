<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SIM_MAIN" Id="{e7bb73c9-25de-42b1-a4f9-ce2c149f30b5}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM SIM_MAIN
VAR
	// logging config
	resource: FB_Resource(schemaUrl:='');
	provider: FB_LoggerProvider(resource:=resource);
	motorScope: FB_InstrumentationScope(name:='motor', version:='0.0.0a', schemaUrl:='');
	motorLogger: FB_Logger(provider:=provider, scope:=motorScope);
	valveScope: FB_InstrumentationScope(name:='valve', version:='0.0.0a', schemaUrl:='');
	valveLogger: FB_Logger(provider:=provider, scope:=valveScope);
	exporter: FB_LogRecordExporter_File(filepath:='C:\Users\samue\Desktop\programming projects\TcOtlp\logs.jsonl');
	processor: FB_LogRecordProcessor_Batch(exporter:=exporter);
	processors: ARRAY [0..0] OF I_LogRecordProcessor := [
		processor
	];
	
	// initialization setup
	firstScan: BOOL := TRUE;
	
	// program variables
	_idx: DINT;
	motorAlarmFlag: BOOL;
	valveAlarmFlag: BOOL;
	valvePosFeedback: 	REAL := 70.0;
 	valvePosCommand: 	REAL := 0.0;
	motorTemp: REAL;
	motorTempLimit: REAL := 135.00;  // °F
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF firstScan THEN
	resource.attributes.addStringAttribute('name', 'PLC1');

END_IF
	
FOR _idx := LOWER_BOUND(processors, 1) TO UPPER_BOUND(processors, 1) DO
	processors[_idx].call();
END_FOR

IF motorTemp > motorTempLimit AND NOT motorAlarmFlag THEN
	motorLogger
		.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_FATAL)
		.setEventName('motor.over_temp_fault')
		.setBody('Motor experienced an over temp fault... initiating auto shutdown sequence!')
		.addNumberAttribute('temp.limit', motorTempLimit)
		.addNumberAttribute('temp.actual', motorTemp)
		.emit(processors);
END_IF
motorAlarmFlag := motorTemp > motorTempLimit;
firstScan := FALSE;

IF motorAlarmFlag AND NOT valveAlarmFlag THEN
	valveLogger
		.startLogRecord(severityNumber:=E_SeverityNumber.SEVERITY_NUMBER_FATAL)
		.setEventName('valve.emergency_close')
		.setBody('Motor has stopped running, closing valve to prevent flooding!')
		.addNumberAttribute('valve.position_feedback', valvePosFeedback)
		.addNumberAttribute('valve.position_command', valvePosCommand)
		.emit(processors);
END_IF
valveAlarmFlag := motorAlarmFlag;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>