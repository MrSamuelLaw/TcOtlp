<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProcessor_Signoz" Id="{c39519d7-9c11-497b-a8d0-f1bad5b1f41b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordProcessor_Signoz EXTENDS FB_LogRecordProcessor_Simple

]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="enrich" Id="{25711e50-1f43-4c45-ae9e-60a06d9d1bbd}">
      <Declaration><![CDATA[METHOD enrich
VAR_IN_OUT
	logRecord	: FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// signoz drops eventName so we have to move it into the attributes.
IF logRecord.eventName <> 0 THEN
	logRecord.attributes.setStringAttribute('event.name', logRecord.eventName^.pString^);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>