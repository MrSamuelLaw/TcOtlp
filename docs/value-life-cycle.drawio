    <diagram id="k0zKpnbDD-EvpAbD7i6_" name="Page-1">
        <mxGraphModel dx="915" dy="1056" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="16" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Instantiation&lt;/h1&gt;&lt;p&gt;The value factory acts like an initilaizer and validates inputs before returning instantiated function blocks. It MUST validate inputs and MUST verify that the memory address the user intends to use is already = 0.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="10" y="-90" width="450" height="910" as="geometry"/>
                </mxCell>
                <mxCell id="10" style="edgeStyle=none;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="9">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="Start" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
                    <mxGeometry x="120" y="40" width="80" height="80" as="geometry"/>
