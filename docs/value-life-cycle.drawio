                </mxCell>
                <mxCell id="55" value="Note, that the reason a pointer to this must be used is the compiler does not allow calling __DELETE on &quot;THIS&quot; directly." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;strokeColor=#d6b656;fillColor=#fff2cc;labelPadding=0;shadow=0;perimeterSpacing=1;" vertex="1" parent="1">
                    <mxGeometry x="1285" y="470" width="170" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="56" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Copying&lt;/h1&gt;&lt;div&gt;A value MUST implement a copy method that takes an instance of a pointer and copies its value to another instance of the same type. Under the hood it SHOULD call the create methods that must be implemented.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="560" y="-90" width="450" height="910" as="geometry"/>
                </mxCell>
