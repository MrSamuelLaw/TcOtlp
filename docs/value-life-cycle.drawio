                <mxCell id="9" value="Is pSrc &amp;lt;&amp;gt; 0" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="110" y="180" width="100" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Deallocation&lt;/h1&gt;&lt;div&gt;Function blocks are creating using a value factory MUST implement the free method and the delete method. The free method is to be used when a function block must continue to exist, but all the data it points to needs be deallocated. the delete method is to be used when a function block must be deleted and its memory deallocated in addtion to all the data it points to being deallocated.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="1110" y="-90" width="410" height="740" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="Set pOut = pSrc and sts = &quot;POINTER ALREADY ALLOCATED&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="260" y="180" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="Set pOut = pSrc and sts = &quot;INVALID DATA&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="260" y="390" width="120" height="60" as="geometry"/>
                </mxCell>
