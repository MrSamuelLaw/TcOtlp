                <mxCell id="6" value="OnEmit is called, transfering the log record in the LoggerProvider single record buffer." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="130" y="170" width="230" height="60" as="geometry"/>
