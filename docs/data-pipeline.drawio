                <mxCell id="8" value="Once the logger provider is run it will check if the last processor is complete, and if so it will request that it delete all of its log records." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="130" y="280" width="230" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="From there a transfer will happen between each log processor with the goal that the first processor will be able to accept a new record." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="130" y="400" width="230" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="I&#39;m seeing&amp;nbsp; a need for methods to check if a processor can take more log records or not, for example, a batch log processor.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;// clear the last processor&lt;/div&gt;&lt;div&gt;nextProcessor.free();&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;// transfer as many as possible&lt;/div&gt;&lt;div&gt;while prevProcessor.hasRecords() and nextP&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;rocessor.hasVacancy() do&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; nextProcessors.addRecord(prevProcessors.getRecord())&lt;/span&gt;&lt;/div&gt;&lt;div&gt;end_while&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;// if not all were transfered exit the loop early as the loop cannot progress.&lt;/div&gt;&lt;div&gt;if prevProcessors.hasRecords() then&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; return;&lt;/div&gt;&lt;div&gt;end_if&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="410" y="60" width="420" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="What is the optimal return type of onEmit?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="410" y="330" width="420" height="50" as="geometry"/>
