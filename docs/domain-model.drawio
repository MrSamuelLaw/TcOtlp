                </mxCell>
                <mxCell id="124" value="This is an example of a class that realizes the I_OtlpValue interface. When instantiated it takes pString and copies the data into its own byte array, pointed at by pString. This way it owns its own data and only allocates the exact amount of bytes necessary to hold the string data coming in." style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="56" vertex="1">
