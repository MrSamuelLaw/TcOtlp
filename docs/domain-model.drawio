                <mxCell id="144" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Used to serialize common types to ProtoJSON. Manages an SJsonValue that it uses as an output for the exporter&lt;/span&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="143" vertex="1">
