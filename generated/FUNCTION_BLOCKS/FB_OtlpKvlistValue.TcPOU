  <POU Name="FB_OtlpKvlistValue" Id="{069b1e72-d954-45c9-a8bc-7696f3ba649d}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpKvlistValue IMPLEMENTS I_OtlpAnyValue
VAR
	_arrValues : ARRAY[0..99] OF POINTER TO FB_OtlpKeyValue;
	_nValuesCount : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SerializeToProtoJson" Id="{ce05020a-2113-44b1-a663-9e76fc13fbef}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	kvlistNode : SJsonValue;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[kvlistNode := parser.AddObjectMember(node, 'kvlistValue');
IF THIS^._nValuesCount > 0 THEN
	arrNode := parser.AddArrayMember(kvlistNode, 'values', 0);
	FOR i := 0 TO THIS^._nValuesCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrValues[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{cf5fb03b-ecd2-4279-bf63-2921064a6048}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO THIS^._nValuesCount - 1 DO
	IF THIS^._arrValues[i] <> 0 THEN
		__DELETE(THIS^._arrValues[i]);
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddValue" Id="{3551c07a-d6cf-4f3b-b1f6-9ce1c8a1bd11}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddValue : POINTER TO FB_OtlpKeyValue
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nValuesCount < 100 THEN
	AddValue := __NEW(FB_OtlpKeyValue);
	THIS^._arrValues[THIS^._nValuesCount] := AddValue;
	THIS^._nValuesCount := THIS^._nValuesCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="eValueType" Id="{bcd52bf1-eab4-4712-92e8-25f6186daccb}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
