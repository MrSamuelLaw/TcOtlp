    <Method Name="SerializeToProtoJson" Id="{88fafe33-ded2-4ee8-8693-12a79c44a652}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	kvlistNode : SJsonValue;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[kvlistNode := parser.AddObjectMember(node, 'kvlistValue');
IF THIS^._nValuesCount > 0 THEN
	arrNode := parser.AddArrayMember(kvlistNode, 'values', 0);
	FOR i := 0 TO THIS^._nValuesCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrValues[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{5dd2d341-d2d1-41cf-9026-fbc9742cc001}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO THIS^._nValuesCount - 1 DO
	IF THIS^._arrValues[i] <> 0 THEN
		__DELETE(THIS^._arrValues[i]);
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddValue" Id="{531c229b-a8c1-467b-b108-531bada22cf7}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddValue : POINTER TO FB_OtlpKeyValue
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nValuesCount < 100 THEN
	AddValue := __NEW(FB_OtlpKeyValue);
	THIS^._arrValues[THIS^._nValuesCount] := AddValue;
	THIS^._nValuesCount := THIS^._nValuesCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
