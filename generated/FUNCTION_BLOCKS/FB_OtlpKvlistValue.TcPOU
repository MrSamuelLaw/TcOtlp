      <Get Name="Get" Id="{3bec510d-1822-46a9-b235-a2164ab2e36e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eValueType := E_OtlpAnyValueType.KVLIST_VALUE;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="nValuesCount" Id="{b289aed9-af0d-4c06-9bc1-aec66f3a1c52}">
