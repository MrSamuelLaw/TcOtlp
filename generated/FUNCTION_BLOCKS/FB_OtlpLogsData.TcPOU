    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SerializeToProtoJson" Id="{d928854a-d9b3-42a8-af45-c2e52e2ba52f}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	i : UDINT;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nResourceLogsCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'resourceLogs', 0);
	FOR i := 0 TO THIS^._nResourceLogsCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrResourceLogs[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{02039dea-8934-4940-98e0-b3b66731701d}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO THIS^._nResourceLogsCount - 1 DO
	IF THIS^._arrResourceLogs[i] <> 0 THEN
		__DELETE(THIS^._arrResourceLogs[i]);
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddResourceLogs" Id="{9babe61d-cf9f-4021-b513-13b8a15d1084}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddResourceLogs : POINTER TO FB_OtlpResourceLogs
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nResourceLogsCount < 100 THEN
	AddResourceLogs := __NEW(FB_OtlpResourceLogs);
	THIS^._arrResourceLogs[THIS^._nResourceLogsCount] := AddResourceLogs;
	THIS^._nResourceLogsCount := THIS^._nResourceLogsCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="nResourceLogsCount" Id="{5c9d740b-5c2b-4a6f-afee-5891272115b5}">
