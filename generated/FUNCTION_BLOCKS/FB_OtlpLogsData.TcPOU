  <POU Name="FB_OtlpLogsData" Id="{412f0230-400d-45ec-8f5e-f0d2669630e2}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
