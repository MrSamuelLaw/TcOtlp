  <POU Name="FB_OtlpLogsData" Id="{b51ed2f4-12ae-4fab-a621-1795164e3d65}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpLogsData IMPLEMENTS I_OtlpSerializable
VAR
	_arrResourceLogs : ARRAY[0..99] OF POINTER TO FB_OtlpResourceLogs;
	_nResourceLogsCount : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SerializeToProtoJson" Id="{383ba5e1-1746-4b2c-b875-ead31ed6f676}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	i : UDINT;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nResourceLogsCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'resourceLogs', 0);
	FOR i := 0 TO THIS^._nResourceLogsCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrResourceLogs[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{4f8de2d8-37f1-44f1-8935-80f66e0e28c0}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nResourceLogsCount > 0 THEN
	FOR i := 0 TO THIS^._nResourceLogsCount - 1 DO
		IF THIS^._arrResourceLogs[i] <> 0 THEN
			__DELETE(THIS^._arrResourceLogs[i]);
		END_IF
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddResourceLogs" Id="{c22f4348-b365-4972-9dd0-489c3717922c}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddResourceLogs : POINTER TO FB_OtlpResourceLogs
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nResourceLogsCount < 100 THEN
	AddResourceLogs := __NEW(FB_OtlpResourceLogs);
	THIS^._arrResourceLogs[THIS^._nResourceLogsCount] := AddResourceLogs;
	THIS^._nResourceLogsCount := THIS^._nResourceLogsCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="nResourceLogsCount" Id="{fe222753-d8ac-47a3-846c-5b18f05e1a06}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
