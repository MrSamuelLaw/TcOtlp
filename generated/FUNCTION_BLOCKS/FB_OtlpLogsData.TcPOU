  <POU Name="FB_OtlpLogsData" Id="{be35d7bd-ce24-4918-9f02-64e48b5b5cd3}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
