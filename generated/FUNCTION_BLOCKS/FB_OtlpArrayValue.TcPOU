      <Get Name="Get" Id="{6f539ec0-142a-4cbb-9792-e8546f32e32f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eValueType := E_OtlpAnyValueType.ARRAY_VALUE;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="nValuesCount" Id="{426e6a3e-9c9e-4f76-848b-e277b386341d}">
