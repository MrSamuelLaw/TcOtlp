  <POU Name="FB_OtlpArrayValue" Id="{ccafbb4d-9036-4045-88f0-09be997db54f}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpArrayValue IMPLEMENTS I_OtlpAnyValue
VAR
	_arrValues : ARRAY[0..99] OF POINTER TO I_OtlpAnyValue;
	_nValuesCount : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SerializeToProtoJson" Id="{d0551c91-419c-454a-827c-4015052058fd}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	valuesNode : SJsonValue;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[valuesNode := parser.AddObjectMember(node, 'arrayValue');
IF THIS^._nValuesCount > 0 THEN
	arrNode := parser.AddArrayMember(valuesNode, 'values', 0);
	FOR i := 0 TO THIS^._nValuesCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrValues[i]^^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{ca9351d4-db99-4ad8-86a1-c433ba5495a6}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nValuesCount > 0 THEN
	FOR i := 0 TO THIS^._nValuesCount - 1 DO
	IF THIS^._arrValues[i] <> 0 THEN
		__DELETE(THIS^._arrValues[i]);
	END_IF
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddValue" Id="{825e64f5-2b55-47c6-b904-e2c3ea2a2033}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddValue
VAR_INPUT
	pValue : POINTER TO I_OtlpAnyValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nValuesCount < 100 AND pValue <> 0 THEN
	THIS^._arrValues[THIS^._nValuesCount] := pValue;
	THIS^._nValuesCount := THIS^._nValuesCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="eValueType" Id="{aee224dd-9a93-4257-a346-d3d8973c0e72}">
