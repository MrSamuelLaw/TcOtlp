<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_OtlpSpan" Id="{e8237d97-f34a-42e3-b9a7-8d1ce7c56b3e}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpSpan IMPLEMENTS I_OtlpSerializable
VAR
	_arrTraceId : ARRAY[0..15] OF BYTE;
	_arrSpanId : ARRAY[0..7] OF BYTE;
	_sTraceState : STRING(255);
	_arrParentSpanId : ARRAY[0..7] OF BYTE;
	_nFlags : UDINT;
	_sName : STRING(255);
	_eKind : E_OtlpSpanKind;
	_nStartTimeUnixNano : ULINT;
	_nEndTimeUnixNano : ULINT;
	_arrAttributes : ARRAY[0..99] OF POINTER TO FB_OtlpKeyValue;
	_nAttributesCount : UDINT;
	_nDroppedAttributesCount : UDINT;
	_arrEvents : ARRAY[0..99] OF POINTER TO FB_OtlpEvent;
	_nEventsCount : UDINT;
	_nDroppedEventsCount : UDINT;
	_arrLinks : ARRAY[0..99] OF POINTER TO FB_OtlpLink;
	_nLinksCount : UDINT;
	_nDroppedLinksCount : UDINT;
	_pStatus : POINTER TO FB_OtlpStatus;
	_arrStringAttrValues : ARRAY[0..99] OF POINTER TO FB_OtlpStringValue;
	_arrStringAttrInterfaces : ARRAY[0..99] OF I_OtlpAnyValue;
	_nStringAttrValuesCount : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SerializeToProtoJson" Id="{564a6986-d6a8-4a2b-aa5e-2b445518c7c6}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	i : UDINT;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
	objNode : SJsonValue;
	sTemp : STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[sTemp := F_BytesToHex(pBytes := ADR(THIS^._arrTraceId), nLen := 16);
parser.AddStringMember(node, 'traceId', sTemp);

sTemp := F_BytesToHex(pBytes := ADR(THIS^._arrSpanId), nLen := 8);
parser.AddStringMember(node, 'spanId', sTemp);

parser.AddStringMember(node, 'traceState', THIS^._sTraceState);

sTemp := F_BytesToHex(pBytes := ADR(THIS^._arrParentSpanId), nLen := 8);
parser.AddStringMember(node, 'parentSpanId', sTemp);

parser.AddUintMember(node, 'flags', THIS^._nFlags);

parser.AddStringMember(node, 'name', THIS^._sName);

parser.AddIntMember(node, 'kind', TO_DINT(THIS^._eKind));

parser.AddUint64Member(node, 'startTimeUnixNano', THIS^._nStartTimeUnixNano);

parser.AddUint64Member(node, 'endTimeUnixNano', THIS^._nEndTimeUnixNano);

IF THIS^._nAttributesCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'attributes', 0);
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrAttributes[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF

parser.AddUintMember(node, 'droppedAttributesCount', THIS^._nDroppedAttributesCount);

IF THIS^._nEventsCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'events', 0);
	FOR i := 0 TO THIS^._nEventsCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrEvents[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF

parser.AddUintMember(node, 'droppedEventsCount', THIS^._nDroppedEventsCount);

IF THIS^._nLinksCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'links', 0);
	FOR i := 0 TO THIS^._nLinksCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrLinks[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF

parser.AddUintMember(node, 'droppedLinksCount', THIS^._nDroppedLinksCount);

IF THIS^._pStatus <> 0 THEN
	objNode := parser.AddObjectMember(node, 'status');
	THIS^._pStatus^.SerializeToProtoJson(parser, objNode);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{ebb286ea-b01c-4889-94da-d0e18fd61552}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nAttributesCount > 0 THEN
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		IF THIS^._arrAttributes[i] <> 0 THEN
			THIS^._arrAttributes[i]^.pValue := 0;
		END_IF
	END_FOR
END_IF

IF THIS^._nStringAttrValuesCount > 0 THEN
	FOR i := 0 TO THIS^._nStringAttrValuesCount - 1 DO
		IF THIS^._arrStringAttrValues[i] <> 0 THEN
			__DELETE(THIS^._arrStringAttrValues[i]);
		END_IF
	END_FOR
END_IF

IF THIS^._nAttributesCount > 0 THEN
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		IF THIS^._arrAttributes[i] <> 0 THEN
			THIS^._arrAttributes[i]^.pValue := 0;
			__DELETE(THIS^._arrAttributes[i]);
		END_IF
	END_FOR
END_IF

IF THIS^._nEventsCount > 0 THEN
	FOR i := 0 TO THIS^._nEventsCount - 1 DO
		IF THIS^._arrEvents[i] <> 0 THEN
			__DELETE(THIS^._arrEvents[i]);
		END_IF
	END_FOR
END_IF

IF THIS^._nLinksCount > 0 THEN
	FOR i := 0 TO THIS^._nLinksCount - 1 DO
		IF THIS^._arrLinks[i] <> 0 THEN
			__DELETE(THIS^._arrLinks[i]);
		END_IF
	END_FOR
END_IF

IF THIS^._pStatus <> 0 THEN
	__DELETE(THIS^._pStatus);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddAttributes" Id="{fc01980c-b1e2-49b7-af19-9ea8840568d1}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddAttributes : POINTER TO FB_OtlpKeyValue
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nAttributesCount < 100 THEN
	AddAttributes := __NEW(FB_OtlpKeyValue);
	THIS^._arrAttributes[THIS^._nAttributesCount] := AddAttributes;
	THIS^._nAttributesCount := THIS^._nAttributesCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
