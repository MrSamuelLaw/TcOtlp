<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_OtlpResource" Id="{41813951-9174-4271-a181-4ff2ba9cbbaf}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpResource IMPLEMENTS I_OtlpSerializable
VAR
	_arrAttributes : ARRAY[0..99] OF POINTER TO FB_OtlpKeyValue;
	_nAttributesCount : UDINT;
	_nDroppedAttributesCount : UDINT;
	_arrEntityRefs : ARRAY[0..99] OF POINTER TO FB_OtlpEntityRef;
	_nEntityRefsCount : UDINT;
	_arrStringAttrValues : ARRAY[0..99] OF POINTER TO FB_OtlpStringValue;
	_arrStringAttrInterfaces : ARRAY[0..99] OF I_OtlpAnyValue;
	_nStringAttrValuesCount : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SerializeToProtoJson" Id="{f85f1748-7048-4ef7-b838-bbd00cc9b479}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	i : UDINT;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nAttributesCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'attributes', 0);
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrAttributes[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF

parser.AddUintMember(node, 'droppedAttributesCount', THIS^._nDroppedAttributesCount);

IF THIS^._nEntityRefsCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'entityRefs', 0);
	FOR i := 0 TO THIS^._nEntityRefsCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrEntityRefs[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{f82bbcee-a583-4989-ad26-7e4eab7ffff1}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nAttributesCount > 0 THEN
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		IF THIS^._arrAttributes[i] <> 0 THEN
			THIS^._arrAttributes[i]^.pValue := 0;
		END_IF
	END_FOR
END_IF

IF THIS^._nStringAttrValuesCount > 0 THEN
	FOR i := 0 TO THIS^._nStringAttrValuesCount - 1 DO
		IF THIS^._arrStringAttrValues[i] <> 0 THEN
			__DELETE(THIS^._arrStringAttrValues[i]);
		END_IF
	END_FOR
END_IF

IF THIS^._nAttributesCount > 0 THEN
	FOR i := 0 TO THIS^._nAttributesCount - 1 DO
		IF THIS^._arrAttributes[i] <> 0 THEN
			THIS^._arrAttributes[i]^.pValue := 0;
			__DELETE(THIS^._arrAttributes[i]);
		END_IF
	END_FOR
END_IF

IF THIS^._nEntityRefsCount > 0 THEN
	FOR i := 0 TO THIS^._nEntityRefsCount - 1 DO
		IF THIS^._arrEntityRefs[i] <> 0 THEN
			__DELETE(THIS^._arrEntityRefs[i]);
		END_IF
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddAttributes" Id="{bf7ac385-4491-4c4a-8ba7-eb897cd2c883}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddAttributes : POINTER TO FB_OtlpKeyValue
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nAttributesCount < 100 THEN
	AddAttributes := __NEW(FB_OtlpKeyValue);
	THIS^._arrAttributes[THIS^._nAttributesCount] := AddAttributes;
	THIS^._nAttributesCount := THIS^._nAttributesCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddEntityRefs" Id="{9fa130ed-15a2-42e0-89d0-8ad880cc8055}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddEntityRefs : POINTER TO FB_OtlpEntityRef
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nEntityRefsCount < 100 THEN
	AddEntityRefs := __NEW(FB_OtlpEntityRef);
	THIS^._arrEntityRefs[THIS^._nEntityRefsCount] := AddEntityRefs;
	THIS^._nEntityRefsCount := THIS^._nEntityRefsCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddStringAttribute" Id="{2a6e6279-c192-4290-9d31-4c473270ff35}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddStringAttribute
VAR_INPUT
	sKey : STRING(255);
	sValue : STRING(255);
END_VAR
VAR
	pKv : POINTER TO FB_OtlpKeyValue;
	pStrVal : POINTER TO FB_OtlpStringValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nStringAttrValuesCount >= 100 THEN
	RETURN;
END_IF

pStrVal := __NEW(FB_OtlpStringValue);
IF pStrVal = 0 THEN
	RETURN;
END_IF

pKv := THIS^.AddAttributes();
IF pKv = 0 THEN
	__DELETE(pStrVal);
	RETURN;
END_IF

pKv^.sKey := sKey;

pStrVal^.sValue := sValue;
THIS^._arrStringAttrValues[THIS^._nStringAttrValuesCount] := pStrVal;

THIS^._arrStringAttrInterfaces[THIS^._nStringAttrValuesCount] := pStrVal^;
pKv^.pValue := ADR(THIS^._arrStringAttrInterfaces[THIS^._nStringAttrValuesCount]);

THIS^._nStringAttrValuesCount := THIS^._nStringAttrValuesCount + 1;]]></ST>
      </Implementation>
    </Method>
    <Property Name="nAttributesCount" Id="{d8b03b79-618a-46b2-8f75-7dcf3d430d1f}">
