  <POU Name="FB_OtlpScopeLogs" Id="{d42e7373-31d1-4387-bb59-a3651c97b078}" SpecialFunc="None">
    <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_OtlpScopeLogs IMPLEMENTS I_OtlpSerializable
VAR
	_pScope : POINTER TO FB_OtlpInstrumentationScope;
	_arrLogRecords : ARRAY[0..99] OF POINTER TO FB_OtlpLogRecord;
	_nLogRecordsCount : UDINT;
	_sSchemaUrl : STRING(255);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SerializeToProtoJson" Id="{aad03ff0-2f75-4df5-830f-09a46be7c495}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD SerializeToProtoJson
VAR_INPUT
	parser : REFERENCE TO FB_JsonDynDomParser;
	node   : SJsonValue;
END_VAR
VAR
	i : UDINT;
	arrNode : SJsonValue;
	elemNode : SJsonValue;
	objNode : SJsonValue;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._pScope <> 0 THEN
	objNode := parser.AddObjectMember(node, 'scope');
	THIS^._pScope^.SerializeToProtoJson(parser, objNode);
END_IF

IF THIS^._nLogRecordsCount > 0 THEN
	arrNode := parser.AddArrayMember(node, 'logRecords', 0);
	FOR i := 0 TO THIS^._nLogRecordsCount - 1 DO
		elemNode := parser.PushbackJsonValue(arrNode, '{}');
		THIS^._arrLogRecords[i]^.SerializeToProtoJson(parser, elemNode);
	END_FOR
END_IF

parser.AddStringMember(node, 'schemaUrl', THIS^._sSchemaUrl);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{7e72acfa-777b-483c-933f-da67d9183c71}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL;
END_VAR
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._pScope <> 0 THEN
	__DELETE(THIS^._pScope);
END_IF

FOR i := 0 TO THIS^._nLogRecordsCount - 1 DO
	IF THIS^._arrLogRecords[i] <> 0 THEN
		__DELETE(THIS^._arrLogRecords[i]);
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddLogRecords" Id="{00891832-aa55-4b22-a217-239a990ef21f}">
      <Declaration><![CDATA[(* AUTO GENERATED CODE, DO NOT MODIFY THIS FILE DIRECTLY *)
METHOD AddLogRecords : POINTER TO FB_OtlpLogRecord
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF THIS^._nLogRecordsCount < 100 THEN
	AddLogRecords := __NEW(FB_OtlpLogRecord);
	THIS^._arrLogRecords[THIS^._nLogRecordsCount] := AddLogRecords;
	THIS^._nLogRecordsCount := THIS^._nLogRecordsCount + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
