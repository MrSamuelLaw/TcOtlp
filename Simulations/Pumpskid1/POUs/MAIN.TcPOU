<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{f531e982-a20c-4760-910c-0f69803ce7f9}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// logging config, note that loggers are oriented on a per entity (device) basis.
	
	motorScope: FB_InstrumentationScope(name:='motor', version:='0.0.0a', schemaUrl:='');
	valveScope: FB_InstrumentationScope(name:='valve', version:='0.0.0a', schemaUrl:='');
	motorLogger: FB_Logger(provider:=GVL.loggerProvider, scope:=motorScope);
	valveLogger: FB_Logger(provider:=GVL.loggerProvider, scope:=valveScope);
	signozProcessor: FB_LogRecordProcessor_Signoz(0);
	logExporter: FB_LogRecordExporter_HTTP('http://192.168.97.55:4318/v1/logs', TRUE);
	logBatchProcessor: FB_LogRecordProcessor_Batch(maxQueueSize:=500, scheduledDelayMillis:=1500, 
												maxExportBatchSize:=500, exporter:=logExporter);
	
	// tracing config, note that tracers are oriented per service basis.
	skidScope: FB_InstrumentationScope(name:='skid', version:='0.0.0a', schemaUrl:='');
	modbusScope: FB_InstrumentationScope(name:='modbus', version:='0.0.0a', schemaUrl:='');
	tracer: FB_Tracer(scope:=skidScope, provider:=GVL.tracerProvider);
	modbusTracer: FB_Tracer(scope:=modbusScope, provider:=GVL.tracerProvider);
	spanExporter: FB_SpanExporter_HTTP('http://192.168.97.55:4318/v1/traces', TRUE);
	spanBatchProcessor: FB_SpanProcessor_Batch(maxQueueSize:=500, scheduledDelayMillis:=1500, 
										   maxExportBatchSize:=500, exporter:=spanExporter);
	pRootSpan: 			POINTER TO FB_Span;
	pPumpStageSpan: 	POINTER TO FB_Span;
	pValveStageSpan: 	POINTER TO FB_Span;
	pModbusSpan:		POINTER TO FB_Span;
	
	
	// initialization setup
	firstScan: BOOL := TRUE;
	
	// simulated faults
	simulateValveFailure: BOOL;
	simulateMotorFailure: BOOL;
	simulateModbusFailure: BOOL;
	
	// process inputs (in a real sitation these would likely come from SCADA)
	cmdStageUp: BOOL := FALSE;  	// when true the skid will attempt to stage up
	cmdFlowRate: REAL := 700;  		// GPM
	valveOpenPosition: REAL := 100;	// open position
	
	// process outputs
	currentState: 	USINT;
	flowRate: 		REAL;
	valvePosition: 	REAL;
	pumpError: 		BOOL;
	valveError: 	BOOL;
	
	// program variables
	_computedState: 	USINT;
	_stateChanged: 		BOOL;
	formatter: 			FB_FormatString();
	body: 				T_MaxString;
	
	// simulation ramp rates
	flowRampRate: 	REAL := 20;  // gpm/sec
	valveRampRate: 	REAL := 2;  // %/sec
	pumpRampTON: 	TON := (PT:=T#1S);
	valveRampTON: 	TON := (PT:=T#1S);
	modbusTimer: 	TON := (PT:=T#1S);
	modbusPort: 	UINT := 502;
	modbusRegister: UINT := 40005; 
	modbusCount: 	UINT := 10;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF firstScan THEN
	GVL.resource.attributes.setStringAttribute('service.name', 'PLC1');
END_IF
	
// run the logger every tick
GVL.loggerProvider
	.stageProcessor(signozProcessor)
	.stageProcessor(logBatchProcessor)
	.tick();
	
// run the tracer every tick
GVL.tracerProvider
	.stageProcessor(spanBatchProcessor)
	.tick();
	
CASE currentState OF
	0:  // shutdown state
		IF _stateChanged AND (NOT cmdStageUp) THEN
			tracer.setSpanStatusOk(pRootSpan);
			tracer.endSpan(pRootSpan);
		END_IF
		
		IF cmdStageUp THEN
			tracer.discardSpan(pRootSpan);
			tracer
				.startSpan('skid.staging.stage_up')
				.setNumberAttribute('flow.target', cmdFlowRate)
				.build(pRootSpan);
			_computedState := 1;
		END_IF
		
	1:  // stage pump up/down
		IF _stateChanged THEN
			IF pRootSpan <> 0 THEN
				tracer.startSpan(SEL(cmdStageUp, 
					'skid.staging.pump_stage_down', 
					'skid.staging.pump_stage_up'));
				tracer.setParentUsingSpan(pRootSpan);
				tracer.build(pPumpStageSpan);
			END_IF
			motorLogger
				.startLogRecord(E_SeverityNumber.TRACE)
				.setBody(SEL(cmdStageUp, 'stopping pump', 'starting pump'))
				.setNumberAttribute('flow.target', cmdFlowRate)
				.setTraceContextFromSpan(pPumpStageSpan)
				.emit();
		END_IF
		
		// ramp up the flow if staging up, otherwise stage down
		IF pumpRampTON.Q THEN
			flowRate := SEL(cmdStageUp, 
				flowRate - flowRampRate, 
				flowRate + flowRampRate);
		END_IF
		
		// go to adjacent states based on command
		IF (NOT cmdStageUp) AND flowRate <= 0 THEN
			_computedState := 0;
			tracer.setSpanStatusOk(pPumpStageSpan);
		ELSIF cmdStageUp THEN
			IF NOT simulateMotorFailure AND flowRate >= cmdFlowRate THEN
				_computedState := 2;
			ELSIF simulateMotorFailure AND flowRate >= cmdFlowRate * 0.5 THEN
				_computedState := 0;
				flowRate := 0;
				cmdStageUp := FALSE;
				tracer.setSpanStatusError(pPumpStageSpan, 'pump motor failure');
				tracer.setSpanStatusError(pRootSpan, 'skid startup failure');
				motorLogger
					.startLogRecord(E_SeverityNumber.FATAL)
					.setBody('pump failure detected, stopping pump!')
					.setNumberAttribute('flow.target', cmdFlowRate)
					.setNumberAttribute('flow.actual', flowRate)
					.setTraceContextFromSpan(pPumpStageSpan)
					.emit();
			END_IF
		END_IF
		
		IF _computedState <> currentState AND pPumpStageSpan <> 0 THEN
			tracer.endSpan(pPumpStageSpan);
		END_IF
		
	2:  // open isolation valve
		IF _stateChanged THEN
			IF pRootSpan <> 0 THEN
				tracer.startSpan(SEL(cmdStageUp, 
					'skid.staging.valve_close', 
					'skid.staging.valve_open'));
				tracer.setParentUsingSpan(pRootSpan);
				tracer.build(pValveStageSpan);
			END_IF
			valveLogger
				.startLogRecord(E_SeverityNumber.TRACE)
				.setBody(SEL(cmdStageUp, 'closing valve', 'opening valve'))
				.setNumberAttribute('position.target', valveOpenPosition)
				.setTraceContextFromSpan(pValveStageSpan)
				.emit();
		END_IF
		
		IF valveRampTON.Q THEN
			valvePosition := SEL(cmdStageUp, 
				valvePosition - valveRampRate, 
				valvePosition + valveRampRate);
		END_IF
		
		IF (NOT cmdStageUp) AND valvePosition <= 0.0 THEN
			_computedState := 1;
		ELSIF cmdStageUp THEN
			IF simulateValveFailure AND valvePosition >= 50.0 THEN
				_computedState := 1;
				cmdStageUp := FALSE;
				valvePosition := 0;
				tracer.setSpanStatusError(pRootSpan, 'startup failure');
				tracer.setSpanStatusError(pValveStageSpan, 'valve open failure');
				valveLogger
					.startLogRecord(E_SeverityNumber.FATAL)
					.setBody('valve failure detected, attempting to shut down')
					.setNumberAttribute('valve.target', valveOpenPosition)
					.setNumberAttribute('valve.actual', valvePosition)
					.setTraceContextFromSpan(pValveStageSpan)
					.emit();
			ELSIF valvePosition >= 100.0 THEN
				tracer.setSpanStatusOk(pValveStageSpan);
				_computedState := 3;
			END_IF
		END_IF
		
		IF _computedState <> currentState THEN
			tracer.endSpan(pValveStageSpan);
		END_IF
		
	3: // staged up
		IF _stateChanged AND cmdStageUp THEN
			tracer.setSpanStatusOk(pRootSpan);
			tracer.endSpan(pRootSpan);
		END_IF
		
		IF (NOT cmdStageUp) THEN
			tracer.discardSpan(pRootSpan);
			tracer
				.startSpan('skid.staging.stage_down')
				.build(pRootSpan);
			_computedState := 2;
		END_IF
END_CASE

_stateChanged := currentState <> _computedState;
currentState := _computedState;

pumpRampTON(IN:=currentState=1 AND NOT pumpRampTON.Q);
valveRampTON(IN:=currentState=2 AND NOT valveRampTON.Q);

// modbus fake logic
modbusTimer(IN := NOT modbusTimer.Q);

IF modbusTimer.IN AND TO_DINT(modbusTimer.ET) = 0 THEN
	modbusTracer.discardSpan(pModbusSpan);
	modbusTracer
		.startSpan(name:='modbus.poll', kind:=E_SpanKind.SPAN_KIND_CLIENT)
		.setStringAttribute('peer.service', 'chiller')
		.setStringAttribute('peer.address', '127.0.0.1')
		.setNumberAttribute('peer.port', modbusPort)
		.setStringAttribute('modbus.protocol', 'tcp')
		.setStringAttribute('modbus.function_code', '0x04')
		.setNumberAttribute('modbus.start_register', modbusRegister)
		.setNumberAttribute('modbus.count', modbusCount)
		.build(pModbusSpan);
ELSIF modbusTimer.Q THEN
	IF simulateModbusFailure THEN
		simulateModbusFailure := FALSE;
		modbusTracer.setSpanStatusError(pModbusSpan, 'Error code 0x04');
		modbusTracer.endSpan(pModbusSpan);
	ELSE
		modbusTracer.discardSpan(pModbusSpan);
	END_IF
	
END_IF

firstScan := FALSE;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>