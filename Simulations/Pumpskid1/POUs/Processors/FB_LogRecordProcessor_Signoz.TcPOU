<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_LogRecordProcessor_Signoz" Id="{2571e0bd-c3f7-4d99-b45e-5120ce2bc3b4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LogRecordProcessor_Signoz EXTENDS FB_LogRecordProcessor_Simple
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="enrich" Id="{91a52f0c-96a1-409b-81d1-5413c0486b5a}">
      <Declaration><![CDATA[METHOD enrich
VAR_IN_OUT
	logRecord	: TcOtlp.FB_LogRecord;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF logRecord.eventName <> 0 THEN
	logRecord.attributes.setStringAttribute('event.name', logRecord.eventName^.pString^);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>